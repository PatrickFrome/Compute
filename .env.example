# METAENGINE Compute Fabric — local environment TEMPLATE.
# Copy to .env and fill with ROTATED secrets. NEVER commit .env.
# These variables are consumed by the code via process.env (see daemon, sovereign runner, CI).

# --- Supabase (project ref: xpeibufgzjknrhbhpffp) ---
# Public project URL (safe to keep).
SUPABASE_URL=https://xpeibufgzjknrhbhpffp.supabase.co
# service_role JWT from Supabase Dashboard -> Project Settings -> API -> service_role.
# It is ADMIN and bypasses Row Level Security. Provide a ROTATED key, NOT one pasted in chat.
SUPABASE_SERVICE_ROLE_KEY=
# anon/public key (some clients may need it).
SUPABASE_ANON_KEY=
# Direct Postgres connection string used by the native pg client (orchestration/sovereign).
# Format: postgresql://postgres.<REF>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# IMPORTANT: <DB_PASSWORD> is the DATABASE password from Project Settings -> Database.
# It is NOT the service_role JWT and cannot be derived from it.
DATABASE_URL=
# Alias used by some CI workflows (.github/workflows/*.yml use SUPABASE_DB_URL).
SUPABASE_DB_URL=

# --- A2 Chat Control Plane bridge daemon (coordination/chat-control-plane/daemon) ---
A2_BRIDGE_HOST=127.0.0.1
A2_BRIDGE_PORT=8765
A2_BRIDGE_INTERNAL_PORT=8766
# Shared secret for the secure internal entry; treat as a secret.
A2_BRIDGE_SHARED_SECRET=
A2_WORKSPACE_ID=2de9f84b-7c0a-4091-911c-894ff1d6eaf4
A2_MACROBLOCK_ID=dce58a3b-2f67-47e0-ae0d-9b3825ff53cd
A2_BRIDGE_IDLE_MS=18000
A2_BRIDGE_WAKE_COOLDOWN_MS=60000
A2_BRIDGE_A2_REFRESH_MS=5000
A2_BRIDGE_SNAPSHOT_FRESH_MS=45000
A2_BRIDGE_LEASE_TIMEOUT_MS=120000
A2_BRIDGE_IDEMPOTENCY_WINDOW_MS=300000
A2_BRIDGE_STATE_DIR=state
A2_BRIDGE_CURRENT_MAIN_SHA=

# --- Sovereign duel runner (orchestration/sovereign) ---
SOVEREIGN_HTTP_HOST=127.0.0.1
SOVEREIGN_HTTP_PORT=8090
SOVEREIGN_CONTROL_TOKEN=
SOVEREIGN_GPT_URL=http://127.0.0.1:8001
SOVEREIGN_GLM_URL=http://127.0.0.1:8002
SOVEREIGN_GPT_MODEL=openai/gpt-oss-20b
SOVEREIGN_GLM_MODEL=zai-org/GLM-4.7-Flash
SOVEREIGN_INFERENCE_TOKEN=
SOVEREIGN_GPT_TOKEN=
SOVEREIGN_GLM_TOKEN=
DUEL_RUNNER_ID=
DUEL_MODEL_TIMEOUT_MS=90000
DUEL_MAX_OUTPUT_TOKENS=1200
DUEL_RECOVERY_MS=60000
SOVEREIGN_UPSTREAM_TIMEOUT_MS=120000
SOVEREIGN_HTTP_MAX_BODY_BYTES=2097152

# --- CI / external services (GitHub Actions + Cloudflare) ---
# Prefer GitHub Encrypted Secrets / Cloudflare secret store over this file in CI.
# GITHUB_TOKEN is auto-provided by Actions.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=