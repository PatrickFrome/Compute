[Unit]
Description=METAENGINE H205F22 persistent Linux worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=metaengine-worker
Group=metaengine-worker
WorkingDirectory=/var/lib/metaengine-worker
StateDirectory=metaengine-worker
RuntimeDirectory=metaengine-worker
RuntimeDirectoryMode=0700
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/metaengine-worker/worker.env
EnvironmentFile=/etc/metaengine-worker/policy.env
LoadCredential=bearer-token:/etc/metaengine-worker/bearer-token

ExecStartPre=/usr/bin/python3 /opt/metaengine-worker/w1_safety_probe.py --mode runtime
ExecStart=/usr/bin/python3 /opt/metaengine-worker/worker_agent.py

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot-locked
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Do not set RestrictSUIDSGID=yes: current systemd seccomp implementation blocks
# openat2(2) under that setting. H1-H13 explicitly requires openat2 workspace
# containment. NoNewPrivileges=yes plus an empty capability set prevents execve
# from gaining privilege via setuid/setgid bits or file capabilities.
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
ReadWritePaths=/var/lib/metaengine-worker /run/metaengine-worker

CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryMax=1G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=128
LimitNPROC=64
LimitFSIZE=16777216
LimitAS=1073741824
LimitCPU=300

KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
