{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metaengine-h205f22-aop1",
  "main": "bundle/index.js",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "AOP_MODEL": "@cf/openai/gpt-oss-20b",
    "DUEL_MAX_OUTPUT_TOKENS": "1200",
    "SUPABASE_URL": "https://xpeibufgzjknrhbhpffp.supabase.co"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AOP_SUPERVISOR",
        "class_name": "ComputeFabricSupervisor"
      }
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "AOP_WAKE_QUEUE",
        "queue": "metaengine-h205f22-aop-wake"
      }
    ]
  },
  "workflows": [
    {
      "binding": "AOP_RUN_WORKFLOW",
      "name": "metaengine-h205f22-aop-run",
      "class_name": "AopRunWorkflow"
    }
  ],
  "secrets_hint": [
    "AOP_SUPERVISOR_TOKEN",
    "AOP_WAKE_SECRET",
    "CF_ACCOUNT_ID",
    "CF_AI_TOKEN",
    "SUPABASE_SERVICE_ROLE_KEY",
    "VERCEL_AI_GATEWAY_API_KEY"
  ]
}
