{
  "manifest_version": 3,
  "name": "METAENGINE A2 Browser Operator",
  "version": "0.7.2",
  "minimum_chrome_version": "125",
  "description": "Device-bound MV3 browser operator with semantic perception, supervisor control, durable identity, and fenced physical actuation.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.z.ai/*",
    "https://xpeibufgzjknrhbhpffp.supabase.co/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.z.ai/*"
      ],
      "js": [
        "prompt-gate.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.z.ai/*"
      ],
      "js": [
        "platform-dom-compat.js",
        "content.js",
        "content-recovery.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "METAENGINE A2 Browser Operator 0.7.2 — Durable Identity"
  }
}
