{
  "schema": "metaengine.a2-browser-operator.runtime-package.v2",
  "package_version": "0.8.0",
  "operator_runtime": "0.8.0",
  "policy": {
    "canonical_filenames_only": true,
    "reject_versioned_runtime_files": true,
    "reject_unlisted_files": true,
    "generic_bootstrap_must_be_empty": true,
    "privileged_master_secret_in_bundle": false,
    "provider_architecture_is_policy_only": true,
    "browser_provider_policy": "OPENAI_WEB_CHAT_ONLY",
    "external_glm_transport": "MAILBOX_ONLY",
    "direct_peer_messaging": false,
    "single_extension_actuator": true,
    "automatic_retry_allowed": false
  },
