+        accept("maximum_version_length", image(L"C:\\Package", L"METAENGINE-Guardian-Install-Origin-" + maximum_version + L"-x64.exe"),
+            L"C:\\Package\\METAENGINE Browser Test.exe");
+        const auto suffix_size = image(L"C:\\").size() - 3;
+        const auto maximum_root = L"C:\\" + std::wstring(2048 - suffix_size - 3, L'a');
+        const auto maximum_image = image(maximum_root);
+        if (maximum_image.size() != 2048) throw std::runtime_error("maximum_path_fixture_size");
+        accept("maximum_path_budget", maximum_image, maximum_root + L"\\METAENGINE Browser Test.exe");
+        reject("path_budget_exceeded", image(maximum_root + L"a"));
+
+        for (const auto& [name, value] : std::vector<std::pair<std::string, std::wstring>>{
+            {"empty", L""}, {"relative", L"Package\\resources\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"drive_relative", L"C:Package\\resources\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"unc", L"\\\\server\\share\\Package\\resources\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"extended_device", L"\\\\?\\" + image()}, {"nt_device", L"\\??\\" + image()},
+            {"device_namespace", L"\\\\.\\" + image()}, {"root_relative", L"\\Package\\resources\\guardian-bootstrap\\" + std::wstring(kLeaf)},
