+            {"quote_component", image(L"C:\\Pack\"age")}, {"less_than_component", image(L"C:\\Pack<age")},
+            {"greater_than_component", image(L"C:\\Pack>age")}, {"pipe_component", image(L"C:\\Pack|age")},
+            {"tilde_short_alias", image(L"C:\\PROGRA~1\\Package")}, {"trailing_separator", image() + L"\\"},
+            {"drive_root_package", image(L"C:")}, {"resources_spelling", L"C:\\Package\\Resources\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"bootstrap_directory_spelling", L"C:\\Package\\resources\\Guardian-Bootstrap\\" + std::wstring(kLeaf)},
+            {"missing_resource_directory", L"C:\\Package\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"foreign_resource_directory", L"C:\\Package\\resources-old\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"extra_resource_component", L"C:\\Package\\resources\\extra\\guardian-bootstrap\\" + std::wstring(kLeaf)},
+            {"wrong_purpose", image(L"C:\\Package", L"METAENGINE-Guardian-Bootstrap-0.7.0-dev.123.1-x64.exe")},
+            {"wrong_leaf_case", image(L"C:\\Package", L"metaengine-Guardian-Install-Origin-0.7.0-dev.123.1-x64.exe")},
+            {"wrong_architecture", image(L"C:\\Package", L"METAENGINE-Guardian-Install-Origin-0.7.0-dev.123.1-arm64.exe")},
+            {"wrong_extension", image(L"C:\\Package", L"METAENGINE-Guardian-Install-Origin-0.7.0-dev.123.1-x64.dll")},
+            {"wrong_extension_case", image(L"C:\\Package", L"METAENGINE-Guardian-Install-Origin-0.7.0-dev.123.1-x64.EXE")},
+            {"leaf_trailing_bytes", image() + L".exe"},
+        }) reject(name, value);
+
+        for (const auto& name : {L"CON", L"prn", L"AuX.bin", L"NUL", L"com1", L"COM9.dat", L"lpt1", L"LPT9.log"})
+            reject("reserved_device_component_" + std::to_string(cases.size()), image(std::wstring(L"C:\\") + name));
+        accept("nonreserved_numbered_component", image(L"C:\\COM10"), L"C:\\COM10\\METAENGINE Browser Test.exe");
+
+        for (const auto& version : {L"", L"0.7.0-dev.0.1", L"0.7.0-dev.0123.1", L"0.7.0-dev..1", L"0.7.0-dev.-1.1",
+                L"0.7.0-dev.+1.1", L"0.7.0-dev.1a.1", L"0.7.0-dev.1.2", L"0.7.1-dev.1.1", L"0.7.0.1",
