+// Generated inert path DATA only. This directly exercises the production
+// lexical helper; it supplies no native process, package or signing authority.
+#include "../../native/browser-guardian-scm/browser-guardian-original-package-path-data.hpp"
+
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace {
+using metaengine::guardian::original_package_path_data::fixedExecutableFromOriginalCoordinatorImage;
+constexpr std::wstring_view kLeaf = L"METAENGINE-Guardian-Install-Origin-0.7.0-dev.123.1-x64.exe";
+
+std::wstring image(std::wstring_view root = L"C:\\Package", std::wstring_view leaf = kLeaf) {
+    return std::wstring(root) + L"\\resources\\guardian-bootstrap\\" + std::wstring(leaf);
+}
+
+std::string quote(std::string_view value) {
+    std::string result = "\"";
+    for (const auto character : value) {
+        if (character == '\\' || character == '"') result.push_back('\\');
+        result.push_back(character);
+    }
+    return result + '"';
+}
+}
+
+int main() {
+    std::vector<std::string> cases;
+    try {
+        const auto accept = [&](const std::string& name, const std::wstring& value, const std::wstring& expected) {
+            const auto result = fixedExecutableFromOriginalCoordinatorImage(value);
+            if (!result || *result != expected) throw std::runtime_error(name);
+            cases.push_back(name);
+        };
+        const auto reject = [&](const std::string& name, const std::wstring& value) {
+            if (fixedExecutableFromOriginalCoordinatorImage(value)) throw std::runtime_error(name);
+            cases.push_back(name);
+        };
+
+        accept("fixed_resource_layout", image(), L"C:\\Package\\METAENGINE Browser Test.exe");
+        accept("lowercase_drive", image(L"c:\\Package"), L"c:\\Package\\METAENGINE Browser Test.exe");
+        accept("nested_original_root", image(L"D:\\Stage\\one\\Two"), L"D:\\Stage\\one\\Two\\METAENGINE Browser Test.exe");
+        accept("unicode_ancestor_spelling_is_data", image(L"C:\\\u041f\u0430\u043a\u0435\u0442"),
+            L"C:\\\u041f\u0430\u043a\u0435\u0442\\METAENGINE Browser Test.exe");
+        accept("minimum_version_counter", image(L"C:\\P", L"METAENGINE-Guardian-Install-Origin-0.7.0-dev.1.1-x64.exe"),
+            L"C:\\P\\METAENGINE Browser Test.exe");
