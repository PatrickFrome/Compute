+        reject("version_budget_exceeded", image(L"C:\\Package",
+            L"METAENGINE-Guardian-Install-Origin-0.7.0-dev." + std::wstring(53, L'1') + L".1-x64.exe"));
+        auto control = image(L"C:\\Package");
+        control.insert(5, 1, L'\x1f');
+        reject("control_in_ancestor", control);
