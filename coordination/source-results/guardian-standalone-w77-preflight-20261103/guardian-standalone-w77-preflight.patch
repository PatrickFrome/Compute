+            std::cout << (index ? "," : "") << quote(cases[index]);
+        std::cout << "],\"windows_qualification\":\"NOT_RUN\",\"release_signature_verification\":\"NOT_RUN\","
+            "\"package_verified\":false,\"launch_authorized\":false,\"authority_effect\":false}\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cout << "{\"schema\":\"metaengine.guardian.original-package-path-data-tests.v1\",\"passed\":" << cases.size()
+            << ",\"failed\":1,\"reason\":" << quote(error.what()) << ",\"authority_effect\":false}\n";
+        return 1;
+    }
+}
