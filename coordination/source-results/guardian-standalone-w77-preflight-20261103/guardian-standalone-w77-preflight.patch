+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace metaengine::guardian::original_package_path_data {
+namespace detail {
+
+inline wchar_t lowerAscii(wchar_t value) {
+    return value >= L'A' && value <= L'Z' ? static_cast<wchar_t>(value - L'A' + L'a') : value;
+}
+
+inline bool deviceComponent(std::wstring_view component) {
+    const auto dot = component.find(L'.');
+    const auto name = component.substr(0, dot);
+    std::wstring folded;
+    folded.reserve(name.size());
+    for (const auto value : name) folded.push_back(lowerAscii(value));
+    return folded == L"con" || folded == L"prn" || folded == L"aux" || folded == L"nul" ||
+        (folded.size() == 4 && (folded.starts_with(L"com") || folded.starts_with(L"lpt")) &&
+            folded[3] >= L'1' && folded[3] <= L'9');
+}
+
+inline bool localAbsolute(std::wstring_view image) {
+    // Same local DOS path grammar and 2048-character budget as namespace
+    // capture. Conservatively refuse potential short-name aliases as well.
+    if (image.size() < 4 || image.size() > 2048 || image[1] != L':' || image[2] != L'\\' ||
+        !((image[0] >= L'A' && image[0] <= L'Z') || (image[0] >= L'a' && image[0] <= L'z')) ||
+        image.back() == L'\\') return false;
+    std::size_t start = 3;
+    while (start < image.size()) {
+        auto end = image.find(L'\\', start);
+        if (end == std::wstring_view::npos) end = image.size();
+        const auto part = image.substr(start, end - start);
+        if (part.empty() || part == L"." || part == L".." || part.back() == L'.' || part.back() == L' ' ||
+            part.find_first_of(L":/*?\"<>|~") != std::wstring_view::npos ||
+            part.find(L'\0') != std::wstring_view::npos || deviceComponent(part)) return false;
+        for (const auto value : part) if (value < 0x20) return false;
+        start = end + 1;
+    }
+    return true;
+}
+
+inline bool versionShape(std::wstring_view version) {
+    constexpr std::wstring_view prefix = L"0.7.0-dev.", suffix = L".1";
+    if (version.size() > 64 || !version.starts_with(prefix) || !version.ends_with(suffix) ||
+        version.size() <= prefix.size() + suffix.size()) return false;
+    const auto digits = version.substr(prefix.size(), version.size() - prefix.size() - suffix.size());
+    if (digits.front() == L'0') return false;
+    for (const auto digit : digits) if (digit < L'0' || digit > L'9') return false;
+    return true;
+}
+
+}  // namespace detail
+
+// DATA ONLY: derive an untrusted candidate from an already original process's
+// observed image spelling. This performs no path resolution, metadata lookup,
+// signature verification or launch. Real namespace custody and the final
+// signed-policy-derived originalImageExact check remain mandatory.
+[[nodiscard]] inline std::optional<std::wstring> fixedExecutableFromOriginalCoordinatorImage(
+    std::wstring_view image) {
+    constexpr std::wstring_view middle = L"\\resources\\guardian-bootstrap\\";
+    constexpr std::wstring_view prefix = L"METAENGINE-Guardian-Install-Origin-";
+    constexpr std::wstring_view suffix = L"-x64.exe";
+    if (!detail::localAbsolute(image)) return {};
+    const auto leaf_at = image.find_last_of(L'\\');
+    const auto leaf = image.substr(leaf_at + 1);
+    if (!leaf.starts_with(prefix) || !leaf.ends_with(suffix) ||
+        leaf.size() <= prefix.size() + suffix.size()) return {};
+    const auto version = leaf.substr(prefix.size(), leaf.size() - prefix.size() - suffix.size());
+    if (!detail::versionShape(version) || leaf_at + 1 < middle.size()) return {};
+    const auto root_size = leaf_at + 1 - middle.size();
+    if (root_size <= 3 || image.substr(root_size, middle.size()) != middle) return {};
+    std::wstring executable(image.substr(0, root_size));
+    executable += L"\\METAENGINE Browser Test.exe";
+    if (executable.size() > 2048) return {};
+    return executable;
+}
+
+}  // namespace metaengine::guardian::original_package_path_data
