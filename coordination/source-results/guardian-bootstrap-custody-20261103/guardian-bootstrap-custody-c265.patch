+#!/usr/bin/env python3
+"""Compile the actual Genesis process/package predicate against synthetic data.
+
+This is a source-extracted synthetic model plus production ordering guards.
+It does not run Windows APIs, UAC, an installer, signatures or machine effects.
+The positive model case is NOT Windows qualification or release authority.
+"""
+from pathlib import Path
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+
+
+def segment(text, start, end):
+    begin = text.index(start)
+    return text[begin:text.index(end, begin)]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--sanitize', action='store_true')
+    args = parser.parse_args()
+    native = Path(__file__).resolve().parents[2] / 'native/browser-guardian-scm'
+    source = (native / 'browser-guardian-active-policy-genesis.cpp').read_text()
+    header = (native / 'browser-guardian-active-policy-genesis.hpp').read_text()
+    package_header = (native / 'browser-guardian-active-policy-activation-package.hpp').read_text()
+    origin = (native / 'browser-guardian-active-policy-genesis-origin.inc.hpp').read_text()
+    relative = segment(source, 'std::wstring relative(', 'bool signedWindow(')
+    predicate = segment(source, 'bool GuardianActivePolicyGenesis::originalCoordinatorBootstrapExact(',
+                        'std::unique_ptr<GuardianActivePolicyGenesis> GuardianActivePolicyGenesis::captureOriginalBootstrap(')
+    request = segment(origin, 'bool GuardianInstallOriginLink::requestVerifiedGenesisElevation()',
