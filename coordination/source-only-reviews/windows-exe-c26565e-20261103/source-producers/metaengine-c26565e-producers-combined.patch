+        entries = [{'path': 'target', 'mode': '100644', 'oid': oid(b'file')},
+                   {'path': 'link', 'mode': '120000', 'oid': oid(b'target')}]
+        self.assertTrue(policy.physical_tree(root, entries)['physical_tree_verified'])
+        (root / 'link').unlink()
+        (root / 'link').symlink_to('../unreviewed')
+        with self.assertRaisesRegex(ValueError, 'canonical_checkout_representation_mismatch'):
