+// Evaluate the actual hook with imports blocked. A missing early byte gate
+// must fail the regression without invoking tool acquisition or native builds.
+function isolatedHook(name, overrides = {}) {
+  const file = path.join(APP_ROOT, 'scripts', name);
+  const load = createRequire(file);
+  const module = { exports: {} };
+  const wrapper = new vm.Script('(function(require,module,exports,__filename,__dirname){\n'
+    + fs.readFileSync(file, 'utf8') + '\n})', {
+    filename: file,
+    importModuleDynamically() { throw Error('unexpected_packaging_staging_import'); },
+  }).runInThisContext();
+  wrapper(id => Object.hasOwn(overrides, id) ? overrides[id] : load(id),
+    module, module.exports, file, path.dirname(file));
+  return module.exports;
+}
