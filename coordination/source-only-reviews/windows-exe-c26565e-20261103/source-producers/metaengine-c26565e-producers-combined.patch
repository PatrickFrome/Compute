+def synthetic_pe():
+    """Inert x64 PE-shaped bytes for the package gate; never executable."""
+    data = bytearray(1_100_000)
+    header = 0x80
+    optional_size = 0xf0
+    table = header + 24 + optional_size
+    data[:2] = b'MZ'
+    struct.pack_into('<I', data, 0x3c, header)
+    data[header:header + 4] = b'PE\0\0'
+    struct.pack_into('<HH', data, header + 4, 0x8664, 2)
+    struct.pack_into('<H', data, header + 20, optional_size)
