diff --git a/apps/metaengine-browser/scripts/bootstrap-install-and-launch.ps1 b/apps/metaengine-browser/scripts/bootstrap-install-and-launch.ps1
index 402f480..4ff103f 100644
--- a/apps/metaengine-browser/scripts/bootstrap-install-and-launch.ps1
+++ b/apps/metaengine-browser/scripts/bootstrap-install-and-launch.ps1
@@ -25,6 +25,14 @@ function Write-BootstrapProof($Proof) {
   $json
 }
 
+# RUNNER_TEMP is a CI convention; an ordinary Windows user need not have it.
+# Resolve and validate the common log location before any installer effect.
+$logDirectory = if ($env:RUNNER_TEMP) { $env:RUNNER_TEMP } else { [System.IO.Path]::GetTempPath() }
+if (-not $logDirectory -or -not [System.IO.Path]::IsPathRooted($logDirectory) `
+    -or -not (Test-Path -LiteralPath $logDirectory -PathType Container)) {
+  throw 'bootstrap_log_directory_unavailable'
+}
+
 if ($ExpectedInstallerSha256 -notmatch '^[a-fA-F0-9]{64}$') { throw 'bootstrap_installer_sha256_invalid' }
 if ($ExpectedVersion -notmatch '^\d+\.\d+\.\d+-dev\.\d+\.1$') { throw 'bootstrap_expected_version_invalid' }
 if (-not (Test-Path -LiteralPath $InstallerPath -PathType Leaf)) { throw 'bootstrap_installer_missing' }
@@ -128,8 +136,8 @@ $userData = $null
 $startupJournal = $null
 $versionProbeVerified = $false
 if ($PhysicalProof) {
-  $profileOut = Join-Path $env:RUNNER_TEMP 'bootstrap-profile-probe.out'
-  $profileErr = Join-Path $env:RUNNER_TEMP 'bootstrap-profile-probe.err'
+  $profileOut = Join-Path $logDirectory 'bootstrap-profile-probe.out'
+  $profileErr = Join-Path $logDirectory 'bootstrap-profile-probe.err'
   Remove-Item $profileOut,$profileErr -Force -ErrorAction SilentlyContinue
