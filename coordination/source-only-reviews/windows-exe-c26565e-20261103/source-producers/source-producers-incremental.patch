+    const section = { name, header, rva, virtualSize, offset, size,
+      mappedSize: round(Math.max(virtualSize, size), sectionAlignment),
+      flags: image.readUInt32LE(header + 36), start: offset, end: offset + size };
+    for (const previous of sections) {
