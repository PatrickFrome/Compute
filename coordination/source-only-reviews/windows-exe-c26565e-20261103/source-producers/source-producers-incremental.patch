@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import { fixedLayoutFixture } from './fixtures/pe-fixed-layout.mjs';
+const require = createRequire(import.meta.url);
+const { sourceInventory, comparePinnedSourceBytes, deriveAsarIntegrityResource,
+  collectWindowsTransformIngredients } = require('../scripts/custom-electron-transform-inputs.cjs');
+const { inspectFixedLayoutTransform, sourceFuseWrites, peChecksum } = require('../scripts/custom-electron-pe-layout.cjs');
+const app = fileURLToPath(new URL('../', import.meta.url));
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+
+function sourceBytes(t) {
+  const fixture = process.env.METAENGINE_TEST_TRANSFORM_SOURCE_BYTES;
+  if (fixture) {
+    const data = JSON.parse(fs.readFileSync(fixture));
+    return { lockBytes: Buffer.from(data.lock_base64, 'base64'),
+      sourceFiles: new Map(Object.entries(data.files_base64).map(([name, value]) => [name, Buffer.from(value, 'base64')])) };
+  }
+  try {
+    return { lockBytes: fs.readFileSync(path.join(app, 'package-lock.json')),
+      sourceFiles: new Map([...sourceInventory()].map(([name]) => [name, fs.readFileSync(path.join(app, name))])) };
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+    t.skip('Exact installed source bytes or explicit read-only archive-byte fixture unavailable'); return null;
+  }
+}
+
+test('source-only ingredient comparison binds all 52 CJS modules and 9 reference sources', t => {
+  const input = sourceBytes(t); if (!input) return;
+  const proof = comparePinnedSourceBytes(input);
+  assert.equal(proof.scope, 'PINNED_SOURCE_BYTES_ONLY');
+  assert.equal(proof.cjs_module_count, 52); assert.equal(proof.reference_source_count, 9);
+  assert.equal(proof.file_count, 63); assert.equal(proof.authority_effect, false);
+});
+
+for (const target of ['node_modules/resedit/dist/index.js', 'node_modules/pe-library/dist/NtExecutable.js',
+  'node_modules/app-builder-lib/node_modules/@electron/fuses/dist/index.js']) {
+  test('changed source bytes cannot reuse the ingredient catalog: ' + target, t => {
+    const input = sourceBytes(t); if (!input) return;
+    const changed = Buffer.from(input.sourceFiles.get(target)); changed[0] ^= 0xff;
+    input.sourceFiles.set(target, changed);
+    assert.throws(() => comparePinnedSourceBytes(input), /source_bytes_drift/);
+  });
+}
+
+test('missing source and changed lock SRI both refuse an ingredient comparison', t => {
+  const input = sourceBytes(t); if (!input) return;
+  const incomplete = new Map(input.sourceFiles); incomplete.delete(incomplete.keys().next().value);
+  assert.throws(() => comparePinnedSourceBytes({ ...input, sourceFiles: incomplete }), /source_inventory_incomplete/);
+  const lock = JSON.parse(input.lockBytes); lock.packages['node_modules/resedit'].integrity = 'sha512-unreviewed';
+  assert.throws(() => comparePinnedSourceBytes({ ...input, lockBytes: Buffer.from(JSON.stringify(lock)) }), /dependency_lock_drift/);
+});
+
+function asar(header, body = Buffer.from('inert payload')) {
+  const text = Buffer.from(header), size = 4 + Math.ceil((4 + text.length) / 4) * 4;
+  const bytes = Buffer.alloc(8 + size + body.length);
+  bytes.writeUInt32LE(4, 0); bytes.writeUInt32LE(size, 4);
+  bytes.writeUInt32LE(size - 4, 8); bytes.writeUInt32LE(text.length, 12);
+  text.copy(bytes, 16); body.copy(bytes, 8 + size); return bytes;
+}
+
+test('pure ASAR utility hashes the exact UTF-8 header string and serializes the builder payload', () => {
+  const header = JSON.stringify({ files: { 'é.mjs': { size: 1, offset: '0' } } });
+  const expected = Buffer.from(JSON.stringify([{ file: 'resources\\app.asar', alg: 'SHA256', value: hash(Buffer.from(header)) }]));
+  assert.deepEqual(deriveAsarIntegrityResource(asar(header)), expected);
+  assert.deepEqual(deriveAsarIntegrityResource(asar(header, Buffer.from('different inert body'))), expected);
+});
+
+test('ASAR utility refuses malformed/truncated pickle, invalid UTF-8 and non-files header', () => {
+  const valid = asar('{"files":{}}');
+  assert.throws(() => deriveAsarIntegrityResource(valid.subarray(0, 15)), /asar_/);
+  const oversized = Buffer.from(valid); oversized.writeUInt32LE(0x7fffffff, 4);
+  assert.throws(() => deriveAsarIntegrityResource(oversized), /asar_header_pickle_invalid/);
+  const utf8 = Buffer.from(valid); utf8[16] = 0xff;
+  assert.throws(() => deriveAsarIntegrityResource(utf8), /asar_header_utf8_invalid/);
+  assert.throws(() => deriveAsarIntegrityResource(asar('\ufeff{"files":{}}')), /asar_header_bom_unsupported/);
+  assert.throws(() => deriveAsarIntegrityResource(asar('{}')), /asar_header_files_invalid/);
+});
+
+test('collector never invents expected ASAR identity and its CLI remains HOLD', () => {
+  const ingredients = collectWindowsTransformIngredients();
+  assert.equal(ingredients.state, 'HOLD'); assert.equal(ingredients.expected_asar_integrity, null);
+  assert.equal(ingredients.authority_effect, false);
