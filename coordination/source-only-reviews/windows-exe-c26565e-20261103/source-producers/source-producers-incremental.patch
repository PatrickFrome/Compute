+        { start: previous.rva, end: previous.rva + previous.mappedSize })) fail('section_overlap');
+    }
+    names.add(name); sections.push(section);
+  }
+  const directories = Array.from({ length: 16 }, (_, index) => ({
+    rva: image.readUInt32LE(optional + 112 + index * 8),
+    size: image.readUInt32LE(optional + 116 + index * 8),
+  }));
+  if (directories[4].rva || directories[4].size) fail('unsigned_image_required');
+  const resource = sections.find(section => section.name === '.rsrc');
+  if (!resource || resource.flags !== 0x40000040 || resource.virtualSize > resource.size
