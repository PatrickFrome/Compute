diff --git a/apps/metaengine-browser/scripts/custom-electron-pe-layout.cjs b/apps/metaengine-browser/scripts/custom-electron-pe-layout.cjs
new file mode 100644
index 0000000..b463697
--- /dev/null
+++ b/apps/metaengine-browser/scripts/custom-electron-pe-layout.cjs
@@ -0,0 +1,143 @@
+'use strict';
+// A precondition audit for a FUTURE expected-image serializer. This is not a
+// transform verifier: resource serialization and indirect loader references
+// remain unresolved, so even a successful audit returns HOLD. The production
+// package gate continues to require exact whole-image equality.
+const { createHash } = require('node:crypto');
+const FUSE_SENTINEL = Buffer.from('dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX');
+const fail = reason => { throw Error('custom_electron_layout_' + reason); };
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+const round = (value, alignment) => Math.ceil(value / alignment) * alignment;
+const powerOfTwo = value => value > 0 && Number.isInteger(Math.log2(value));
+function span(start, size, limit) {
+  return Number.isSafeInteger(start) && Number.isSafeInteger(size) && start >= 0 && size > 0
+    && start <= limit && size <= limit - start;
+}
+function overlaps(a, b) { return a.start < b.end && b.start < a.end; }
+
+function readFixedLayout(image) {
+  if (!Buffer.isBuffer(image) || image.length < 512 || image.length > 512 * 1024 * 1024
+      || image.toString('ascii', 0, 2) !== 'MZ') fail('image_invalid');
+  const nt = image.readUInt32LE(0x3c);
+  if (nt < 64 || nt % 4 || !span(nt, 24 + 240, image.length) || image.toString('ascii', nt, nt + 4) !== 'PE\0\0'
+      || image.readUInt16LE(nt + 4) !== 0x8664 || image.readUInt16LE(nt + 20) !== 240
+      || image.readUInt16LE(nt + 24) !== 0x20b) fail('pe32plus_x64_required');
+  if (image.readUInt32LE(nt + 12) || image.readUInt32LE(nt + 16)) fail('symbols_unsupported');
+  const optional = nt + 24, table = optional + 240;
+  const count = image.readUInt16LE(nt + 6);
+  if (!count || count > 96 || !span(table, count * 40, image.length)
+      || image.readUInt32LE(optional + 108) !== 16) fail('headers_unsupported');
+  const fileAlignment = image.readUInt32LE(optional + 36);
+  const sectionAlignment = image.readUInt32LE(optional + 32);
+  const headers = image.readUInt32LE(optional + 60);
+  if (!powerOfTwo(fileAlignment) || fileAlignment < 512 || fileAlignment > 65536
+      || !powerOfTwo(sectionAlignment) || sectionAlignment < fileAlignment
+      || headers !== round(table + count * 40, fileAlignment) || headers > image.length) fail('alignment_unsupported');
+  const sections = [], names = new Set();
+  for (let index = 0; index < count; index++) {
+    const header = table + index * 40;
+    const name = image.toString('ascii', header, header + 8).replace(/\0+$/, '');
+    const virtualSize = image.readUInt32LE(header + 8), rva = image.readUInt32LE(header + 12);
+    const size = image.readUInt32LE(header + 16), offset = image.readUInt32LE(header + 20);
+    if (!/^[.A-Za-z0-9_-]+$/.test(name) || names.has(name) || !virtualSize
+        || !span(offset, size, image.length) || offset < headers || offset % fileAlignment || size % fileAlignment
