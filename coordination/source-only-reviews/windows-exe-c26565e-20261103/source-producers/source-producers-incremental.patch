+      'INDIRECT_LOADER_REFERENCE_CLOSURE', 'EXACT_EXPECTED_WHOLE_IMAGE_COMPARISON'], authority_effect: false });
+}
+
+module.exports = { readFixedLayout, sourceFuseWrites, peChecksum, inspectFixedLayoutTransform };
