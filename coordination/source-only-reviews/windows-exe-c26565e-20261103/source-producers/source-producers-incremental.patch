index 0000000..72e6932
--- /dev/null
+++ b/apps/metaengine-browser/scripts/custom-electron-source-policy.py
@@ -0,0 +1,416 @@
+#!/usr/bin/env python3
+"""Derive complete component Git trees from pinned objects and official patches.
+
+This producer never runs source scripts, hooks, downloads or a compiler. Its
+scope is COMPLETE_COMPONENT_GIT_TREES, not the enabled gclient/DEPS/CIPD/hook or
+toolchain closure. All output remains build-host evidence without release or
+runtime authority. The physical profile is canonical raw Git blobs: upstream
+attribute-driven EOL/encoding conversions are not silently normalized.
+"""
+import argparse
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import stat
+import subprocess
+import tempfile
+
+ELECTRON_COMMIT = 'c542df1ecbc2c2978e8f53f8c7baf602404d166f'
+ELECTRON_TREE = '328891d1f8b4d93d49c9f31332baf75fa726cb6e'
+COMPONENTS = {
+    'electron': (ELECTRON_COMMIT, None),
+    'chromium': ('dd78960ccd8a03a2fe1f629543d27783885b78e9', 'patches/chromium'),
+    'node': ('f14cd3aa7bf9ca8df2cc5b8bb14beb0f335b1d93', 'patches/node'),
+    'v8': ('a11d960c1c22c067ff898ceb4a8e4e0687014d41', 'patches/v8'),
+    'boringssl': ('572a4c68475d284b34675f45ddbb9c158ef3c2ae', 'patches/boringssl'),
+}
+KNOWN_BASE_TREES = {
+    'electron': ELECTRON_TREE,
+    'chromium': '63b2edfe4c6ae23d2fd3424cde3e529db49f7068',
+    'node': '409a26f676d83fa6e1b0bfdb1c10d6878845c071',
+}
+OID = re.compile(r'^[0-9a-f]{40}$')
+MAX_OBJECT = 1024 ** 3
+
+
+def fail(reason):
+    raise ValueError('custom_electron_source_policy_' + reason)
+
+
+def environment(extra=None):
+    result = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
+    result.update(GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull,
+                  GIT_NO_REPLACE_OBJECTS='1', GIT_OPTIONAL_LOCKS='0',
+                  GIT_NO_LAZY_FETCH='1', GIT_TERMINAL_PROMPT='0')
+    result.update(extra or {})
+    return result
+
+
+def git_arguments(repo, *args):
+    return ['git', '--no-optional-locks', '-c', 'core.fsmonitor=false',
+            '-c', 'core.hooksPath=' + os.devnull, '-c', 'core.attributesFile=' + os.devnull,
+            '-c', 'core.autocrlf=false', '-C', str(repo), *map(str, args)]
+
+
+def git(repo, *args, data=None, allow_missing=False):
+    result = subprocess.run(git_arguments(repo, *args), input=data, capture_output=True,
+                            env=environment(), timeout=120)
+    if result.returncode and not allow_missing:
+        # Never expose provider/config diagnostics or execute a lazy fetch.
+        fail('git_operation_failed:' + str(args[0]))
+    return result.stdout
+
+
+def repository_controls(repo):
+    repo = Path(repo).absolute()
+    if not repo.is_dir() or repo.is_symlink() or repo.resolve() != repo:
+        fail('canonical_repository_required')
+    # Read only the repository's own config keys, never included files. Reject
+    # alternate config composition before any object access could trigger an
+    # included promisor remote or filter. False includeIf conditions are still
+    # outside this producer's deliberately fixed configuration profile.
+    config_keys = {key.casefold() for key in git(repo, 'config', '--local',
+        '--no-includes', '--name-only', '--list').decode('utf-8', 'strict').splitlines()}
+    if any(key.startswith(('include.', 'includeif.')) for key in config_keys) \
+            or 'extensions.worktreeconfig' in config_keys:
+        fail('local_config_composition_forbidden')
+    if any(key == 'extensions.partialclone' or key.startswith('filter.')
+            or (key.startswith('remote.') and key.endswith('.promisor'))
+            or key in ('core.attributesfile', 'core.fsmonitor') for key in config_keys):
+        fail('partial_clone_or_external_filter_forbidden')
+    top = git(repo, 'rev-parse', '--show-toplevel').decode().strip()
+    if Path(top).resolve() != repo or git(repo, 'rev-parse', '--show-object-format').strip() != b'sha1':
+        fail('repository_root_or_object_format')
+    if git(repo, 'for-each-ref', '--format=%(refname)', 'refs/replace').strip():
+        fail('replacement_objects_forbidden')
+    grafts = Path(git(repo, 'rev-parse', '--path-format=absolute', '--git-path', 'info/grafts').decode().strip())
+    if grafts.exists() and (grafts.is_symlink() or grafts.stat().st_size):
+        fail('grafts_forbidden')
+    return repo
+
+
+class Objects:
+    """Streaming raw object verification; never textconv/attributes/filters."""
+    def __init__(self, repo):
+        self.repo = Path(repo)
+        self.child = subprocess.Popen(git_arguments(repo, 'cat-file', '--batch'),
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+            env=environment())
+        self.checked = set()
+
+    def read(self, oid, retain=True):
+        if not OID.fullmatch(oid):
+            fail('object_id_invalid')
+        self.child.stdin.write((oid + '\n').encode())
+        self.child.stdin.flush()
+        fields = self.child.stdout.readline(256).rstrip(b'\n').split(b' ')
+        if len(fields) != 3 or fields[0].decode('ascii', 'strict') != oid:
+            fail('required_object_unavailable:' + oid)
+        kind = fields[1].decode('ascii', 'strict')
+        if kind not in ('blob', 'tree', 'commit') or not fields[2].isdigit():
+            fail('object_header_invalid')
+        size = int(fields[2])
+        if size > MAX_OBJECT or (retain and size > 64 * 1024 ** 2):
+            fail('object_too_large')
+        digest = hashlib.sha1(kind.encode() + b' ' + fields[2] + b'\0')
+        chunks, remaining = [], size
+        while remaining:
+            chunk = self.child.stdout.read(min(1024 ** 2, remaining))
+            if not chunk:
+                fail('object_read_incomplete')
+            digest.update(chunk)
+            if retain:
+                chunks.append(chunk)
+            remaining -= len(chunk)
+        if self.child.stdout.read(1) != b'\n' or digest.hexdigest() != oid:
+            fail('object_content_hash_mismatch')
+        self.checked.add(oid)
+        return kind, b''.join(chunks)
+
+    def close(self):
+        self.child.stdin.close()
+        try:
+            self.child.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            self.child.terminate()
+            self.child.wait(timeout=5)
+        self.child.stdout.close()
+
+
+def commit_tree(objects, commit):
+    kind, content = objects.read(commit)
+    first = content.split(b'\n', 1)[0]
+    if kind != 'commit' or not first.startswith(b'tree '):
+        fail('commit_object_invalid')
+    tree = first[5:].decode('ascii', 'strict')
+    if not OID.fullmatch(tree):
+        fail('commit_tree_invalid')
+    return tree
+
+
+def tree_entries(objects, tree, prefix='', verify_blobs=True):
+    kind, content = objects.read(tree)
+    if kind != 'tree':
+        fail('tree_object_invalid')
+    entries, offset = [], 0
+    while offset < len(content):
+        space = content.find(b' ', offset)
+        end = content.find(b'\0', space + 1)
+        if space < 0 or end < 0 or end + 21 > len(content):
+            fail('tree_encoding_invalid')
+        mode = content[offset:space].decode('ascii', 'strict')
+        name = content[space + 1:end].decode('utf-8', 'strict')
+        if not name or name in ('.', '..') or '/' in name or '\\' in name:
+            fail('tree_path_invalid')
+        path = prefix + name
+        oid = content[end + 1:end + 21].hex()
+        offset = end + 21
+        if mode == '40000':
+            entries.extend(tree_entries(objects, oid, path + '/', verify_blobs))
+        elif mode in ('100644', '100755', '120000', '160000'):
+            if mode != '160000' and verify_blobs and oid not in objects.checked:
+                if objects.read(oid, retain=False)[0] != 'blob':
+                    fail('tree_leaf_not_blob')
+            entries.append({'path': path, 'mode': mode, 'oid': oid})
+        else:
+            fail('tree_mode_invalid')
+    return sorted(entries, key=lambda entry: entry['path'])
+
+
+@contextmanager
+def derive_component_tree(electron_repo, component_repo, component):
+    """All official patches, in order, in private index/object storage only."""
+    if component not in COMPONENTS:
+        fail('component_invalid')
+    electron_repo = repository_controls(electron_repo)
+    component_repo = repository_controls(component_repo)
+    authority, source, derived = Objects(electron_repo), Objects(component_repo), None
+    try:
+        authority_tree = commit_tree(authority, ELECTRON_COMMIT)
+        if authority_tree != ELECTRON_TREE:
+            fail('electron_authority_tree_mismatch')
+        authority_entries = {entry['path']: entry for entry in tree_entries(authority,
+            authority_tree, verify_blobs=False)}
+        base, patch_directory = COMPONENTS[component]
+        base_tree = commit_tree(source, base)
+        if component in KNOWN_BASE_TREES and base_tree != KNOWN_BASE_TREES[component]:
+            fail('base_tree_mismatch')
+        tree_entries(source, base_tree)  # Hash all base blobs, not selected headers.
+        patches, list_blob = [], None
+        if patch_directory:
+            row = authority_entries.get(patch_directory + '/.patches')
+            if not row or row['mode'] != '100644':
+                fail('patch_order_missing')
+            list_blob = row['oid']
+            _, order = authority.read(list_blob)
+            names = order.decode('utf-8', 'strict').splitlines()
+            if not names or len(names) != len(set(names)):
+                fail('patch_order_invalid')
+            for name in names:
+                if not re.fullmatch(r'[A-Za-z0-9_.-]+\.patch', name):
+                    fail('patch_name_invalid')
+                row = authority_entries.get(patch_directory + '/' + name)
+                if not row or row['mode'] != '100644':
+                    fail('official_patch_missing')
+                kind, content = authority.read(row['oid'])
+                if kind != 'blob':
+                    fail('official_patch_not_blob')
+                patches.append((name, row['oid'], content))
+        with tempfile.TemporaryDirectory(prefix='guardian-component-tree-') as directory:
+            scratch = Path(directory)
+            bare = scratch / 'replay.git'
+            result = subprocess.run(['git', 'init', '--bare', '--quiet', str(bare)],
+                env=environment(), capture_output=True, timeout=30)
+            if result.returncode:
+                fail('temporary_repository_failed')
+            object_path = git(component_repo, 'rev-parse', '--path-format=absolute',
+                              '--git-path', 'objects').decode().strip()
+            (bare / 'objects/info/alternates').write_text(object_path + '\n')
+            git(bare, 'read-tree', base)
+            for _, _, content in patches:
+                git(bare, 'apply', '--cached', '--whitespace=nowarn', '-', data=content)
+            expected_tree = git(bare, 'write-tree').decode().strip()
+            derived = Objects(bare)
+            derived.checked.update(source.checked)
+            entries = tree_entries(derived, expected_tree)
+            serialized = json.dumps(entries, separators=(',', ':'), ensure_ascii=False).encode()
+            evidence = {
+                'schema': 'metaengine.component-git-tree-proof.v1',
+                'scope': 'COMPLETE_COMPONENT_GIT_TREES', 'component': component,
+                'electron_commit': ELECTRON_COMMIT, 'electron_tree': ELECTRON_TREE,
+                'base_commit': base, 'base_tree': base_tree,
+                'patch_order_blob': list_blob,
+                'patches': [{'name': name, 'blob_sha1': oid,
+                    'sha256': hashlib.sha256(content).hexdigest(), 'bytes': len(content)}
+                    for name, oid, content in patches],
+                'expected_tree': expected_tree, 'entry_count': len(entries),
+                'entry_manifest_sha256': hashlib.sha256(serialized).hexdigest(),
+                'gitlinks': [entry for entry in entries if entry['mode'] == '160000'],
+                'physical_profile': 'canonical-raw-git-blobs-v1',
+                'physical_tree_verified': False, 'dependency_closure_verified': False,
+                'compiler_or_windows_build_executed': False, 'authority_effect': False,
+            }
+            yield evidence, entries, derived
+    finally:
+        if derived:
+            derived.close()
+        authority.close()
+        source.close()
+
+
+def physical_tree(root, entries):
+    """Read every physical byte; Git index assume/skip flags cannot hide drift."""
+    root = Path(root).absolute()
+    if not root.is_dir() or root.is_symlink() or root.resolve() != root:
+        fail('canonical_physical_tree_required')
+    expected = {entry['path']: entry for entry in entries}
+    gitlinks = {entry['path'] for entry in entries if entry['mode'] == '160000'}
+    directories = {str(PurePosixPath(name).parent) for name in expected}
+    for name in tuple(directories):
+        directories.update(str(parent) for parent in PurePosixPath(name).parents)
+    seen, pins = set(), []
+    def identity(info):
+        return (info.st_dev, info.st_ino, info.st_mode, info.st_nlink, info.st_size,
+                info.st_mtime_ns, info.st_ctime_ns)
+    for current, dirs, files in os.walk(root, followlinks=False):
+        current = Path(current)
+        pins.append((current, identity(current.lstat())))
+        for name in tuple(dirs):
+            target = current / name
+            relative = target.relative_to(root).as_posix()
+            if relative == '.git':
+                dirs.remove(name)
+            elif relative in gitlinks:
+                if target.is_symlink():
+                    fail('gitlink_directory_alias')
+                dirs.remove(name)
+            elif target.is_symlink():
+                dirs.remove(name)
+                files.append(name)
+            elif relative not in directories:
+                fail('extra_physical_directory:' + relative)
+        for name in files:
+            target = current / name
+            relative = target.relative_to(root).as_posix()
+            if relative == '.git':
+                continue  # A real worktree .git control file is not source.
+            row = expected.get(relative)
+            if row is None or relative in gitlinks:
+                fail('extra_physical_file:' + relative)
+            before = target.lstat()
+            if row['mode'] == '120000':
+                if not stat.S_ISLNK(before.st_mode):
+                    fail('reviewed_symlink_representation_required:' + relative)
+                content = os.fsencode(os.readlink(target))
+                digest = hashlib.sha1(b'blob ' + str(len(content)).encode() + b'\0' + content).hexdigest()
+            else:
+                if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
+                    fail('physical_file_alias:' + relative)
+                if os.name != 'nt' and bool(before.st_mode & 0o111) != (row['mode'] == '100755'):
+                    fail('physical_file_mode_mismatch:' + relative)
+                value = hashlib.sha1(b'blob ' + str(before.st_size).encode() + b'\0')
+                with target.open('rb') as stream:
+                    if identity(os.fstat(stream.fileno())) != identity(before):
+                        fail('physical_file_changed')
+                    for chunk in iter(lambda: stream.read(1024 ** 2), b''):
+                        value.update(chunk)
+                    if identity(os.fstat(stream.fileno())) != identity(before):
+                        fail('physical_file_changed')
+                digest = value.hexdigest()
+            if digest != row['oid']:
+                fail('canonical_checkout_representation_mismatch:' + relative)
+            if identity(target.lstat()) != identity(before):
+                fail('physical_file_changed')
+            pins.append((target, identity(before)))
+            seen.add(relative)
+    if seen != set(expected) - gitlinks:
+        fail('physical_tree_file_set_mismatch')
+    if any(identity(target.lstat()) != before for target, before in pins):
+        fail('physical_tree_changed_during_readback')
+    return {'physical_tree_verified': True, 'physical_file_count': len(seen),
+            'gitlink_dependencies_qualified': False, 'windows_representation_qualified': False}
+
+
+def materialize_canonical_tree(root, entries, objects):
+    """Create a new source-only tree from verified raw blobs; never overwrite."""
+    root = Path(root).absolute()
+    if not root.parent.is_dir() or root.parent.resolve() != root.parent or root.exists():
+        fail('new_canonical_output_required')
+    root.mkdir(mode=0o700)
+    for row in entries:
+        target = root.joinpath(*PurePosixPath(row['path']).parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        if row['mode'] == '160000':
+            target.mkdir()
+            continue  # An empty dependency placeholder is never qualified.
+        kind, content = objects.read(row['oid'])
+        if kind != 'blob':
+            fail('canonical_source_not_blob')
+        if row['mode'] == '120000':
+            target.symlink_to(os.fsdecode(content))
+        else:
+            with target.open('xb') as stream:
+                stream.write(content)
+            target.chmod(0o755 if row['mode'] == '100755' else 0o644)
+    return physical_tree(root, entries)
+
+
+def verify_component_tree(electron_repo, checkout, component):
+    with derive_component_tree(electron_repo, checkout, component) as (evidence, entries, _):
+        observed = git(checkout, 'rev-parse', 'HEAD').decode().strip()
+        objects = Objects(checkout)
+        try:
+            if commit_tree(objects, observed) != evidence['expected_tree']:
+                fail('observed_component_tree_mismatch:' + component)
+        finally:
+            objects.close()
+        evidence.update(physical_tree(checkout, entries))
+        if git(checkout, 'rev-parse', 'HEAD').decode().strip() != observed:
+            fail('observed_component_head_changed')
+        return {**evidence, 'observed_head': observed}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron', required=True, type=Path)
+    parser.add_argument('--checkout', required=True, type=Path)
+    parser.add_argument('--component', required=True, choices=tuple(COMPONENTS))
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument('--derive-only', action='store_true',
+                        help='Derive expected objects only; does not qualify a physical checkout')
+    mode.add_argument('--canonical-output', type=Path,
+                        help='Create a NEW canonical raw-blob source tree; no hooks or dependencies')
+    mode.add_argument('--physical-tree', type=Path,
+                      help='Verify a separate canonical source tree against the fully derived tree')
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    try:
+        if args.derive_only or args.canonical_output or args.physical_tree:
+            with derive_component_tree(args.electron, args.checkout, args.component) as result:
+                evidence = result[0]
+                if args.canonical_output:
+                    evidence.update(materialize_canonical_tree(args.canonical_output, result[1], result[2]))
+                    evidence['canonical_source_materialization'] = True
+                elif args.physical_tree:
+                    evidence.update(physical_tree(args.physical_tree, result[1]))
+                    evidence['physical_tree_is_separate_from_object_checkout'] = True
+        else:
+            evidence = verify_component_tree(args.electron, args.checkout, args.component)
+        with args.output.open('x', encoding='utf-8') as stream:
+            json.dump(evidence, stream, indent=2)
+            stream.write('\n')
+        print(json.dumps({'scope': evidence['scope'], 'component': args.component,
+            'expected_tree': evidence['expected_tree'], 'entry_count': evidence['entry_count'],
+            'patch_count': len(evidence['patches']),
+            'physical_tree_verified': evidence['physical_tree_verified'],
+            'dependency_closure_verified': False, 'authority_effect': False}))
+    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
+        reason = str(error) if str(error).startswith('custom_electron_source_policy_') else 'custom_electron_source_policy_unavailable'
+        parser.exit(1, reason + '\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/apps/metaengine-browser/scripts/custom-electron-transform-inputs.cjs b/apps/metaengine-browser/scripts/custom-electron-transform-inputs.cjs
new file mode 100644
index 0000000..6167c7c
--- /dev/null
+++ b/apps/metaengine-browser/scripts/custom-electron-transform-inputs.cjs
@@ -0,0 +1,147 @@
+'use strict';
+// Build-only ingredient collection. No dependency code is imported/executed.
+// No caller-provided expected image, ASAR path, callback or "verified" receipt
+// can authorize a transform. The expected-resource producer does not exist yet;
+// this collector therefore always reports HOLD and is not a package gate.
+const fs = require('node:fs');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const APP = path.resolve(__dirname, '..');
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+const fail = reason => { throw Error('custom_electron_transform_inputs_' + reason); };
+
+function stableFile(root, relative, maximum = 8 * 1024 * 1024) {
+  if (!relative || relative.includes('\\') || path.isAbsolute(relative)
+      || relative.split('/').some(part => !part || part === '.' || part === '..')) fail('path_invalid');
+  let current = root;
+  if (fs.lstatSync(current).isSymbolicLink()) fail('source_alias');
+  for (const part of relative.split('/')) {
+    current = path.join(current, part);
+    if (fs.lstatSync(current).isSymbolicLink()) fail('source_alias');
+  }
+  const before = fs.lstatSync(current);
+  if (!before.isFile() || before.nlink !== 1 || before.size > maximum) fail('source_file_invalid');
+  const actual = fs.realpathSync(current), expected = path.resolve(current);
+  if (process.platform === 'win32' ? actual.toLowerCase() !== expected.toLowerCase() : actual !== expected) fail('source_alias');
+  const bytes = fs.readFileSync(current), after = fs.lstatSync(current);
+  if (before.dev !== after.dev || before.ino !== after.ino || before.size !== bytes.length
+      || before.size !== after.size || before.mtimeMs !== after.mtimeMs || !after.isFile() || after.nlink !== 1) fail('source_changed');
+  return bytes;
+}
+
+function catalog() {
+  const bytes = stableFile(APP, 'build/custom-electron-transform-inputs.json');
+  const value = JSON.parse(bytes);
+  if (value.schema !== 'metaengine.custom-electron.transform-input-catalog.v1'
+      || value.entry_module !== 'resedit/dist/index.js'
+      || Object.keys(value.packages).sort().join(',') !== 'pe-library,resedit'
+      || value.modules.length !== 52 || value.reference_sources.length !== 9) fail('catalog_invalid');
+  Object.defineProperty(value, 'source_catalog_sha256', { value: sha(bytes) });
+  return value;
+}
+
+function sourceInventory(value = catalog()) {
+  const files = new Map();
+  const add = (relative, bytes, digest) => {
+    if (files.has(relative) || !Number.isSafeInteger(bytes) || bytes < 1 || !/^[a-f0-9]{64}$/.test(digest)) fail('catalog_file_invalid');
+    files.set(relative, { bytes, sha256: digest });
+  };
+  for (const item of Object.values(value.packages)) add(item.lock_path + '/package.json', item.package_json_bytes, item.package_json_sha256);
+  for (const item of value.modules) {
+    const owner = value.packages[item.package];
+    if (!owner) fail('catalog_owner_invalid');
+    add(owner.lock_path + '/' + item.path, item.bytes, item.sha256);
+  }
+  for (const item of value.reference_sources) add(item.lock_path + '/' + item.path, item.bytes, item.sha256);
+  return files;
+}
+
+// A data-only comparison against the checked-in lock-derived catalog. This
+// does not qualify a serializer, prove safe module loading, or admit an image.
+function comparePinnedSourceBytes({ lockBytes, sourceFiles }) {
+  const value = catalog(), lock = JSON.parse(lockBytes.toString('utf8'));
+  const records = [...Object.values(value.packages), ...value.reference_sources];
+  for (const item of records) {
+    const pin = lock.packages?.[item.lock_path];
+    if (!pin || pin.version !== item.version || pin.resolved !== item.resolved || pin.integrity !== item.lock_integrity) fail('dependency_lock_drift:' + item.lock_path);
+  }
+  const inventory = sourceInventory(value);
+  if (!(sourceFiles instanceof Map) || sourceFiles.size !== inventory.size) fail('source_inventory_incomplete');
+  const summaries = [];
+  for (const [relative, pin] of inventory) {
+    const bytes = sourceFiles.get(relative);
+    if (!Buffer.isBuffer(bytes) || bytes.length !== pin.bytes || sha(bytes) !== pin.sha256) fail('source_bytes_drift:' + relative);
+    summaries.push({ path: relative, bytes: bytes.length, sha256: pin.sha256 });
+  }
+  return Object.freeze({ scope: 'PINNED_SOURCE_BYTES_ONLY', cjs_module_count: value.modules.length,
+    reference_source_count: value.reference_sources.length, file_count: inventory.size,
+    source_inventory_sha256: sha(Buffer.from(JSON.stringify(summaries))),
+    catalog_sha256: value.source_catalog_sha256, authority_effect: false });
+}
+
+// Pure byte utility for a FUTURE producer-owned immutable ASAR snapshot. The
+// collector below deliberately never obtains expected integrity from a
+// candidate app.asar. Header hashing follows builder 26.15.7 readAsarHeader/
+// hashHeader: the UTF-8 header string, not the ASAR body or raw pickle bytes.
+function deriveAsarIntegrityResource(immutableExpectedAsarBytes) {
+  const bytes = immutableExpectedAsarBytes;
+  if (!Buffer.isBuffer(bytes) || bytes.length < 16 || bytes.readUInt32LE(0) !== 4) fail('asar_size_pickle_invalid');
+  const size = bytes.readUInt32LE(4);
+  if (size < 8 || size > 16 * 1024 * 1024 || size % 4 || size > bytes.length - 8
+      || bytes.readUInt32LE(8) !== size - 4) fail('asar_header_pickle_invalid');
+  const length = bytes.readUInt32LE(12);
+  if (length > size - 8) fail('asar_header_string_invalid');
+  const raw = bytes.subarray(16, 16 + length);
+  // TextDecoder normally removes a leading BOM. The pinned builder hashes the
+  // exact header string; this narrow profile rejects BOM instead of silently
+  // changing the value that a future producer would bind.
+  if (raw.length >= 3 && raw[0] === 0xef && raw[1] === 0xbb && raw[2] === 0xbf) fail('asar_header_bom_unsupported');
+  let header;
+  try { header = new TextDecoder('utf-8', { fatal: true }).decode(raw); } catch { fail('asar_header_utf8_invalid'); }
+  let parsed;
+  try { parsed = JSON.parse(header); } catch { fail('asar_header_json_invalid'); }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || !parsed.files
+      || typeof parsed.files !== 'object' || Array.isArray(parsed.files)) fail('asar_header_files_invalid');
+  const digest = sha(Buffer.from(header, 'utf8'));
+  return Buffer.from(JSON.stringify([{ file: 'resources\\app.asar', alg: 'SHA256', value: digest }]));
+}
+
+function collectWindowsTransformIngredients() {
+  const configBytes = stableFile(APP, 'electron-builder.test.json');
+  const config = JSON.parse(configBytes), packageBytes = stableFile(APP, 'package.json');
+  if (config.electronVersion !== '44.9.3' || config.electronDist !== 'native-dist/custom-electron'
+      || config.asar !== true || config.electronFuses?.enableEmbeddedAsarIntegrityValidation !== true
+      || config.electronFuses?.onlyLoadAppFromAsar !== true || config.win?.icon !== 'build/icon.ico') fail('package_policy_drift');
+  const icon = stableFile(APP, 'build/icon.ico', 32 * 1024 * 1024);
+  const lockBytes = stableFile(APP, 'package-lock.json');
+  let dependencySources = null, dependencyHold = null;
+  try {
+    const sourceFiles = new Map([...sourceInventory()].map(([relative]) => [relative, stableFile(APP, relative)]));
+    dependencySources = comparePinnedSourceBytes({ lockBytes, sourceFiles });
+  } catch (error) {
+    if (error?.code === 'ENOENT') dependencyHold = 'LOCKED_INSTALLED_SOURCE_FILES_UNAVAILABLE';
+    else throw error;
+  }
+  const unresolved = ['IMMUTABLE_EXPECTED_ASAR_PRODUCER_UNAVAILABLE', 'BUILDER_RESOLVED_METADATA_NOT_RETAINED',
+    'EXACT_EXPECTED_IMAGE_SERIALIZER_UNAVAILABLE', 'INDIRECT_LOADER_REFERENCE_CLOSURE_UNPROVEN'];
+  if (dependencyHold) unresolved.unshift(dependencyHold);
+  return Object.freeze({ schema: 'metaengine.custom-electron.transform-ingredients.v1', state: 'HOLD',
+    scope: 'BUILD_INPUT_COLLECTION_ONLY',
+    package_json_sha256: sha(packageBytes), builder_config_sha256: sha(configBytes),
+    icon: { relative_path: 'build/icon.ico', bytes: icon.length, sha256: sha(icon) },
+    dependency_sources: dependencySources,
+    expected_asar_integrity: null,
+    future_transform_order: ['ASAR_INTEGRITY_RESOURCE', 'SOURCE_ANCHORED_FUSES_4_5', 'VERSION_AND_ICON_RESOURCES'],
+    unresolved_checks: unresolved, authority_effect: false });
+}
+
+if (require.main === module) {
+  try {
+    if (process.argv.length !== 2) fail('arguments_forbidden');
+    process.stdout.write(JSON.stringify(collectWindowsTransformIngredients(), null, 2) + '\n');
+    process.exitCode = 1; // An ingredients record must never be mistaken for package admission.
+  } catch (error) { process.stderr.write(String(error.message) + '\n'); process.exitCode = 1; }
+}
+
+module.exports = { sourceInventory, comparePinnedSourceBytes, deriveAsarIntegrityResource,
+  collectWindowsTransformIngredients };
