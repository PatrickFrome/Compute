+    if (permittedHeaderFields.some(start => offset >= start && offset < start + 4)) continue;
+    if (source[offset] !== candidate[offset]) fail('header_or_mapping_changed:' + offset);
+  }
+  const checksumOffset = original.optional + 64;
+  const expectedChecksum = source.readUInt32LE(checksumOffset) ? peChecksum(candidate, checksumOffset) : 0;
+  if (candidate.readUInt32LE(checksumOffset) !== expectedChecksum) fail('checksum_not_expected');
+  const expectedFuses = new Map(writes.map(write => [write.offset, stage === 'FINAL_UNSIGNED' ? write.value : source[write.offset]]));
+  for (let offset = original.headers; offset < source.length; offset++) {
