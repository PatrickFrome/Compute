+    // Its exact expected serialization remains an explicit unresolved check.
+    if (offset >= resource.offset && offset < resource.offset + resource.size) continue;
+    if (candidate[offset] !== (expectedFuses.has(offset) ? expectedFuses.get(offset) : source[offset])) fail('nonresource_byte_changed:' + offset);
+  }
+  return Object.freeze({ schema: 'metaengine.custom-electron.direct-layout-preconditions.v1', state: 'HOLD',
+    stage, source_image_sha256: hash(source), candidate_image_sha256: hash(candidate),
+    resource_source_sha256: hash(source.subarray(resource.offset, resource.offset + resource.size)),
+    resource_candidate_sha256: hash(candidate.subarray(resource.offset, resource.offset + resource.size)),
