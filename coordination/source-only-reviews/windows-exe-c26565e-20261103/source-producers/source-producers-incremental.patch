@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+"""Real Git/object/physical-byte policy regressions with inert small fixtures."""
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'scripts/custom-electron-source-policy.py'
+spec = importlib.util.spec_from_file_location('component_source_policy_tests', SCRIPT)
+policy = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(policy)
+
+
+def run(repo, *args):
+    result = subprocess.run(policy.git_arguments(repo, *args), capture_output=True,
+                            env=policy.environment(), check=True)
+    return result.stdout
+
+
+def commit(repo, message):
+    run(repo, 'add', '-A')
+    run(repo, '-c', 'user.name=Component Model', '-c', 'user.email=model@example.invalid',
+        '-c', 'commit.gpgsign=false', 'commit', '-qm', message)
+    return run(repo, 'rev-parse', 'HEAD').decode().strip()
+
+
+class ComponentPolicyTests(unittest.TestCase):
+    def fixture(self):
+        temporary = tempfile.TemporaryDirectory(prefix='component-source-policy-model-')
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        node, electron = root / 'node', root / 'electron'
+        node.mkdir()
+        electron.mkdir()
+        run(node, 'init', '--quiet')
+        run(electron, 'init', '--quiet')
+        (node / 'main.cc').write_bytes(b'original source\n')
+        (node / 'binary.dat').write_bytes(b'\0original\xff')
+        (node / '.gitignore').write_text('ignored-extra.cc\n')
+        base = commit(node, 'base')
+        base_tree = run(node, 'rev-parse', 'HEAD^{tree}').decode().strip()
+        (node / 'main.cc').write_bytes(b'official first patch\n')
+        (node / 'binary.dat').write_bytes(b'\0official binary patch\xfe')
+        first = run(node, 'diff', '--binary', '--full-index')
+        commit(node, 'official patch one')
+        (node / 'extra-official.cc').write_bytes(b'official added source\n')
+        run(node, 'add', 'extra-official.cc')
+        second = run(node, 'diff', '--cached', '--binary', '--full-index')
+        commit(node, 'official patch two')
+        final_tree = run(node, 'rev-parse', 'HEAD^{tree}').decode().strip()
+        patches = electron / 'patches/node'
+        patches.mkdir(parents=True)
+        (patches / '.patches').write_text('first.patch\nsecond.patch\n')
+        (patches / 'first.patch').write_bytes(first)
+        (patches / 'second.patch').write_bytes(second)
+        authority = commit(electron, 'official patch authority model')
+        authority_tree = run(electron, 'rev-parse', 'HEAD^{tree}').decode().strip()
+        for name, value in (('ELECTRON_COMMIT', authority), ('ELECTRON_TREE', authority_tree)):
+            patch = mock.patch.object(policy, name, value)
+            patch.start()
+            self.addCleanup(patch.stop)
+        for target, values in ((policy.COMPONENTS, {'node': (base, 'patches/node')}),
+                               (policy.KNOWN_BASE_TREES, {'node': base_tree})):
+            patch = mock.patch.dict(target, values)
+            patch.start()
+            self.addCleanup(patch.stop)
+        return root, electron, node, final_tree
+
+    def test_complete_ordered_binary_tree_replay_and_physical_checkout(self):
+        _, electron, node, expected = self.fixture()
+        before = {name: (node / '.git' / name).read_bytes() for name in ('HEAD', 'index')}
+        proof = policy.verify_component_tree(electron, node, 'node')
+        self.assertEqual(proof['expected_tree'], expected)
+        self.assertEqual(len(proof['patches']), 2)
+        self.assertEqual(proof['scope'], 'COMPLETE_COMPONENT_GIT_TREES')
+        self.assertTrue(proof['physical_tree_verified'])
+        self.assertFalse(proof['dependency_closure_verified'])
+        self.assertFalse(proof['authority_effect'])
+        self.assertEqual(before, {name: (node / '.git' / name).read_bytes() for name in before})
+
+    def test_index_assume_unchanged_does_not_hide_physical_source_drift(self):
+        _, electron, node, _ = self.fixture()
+        run(node, 'update-index', '--assume-unchanged', 'main.cc')
+        (node / 'main.cc').write_bytes(b'unreviewed physical source\n')
+        self.assertEqual(run(node, 'status', '--porcelain'), b'')
+        with self.assertRaisesRegex(ValueError, 'canonical_checkout_representation_mismatch'):
+            policy.verify_component_tree(electron, node, 'node')
+
+    def test_ignored_extra_source_is_not_a_permitted_boundary(self):
+        _, electron, node, _ = self.fixture()
+        (node / 'ignored-extra.cc').write_bytes(b'unreviewed ignored source\n')
+        self.assertEqual(run(node, 'status', '--porcelain'), b'')
+        with self.assertRaisesRegex(ValueError, 'extra_physical_file'):
+            policy.verify_component_tree(electron, node, 'node')
+
+    def test_unreviewed_descendant_outside_patches_is_rejected(self):
+        _, electron, node, _ = self.fixture()
+        (node / 'unreviewed.cc').write_bytes(b'unreviewed descendant source\n')
+        commit(node, 'not an official patch')
+        with self.assertRaisesRegex(ValueError, 'observed_component_tree_mismatch'):
+            policy.verify_component_tree(electron, node, 'node')
+
+    def test_patch_worktree_tampering_cannot_replace_pinned_git_object_bytes(self):
+        _, electron, node, expected = self.fixture()
+        (electron / 'patches/node/first.patch').write_bytes(b'not official patch content')
+        with policy.derive_component_tree(electron, node, 'node') as (proof, _, _):
+            self.assertEqual(proof['expected_tree'], expected)
+            self.assertEqual(len(proof['patches']), 2)
+            self.assertFalse(proof['physical_tree_verified'])
+
+    def test_complete_canonical_materialization_is_fresh_and_reverified(self):
+        root, electron, node, expected = self.fixture()
+        output = root / 'canonical-source'
+        with policy.derive_component_tree(electron, node, 'node') as (proof, entries, objects):
+            result = policy.materialize_canonical_tree(output, entries, objects)
+            self.assertTrue(result['physical_tree_verified'])
+            self.assertEqual(proof['expected_tree'], expected)
+            self.assertEqual((output / 'binary.dat').read_bytes(), b'\0official binary patch\xfe')
+            with self.assertRaisesRegex(ValueError, 'new_canonical_output_required'):
+                policy.materialize_canonical_tree(output, entries, objects)
+
+    def test_raw_profile_refuses_crlf_instead_of_silently_normalizing(self):
+        root, electron, node, _ = self.fixture()
+        with policy.derive_component_tree(electron, node, 'node') as (_, entries, objects):
+            output = root / 'canonical-source'
+            policy.materialize_canonical_tree(output, entries, objects)
+            (output / 'main.cc').write_bytes(b'official first patch\r\n')
+            with self.assertRaisesRegex(ValueError, 'canonical_checkout_representation_mismatch'):
+                policy.physical_tree(output, entries)
+
+    def test_supplied_git_environment_cannot_redirect_index_or_repository(self):
+        root, electron, node, _ = self.fixture()
+        index = node / '.git/index'
+        before = index.read_bytes()
+        with mock.patch.dict(os.environ, {'GIT_INDEX_FILE': str(index),
+                'GIT_DIR': str(root / 'nonexistent'), 'GIT_CONFIG_COUNT': '1',
+                'GIT_CONFIG_KEY_0': 'core.fsmonitor', 'GIT_CONFIG_VALUE_0': 'untrusted-command'}):
+            self.assertTrue(policy.verify_component_tree(electron, node, 'node')['physical_tree_verified'])
+        self.assertEqual(index.read_bytes(), before)
