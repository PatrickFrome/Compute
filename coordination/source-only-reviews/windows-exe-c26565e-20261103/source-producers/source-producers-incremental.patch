@@ -0,0 +1,42 @@
+// Inert layout data only. The resource payload is deliberately not a resource
+// tree, so this fixture cannot qualify serialization, a loader graph or Windows.
+export function fixedLayoutFixture() {
+  const image = Buffer.alloc(7296);
+  const nt = 0x80, optional = nt + 24, table = optional + 240;
+  image.write('MZ'); image.writeUInt32LE(nt, 0x3c); image.write('PE\0\0', nt);
+  image.writeUInt16LE(0x8664, nt + 4); image.writeUInt16LE(5, nt + 6);
+  image.writeUInt16LE(240, nt + 20); image.writeUInt16LE(0x22, nt + 22);
+  image.writeUInt16LE(0x20b, optional); image.writeUInt32LE(0x1010, optional + 16);
+  image.writeBigUInt64LE(0x140000000n, optional + 24);
+  image.writeUInt32LE(4096, optional + 32); image.writeUInt32LE(512, optional + 36);
+  image.writeUInt32LE(0x6000, optional + 56); image.writeUInt32LE(1024, optional + 60);
+  image.writeUInt32LE(16, optional + 108);
+  const rows = [
+    ['.text', 1024, 512, 512, 0x60000020], ['.rdata', 1536, 512, 512, 0x40000040],
+    ['.code', 2048, 512, 512, 0x60000020], ['.rsrc', 2560, 4096, 1000, 0x40000040],
+    ['.reloc', 6656, 512, 100, 0x42000040],
+  ];
+  const sections = {};
+  for (const [index, [name, offset, size, virtualSize, flags]] of rows.entries()) {
+    const header = table + index * 40, rva = (index + 1) * 4096;
+    image.write(name, header); image.writeUInt32LE(virtualSize, header + 8);
+    image.writeUInt32LE(rva, header + 12); image.writeUInt32LE(size, header + 16);
+    image.writeUInt32LE(offset, header + 20); image.writeUInt32LE(flags, header + 36);
+    image.fill(name === '.text' || name === '.code' ? 0xcc : 0x55, offset, offset + size);
+    sections[name] = { header, offset, size, virtualSize, rva };
+  }
+  image.writeUInt32LE(sections['.rdata'].rva + 128, optional + 120);
+  image.writeUInt32LE(20, optional + 124);
+  image.writeUInt32LE(sections['.rsrc'].rva, optional + 128);
+  image.writeUInt32LE(1000, optional + 132);
+  image.writeUInt32LE(sections['.reloc'].rva, optional + 152);
+  image.writeUInt32LE(100, optional + 156);
+  const sentinel = Buffer.from('dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX');
+  const wire = sections['.rdata'].offset + 32 + sentinel.length;
+  sentinel.copy(image, sections['.rdata'].offset + 32);
+  image[wire] = 1; image[wire + 1] = 8;
+  image.set([49, 48, 49, 49, 48, 48, 48, 49], wire + 2);
+  const final = Buffer.from(image); final[wire + 6] = 49; final[wire + 7] = 49;
+  final[sections['.rsrc'].offset + 100] ^= 0xff;
+  return { image, final, nt, optional, table, sections, wire };
+}
