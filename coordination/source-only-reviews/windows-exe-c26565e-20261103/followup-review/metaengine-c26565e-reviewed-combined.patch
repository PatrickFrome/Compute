+def synthetic_pe():
+    """Inert x64 PE-shaped bytes for the package gate; never executable."""
+    data = bytearray(1_100_000)
+    header = 0x80
+    optional_size = 0xf0
+    table = header + 24 + optional_size
+    data[:2] = b'MZ'
+    struct.pack_into('<I', data, 0x3c, header)
+    data[header:header + 4] = b'PE\0\0'
+    struct.pack_into('<HH', data, header + 4, 0x8664, 2)
+    struct.pack_into('<H', data, header + 20, optional_size)
+    struct.pack_into('<H', data, header + 24, 0x20b)
+    for index, (name, offset) in enumerate(((b'.text', 512), (b'.rdata', 4608))):
+        section = table + index * 40
+        data[section:section + len(name)] = name
+        struct.pack_into('<II', data, section + 16, 4096, offset)
+    data[512:4608] = b'\xcc' * 4096
+    marker = b'electron_browser_guardian_original_main\0'
+    data[4624:4624 + len(marker)] = marker
