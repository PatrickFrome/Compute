+#!/usr/bin/env python3
+"""Offline source/request contracts; no client, download or upstream code runs."""
+import base64
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest import mock
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'scripts/custom-electron-cipd-policy.py'
+spec = importlib.util.spec_from_file_location('cipd_source_request_models', SCRIPT)
+policy = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(policy)
+
+
+def instance(content=b'inert model archive'):
+    return base64.urlsafe_b64encode(hashlib.sha256(content).digest() + b'\x02').decode()
+
+
+def tree_row(mode, name, oid):
+    return mode.encode() + b' ' + name.encode() + b'\0' + bytes.fromhex(oid)
+
+
+class SourceModels(unittest.TestCase):
+    def setUp(self):
+        self.electron = b'vars={}; deps={}; hooks=[]; recursedeps=[]\n'
+        self.version_bytes = (instance(b'excluded orderfile') + '\n').encode()
+        self.chromium = ("""vars={}
+deps={
+ 'src/strong':{'dep_type':'cipd','packages':[{'package':'model/data','version':'%s'}]},
+ 'src/tag':{'dep_type':'cipd','packages':[{'package':'infra/tool/${{platform}}','version':'git_revision:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'}]},
+ 'src/literal':{'dep_type':'cipd','packages':[{'package':'model/typescript/linux-amd64','version':'version:1'}]},
+ 'src/arm':{'dep_type':'cipd','condition':'checkout_win','packages':[{'package':'model/updater/windows-arm64','version':'version:1'}]},
+ 'src/multi':{'dep_type':'cipd','packages':[{'package':'model/${{os}}/${{arch}}','version':'version:2'},{'package':'model/literal','version':'latest'}]},
+ 'src/swift':{'dep_type':'cipd','condition':'host_os == mac','packages':[{'package':'model/swift/mac-${{arch}}','version':'version:1'}]},
+ 'src/excluded':{'dep_type':'cipd','condition':'checkout_android','packages':[{'package':'model/orderfile','version_file':'versions/orderfile.txt'}]},
+}
+hooks=[]
+recursedeps=[]
+""" % instance()).encode()
+        self.pin_sources()
+        temporary = tempfile.TemporaryDirectory(prefix='cipd-source-merkle-model-')
+        self.addCleanup(temporary.cleanup)
+        self.packet = Path(temporary.name)
+        self.blob_oid = policy.git_oid('blob', self.version_bytes)
+        child = tree_row('100644', 'orderfile.txt', self.blob_oid)
+        child_oid = policy.git_oid('tree', child)
+        root = tree_row('40000', 'versions', child_oid)
+        self.root_oid = policy.git_oid('tree', root)
+        (self.packet / (child_oid + '.tree')).write_bytes(child)
+        (self.packet / (self.root_oid + '.tree')).write_bytes(root)
+        patch = mock.patch.object(policy.DEPS, 'CHROMIUM_TREE', self.root_oid)
+        patch.start()
+        self.addCleanup(patch.stop)
+
+    def pin_sources(self):
+        sources = {owner: {'commit': 'a' * 40, 'blob_sha1': policy.git_oid('blob', content),
+                           'sha256': hashlib.sha256(content).hexdigest()}
+                   for owner, content in (('electron', self.electron), ('chromium', self.chromium))}
