index 0000000..1f5b37c
--- /dev/null
+++ b/apps/metaengine-browser/scripts/custom-electron-cipd-payload.py
@@ -0,0 +1,416 @@
+#!/usr/bin/env python3
+"""Offline CIPD ZIP byte identity, not installation or build admission.
+
+The instance ID hashes the entire ZIP body, not just its member contents. The
+embedded CIPD 1.1 manifest names the package; it has no member hash list. This
+module derives that list without extracting files or running package code.
+
+The supported profile is deliberately narrower than arbitrary ZIP/CIPD: ASCII
+Windows-safe regular files, Store/Deflate, ordinary 32-bit ZIP headers and data
+descriptors. Unsupported metadata/layouts fail rather than being normalized.
+All successful inventories remain HOLD. Generated deployment files, installed
+paths, patched DEPS, client/bootstrap custody and release authority are separate.
+"""
+import argparse
+import base64
+import binascii
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+import zlib
+
+MANIFEST = '.cipdpkg/manifest.json'
+PROFILE = 'CIPD_1_1_ASCII_WINDOWS_REGULAR_ZIP32'
+MAX_ARCHIVE_BYTES = 128 * 1024 ** 2
+MAX_MEMBER_BYTES = 64 * 1024 ** 2
+MAX_TOTAL_BYTES = 256 * 1024 ** 2
+MAX_MEMBERS = 8192
+MAX_MANIFEST_BYTES = 1024 ** 2
+CHUNK = 64 * 1024
+LUCI_COMMIT = '61fc2ffcffaa3d602e13d752206c2285ae9a637c'
+FORMAT_SOURCES = {
+    'cipd/client/cipd/local/json_descs.go': 'f65cd0c34e18061f8614801882ef755ad55c9de266db27b2d0ccaf28f66379d7',
+    'cipd/client/cipd/local/builder.go': 'fee0a2c3ba45fead82edd55ab1c6cf0c319c3908fe0548aef0539dfa39dc8eed',
+    'cipd/client/cipd/local/reader.go': '7f0f19b1f5788626d9dcb72eb30cba99e27ca93288625f30cbd528eb5b4e3eb4',
+}
+COMMON_MISSING = [
+    'PATCHED_DEPS_SYNC_PROFILE_AND_BOOTSTRAP_CLIENT_USE_UNQUALIFIED',
+    'SERVICE_TRANSPORT_AND_DOWNLOAD_CUSTODY_NOT_QUALIFIED',
+    'INSTALLED_NAMESPACE_REPARSE_AND_PHYSICAL_READBACK_NOT_QUALIFIED',
+    'GENERATED_DEPLOYMENT_OUTPUT_CLOSURE_NOT_QUALIFIED',
+]
+
+
+def fail(reason):
+    raise ValueError('custom_electron_cipd_payload_' + reason)
+
+
+def canonical_bytes(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode('ascii')
+
+
+def instance_sha256(instance_id):
+    """Decode the canonical full-object SHA256 instance form, never a tag."""
+    if isinstance(instance_id, str) and re.fullmatch(r'[0-9a-f]{40}', instance_id):
+        fail('legacy_sha1_instance_unsupported')
+    if not isinstance(instance_id, str) or not re.fullmatch(r'[A-Za-z0-9_-]{44}', instance_id):
+        fail('strong_sha256_instance_required')
+    try:
+        raw = base64.b64decode(instance_id, altchars=b'-_', validate=True)
+    except (ValueError, binascii.Error):
+        fail('instance_encoding_invalid')
+    if len(raw) != 33 or base64.urlsafe_b64encode(raw).decode('ascii') != instance_id:
+        fail('instance_encoding_invalid')
+    if raw[-1] != 2:
+        fail('instance_algorithm_unsupported')
+    return raw[:-1].hex()
+
+
+def canonical_package_name(name):
+    if not isinstance(name, str) or len(name) > 1024 or not re.fullmatch(r'[a-z0-9_./-]+', name) \
+            or any(not part.strip('.') for part in name.split('/')):
+        fail('package_name_not_canonical')
+    return name
+
+
+def safe_member_path(raw):
+    """No Windows path aliasing or service-namespace admission through ZIP."""
+    if not isinstance(raw, bytes) or not 0 < len(raw) <= 1024:
+        fail('member_path_invalid')
+    try:
+        name = raw.decode('ascii', 'strict')
+    except UnicodeError:
+        fail('member_path_non_ascii_unsupported')
+    parts = name.split('/')
+    for part in parts:
+        if not part or part in ('.', '..') or len(part) > 255 or part[-1] in ' .' \
+                or any(ord(char) < 32 or ord(char) > 126 or char in '<>:"\\|?*' for char in part):
+            fail('member_path_unsafe')
+        stem = part.split('.')[0].rstrip(' .').upper()
+        if stem in ('CON', 'PRN', 'AUX', 'NUL', 'CONIN$', 'CONOUT$') \
+                or re.fullmatch(r'(?:COM|LPT)[1-9]', stem):
+            fail('member_path_device')
+    if parts[0].casefold() == '.cipd' or (parts[0].casefold() == '.cipdpkg' and name != MANIFEST):
+        fail('reserved_service_member_unsupported')
+    return name
+
+
+def _check_namespace(names):
+    files, spellings = set(), {}
+    for name in names:
+        folded = name.casefold()
+        if folded in files:
+            fail('duplicate_or_case_alias_member')
+        parts = name.split('/')
+        for index in range(1, len(parts) + 1):
+            prefix = '/'.join(parts[:index])
+            key = prefix.casefold()
+            if key in spellings and spellings[key] != prefix:
+                fail('parent_component_case_alias')
+            spellings[key] = prefix
+        files.add(folded)
+    for name in files:
+        parts = name.split('/')
+        if any('/'.join(parts[:index]) in files for index in range(1, len(parts))):
+            fail('file_directory_prefix_collision')
+
+
+def _extra_fields(raw):
+    """Only the ordinary Go ZIP writer's mtime extension is supported."""
+    offset, seen = 0, set()
+    while offset < len(raw):
+        if offset + 4 > len(raw):
+            fail('extra_field_truncated')
+        tag, length = struct.unpack_from('<HH', raw, offset)
+        offset += 4
+        if tag in seen or offset + length > len(raw):
+            fail('extra_field_duplicate_or_truncated')
+        seen.add(tag)
+        value = raw[offset:offset + length]
+        if tag == 1:
+            fail('zip64_unsupported')
+        if tag != 0x5455 or length != 5 or value[0] != 1:
+            fail('extra_field_unsupported')
+        offset += length
+
+
+def _central_members(archive):
+    # Comments, SFX preambles, ZIP64 and opaque trailing bodies are not profiled.
+    end = len(archive) - 22
+    if end < 0 or archive[end:end + 4] != b'PK\x05\x06':
+        fail('end_record_not_exact')
+    _, disk, central_disk, disk_count, count, size, start, comment = struct.unpack_from('<4s4H2IH', archive, end)
+    if disk or central_disk or disk_count != count:
+        fail('multidisk_unsupported')
+    if count == 0xffff or size == 0xffffffff or start == 0xffffffff:
+        fail('zip64_unsupported')
+    if comment or not 0 < count <= MAX_MEMBERS or start + size != end:
+        fail('central_directory_span_or_count')
+    members, offset, total = [], start, 0
+    for _ in range(count):
+        if offset + 46 > end or archive[offset:offset + 4] != b'PK\x01\x02':
+            fail('central_header_invalid')
+        values = struct.unpack_from('<4s6H3I5H2I', archive, offset)
+        (_, creator, required, flags, method, mtime, mdate, crc, compressed, size,
+         name_length, extra_length, comment_length, member_disk, internal, external, local) = values
+        record_end = offset + 46 + name_length + extra_length + comment_length
+        if record_end > end:
+            fail('central_header_truncated')
+        if member_disk:
+            fail('multidisk_unsupported')
+        if 0xffffffff in (compressed, size, local):
+            fail('zip64_unsupported')
+        if flags & 1:
+            fail('encrypted_member_unsupported')
+        if flags & ~(0x08 | 0x800):
+            fail('zip_flags_unsupported')
+        if method not in (0, 8):
+            fail('compression_unsupported')
+        if creator != 0x0314 or required != 20 or internal or comment_length:
+            fail('zip_header_metadata_unsupported')
+        mode, attributes = external >> 16, external & 0xffff
+        if mode not in (0o100400, 0o100500, 0o100600, 0o100700) or attributes & ~7:
+            fail('member_mode_or_attributes_unsupported')
+        if bool(attributes & 1) == bool(mode & 0o200):
+            fail('readonly_mode_disagreement')
+        raw_name = archive[offset + 46:offset + 46 + name_length]
+        name = safe_member_path(raw_name)
+        extra = archive[offset + 46 + name_length:offset + 46 + name_length + extra_length]
+        _extra_fields(extra)
+        if size > MAX_MEMBER_BYTES or compressed > MAX_ARCHIVE_BYTES:
+            fail('member_size_limit')
+        total += size
+        if total > MAX_TOTAL_BYTES:
+            fail('total_size_limit')
+        members.append({'path': name, 'raw_name': raw_name, 'creator': creator, 'required': required,
+                        'flags': flags, 'compression': method, 'dos_time': mtime, 'dos_date': mdate,
+                        'crc32': crc, 'compressed_bytes': compressed, 'size_bytes': size,
+                        'external_attributes': external, 'unix_mode': mode, 'extra': extra,
+                        'local_header_offset': local})
+        offset = record_end
+    if offset != end:
+        fail('central_directory_unlisted_bytes')
+    _check_namespace([row['path'] for row in members])
+    offsets = sorted(row['local_header_offset'] for row in members)
+    if offsets[0] != 0 or len(set(offsets)) != len(offsets) or offsets[-1] >= start:
+        fail('local_header_geometry')
+    return members, start
+
+
+def _member_body(archive, row, end):
+    offset = row['local_header_offset']
+    if offset + 30 > end or archive[offset:offset + 4] != b'PK\x03\x04':
+        fail('local_header_invalid_or_overlapping')
+    (_, required, flags, method, mtime, mdate, crc, compressed, size,
+     name_length, extra_length) = struct.unpack_from('<4s5H3I2H', archive, offset)
+    data_start = offset + 30 + name_length + extra_length
+    data_end = data_start + row['compressed_bytes']
+    if data_start > end or data_end > end:
+        fail('member_span_overlapping')
+    raw_name = archive[offset + 30:offset + 30 + name_length]
+    extra = archive[offset + 30 + name_length:data_start]
+    if (required, flags, method, mtime, mdate, raw_name, extra) != \
+            (row['required'], row['flags'], row['compression'], row['dos_time'], row['dos_date'], row['raw_name'], row['extra']):
+        fail('local_central_header_disagreement')
+    expected = (row['crc32'], row['compressed_bytes'], row['size_bytes'])
+    if flags & 8:
+        if (crc, compressed, size) not in ((0, 0, 0), expected):
+            fail('local_descriptor_fields_disagree')
+        trailing = archive[data_end:end]
+        if len(trailing) == 16 and trailing[:4] == b'PK\x07\x08':
+            actual = struct.unpack_from('<3I', trailing, 4)
+        elif len(trailing) == 12:
+            actual = struct.unpack('<3I', trailing)
+        else:
+            fail('data_descriptor_span_or_signature')
+        if actual != expected:
+            fail('data_descriptor_disagreement')
+    elif (crc, compressed, size) != expected or data_end != end:
+        fail('local_sizes_or_unlisted_bytes')
+    return memoryview(archive)[data_start:data_end]
+
+
+def _read_member(body, row):
+    digest, crc, produced = hashlib.sha256(), 0, 0
+    manifest = bytearray() if row['path'] == MANIFEST else None
+    if manifest is not None and row['size_bytes'] > MAX_MANIFEST_BYTES:
+        fail('manifest_size_limit')
+
+    def consume(data):
+        nonlocal produced, crc
+        produced += len(data)
+        if produced > row['size_bytes']:
+            fail('uncompressed_size_disagreement')
+        digest.update(data)
+        crc = binascii.crc32(data, crc)
+        if manifest is not None:
+            manifest.extend(data)
+
+    if row['compression'] == 0:
+        if len(body) != row['size_bytes']:
+            fail('stored_size_disagreement')
+        for offset in range(0, len(body), CHUNK):
+            consume(body[offset:offset + CHUNK])
+    else:
+        decoder = zlib.decompressobj(-15)
+        try:
+            for offset in range(0, len(body), CHUNK):
+                pending = body[offset:offset + CHUNK]
+                while True:
+                    output = decoder.decompress(pending, CHUNK)
+                    consume(output)
+                    pending = decoder.unconsumed_tail
+                    if decoder.unused_data:
+                        fail('deflate_trailing_bytes')
+                    # zlib can retain decoded output after consuming the last
+                    # input byte. Drain with b'' when max_length was reached;
+                    # an empty unconsumed_tail alone does not prove EOF.
+                    if not pending and len(output) < CHUNK:
+                        break
+            if not decoder.eof or decoder.unused_data or decoder.unconsumed_tail:
+                fail('deflate_stream_incomplete')
+        except zlib.error:
+            fail('deflate_stream_invalid')
+    if produced != row['size_bytes']:
+        fail('uncompressed_size_disagreement')
+    if crc & 0xffffffff != row['crc32']:
+        fail('member_crc_disagreement')
+    return digest.hexdigest(), bytes(manifest) if manifest is not None else None
+
+
+def _json_pairs(pairs):
+    value = {}
+    for name, item in pairs:
+        if name in value:
+            fail('manifest_duplicate_json_key')
+        value[name] = item
+    return value
+
+
+def _manifest(content, package_name, member_names):
+    if content is None:
+        fail('embedded_manifest_missing')
+    try:
+        value = json.loads(content.decode('utf-8', 'strict'), object_pairs_hook=_json_pairs,
+                           parse_constant=lambda _: fail('manifest_non_json_constant'))
+    except (UnicodeError, json.JSONDecodeError, RecursionError):
+        fail('manifest_json_invalid')
+    if not isinstance(value, dict) or not {'format_version', 'package_name'} <= set(value) \
+            or set(value) - {'format_version', 'package_name', 'version_file', 'install_mode'}:
+        fail('manifest_fields_unsupported')
+    if any(not isinstance(item, str) for item in value.values()):
+        fail('manifest_field_type')
+    if value['format_version'] != '1.1':
+        fail('manifest_format_unsupported')
+    if canonical_package_name(value['package_name']) != package_name:
+        fail('embedded_package_name_disagreement')
+    if value.get('install_mode', '') not in ('', 'copy'):
+        fail('manifest_install_mode_unsupported')
+    generated = []
+    if value.get('version_file', ''):
+        try:
+            path = safe_member_path(value['version_file'].encode('ascii', 'strict'))
+        except UnicodeError:
+            fail('member_path_non_ascii_unsupported')
+        if path == MANIFEST:
+            fail('generated_version_file_reserved')
+        _check_namespace(member_names + [path])
+        generated.append({'path': path, 'origin': 'EMBEDDED_MANIFEST_VERSION_FILE',
+                          'content': 'GENERATED_DEPLOYMENT_BYTES_NOT_PRODUCED_OR_QUALIFIED',
+                          'is_zip_member': False, 'disposition': 'HOLD'})
+    return value, generated
+
+
+def inspect_declared_archive(archive_bytes, package_name, instance_id):
+    """Compare declared bytes; external declarations are not source authority."""
+    package_name = canonical_package_name(package_name)
+    expected = instance_sha256(instance_id)
+    if not isinstance(archive_bytes, bytes) or not 0 < len(archive_bytes) <= MAX_ARCHIVE_BYTES:
+        fail('archive_type_or_size_limit')
+    measured = hashlib.sha256(archive_bytes).hexdigest()
+    if measured != expected:
+        fail('full_archive_sha256_disagreement')
+    rows, central = _central_members(archive_bytes)
+    physical = sorted(rows, key=lambda row: row['local_header_offset'])
+    inventory, manifest_bytes = [], None
+    for index, row in enumerate(physical):
+        end = physical[index + 1]['local_header_offset'] if index + 1 < len(physical) else central
+        body = _member_body(archive_bytes, row, end)
+        digest, embedded = _read_member(body, row)
+        if embedded is not None:
+            manifest_bytes = embedded
+        inventory.append({key: row[key] for key in ('path', 'compression', 'flags', 'dos_time',
+            'dos_date', 'compressed_bytes', 'size_bytes', 'external_attributes', 'unix_mode', 'local_header_offset')}
+            | {'sha256': digest, 'crc32': format(row['crc32'], '08x'),
+               'central_extra_sha256': hashlib.sha256(row['extra']).hexdigest(),
+               'kind': 'EMBEDDED_MANIFEST' if row['path'] == MANIFEST else 'PAYLOAD'})
+    inventory.sort(key=lambda row: row['path'])
+    manifest, generated = _manifest(manifest_bytes, package_name, [row['path'] for row in inventory])
+    return {'schema': 'metaengine.cipd-archive-members.v1', 'scope': 'DECLARED_SHA256_INSTANCE_ARCHIVE_BYTES_ONLY',
+            'profile': PROFILE, 'package_name': package_name, 'instance_id': instance_id,
+            'archive_sha256': measured, 'archive_size_bytes': len(archive_bytes),
+            'archive_identity': 'MATCHES_DECLARED_FULL_ZIP_SHA256_INSTANCE',
+            'manifest': manifest, 'members': inventory, 'member_count': len(inventory),
+            'payload_member_count': len(inventory) - 1,
+            'member_inventory_sha256': hashlib.sha256(canonical_bytes(inventory)).hexdigest(),
+            'generated_deployment_outputs': generated, 'disposition': 'HOLD', 'authority_effect': False,
+            'physical_readback': 'NOT_RUN', 'archive_extracted': False, 'package_code_executed': False,
+            'missing': ['SOURCE_REQUEST_BINDING_NOT_DERIVED'] + COMMON_MISSING,
+            'format_reference': {'luci_commit': LUCI_COMMIT, 'source_sha256': FORMAT_SOURCES}}
+
+
+def request_policy():
+    spec = importlib.util.spec_from_file_location('metaengine_source_cipd_policy',
+        Path(__file__).with_name('custom-electron-cipd-policy.py'))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)  # Our fixed data parser, not downloaded code.
+    return module
+
+
+def verify_source_archive(electron_bytes, chromium_bytes, selector, archive_bytes, *,
+                          chromium_tree_objects=None, version_file_blobs=None):
+    """Rederive the source request; never accept request JSON or verified flags."""
+    request = request_policy().get_source_request(electron_bytes, chromium_bytes, selector,
+        chromium_tree_objects=chromium_tree_objects, version_file_blobs=version_file_blobs)
+    if request['selection'] != 'SELECTED' or request['reference_kind'] != 'SHA256_INSTANCE' \
+            or not request['package_name'] or request['instance_id'] != request['source_version']:
+        fail('source_selected_direct_sha256_instance_required')
+    result = inspect_declared_archive(archive_bytes, request['package_name'], request['instance_id'])
+    if result['archive_sha256'] != request['payload_sha256']:
+        fail('source_request_digest_disagreement')
+    # Discharge exactly the supplied byte obligation, never the phase/custody or
+    # installed-output obligations. Keep the original source plan immutable.
+    missing = [item for item in request.get('missing', []) if item != 'CIPD_PAYLOAD_BYTES_UNAVAILABLE']
+    bound_request = dict(request, payload_content='MATCHES_SOURCE_DECLARED_FULL_ZIP_SHA256_INSTANCE', missing=missing)
+    result.update(scope='SOURCE_DECLARED_SHA256_INSTANCE_ARCHIVE_MEMBERS_ONLY', source_request=bound_request,
+                  missing=list(dict.fromkeys(missing + COMMON_MISSING)))
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron-deps', type=Path, required=True)
+    parser.add_argument('--chromium-deps', type=Path, required=True)
+    parser.add_argument('--owner', choices=('electron', 'chromium'), required=True)
+    parser.add_argument('--path', required=True)
+    parser.add_argument('--package-index', type=int, required=True)
+    parser.add_argument('--archive', type=Path, required=True)
+    args = parser.parse_args()
+    policy = request_policy()
+    try:
+        result = verify_source_archive(policy._regular_bytes(args.electron_deps, 1024 ** 2),
+            policy._regular_bytes(args.chromium_deps, 1024 ** 2),
+            (args.owner, args.path, args.package_index), policy._regular_bytes(args.archive, MAX_ARCHIVE_BYTES))
+        print(json.dumps(result, indent=2, sort_keys=True))
+        return 1  # A byte inventory is never build or deployment admission.
+    except (ValueError, OSError) as error:
+        print(json.dumps({'disposition': 'HOLD', 'authority_effect': False, 'error': str(error)}, sort_keys=True))
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
