+#!/usr/bin/env python3
+"""Offline requests derived from fixed base DEPS, never a package trust root.
+
+The native Windows/amd64 client is a declared analysis profile. Raw DEPS brace
+escaping and CIPD expansion are separate stages; the bootstrap gclient, actual
+sync spec and client executable remain unqualified. No network, client, hook or
+package code runs here. A caller's resolution response is only an observation;
+it cannot turn a symbolic source selector into a source-pinned instance.
+"""
+import argparse
+import base64
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+
+
+def _load_deps():
+    path = Path(__file__).with_name('custom-electron-deps-policy.py')
+    spec = importlib.util.spec_from_file_location('cipd_fixed_deps_policy', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+DEPS = _load_deps()
+LUCI_COMMIT = '61fc2ffcffaa3d602e13d752206c2285ae9a637c'
+SEMANTIC_SOURCES = [
+    {'path': 'cipd/client/cipd/platform/platform.go',
+     'blob_sha1': 'b303f6f58c8cde603a4fbf9bdf3369afab207f15',
+     'sha256': '9c533ba5e9282aaadfa2738052bad55e8c39503852eb7e4bd48cf99e9e17f843'},
+    {'path': 'cipd/client/cipd/template/template.go',
+     'blob_sha1': '85ba02afd19294d30864b7d23229a7981c6e6425',
+     'sha256': 'dff83dd242f30f58fc0535c066dc150472e52791430b1e37623be1416da96ce3'},
+    {'path': 'cipd/api/cipd/v1/repo.proto',
+     'blob_sha1': 'fa4a6374ee56f8335c760c73079333a8e5936b08',
+     'sha256': 'f0a20babd0cedb270f53d377a6f89d88515ae7a6eec7a588f831734636d7ed3a'},
+    {'path': 'cipd/api/cipd/v1/cas.proto',
+     'blob_sha1': '0770f848dcf353c436e8240d29cc058336542f10',
+     'sha256': '81bfbcac554e2118b406a1d675aa0a18519dd2520c8a5ff50310f535bec98149'},
+]
+PROFILE = {'os': 'windows', 'arch': 'amd64', 'platform': 'windows-amd64'}
+RESOLVE_URL = 'https://chrome-infra-packages.appspot.com/prpc/cipd.Repository/ResolveVersion'
+TREE_LIMIT = 16 * 1024 ** 2
+BLOB_LIMIT = 64 * 1024
+
+
+def fail(reason):
+    raise ValueError('custom_electron_cipd_policy_' + reason)
+
+
+def canonical_bytes(value):
+    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False) + '\n').encode()
+
+
+def git_oid(kind, content):
+    return hashlib.sha1(kind.encode() + b' ' + str(len(content)).encode() + b'\0' + content).hexdigest()
+
+
+def declared_source_format(raw):
+    """Only model escaped literal braces, without assuming gclient was run.
+
+    A single brace would require source-format variable semantics, which this
+    profile does not supply. Do not merge this stage with CIPD's ${...} grammar.
+    """
+    if not isinstance(raw, str) or not raw or len(raw) > 4096:
+        fail('package_template_invalid')
+    result, offset = [], 0
+    while offset < len(raw):
+        value = raw[offset]
+        if value in '{}':
+            if offset + 1 == len(raw) or raw[offset + 1] != value:
+                fail('gclient_single_brace_phase_unqualified')
+            offset += 1
+        result.append(value)
+        offset += 1
+    return ''.join(result)
+
+
+def expand_cipd_template(template):
+    """Bounded implementation of the pinned LUCI os/arch/platform grammar.
+
+    Conditional parameters are parsed even if another parameter skips the
+    template. Unknown variables and malformed dollars cannot disappear behind
+    a nonmatching condition. Return None for a declared nonmatching template.
+    """
+    if not isinstance(template, str) or not template or len(template) > 4096:
+        fail('package_template_invalid')
+    skip = False
+    def replace(match):
+        nonlocal skip
+        value = match.group(1)
+        parts = value.split('=', 1)
+        name = parts[0]
+        if name not in PROFILE:
+            fail('cipd_template_unknown_variable:' + name)
+        if len(parts) == 2:
+            choices = parts[1].split(',')
+            if not choices or any(not choice or not re.fullmatch(r'[a-z0-9_-]+', choice) for choice in choices):
+                fail('cipd_template_constraint_invalid')
+            if PROFILE[name] not in choices:
+                skip = True
+        return PROFILE[name]
+    expanded = re.sub(r'\$\{([^{}]*)\}', replace, template)
+    if any(character in expanded for character in '${}'):
+        fail('cipd_template_malformed_or_unexpanded')
+    # Pinned LUCI common/common.go validatePathishString also forbids every
+    # dots-only component, including lengths greater than '.' and '..'.
+    if not re.fullmatch(r'[a-z0-9_./-]+', expanded) \
+            or any(not part.strip('.') for part in expanded.split('/')):
+        fail('bounded_package_name_invalid')
+    DEPS.safe_path(expanded)
+    return None if skip else expanded
+
+
+def classify_reference(version):
+    kind = DEPS.cipd_instance_kind(version)
+    if kind == 'SHA256_INSTANCE_ID':
+        return {'reference_kind': 'SHA256_INSTANCE', 'instance_id': version,
+                'payload_sha256': base64.urlsafe_b64decode(version)[:-1].hex()}
+    if kind == 'SHA1_INSTANCE_ID':
+        return {'reference_kind': 'LEGACY_SHA1_INSTANCE', 'instance_id': version,
+                'payload_sha256': None}
+    if not isinstance(version, str) or not version or len(version) > 4096 \
+            or any(ord(character) < 33 or ord(character) > 126 for character in version):
+        fail('version_invalid')
+    return {'reference_kind': 'SYMBOLIC_SELECTOR', 'instance_id': None, 'payload_sha256': None}
+
+
+def _regular_bytes(path, limit):
+    path = Path(path)
+    before = path.lstat()
+    identity = lambda value: (value.st_dev, value.st_ino, value.st_mode, value.st_nlink,
+                              value.st_size, value.st_mtime_ns, value.st_ctime_ns)
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or not 0 <= before.st_size <= limit:
+        fail('source_object_file_invalid')
+    with path.open('rb') as stream:
+        if identity(os.fstat(stream.fileno())) != identity(before):
+            fail('source_object_file_changed')
+        content = stream.read(limit + 1)
+        if identity(os.fstat(stream.fileno())) != identity(before) or identity(path.lstat()) != identity(before):
+            fail('source_object_file_changed')
+    if len(content) != before.st_size:
+        fail('source_object_file_changed')
+    return content
+
+
+class FixedChromiumTrees:
+    """Targeted Merkle membership; no Git process or missing-object fetch."""
+    def __init__(self, directory):
+        self.directory = Path(directory).absolute()
+        if not self.directory.is_dir() or self.directory.is_symlink() or self.directory.resolve() != self.directory:
+            fail('canonical_tree_packet_directory_required')
+        self.cache = {}
+
+    def read(self, oid):
+        if oid in self.cache:
+            return self.cache[oid]
+        content = _regular_bytes(self.directory / (oid + '.tree'), TREE_LIMIT)
+        if git_oid('tree', content) != oid:
+            fail('source_tree_hash_mismatch')
+        result, offset = {}, 0
+        while offset < len(content):
+            space, end = content.find(b' ', offset), content.find(b'\0', offset)
+            if space < 0 or end < space or end + 21 > len(content):
+                fail('source_tree_encoding')
+            try:
+                mode = content[offset:space].decode('ascii', 'strict')
+                name = content[space + 1:end].decode('utf-8', 'strict')
+            except UnicodeError:
+                fail('source_tree_encoding')
+            DEPS.safe_path(name)
+            if '/' in name or name in result or mode not in ('40000', '100644', '100755', '120000', '160000'):
+                fail('source_tree_entry_invalid')
+            result[name] = (mode, content[end + 1:end + 21].hex())
+            offset = end + 21
+        self.cache[oid] = result
+        return result
+
+    def blob(self, path):
+        DEPS.safe_path(path)
+        parts = path.split('/')
+        if len(parts) > 64:
+            fail('version_file_path_depth')
+        tree, chain = DEPS.CHROMIUM_TREE, []
+        for index, name in enumerate(parts):
+            row = self.read(tree).get(name)
+            if row is None:
+                fail('version_file_not_in_fixed_tree')
+            mode, oid = row
+            chain.append({'tree': tree, 'name': name, 'mode': mode, 'oid': oid})
+            if index == len(parts) - 1:
+                if mode not in ('100644', '100755'):
+                    fail('version_file_not_regular_tracked_blob')
+                return {'path': path, 'root_tree': DEPS.CHROMIUM_TREE, 'mode': mode,
+                        'blob_sha1': oid, 'membership_chain': chain}
+            if mode != '40000':
+                fail('version_file_crosses_non_tree')
+            tree = oid
+        fail('version_file_path_invalid')
+
+
+def _version_file(owner, path, trees, blobs, used):
+    DEPS.safe_path(path)
+    if owner != 'chromium':
+        return {'path': path, 'content': 'UNAVAILABLE'}, None, ['VERSION_FILE_OWNER_TREE_UNSUPPORTED']
+    if trees is None:
+        return {'path': path, 'content': 'UNAVAILABLE'}, None, ['VERSION_FILE_MERKLE_PROOF_UNAVAILABLE']
+    proof = trees.blob(path)
+    oid = proof['blob_sha1']
+    used.add(oid)
+    content = blobs.get(oid)
+    if content is None:
+        return {**proof, 'content': 'UNAVAILABLE'}, None, ['VERSION_FILE_BLOB_BYTES_UNAVAILABLE:' + oid]
+    if not isinstance(content, bytes) or len(content) > BLOB_LIMIT or git_oid('blob', content) != oid:
+        fail('version_file_blob_bytes_mismatch')
+    try:
+        version = content.decode('utf-8', 'strict').strip()
+    except UnicodeError:
+        fail('version_file_encoding')
+    classify_reference(version)
+    return {**proof, 'content': 'MATCHES_FIXED_BASE_GIT_BLOB', 'size_bytes': len(content),
+            'sha256': hashlib.sha256(content).hexdigest()}, version, []
+
+
+def derive_requests(electron_bytes, chromium_bytes, *, chromium_tree_objects=None, version_file_blobs=None):
+    # Always rederive fixed declarations, not a caller's inventory JSON or flags.
+    inventory = DEPS.derive_manifest(electron_bytes, chromium_bytes)
+    blobs = {} if version_file_blobs is None else version_file_blobs
+    if not isinstance(blobs, dict) or any(not isinstance(key, str) or not re.fullmatch(r'[0-9a-f]{40}', key) for key in blobs):
+        fail('source_blob_mapping_invalid')
+    trees = FixedChromiumTrees(chromium_tree_objects) if chromium_tree_objects is not None else None
+    requests, rows, used = [], [], set()
+    for dependency in inventory['dependencies']:
+        if dependency['kind'] != 'cipd':
+            continue
+        rows.append(dependency)
+        for index, package in enumerate(dependency['packages']):
+            missing = []
+            row = {key: dependency[key] for key in ('owner', 'path', 'selection', 'condition', 'condition_result')}
+            row.update(package_index=index, source_package=package['package'])
+            template = declared_source_format(package['package'])
+            expanded = expand_cipd_template(template)
+            row.update(formatted_package_template=template, package_name=expanded,
+                       source_format_phase='DECLARED_BRACE_ESCAPE_MODEL_NOT_OBSERVED_GCLIENT',
+                       platform_phase='DECLARED_NATIVE_CLIENT_NOT_OBSERVED_BINARY')
+            if expanded is None:
+                missing.append('DECLARED_CIPD_TEMPLATE_NOT_APPLICABLE')
+            version = package.get('version')
+            if 'version_file' in package:
+                proof, version, reasons = _version_file(dependency['owner'], package['version_file'], trees, blobs, used)
+                row['version_file'] = proof
+                missing.extend(reasons)
+            row['source_version'] = version
+            reference = classify_reference(version) if version is not None else {
+                'reference_kind': 'VERSION_FILE_UNAVAILABLE', 'instance_id': None, 'payload_sha256': None}
+            row.update(reference)
+            if reference['reference_kind'] == 'SYMBOLIC_SELECTOR':
+                missing.append('SOURCE_PINNED_INSTANCE_FOR_SELECTOR_UNAVAILABLE')
+            elif reference['reference_kind'] == 'LEGACY_SHA1_INSTANCE':
+                missing.append('STRONG_PAYLOAD_DIGEST_UNAVAILABLE')
+            if dependency['selection'] == 'UNRESOLVED':
+                missing.append('DEPS_CONDITION_UNRESOLVED')
+            row['resolution_request'] = {'method': 'POST', 'url': RESOLVE_URL,
+                'body': {'package': expanded, 'version': version}} \
+                if dependency['selection'] == 'SELECTED' and expanded and reference['reference_kind'] == 'SYMBOLIC_SELECTOR' else None
+            row.update(payload_content='UNAVAILABLE', disposition='HOLD', authority_effect=False,
+                       missing=sorted(set(missing + ['CIPD_PAYLOAD_BYTES_UNAVAILABLE'])))
+            requests.append(row)
+    if set(blobs) - used:
+        fail('source_blob_key_not_in_fixed_version_files')
+    selected = [row for row in requests if row['selection'] == 'SELECTED']
+    return {'schema': 'metaengine.cipd-source-requests.v1', 'scope': 'PINNED_BASE_DEPS_DECLARED_CLIENT_REQUESTS',
+        'disposition': 'HOLD', 'authority_effect': False, 'selection_qualified': False,
+        'source_closure_qualified': False, 'client_executed': False, 'network_used': False,
+        'profile': {'name': inventory['profile']['name'], 'cipd_template_values': dict(PROFILE),
+                    'actual_sync_spec_bound': False, 'actual_cipd_executable_bound': False},
+        'sources': inventory['sources'],
+        'semantic_reference': {'repository': 'https://github.com/luci/luci-go', 'commit': LUCI_COMMIT,
+                               'files': SEMANTIC_SOURCES, 'bootstrap_client_identity': 'UNAVAILABLE'},
+        'requests': requests,
+        'summary': {'dependency_selection': dict(Counter(row['selection'] for row in rows)),
+            'package_selection': dict(Counter(row['selection'] for row in requests)),
+            'selected_reference_kinds': dict(Counter(row['reference_kind'] for row in selected)),
+            'resolution_request_count': sum(row['resolution_request'] is not None for row in requests),
+            'unique_resolution_request_count': len({canonical_bytes(row['resolution_request'])
+                for row in requests if row['resolution_request'] is not None}),
+            'version_file_count': sum('version_file' in row for row in requests)},
+        'blockers': sorted(set(inventory['blockers'] + ['GCLIENT_SOURCE_FORMAT_PHASE_UNQUALIFIED',
+            'CIPD_CLIENT_EXECUTABLE_IDENTITY_UNAVAILABLE', 'SYMBOLIC_SELECTOR_SOURCE_PINS_UNAVAILABLE',
+            'CIPD_PAYLOAD_BYTES_UNAVAILABLE', 'SERVICE_RESPONSE_IS_NOT_A_LOCAL_SIGNED_SOURCE_PIN']))}
+
+
+def get_source_request(electron_bytes, chromium_bytes, selector, **source_inputs):
+    if not isinstance(selector, (tuple, list)) or len(selector) != 3 \
+            or any(not isinstance(value, str) for value in selector[:2]) \
+            or type(selector[2]) is not int or selector[2] < 0:
+        fail('request_selector_invalid')
+    matches = [row for row in derive_requests(electron_bytes, chromium_bytes, **source_inputs)['requests']
+               if (row['owner'], row['path'], row['package_index']) == tuple(selector)]
+    if len(matches) != 1:
+        fail('request_selector_not_in_fixed_source')
+    request = matches[0]
+    if request['selection'] != 'SELECTED' or request['package_name'] is None:
+        fail('request_not_selected_by_declared_profile')
+    return request
+
+
+def inspect_resolution_response(electron_bytes, chromium_bytes, selector, response_bytes, **source_inputs):
+    """Inspect untrusted pRPC JSON without authorizing its tag-to-ID assertion."""
+    request = get_source_request(electron_bytes, chromium_bytes, selector, **source_inputs)
+    if not isinstance(response_bytes, bytes) or len(response_bytes) > BLOB_LIMIT:
+        fail('resolution_response_invalid')
+    try:
+        content = response_bytes.removeprefix(b")]}'\n")
+        def pairs(rows):
+            result = {}
+            for key, value in rows:
+                if key in result:
+                    fail('resolution_duplicate_json_key')
+                result[key] = value
+            return result
+        response = json.loads(content.decode('utf-8', 'strict'), object_pairs_hook=pairs)
+    except (UnicodeError, json.JSONDecodeError, RecursionError):
+        fail('resolution_response_invalid')
+    if not isinstance(response, dict) or set(response) - {'package', 'instance', 'registeredBy', 'registeredTs'} \
+            or response.get('package') != request['package_name']:
+        fail('resolution_package_or_schema_mismatch')
+    instance = response.get('instance')
+    if not isinstance(instance, dict) or set(instance) != {'hashAlgo', 'hexDigest'} \
+            or instance['hashAlgo'] != 'SHA256' or not isinstance(instance['hexDigest'], str) \
+            or not re.fullmatch(r'[0-9a-f]{64}', instance['hexDigest']):
+        fail('resolution_strong_instance_invalid')
+    observed = base64.urlsafe_b64encode(bytes.fromhex(instance['hexDigest']) + b'\x02').decode()
+    if request['instance_id'] is not None and request['instance_id'] != observed:
+        fail('resolution_conflicts_with_direct_source_instance')
+    return {'schema': 'metaengine.cipd-untrusted-resolution-observation.v1',
+        'package_name': request['package_name'], 'source_version': request['source_version'],
+        'source_instance_id': request['instance_id'], 'observed_instance_id': observed,
+        'origin': 'CALLER_SUPPLIED_UNAUTHENTICATED_JSON', 'selector_binding_qualified': False,
+        'disposition': 'HOLD', 'authority_effect': False,
+        'blockers': ['NO_LOCALLY_VERIFIABLE_SIGNED_SELECTOR_BINDING', 'CIPD_PAYLOAD_BYTES_UNAVAILABLE']}
+
+
+def verify_derived_plan(plan, electron_bytes, chromium_bytes, **source_inputs):
+    if canonical_bytes(plan) != canonical_bytes(derive_requests(electron_bytes, chromium_bytes, **source_inputs)):
+        fail('derived_plan_mismatch')
+    return plan
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron-deps', required=True, type=Path)
+    parser.add_argument('--chromium-deps', required=True, type=Path)
+    parser.add_argument('--chromium-tree-objects', type=Path)
+    parser.add_argument('--source-blob-dir', type=Path,
+                        help='preprovisioned content-addressed version-file <Git blob OID>.blob bytes')
+    options = parser.parse_args()
+    blobs = {}
+    if options.source_blob_dir is not None:
+        directory = options.source_blob_dir.absolute()
+        if not directory.is_dir() or directory.is_symlink() or directory.resolve() != directory:
+            fail('canonical_source_blob_directory_required')
+        for path in directory.iterdir():
+            if not re.fullmatch(r'[0-9a-f]{40}\.blob', path.name):
+                fail('source_blob_directory_entry_invalid')
+            blobs[path.stem] = _regular_bytes(path, BLOB_LIMIT)
+    result = derive_requests(_regular_bytes(options.electron_deps, 2 * 1024 ** 2),
+        _regular_bytes(options.chromium_deps, 2 * 1024 ** 2),
+        chromium_tree_objects=options.chromium_tree_objects, version_file_blobs=blobs)
+    sys.stdout.buffer.write(canonical_bytes(result))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, OSError) as error:
+        print(str(error), file=sys.stderr)
+        sys.exit(2)
