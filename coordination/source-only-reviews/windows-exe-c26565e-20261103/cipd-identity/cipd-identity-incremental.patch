+#!/usr/bin/env python3
+"""Inert hand-authored ZIP data only; no package/tool extraction or execution."""
+import base64
+import binascii
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import struct
+import unittest
+from unittest import mock
+import zlib
+
+APP = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('cipd_payload', APP / 'scripts/custom-electron-cipd-payload.py')
+payload = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(payload)
+PACKAGE = 'test/inert/windows-amd64'
+
+
+def instance(content):
+    return base64.urlsafe_b64encode(hashlib.sha256(content).digest() + b'\x02').decode('ascii')
+
+
+def raw_deflate(data):
+    compressor = zlib.compressobj(wbits=-15)
+    return compressor.compress(data) + compressor.flush()
+
+
+def archive(entries=None, *, manifest=None, add_manifest=True, descriptor=None,
+            preamble=b'', gap=b'', central_tail=b'', comment=b'', disk=0):
+    """Write ZIP structures as inert bytes, including otherwise-invalid cases.
+
+    This is not a Go/CIPD client fixture or evidence of actual payload parity.
+    Each member can override local/central fields for adversarial comparisons.
+    """
+    entries = [dict(item) for item in (entries if entries is not None else [
+        {'name': 'bin/tool.exe', 'data': b'inert bytes, never a PE or executable'}])]
+    if add_manifest:
+        if manifest is None:
+            manifest = {'format_version': '1.1', 'package_name': PACKAGE}
+        if not isinstance(manifest, bytes):
+            manifest = json.dumps(manifest, separators=(',', ':')).encode()
+        entries.append({'name': payload.MANIFEST, 'data': manifest})
+    result, records = bytearray(preamble), []
+    for row in entries:
+        raw_name = row['name'].encode('ascii') if isinstance(row['name'], str) else row['name']
+        data = row.get('data', b'inert')
+        method = row.get('method', 8)
+        compressed = row.get('compressed_data', raw_deflate(data) if method == 8 else data)
+        style = row.get('descriptor', descriptor)
+        flags = row.get('flags', 8 if style else 0)
+        crc = row.get('crc', binascii.crc32(data) & 0xffffffff)
+        compressed_size, size = row.get('compressed_size', len(compressed)), row.get('size', len(data))
+        required, creator = row.get('required', 20), row.get('creator', 0x0314)
+        mtime, mdate = row.get('time', 0), row.get('date', 0)
+        mode = row.get('mode', 0o100400)
+        attributes = row.get('attributes', 0 if mode & 0o200 else 1)
+        extra = row.get('extra', b'')
+        local_name = row.get('local_name', raw_name)
+        local_extra = row.get('local_extra', extra)
+        local = len(result)
+        result.extend(struct.pack('<4s5H3I2H', b'PK\x03\x04', row.get('local_required', required),
+            row.get('local_flags', flags), row.get('local_method', method), row.get('local_time', mtime),
+            row.get('local_date', mdate), row.get('local_crc', 0 if flags & 8 else crc),
+            row.get('local_compressed_size', 0 if flags & 8 else compressed_size),
+            row.get('local_size', 0 if flags & 8 else size), len(local_name), len(local_extra)))
+        result.extend(local_name + local_extra + compressed)
+        if style:
+            result.extend(row.get('descriptor_bytes', (b'PK\x07\x08' if style == 'signed' else b'')
+                + struct.pack('<3I', crc, compressed_size, size)))
+        result.extend(gap)
+        if not row.get('omit_central'):
+            member_comment = row.get('comment', b'')
+            record = struct.pack('<4s6H3I5H2I', b'PK\x01\x02', creator, required, flags, method,
+                mtime, mdate, crc, compressed_size, size, len(raw_name), len(extra), len(member_comment),
+                row.get('disk', 0), row.get('internal', 0), (mode << 16) | attributes,
+                row.get('central_local_offset', local)) + raw_name + extra + member_comment
+            records.append(record)
+    central = len(result)
+    result.extend(b''.join(records) + central_tail)
+    result.extend(struct.pack('<4s4H2IH', b'PK\x05\x06', disk, 0, len(records), len(records),
+        len(result) - central, central, len(comment)))
+    result.extend(comment)
+    return bytes(result)
+
+
+def inspect(content):
+    return payload.inspect_declared_archive(content, PACKAGE, instance(content))
+
+
+class DeclaredArchiveIdentity(unittest.TestCase):
+    def test_every_zip_member_is_inventoried_without_inventing_manifest_files(self):
+        content = archive([{'name': 'bin/tool.exe', 'data': b'inert data'},
+                           {'name': 'share/readme.txt', 'data': b'hello', 'method': 0, 'mode': 0o100600}])
+        result = inspect(content)
+        self.assertEqual(result['scope'], 'DECLARED_SHA256_INSTANCE_ARCHIVE_BYTES_ONLY')
+        self.assertEqual(result['archive_sha256'], hashlib.sha256(content).hexdigest())
+        self.assertEqual(result['member_count'], 3)
+        self.assertEqual(result['payload_member_count'], 2)
+        self.assertNotIn('files', result['manifest'])
+        members = {row['path']: row for row in result['members']}
+        self.assertEqual(members['bin/tool.exe']['sha256'], hashlib.sha256(b'inert data').hexdigest())
+        self.assertEqual(members['share/readme.txt']['unix_mode'], 0o100600)
+        self.assertEqual(members[payload.MANIFEST]['kind'], 'EMBEDDED_MANIFEST')
+        self.assertEqual(result['member_inventory_sha256'],
+            hashlib.sha256(payload.canonical_bytes(result['members'])).hexdigest())
+        self.assertEqual(result['disposition'], 'HOLD')
+        self.assertFalse(result['authority_effect'])
+        self.assertFalse(result['archive_extracted'])
+        self.assertFalse(result['package_code_executed'])
+        self.assertEqual(result['physical_readback'], 'NOT_RUN')
+
+    def test_payload_omission_extra_content_and_modes_change_full_instance(self):
+        original = archive()
+        expected = instance(original)
+        variants = [archive([]), archive([{'name': 'extra', 'data': b'new'}]),
+                    archive([{'name': 'bin/tool.exe', 'data': b'different content'}]),
+                    archive([{'name': 'bin/tool.exe', 'data': b'inert bytes, never a PE or executable', 'mode': 0o100500}]),
+                    archive([{'name': 'bin/tool.exe', 'data': b'inert bytes, never a PE or executable', 'time': 1}])]
+        for changed in variants:
+            with self.subTest(sha=hashlib.sha256(changed).hexdigest()), \
+                    self.assertRaisesRegex(ValueError, 'full_archive_sha256_disagreement'):
+                payload.inspect_declared_archive(changed, PACKAGE, expected)
+
+    def test_declared_new_instance_binds_all_new_members_but_has_no_source_authority(self):
+        before = inspect(archive())
+        after = inspect(archive([{'name': 'new', 'data': b'new'}]))
+        self.assertNotEqual(before['member_inventory_sha256'], after['member_inventory_sha256'])
+        self.assertIn('SOURCE_REQUEST_BINDING_NOT_DERIVED', after['missing'])
