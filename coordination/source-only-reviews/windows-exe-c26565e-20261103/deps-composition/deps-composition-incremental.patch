+#!/usr/bin/env python3
+"""Static pinned-DEPS inventory; never exec/eval DEPS or execute its hooks.
+
+Selections describe a declared native-Windows-x64 initial-sync analysis. The
+actual bootstrap gclient revision/spec, recursive DEPS and patched declarations
+are not qualified. This data cannot authorize a build, receipt or installation.
+"""
+import argparse
+import ast
+import base64
+import binascii
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import tempfile
+
+SOURCES = {
+    'electron': {
+        'commit': 'c542df1ecbc2c2978e8f53f8c7baf602404d166f',
+        'blob_sha1': 'b1f99e77cb3661760f655d8fb9346351b354bdba',
+        'sha256': 'c254ca413381a28243b3808e10dc8842ff0bc09629e1663ee7e09ef79dd4514a',
+    },
+    'chromium': {
+        'commit': 'dd78960ccd8a03a2fe1f629543d27783885b78e9',
+        'blob_sha1': '3a60b026a4e39b2eff1ed9ab860107e9e9f57b83',
+        'sha256': 'c3cd8ae90218c260d5fadbe5d9095164693fe420812218a18dfcf65c3f1743b9',
+    },
+}
+CHROMIUM_TREE = '63b2edfe4c6ae23d2fd3424cde3e529db49f7068'
+SOURCE_TREES = {'electron': '328891d1f8b4d93d49c9f31332baf75fa726cb6e',
+                'chromium': CHROMIUM_TREE}
+FIELDS = {'vars', 'deps', 'hooks', 'pre_deps_hooks', 'recursedeps', 'git_dependencies',
+          'gclient_gn_args_from', 'gclient_gn_args_file', 'gclient_gn_args',
+          'allowed_hosts', 'include_rules', 'skip_child_includes'}
+SHA1 = re.compile(r'^[0-9a-f]{40}$')
+SHA256 = re.compile(r'^[0-9a-f]{64}$')
+RESOLVED_ALIASES = {
+    ('https://chromium.googlesource.com/chromium/src.git', '152.0.7977.167'):
+        'dd78960ccd8a03a2fe1f629543d27783885b78e9',
+    ('https://github.com/nodejs/node.git', 'v24.22.0'):
+        'f14cd3aa7bf9ca8df2cc5b8bb14beb0f335b1d93',
+}
+
+
+def fail(code):
+    raise ValueError('custom_electron_deps_policy_' + code)
+
+
+class LiteralString(str):
+    """Str(...) is literal data, not a recursively evaluated condition."""
+
+
+class Unknown:
+    def __init__(self, *reasons):
+        self.reasons = frozenset(reasons)
+
+
+def unknown_union(values):
+    return Unknown(*(reason for value in values if isinstance(value, Unknown) for reason in value.reasons))
+
+
+def json_value(value):
+    if isinstance(value, Unknown):
+        return {'unresolved': sorted(value.reasons)}
+    if isinstance(value, dict):
+        return {key: json_value(child) for key, child in value.items()}
+    if isinstance(value, list):
+        return [json_value(child) for child in value]
+    return value
+
+
+def declared_profile():
+    # An explicit candidate profile, not defaults inferred from GN arguments,
+    # the running host, historical CI or a caller-supplied .gclient file.
+    values = {name: False for name in (
+        'checkout_android', 'checkout_ios', 'checkout_fuchsia', 'checkout_chromeos',
+        'checkout_linux', 'checkout_mac', 'checkout_arm', 'checkout_arm64',
+        'checkout_mips', 'checkout_mips64', 'checkout_ppc', 'checkout_riscv64',
+        'checkout_s390', 'checkout_x86', 'checkout_loong64')}
+    values.update(host_os=LiteralString('win'), host_cpu=LiteralString('x64'),
+                  checkout_win=True, checkout_x64=True)
+    return values
+
+
+class StaticDeps:
+    def __init__(self, content, owner, parent_vars=None):
+        if len(content) > 2 * 1024 ** 2:
+            fail('input_too_large')
+        try:
+            tree = ast.parse(content.decode('utf-8', 'strict'), filename=owner)
+        except (SyntaxError, UnicodeError, RecursionError):
+            fail('syntax_unavailable:' + owner)
+        if sum(1 for _ in ast.walk(tree)) > 100000:
+            fail('ast_too_large')
+        self.owner, self.context = owner, {}
+        assignments = {}
+        for statement in tree.body:
+            if not isinstance(statement, ast.Assign) or len(statement.targets) != 1 \
+                    or not isinstance(statement.targets[0], ast.Name):
+                fail('unsupported_statement:' + type(statement).__name__)
+            name = statement.targets[0].id
+            if name not in FIELDS or name in assignments:
+                fail('unsupported_or_duplicate_field:' + name)
+            assignments[name] = statement.value
+        defaults = self.value(assignments.get('vars', ast.Dict(keys=[], values=[])))
+        if not isinstance(defaults, dict):
+            fail('vars_not_dictionary')
+        self.context = dict(defaults)
+        self.parent_conflicts = []
+        for key, value in (parent_vars or {}).items():
+            if key in self.context and (type(value) != type(self.context[key]) or value != self.context[key]):
+                self.context[key] = Unknown('PARENT_VARIABLE_PRECEDENCE:' + key)
+                self.parent_conflicts.append(key)
+            else:
+                self.context[key] = value
+        self.context.update(declared_profile())
+        self.defaults = defaults
+        self.data = {name: defaults if name == 'vars' else self.value(value)
+                     for name, value in assignments.items()}
+
+    def value(self, node, depth=0):
+        if depth > 64:
+            fail('expression_too_deep')
+        if isinstance(node, ast.Constant) and type(node.value) in (str, int, bool, type(None)):
+            return node.value
+        if isinstance(node, ast.List):
+            return [self.value(child, depth + 1) for child in node.elts]
+        if isinstance(node, ast.Dict):
+            result = {}
+            for key, value in zip(node.keys, node.values):
+                if key is None:
+                    fail('dictionary_unpack_forbidden')
+                name = self.value(key, depth + 1)
+                if not isinstance(name, str) or name in result:
+                    fail('dictionary_key_invalid_or_duplicate')
+                result[name] = self.value(value, depth + 1)
+            return result
+        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
+            left, right = self.value(node.left, depth + 1), self.value(node.right, depth + 1)
+            if isinstance(left, Unknown) or isinstance(right, Unknown):
+                return unknown_union((left, right))
+            if isinstance(left, str) and isinstance(right, str):
+                return left + right
+            fail('non_string_addition')
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \
+                and node.func.id in ('Var', 'Str') and len(node.args) == 1 and not node.keywords:
+            argument = node.args[0]
+            if not isinstance(argument, ast.Constant) or not isinstance(argument.value, str):
+                fail('nonliteral_var_or_str')
+            if node.func.id == 'Str':
+                return LiteralString(argument.value)
+            return self.context.get(argument.value, Unknown('VAR:' + argument.value))
+        fail('unsupported_expression:' + type(node).__name__)
+
+    def condition(self, expression, seen=()):
+        if expression is None:
+            return True
+        if not isinstance(expression, str) or len(expression) > 16384 or len(seen) > 32:
+            fail('condition_invalid_or_cyclic')
+        # Substitute only inside already-parsed string constants. A quote or
+        # boolean fragment in a value must never become condition syntax.
+        def replacement(match):
+            name = match.group(1)
+            value = self.context.get(name, Unknown('SUBSTITUTION:' + name))
+            if isinstance(value, Unknown):
+                raise KeyError(name)
+            if type(value) not in (str, LiteralString, bool, int):
+                fail('substitution_type_unsupported')
+            return str(value)
+        def literal_value(value):
+            if '${' in value:
+                return Unknown('CONDITION_TEMPLATE_SEMANTICS')
+            if re.search(r'\{[^{}]*[.\[!:][^{}]*\}', value):
+                fail('unsafe_condition_substitution')
+            try:
+                return re.sub(r'\{([A-Za-z_][A-Za-z0-9_]*)\}', replacement, value)
+            except KeyError as error:
+                return Unknown('SUBSTITUTION:' + error.args[0])
+        try:
+            node = ast.parse(expression, mode='eval').body
+        except (SyntaxError, RecursionError):
+            return Unknown('CONDITION_PARSE:' + expression)
+        allowed = (ast.Constant, ast.Name, ast.BoolOp, ast.And, ast.Or, ast.UnaryOp,
+                   ast.Not, ast.Compare, ast.Eq, ast.NotEq, ast.Load)
+        if any(not isinstance(child, allowed) for child in ast.walk(node)):
+            fail('unsupported_condition_expression')
+        def evaluate(child):
+            if isinstance(child, ast.Constant):
+                if type(child.value) not in (str, bool, int, type(None)):
+                    fail('condition_literal_unsupported')
+                return literal_value(child.value) if isinstance(child.value, str) else child.value
+            if isinstance(child, ast.Name):
+                if child.id in seen:
+                    fail('condition_variable_cycle:' + child.id)
+                value = self.context.get(child.id, Unknown('CONDITION_VAR:' + child.id))
+                if isinstance(value, LiteralString):
+                    return str(value)
+                if type(value) is str:
+                    if re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', value) \
+                            and value not in self.context and value not in ('True', 'False', 'None'):
+                        return Unknown('STRING_VAR_SEMANTICS_UNKNOWN:' + child.id)
+                    return self.condition(value, (*seen, child.id))
+                return value
+            if isinstance(child, ast.UnaryOp):
+                value = evaluate(child.operand)
+                if isinstance(value, Unknown):
+                    return value
+                if type(value) is not bool:
+                    fail('condition_not_boolean')
+                return not value
+            if isinstance(child, ast.BoolOp):
+                values = [evaluate(value) for value in child.values]
+                if any(not isinstance(value, Unknown) and type(value) is not bool for value in values):
+                    fail('condition_not_boolean')
+                if isinstance(child.op, ast.And) and any(value is False for value in values):
+                    return False
+                if isinstance(child.op, ast.Or) and any(value is True for value in values):
+                    return True
+                if any(isinstance(value, Unknown) for value in values):
+                    return unknown_union(values)
+                return isinstance(child.op, ast.And)
+            if isinstance(child, ast.Compare):
+                values = [evaluate(child.left), *(evaluate(value) for value in child.comparators)]
+                if any(isinstance(value, Unknown) for value in values):
+                    return unknown_union(values)
+                return all((left == right) if isinstance(op, ast.Eq) else (left != right)
+                           for left, op, right in zip(values, child.ops, values[1:]))
+            fail('condition_node_unsupported')
+        result = evaluate(node)
+        if not isinstance(result, Unknown) and type(result) is not bool:
+            fail('condition_not_boolean')
+        return result
+
+
+def selection(value):
+    return 'UNRESOLVED' if isinstance(value, Unknown) else 'SELECTED' if value is True else 'EXCLUDED'
+
+
+def safe_path(value):
+    if not isinstance(value, str) or not value or '\\' in value or ':' in value \
+            or any(part in ('', '.', '..') for part in value.split('/')) or value.startswith('/'):
+        fail('dependency_path_invalid')
+    return value
+
+
+def pinned_bytes(content, owner):
+    if not isinstance(content, bytes) or hashlib.sha256(content).hexdigest() != SOURCES[owner]['sha256'] \
+            or hashlib.sha1(b'blob ' + str(len(content)).encode() + b'\0' + content).hexdigest() != SOURCES[owner]['blob_sha1']:
+        fail('fixed_deps_bytes_mismatch:' + owner)
+
+
+def cipd_instance_kind(value):
+    if not isinstance(value, str):
+        return None
+    if SHA1.fullmatch(value):
+        return 'SHA1_INSTANCE_ID'
+    if not re.fullmatch(r'[A-Za-z0-9_-]{44}', value):
+        return None
+    try:
+        raw = base64.b64decode(value, altchars=b'-_', validate=True)
+    except (ValueError, binascii.Error):
+        return None
+    if len(raw) == 33 and raw[-1] == 2 and base64.urlsafe_b64encode(raw).decode() == value:
+        return 'SHA256_INSTANCE_ID'
+    return None
+
+
+def gitlinks_from_trees(directory):
+    if directory is None:
+        return None
+    directory = Path(directory).absolute()
+    if not directory.is_dir() or directory.is_symlink() or directory.resolve() != directory:
+        fail('canonical_tree_packet_directory_required')
+    result, visiting = {}, set()
+    def read(oid, prefix='', depth=0):
+        if depth > 64 or oid in visiting:
+            fail('tree_packet_cycle_or_depth')
+        visiting.add(oid)
+        target = directory / (oid + '.tree')
+        before = target.lstat()
+        identity = lambda value: (value.st_dev, value.st_ino, value.st_mode, value.st_nlink,
+                                  value.st_size, value.st_mtime_ns, value.st_ctime_ns)
+        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or not 0 <= before.st_size <= 16 * 1024 ** 2:
+            fail('tree_packet_file_invalid')
+        with target.open('rb') as stream:
+            if identity(os.fstat(stream.fileno())) != identity(before):
+                fail('tree_packet_file_changed')
+            content = stream.read(16 * 1024 ** 2 + 1)
+            if identity(os.fstat(stream.fileno())) != identity(before) or identity(target.lstat()) != identity(before):
+                fail('tree_packet_file_changed')
+        if len(content) != before.st_size or hashlib.sha1(b'tree ' + str(len(content)).encode() + b'\0' + content).hexdigest() != oid:
+            fail('tree_packet_hash_mismatch')
+        offset = 0
+        while offset < len(content):
+            space, end = content.find(b' ', offset), content.find(b'\0', offset)
+            if space < 0 or end < space or end + 21 > len(content):
+                fail('tree_packet_encoding')
+            mode, name = content[offset:space].decode(), content[space + 1:end].decode('utf-8', 'strict')
+            safe_path(name)
+            child, path = content[end + 1:end + 21].hex(), prefix + name
+            offset = end + 21
+            if mode == '40000':
+                read(child, path + '/', depth + 1)
+            elif mode == '160000':
+                if path in result:
+                    fail('duplicate_gitlink')
+                result[path] = child
+            elif mode not in ('100644', '100755', '120000'):
+                fail('tree_packet_mode')
+        visiting.remove(oid)
+    read(CHROMIUM_TREE)
+    return result
+
+
+def derive_manifest(electron_bytes, chromium_bytes, chromium_tree_objects=None):
+    for owner, content in (('electron', electron_bytes), ('chromium', chromium_bytes)):
+        pinned_bytes(content, owner)
+    electron = StaticDeps(electron_bytes, 'electron')
+    chromium = StaticDeps(chromium_bytes, 'chromium', electron.defaults)
+    links = gitlinks_from_trees(chromium_tree_objects)
+    dependencies, hooks, recursion, missing = [], [], [], []
+    for document in (electron, chromium):
+        for path, declared in document.data.get('deps', {}).items():
+            safe_path(path)
+            if declared is None:
+                dependencies.append({'owner': document.owner, 'path': path,
+                    'kind': 'disabled', 'selection': 'EXCLUDED'})
+                continue
+            entry = {'url': declared} if isinstance(declared, (str, Unknown)) else declared
+            if not isinstance(entry, dict):
+                fail('dependency_schema')
+            kind = entry.get('dep_type', 'git')
+            fields = {'git': {'url', 'condition', 'dep_type'},
+                'cipd': {'packages', 'condition', 'dep_type'},
+                'gcs': {'bucket', 'objects', 'condition', 'dep_type'}}
+            if kind not in fields or set(entry) - fields[kind]:
+                fail('dependency_kind_or_fields')
+            condition = entry.get('condition')
+            state = document.condition(condition)
+            row = {'owner': document.owner, 'path': path, 'kind': kind,
+                   'condition': condition, 'selection': selection(state),
+                   'condition_result': json_value(state)}
+            reasons = []
+            if isinstance(state, Unknown):
+                reasons.extend(sorted(state.reasons))
+            if kind == 'git':
+                url = entry.get('url')
+                row['url'] = json_value(url)
+                revision = url.rsplit('@', 1)[1] if isinstance(url, str) and '@' in url else None
+                alias = RESOLVED_ALIASES.get((url.rsplit('@', 1)[0], revision)) if isinstance(url, str) and revision else None
+                link = links.get(path.removeprefix('src/')) if links is not None and document.owner == 'chromium' else None
+                if revision and SHA1.fullmatch(revision):
+                    row.update(revision=revision, revision_source='DEPS_EXACT_COMMIT')
+                    if link and link != revision:
+                        reasons.append('DEPS_GITLINK_REVISION_CONFLICT')
+                elif alias:
+                    row.update(revision=alias, declared_alias=revision,
+                               revision_source='FIXED_INDEPENDENT_ALIAS_EVIDENCE')
+                elif link:
+                    row.update(revision=link, revision_source='HASHED_CHROMIUM_GITLINK')
+                else:
+                    row.update(revision=revision, revision_source='UNRESOLVED')
+                    reasons.append('GIT_REVISION_OBJECT_PIN_UNAVAILABLE')
+            elif kind == 'cipd':
+                packages = entry.get('packages')
+                if not isinstance(packages, list):
+                    fail('cipd_packages_schema')
+                row['packages'] = json_value(packages)
+                for package in packages:
+                    if not isinstance(package, dict) or set(package) not in ({'package', 'version'}, {'package', 'version_file'}):
+                        fail('cipd_package_schema')
+                    if 'version_file' in package:
+                        safe_path(package['version_file'])
+                        reasons.append('CIPD_VERSION_FILE_OBJECT_UNAVAILABLE:' + package['version_file'])
+                    else:
+                        version = package['version']
+                        if cipd_instance_kind(version) is None:
+                            reasons.append('CIPD_IMMUTABLE_INSTANCE_PIN_UNAVAILABLE')
+                    if not isinstance(package['package'], str) or '${' in package['package']:
+                        reasons.append('CIPD_PLATFORM_EXPANSION_UNQUALIFIED')
+                reasons.append('CIPD_PAYLOAD_MEMBERSHIP_UNVERIFIED')
+            else:
+                objects = entry.get('objects')
+                if not isinstance(entry.get('bucket'), str) or not isinstance(objects, list):
+                    fail('gcs_schema')
+                row['bucket'], row['objects'] = entry['bucket'], []
+                for obj in objects:
+                    required = {'object_name', 'sha256sum', 'size_bytes', 'generation'}
+                    if not isinstance(obj, dict) or not required <= set(obj) or set(obj) - required - {'output_file', 'condition'}:
+                        fail('gcs_object_schema')
+                    if not isinstance(obj['sha256sum'], str) or not SHA256.fullmatch(obj['sha256sum']) \
+                            or type(obj['size_bytes']) is not int or obj['size_bytes'] <= 0 \
+                            or type(obj['generation']) is not int or obj['generation'] <= 0:
+                        fail('gcs_object_pin_schema')
+                    object_state = document.condition(obj.get('condition'))
+                    combined = False if state is False or object_state is False else unknown_union((state, object_state)) \
+                        if isinstance(state, Unknown) or isinstance(object_state, Unknown) else True
+                    row['objects'].append({**obj, 'selection': selection(combined),
+                        'condition_result': json_value(combined)})
+                reasons.append('GCS_PAYLOAD_CONTENT_UNVERIFIED')
+            row['missing'] = sorted(set(reasons))
+            dependencies.append(row)
+            if state is not False:
+                missing.extend({'owner': document.owner, 'path': path, 'reason': reason} for reason in row['missing'])
+        for phase in ('pre_deps_hooks', 'hooks'):
+            for index, hook in enumerate(document.data.get(phase, [])):
+                if not isinstance(hook, dict) or set(hook) - {'name', 'condition', 'action', 'pattern', 'cwd'} \
+                        or not isinstance(hook.get('action'), list):
+                    fail('hook_schema')
+                state = document.condition(hook.get('condition'))
+                hooks.append({'owner': document.owner, 'phase': phase, 'index': index,
+                    **json_value(hook), 'selection': selection(state),
+                    'condition_result': json_value(state), 'executed': False})
+        for item in document.data.get('recursedeps', []):
+            if not isinstance(item, str):
+                fail('recursive_deps_schema')
+            recursion.append({'owner': document.owner, 'path': safe_path(item),
+                'deps_file': 'DEPS', 'qualified': False})
+    blockers = ['DEPOT_TOOLS_GCLIENT_INTERPRETER_IDENTITY', 'GCLIENT_PHASE_AND_CUSTOM_VARS_IDENTITY',
+        'DECLARED_PROFILE_SELECTION_NOT_OPERATIONAL', 'RECURSIVE_DEPS_OBJECT_CLOSURE_UNAVAILABLE',
+        'ELECTRON_PATCHED_DEPS_RECONCILIATION_UNAVAILABLE', 'HOOK_GENERATED_OUTPUTS_UNVERIFIED',
+        'ENABLED_GIT_CIPD_GCS_PHYSICAL_CONTENT_UNVERIFIED']
+    if links is None:
+        blockers.append('CHROMIUM_GITLINK_TREE_OBJECTS_UNAVAILABLE')
+    return {
+        'schema': 'metaengine.enabled-deps-inventory.v1', 'scope': 'PINNED_TOP_LEVEL_DEPS_ONLY',
+        'disposition': 'HOLD', 'analysis': 'DECLARED_PROFILE_ANALYSIS',
+        'profile': {'name': 'DECLARED_NATIVE_WIN_X64_INITIAL_SYNC',
+                    'variables': json_value(declared_profile()), 'observed_sync_spec': False},
+        'sources': [{'name': owner, **record} for owner, record in SOURCES.items()],
+        'declarations': [{'owner': document.owner,
+            'variables': [{'name': name, 'value': json_value(value),
+                           'literal_str': isinstance(value, LiteralString)}
+                          for name, value in sorted(document.defaults.items())],
+            'semantic_fields': {name: json_value(value) for name, value in document.data.items()
+                if name not in ('vars', 'deps', 'hooks', 'pre_deps_hooks', 'recursedeps')}}
+            for document in (electron, chromium)],
+        'chromium_gitlink_tree': CHROMIUM_TREE,
+        'gitlink_packet_checked': links is not None,
+        'gitlink_count': len(links) if links is not None else None,
+        'selection_qualified': False, 'source_closure_qualified': False, 'authority_effect': False,
+        'parent_variable_conflicts': sorted(chromium.parent_conflicts),
+        'dependencies': dependencies, 'hooks': hooks, 'recursion': recursion,
+        'summary': {'dependency_kinds': dict(Counter(row['kind'] for row in dependencies)),
+                    'dependency_selection': dict(Counter(row['selection'] for row in dependencies)),
+                    'hook_selection': dict(Counter(row['selection'] for row in hooks)),
+                    'hook_count': len(hooks), 'recursion_count': len(recursion)},
+        'missing_pins_and_content': sorted(missing, key=lambda row: (row['owner'], row['path'], row['reason'])),
+        'blockers': blockers,
+    }
+
+
+def canonical_bytes(manifest):
+    return (json.dumps(manifest, sort_keys=True, separators=(',', ':'), ensure_ascii=False) + '\n').encode()
+
+
+def derive_from_git(electron_repo, chromium_repo):
+    """Read only fixed base objects; never execute DEPS or fetch missing input.
+
+    These are base declarations. Electron's patch-modified DEPS and the actual
+    sync interpreter/spec remain explicit HOLDs in the resulting inventory.
+    """
+    path = Path(__file__).with_name('custom-electron-source-policy.py')
+    spec = importlib.util.spec_from_file_location('fixed_deps_component_object_reader', path)
+    component = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(component)
+    objects, contents = [], {}
+    try:
+        with tempfile.TemporaryDirectory(prefix='guardian-fixed-deps-trees-') as temporary:
+            packet = Path(temporary)
+            for owner, repository in (('electron', electron_repo), ('chromium', chromium_repo)):
+                repository = component.repository_controls(repository)
+                reader = component.Objects(repository)
+                objects.append(reader)
+                tree = component.commit_tree(reader, SOURCES[owner]['commit'])
+                if tree != SOURCE_TREES[owner]:
+                    fail('fixed_deps_commit_tree_mismatch')
+                _, root = reader.read(tree)
+                def rows(content):
+                    offset = 0
+                    while offset < len(content):
+                        space, end = content.find(b' ', offset), content.find(b'\0', offset)
+                        if space < 0 or end < space or end + 21 > len(content):
+                            fail('fixed_tree_encoding')
+                        mode = content[offset:space].decode('ascii', 'strict')
+                        name = content[space + 1:end].decode('utf-8', 'strict')
+                        safe_path(name)
+                        yield mode, name, content[end + 1:end + 21].hex()
+                        offset = end + 21
+                deps = [(mode, child) for mode, name, child in rows(root) if name == 'DEPS']
+                if deps != [('100644', SOURCES[owner]['blob_sha1'])]:
+                    fail('fixed_deps_tree_membership_mismatch')
+                kind, content = reader.read(deps[0][1])
+                if kind != 'blob':
+                    fail('fixed_deps_not_blob')
+                pinned_bytes(content, owner)
+                contents[owner] = content
+                if owner == 'chromium':
+                    seen = set()
+                    def export(oid):
+                        if oid in seen:
+                            return
+                        seen.add(oid)
+                        kind, content = reader.read(oid)
+                        if kind != 'tree':
+                            fail('fixed_tree_object_type')
+                        (packet / (oid + '.tree')).write_bytes(content)
+                        for mode, _, child in rows(content):
+                            if mode == '40000':
+                                export(child)
+                    export(tree)
+            return derive_manifest(contents['electron'], contents['chromium'], packet)
+    finally:
+        for reader in objects:
+            reader.close()
+
+
+def verify_derived_manifest(candidate, electron_bytes, chromium_bytes, chromium_tree_objects=None):
+    expected = canonical_bytes(derive_manifest(electron_bytes, chromium_bytes, chromium_tree_objects))
+    if not isinstance(candidate, bytes) or candidate != expected:
+        fail('derived_manifest_bytes_mismatch')
+    return hashlib.sha256(expected).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron-deps', required=True, type=Path)
+    parser.add_argument('--chromium-deps', required=True, type=Path)
+    parser.add_argument('--chromium-tree-objects', type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    try:
+        manifest = derive_manifest(args.electron_deps.read_bytes(), args.chromium_deps.read_bytes(), args.chromium_tree_objects)
+        content = canonical_bytes(manifest)
+        with args.output.open('xb') as stream:
+            stream.write(content)
+        print(json.dumps({'schema': manifest['schema'], 'disposition': 'HOLD',
+            'selection_qualified': False, 'manifest_sha256': hashlib.sha256(content).hexdigest(),
+            'summary': manifest['summary'], 'blockers': manifest['blockers']}))
+    except (OSError, ValueError, RecursionError) as error:
+        reason = str(error) if str(error).startswith('custom_electron_deps_policy_') else 'custom_electron_deps_policy_unavailable'
+        parser.exit(1, reason + '\n')
+
+
+if __name__ == '__main__':
+    main()
