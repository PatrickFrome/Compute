+                'DEPOT_TOOLS_WIN_TOOLCHAIN', 'GYP_MSVS_OVERRIDE_PATH', 'WINDOWSSDKDIR',
+                'BASE_COMMIT_HASH', 'BASE_COMMIT_SUBMISSION_MS', 'PYTHONPATH', 'PYTHONHOME',
