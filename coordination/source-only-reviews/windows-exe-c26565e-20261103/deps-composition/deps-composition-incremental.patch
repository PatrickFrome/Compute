+        self.assertTrue(all(row['content'] == 'MATCHES_BASE_BLOB_BYTES' for row in result['sources']))
+        self.assertEqual({row['target'] for row in result['electron_pgo']}, {'win-x64', 'win-arm64', 'v8-builtins'})
+        self.assertTrue(all(len(row['sha256']) == 64 and row['payload'] == 'UNAVAILABLE' for row in result['electron_pgo']))
+        self.assertEqual(result['windows_toolchain_defaults']['toolchain_hash'], 'e66617bc68')
+        self.assertEqual(result['windows_toolchain_defaults']['sdk_version'], '10.0.26100.0')
+        self.assertIsNone(result['windows_toolchain_defaults']['sdk_payload_sha256'])
