+                      {'sha256sum': 'A' * 64}, {'size_bytes': -1}]:
+            with self.subTest(patch=patch), self.assertRaisesRegex(ValueError, 'gcs_descriptor_invalid'):
+                hooks.compare_gcs_bytes({**base, **patch}, b'x')
+
+    def test_pgo_legacy_hashless_unsafe_or_extra_fields_remain_unsupported(self):
+        for value in [b'profile.profdata', b'../profile ' + b'a' * 64, b'.. ' + b'a' * 64,
+                      b'name ' + b'a' * 64 + b' extra']:
+            with self.subTest(value=value), self.assertRaisesRegex(ValueError, 'pgo_strong_digest_state_required'):
+                hooks.pgo_state(value)
+        result = hooks.pgo_state(b'profile.profdata ' + b'a' * 64 + b'\n')
+        self.assertEqual(result['sha256'], 'a' * 64)
+        self.assertIsNone(result['size_bytes'])
