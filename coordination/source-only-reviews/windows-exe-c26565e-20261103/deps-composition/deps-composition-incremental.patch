+#!/usr/bin/env python3
+"""Data-only hook contracts; no upstream script, downloader or client runs."""
+import base64
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import unittest
+
+APP = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('hook_inputs', APP / 'scripts/custom-electron-hook-inputs.py')
+hooks = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(hooks)
+
+
+def fixture(case):
+    directory = os.environ.get('METAENGINE_HOOK_INPUT_FIXTURES')
+    if not directory:
+        case.skipTest('Pinned source byte capture not provided; no acquisition or install in tests')
+    root = Path(directory)
+    electron = (root / 'electron-DEPS.raw').read_bytes()
+    chromium = (root / 'chromium-DEPS.raw').read_bytes()
+    sources = {}
+    for row in hooks.catalog()['files']:
+        key = row['owner'] + '/' + row['path']
+        source = root / 'hook-sources' / key
+        if source.is_file():
+            sources[key] = source.read_bytes()
+    return electron, chromium, sources
+
+
+class ReferenceContracts(unittest.TestCase):
+    def test_sha256_instance_is_canonical_digest_plus_algorithm_byte(self):
+        digest = hashlib.sha256(b'inert package data').digest()
+        version = base64.urlsafe_b64encode(digest + b'\x02').decode()
+        result = hooks.classify_cipd_reference(version)
+        self.assertEqual(result['kind'], 'SHA256_INSTANCE')
+        self.assertEqual(result['sha256'], digest.hex())
+        self.assertEqual(result['disposition'], 'HOLD')
+
+    def test_legacy_sha1_is_preserved_without_promotion_to_strong_payload_identity(self):
+        result = hooks.classify_cipd_reference('a' * 40)
+        self.assertEqual(result['kind'], 'LEGACY_SHA1_INSTANCE')
+        self.assertEqual(result['disposition'], 'HOLD')
+
+    def test_tags_and_refs_are_not_immutable_package_instances(self):
+        for version in ['git_revision:' + 'a' * 40, 'version:1.2.3', 'latest', 'refs/heads/main',
+                        'A' * 43, 'A' * 40, None, {'verified': True}]:
