+#!/usr/bin/env python3
+"""Data-only restricted-DEPS/Merkle/derived-manifest regressions."""
+import base64
+import hashlib
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'scripts/custom-electron-deps-policy.py'
+spec = importlib.util.spec_from_file_location('static_deps_policy_models', SCRIPT)
+policy = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(policy)
+
+
+def oid(kind, content):
+    return hashlib.sha1(kind.encode() + b' ' + str(len(content)).encode() + b'\0' + content).hexdigest()
+
+
+def tree_row(mode, name, child):
+    return mode.encode() + b' ' + name.encode() + b'\0' + bytes.fromhex(child)
+
+
+class StaticSyntaxTests(unittest.TestCase):
+    def document(self, code):
+        return policy.StaticDeps(code.encode(), 'model')
+
+    def test_literals_var_str_and_add_only(self):
+        result = self.document(
+            "vars={'host':'https://example.invalid','flag':'True','literal':Str('not a condition')}; deps={'src/component':Var('host')+'/repo'}")
+        self.assertEqual(result.data['deps']['src/component'], 'https://example.invalid/repo')
+        self.assertTrue(result.condition('flag'))
+        self.assertIsInstance(result.defaults['literal'], policy.LiteralString)
+        self.assertTrue(result.condition('literal == "not a condition"'))
+
+    def test_unknown_names_are_never_implicit_false_or_literal_mac(self):
+        result = self.document('vars = {}')
+        self.assertIsInstance(result.condition('host_os == mac'), policy.Unknown)
+        self.assertIsInstance(result.condition('unknown and True'), policy.Unknown)
+        self.assertIsInstance(result.condition('unknown or False'), policy.Unknown)
+        self.assertFalse(result.condition('False and unknown'))
+
+    def test_defined_plain_string_semantics_are_not_reported_as_missing_variable(self):
+        result = self.document("vars={'checkout_configuration':'default'}")
+        value = result.condition('checkout_configuration != "small"')
+        self.assertEqual(value.reasons, frozenset({'STRING_VAR_SEMANTICS_UNKNOWN:checkout_configuration'}))
+
+    def test_substitution_values_cannot_inject_condition_syntax(self):
+        result = self.document("vars={'label':'\" or True or \"','empty':Str('')}")
+        self.assertFalse(result.condition('"{label}" == "known"'))
+        self.assertFalse(result.condition('"{empty}" != ""'))
+        with self.assertRaisesRegex(ValueError, 'unsafe_condition_substitution'):
+            result.condition('"{label.__class__}" == "x"')
+
+    def test_unsupported_ast_is_rejected_even_in_false_condition_branch(self):
+        result = self.document('vars = {}')
+        for expression in ('False and __import__("os")', 'False and x.attr',
+                           'False and (1 + 2 == 3)', 'False and [x for x in []]'):
+            with self.subTest(expression=expression), self.assertRaisesRegex(ValueError, 'unsupported_condition_expression'):
+                result.condition(expression)
+
+    def test_executable_statements_calls_and_comprehensions_never_run(self):
+        for text in ('import os', 'if True: vars={}', 'vars = dict()',
+                     'vars={"x":__import__("os")}', 'vars={"x":[x for x in []]}',
+                     'vars={"x":Var(123)}', 'vars={"x":Str(name)}'):
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                self.document(text)
+
+    def test_duplicate_keys_and_assignments_are_refused(self):
+        cases = ('vars={"x":True,"x":False}', 'vars={};vars={}', 'unknown_field={}')
+        for text in cases:
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                self.document(text)
+
+    def test_recursive_condition_variables_must_not_cycle(self):
+        result = self.document("vars={'a':'b','b':'a'}")
+        with self.assertRaisesRegex(ValueError, 'condition_variable_cycle'):
+            result.condition('a')
+
+    def test_parent_default_conflict_is_unresolved_not_assumed_precedence(self):
+        result = policy.StaticDeps(b"vars={'checkout_openxr':'checkout_win'}", 'child',
+                                   {'checkout_openxr': False})
+        self.assertIsInstance(result.condition('checkout_openxr'), policy.Unknown)
+        self.assertEqual(result.parent_conflicts, ['checkout_openxr'])
+
+
+class MerklePacketTests(unittest.TestCase):
+    def fixture(self):
+        temporary = tempfile.TemporaryDirectory(prefix='deps-merkle-model-')
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        child = tree_row('160000', 'dependency', 'a' * 40)
+        child_oid = oid('tree', child)
+        content = tree_row('40000', 'left', child_oid) + tree_row('40000', 'right', child_oid)
+        root_oid = oid('tree', content)
+        (root / (root_oid + '.tree')).write_bytes(content)
+        (root / (child_oid + '.tree')).write_bytes(child)
+        patch = mock.patch.object(policy, 'CHROMIUM_TREE', root_oid)
+        patch.start()
+        self.addCleanup(patch.stop)
+        return root, root_oid
+
+    def test_same_subtree_at_two_prefixes_preserves_both_gitlink_paths(self):
+        root, _ = self.fixture()
+        self.assertEqual(policy.gitlinks_from_trees(root),
+                         {'left/dependency': 'a' * 40, 'right/dependency': 'a' * 40})
+
+    def test_changed_tree_bytes_cannot_be_blessed_by_filename(self):
+        root, root_oid = self.fixture()
+        (root / (root_oid + '.tree')).write_bytes(b'changed')
+        with self.assertRaisesRegex(ValueError, 'tree_packet_hash_mismatch'):
+            policy.gitlinks_from_trees(root)
+
+    def test_packet_file_hardlink_is_refused_before_read(self):
+        root, root_oid = self.fixture()
+        os.link(root / (root_oid + '.tree'), root / 'alias')
+        with self.assertRaisesRegex(ValueError, 'tree_packet_file_invalid'):
+            policy.gitlinks_from_trees(root)
+
+
+class ManifestTests(unittest.TestCase):
+    def fixture(self):
+        electron = b"""vars={'process_deps':True};
+deps={'src':{'url':'https://chromium.googlesource.com/chromium/src.git@152.0.7977.167','condition':'process_deps'}}
+pre_deps_hooks=[{'name':'pre','action':['python3','never-executed.py']}]
+hooks=[]
+recursedeps=['src']
+"""
+        chromium = b"""git_dependencies='SYNC'
+vars={'non_git_source':'True'}
+deps={
+ 'src/dependency':{'url':'https://example.invalid/repo.git','condition':'checkout_win'},
+ 'src/cipd':{'dep_type':'cipd','packages':[{'package':'tools/${{platform}}','version':'git_revision:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'}]},
+ 'src/orderfile':{'dep_type':'cipd','condition':'checkout_android','packages':[{'package':'orderfile','version_file':'orderfile/instance'}]},
+ 'src/gcs':{'dep_type':'gcs','bucket':'model','condition':'checkout_win','objects':[{'object_name':'archive','sha256sum':'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa','size_bytes':1,'generation':1,'condition':'checkout_linux'}]},
+}
+hooks=[{'name':'model','condition':'checkout_win','action':['python3','-c','never execute code from a hook inventory']}]
+recursedeps=['src/dependency']
+"""
+        sources = {}
+        for name, content in (('electron', electron), ('chromium', chromium)):
+            sources[name] = {'commit': 'a' * 40, 'blob_sha1': oid('blob', content),
+                             'sha256': hashlib.sha256(content).hexdigest()}
+        patch = mock.patch.dict(policy.SOURCES, sources)
+        patch.start()
+        self.addCleanup(patch.stop)
+        return electron, chromium
+
+    def test_complete_inventory_is_data_only_and_explicit_hold(self):
+        electron, chromium = self.fixture()
+        manifest = policy.derive_manifest(electron, chromium)
+        self.assertEqual(manifest['disposition'], 'HOLD')
+        self.assertFalse(manifest['selection_qualified'])
+        self.assertFalse(manifest['source_closure_qualified'])
+        self.assertFalse(manifest['authority_effect'])
+        self.assertEqual(len(manifest['dependencies']), 5)
+        self.assertEqual(len(manifest['hooks']), 2)
+        self.assertTrue(all(row['executed'] is False for row in manifest['hooks']))
+        self.assertEqual(manifest['dependencies'][0]['revision'], 'dd78960ccd8a03a2fe1f629543d27783885b78e9')
+        gcs = next(row for row in manifest['dependencies'] if row['kind'] == 'gcs')
+        self.assertEqual(gcs['objects'][0]['selection'], 'EXCLUDED')
+        orderfile = next(row for row in manifest['dependencies'] if row['path'] == 'src/orderfile')
+        self.assertEqual(orderfile['packages'][0]['version_file'], 'orderfile/instance')
+        self.assertEqual(orderfile['selection'], 'EXCLUDED')
+        self.assertIn('git_dependencies', manifest['declarations'][1]['semantic_fields'])
+
+    def test_candidate_json_cannot_supply_authority_or_hide_a_blocker(self):
+        electron, chromium = self.fixture()
+        manifest = policy.derive_manifest(electron, chromium)
+        canonical = policy.canonical_bytes(manifest)
+        self.assertEqual(policy.verify_derived_manifest(canonical, electron, chromium), hashlib.sha256(canonical).hexdigest())
+        for field in ('selection_qualified', 'source_closure_qualified', 'authority_effect'):
+            changed = {**manifest, field: True}
+            with self.subTest(field=field), self.assertRaisesRegex(ValueError, 'derived_manifest_bytes_mismatch'):
+                policy.verify_derived_manifest(policy.canonical_bytes(changed), electron, chromium)
+
+    def test_raw_source_drift_fails_before_derived_manifest(self):
+        electron, chromium = self.fixture()
+        with self.assertRaisesRegex(ValueError, 'fixed_deps_bytes_mismatch'):
+            policy.derive_manifest(electron + b'\n', chromium)
+
+    def test_git_input_producer_binds_base_commit_tree_and_deps_blob(self):
+        electron, chromium = self.fixture()
+        with tempfile.TemporaryDirectory(prefix='fixed-deps-git-model-') as temporary:
+            root = Path(temporary)
+            repositories, records, trees = {}, {}, {}
+            def git(directory, *arguments):
+                return subprocess.run(['git', '-c', 'core.hooksPath=' + os.devnull,
+                    '-c', 'commit.gpgsign=false', '-C', str(directory), *arguments],
+                    capture_output=True, check=True).stdout
+            for owner, content in (('electron', electron), ('chromium', chromium)):
+                directory = root / owner
+                directory.mkdir()
+                git(directory, 'init', '--quiet')
+                (directory / 'DEPS').write_bytes(content)
+                git(directory, 'add', 'DEPS')
+                git(directory, '-c', 'user.name=Fixed DEPS Model',
+                    '-c', 'user.email=model@example.invalid', 'commit', '-qm', 'fixed source model')
+                commit = git(directory, 'rev-parse', 'HEAD').decode().strip()
+                tree = git(directory, 'rev-parse', 'HEAD^{tree}').decode().strip()
+                repositories[owner], trees[owner] = directory, tree
+                records[owner] = {'commit': commit, 'blob_sha1': oid('blob', content),
+                                  'sha256': hashlib.sha256(content).hexdigest()}
+            with mock.patch.dict(policy.SOURCES, records), mock.patch.dict(policy.SOURCE_TREES, trees), \
+                    mock.patch.object(policy, 'CHROMIUM_TREE', trees['chromium']):
+                manifest = policy.derive_from_git(repositories['electron'], repositories['chromium'])
+            self.assertEqual(manifest['sources'][0]['commit'], records['electron']['commit'])
+            self.assertTrue(manifest['gitlink_packet_checked'])
+            self.assertEqual(manifest['gitlink_count'], 0)
+            self.assertFalse(manifest['selection_qualified'])
+            self.assertEqual(manifest['disposition'], 'HOLD')
+
+    def test_cipd_instance_encoding_is_canonical_and_algorithm_bound(self):
+        instance = base64.urlsafe_b64encode(bytes(range(32)) + b'\x02').decode()
+        self.assertEqual(len(instance), 44)
+        self.assertEqual(policy.cipd_instance_kind(instance), 'SHA256_INSTANCE_ID')
+        self.assertEqual(policy.cipd_instance_kind('a' * 40), 'SHA1_INSTANCE_ID')
+        for bad in (instance[:-1], instance + '=', base64.urlsafe_b64encode(bytes(range(32)) + b'\x03').decode(),
+                    'git_revision:' + 'a' * 40, 'version:1', 'A' * 40):
+            with self.subTest(value=bad):
+                self.assertIsNone(policy.cipd_instance_kind(bad))
+
+
+if __name__ == '__main__':
+    unittest.main()
