+        self.assertEqual(hooks.classify_cipd_reference(unknown)['kind'], 'UNSUPPORTED_INSTANCE_ENCODING')
+        self.assertNotEqual(hooks.classify_cipd_reference(valid + '=')['kind'], 'SHA256_INSTANCE')
+
+    def test_gcs_declared_digest_size_and_generation_compare_without_admission(self):
+        content = b'inert payload'
+        descriptor = {'object_name': 'fixture', 'sha256sum': hashlib.sha256(content).hexdigest(),
+                      'size_bytes': len(content), 'generation': 123}
+        result = hooks.compare_gcs_bytes(descriptor, content)
+        self.assertEqual(result['scope'], 'DECLARED_GCS_DESCRIPTOR_BYTES_ONLY')
+        self.assertEqual(result['disposition'], 'HOLD')
+        self.assertFalse(result['authority_effect'])
+        with self.assertRaisesRegex(ValueError, 'gcs_payload_size_mismatch'):
