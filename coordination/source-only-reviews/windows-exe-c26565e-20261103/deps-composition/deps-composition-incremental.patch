+#!/usr/bin/env python3
+"""Data-only base hook/tool input inventory; never execute a hook or downloader.
+
+The fixed DEPS parser derives selections again from pinned source bytes. No
+caller manifest, hook exit status or "verified" boolean can authorize a build.
+Known raw files are checked against a fixed upstream-base blob catalog. Their
+patched phase, imported code, host programs, payload members and generated
+outputs remain separate producers; every composed inventory stays HOLD.
+"""
+import argparse
+import base64
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+
+APP = Path(__file__).resolve().parents[1]
+CATALOG = APP / 'build/custom-electron-hook-inputs.json'
+HEX256 = re.compile(r'^[0-9a-f]{64}$')
+PROFILE = 'DECLARED_NATIVE_WIN_X64_INITIAL_SYNC'
+COMMON_HOLDS = [
+    'GCLIENT_PHASE_AND_CUSTOM_VARS_NOT_OPERATIONALLY_BOUND',
+    'PATCHED_DEPS_AND_HOOK_SOURCE_RECONCILIATION_UNAVAILABLE',
+    'RECURSIVE_HOOK_GRAPH_AND_GLOBAL_EXECUTION_ORDER_UNAVAILABLE',
+    'HOST_INTERPRETER_STDLIB_BOOTSTRAP_AND_SUBPROCESS_BYTES_UNBOUND',
+    'GENERATED_OUTPUT_NAMESPACE_AND_CONTENT_PRODUCER_UNAVAILABLE',
+]
+SPECIAL_HOLDS = {
+    'generate_mtime_cache': ['FILESYSTEM_MTIME_INPUTS_NOT_CANONICAL_SOURCE_BYTES'],
+    'apply_mtime_cache': ['FILESYSTEM_MTIME_INPUTS_NOT_CANONICAL_SOURCE_BYTES'],
+    'patch_chromium': ['ALL_PATCH_CONFIG_TARGET_REPOSITORIES_MUST_BE_PRESENT_NO_EXIT_STATUS_SUBSTITUTE'],
+    'electron_npm_deps': ['BARE_PATH_NODE_NOT_PINNED_NODE_SOURCE', 'YARN_LOCK_PAYLOAD_AND_INSTALL_OUTPUT_CLOSURE_UNBOUND'],
+    'gen_siso_revision': ['BARE_PATH_NODE_NOT_PINNED_NODE_SOURCE', 'ADJACENT_PATCHED_DEPS_AND_GENERATED_SISO_OUTPUT_UNBOUND'],
+    'electron_pgo_profiles_win': ['ALL_REQUESTED_WIN_X64_AND_ARM64_PROFILE_PAYLOADS_UNAVAILABLE'],
+    'electron_pgo_profiles_v8_builtins': ['V8_BUILTINS_PROFILE_PAYLOAD_UNAVAILABLE'],
+    'vpython3_common': ['VPYTHON_PLATFORM_FILTER_AND_RESOLVED_WHEEL_INSTANCES_UNBOUND'],
+    'landmines': ['LANDMINE_SCRIPT_IMPORTS_AND_CLOBBER_NAMESPACE_UNBOUND'],
+    'disable_depot_tools_selfupdate': ['DEPOT_TOOLS_BOOTSTRAP_CLIENT_AND_HOOK_SCRIPT_BYTES_UNBOUND'],
+    'remove_stale_files': ['DECLARED_REMOVAL_NAMESPACE_UNBOUND'],
+    'remove_stale_pyc_files': ['DECLARED_REMOVAL_NAMESPACE_UNBOUND'],
+    'win_toolchain': ['SDK_ARTIFACT_LABEL_NOT_STRONG_PAYLOAD_DIGEST', 'DEPOT_TOOLS_SDK_DOWNLOADER_AND_EXTRACTED_MEMBERS_UNBOUND'],
+    'lastchange': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'gpu_lists_version': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'lastchange_skia': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'lastchange_dawn': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'rc_win': ['LEGACY_SHA1_DESCRIPTOR_NOT_STRONG_PAYLOAD_PROOF', 'DEPOT_TOOLS_GCS_DOWNLOADER_UNBOUND'],
+    'apache_win32': ['RECURSIVE_SHA1_DESCRIPTOR_AND_DOWNLOADER_CLOSURE_UNBOUND'],
+    'configure_reclient_cfgs': ['GENERATED_RECLIENT_TEMPLATES_AND_CONFIG_NAMESPACE_UNBOUND'],
+    'configure_siso': ['GENERATED_SISO_ENV_AND_BACKEND_CONFIG_NAMESPACE_UNBOUND'],
+    'tast_control': ['TAST_TEMPLATE_FILTER_AND_GENERATED_OUTPUT_BYTES_UNBOUND'],
+}
+KNOWN_OVERRIDES = frozenset(name.casefold() for name in (
+    'EXTRA_LANDMINES_SCRIPT', 'CHROMIUM_OUT_DIR', 'DEPOT_TOOLS_WIN_TOOLCHAIN',
+    'GYP_MSVS_OVERRIDE_PATH', 'WINDOWSSDKDIR', 'BASE_COMMIT_HASH',
+    'BASE_COMMIT_SUBMISSION_MS', 'PYTHONPATH', 'PYTHONHOME', 'NODE_OPTIONS',
+    'NODE_PATH', 'ELECTRON_PGO_CDN_URL', 'CDS_CLANG_BUCKET_OVERRIDE'))
+
+
+def fail(reason):
+    raise ValueError('custom_electron_hook_inputs_' + reason)
+
+
+def deps_policy():
+    spec = importlib.util.spec_from_file_location('metaengine_fixed_deps_policy',
+        Path(__file__).with_name('custom-electron-deps-policy.py'))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)  # Our data parser, never an upstream script.
+    return module
+
+
+def sha256(content):
+    return hashlib.sha256(content).hexdigest()
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()
+
+
+def catalog():
+    value = json.loads(CATALOG.read_bytes())
+    if value.get('schema') != 'metaengine.custom-electron.hook-source-catalog.v1':
+        fail('catalog_schema')
+    return value
+
+
+def compare_source_bytes(source_files):
+    """Compare bytes only; no script import/exec, patch-phase or closure claim."""
+    pins = {row['owner'] + '/' + row['path']: row for row in catalog()['files']}
+    if set(source_files) - set(pins):
+        fail('unknown_source_key')
+    result = []
+    for key, pin in pins.items():
+        content = source_files.get(key)
+        if content is not None:
+            if not isinstance(content, bytes) or len(content) != pin['bytes'] or sha256(content) != pin['sha256'] \
+                    or hashlib.sha1(b'blob ' + str(len(content)).encode() + b'\0' + content).hexdigest() != pin['blob_sha1']:
+                fail('known_source_bytes_mismatch:' + key)
+        result.append({'path': key, 'blob_sha1': pin['blob_sha1'], 'sha256': pin['sha256'],
+            'phase': pin['phase'], 'content': 'MISSING' if content is None else 'MATCHES_BASE_BLOB_BYTES'})
+    return result
+
+
+def classify_cipd_reference(version):
+    """CIPD instance syntax is not package membership, extraction or execution."""
+    if not isinstance(version, str):
+        return {'kind': 'UNRESOLVED_REFERENCE', 'disposition': 'HOLD'}
+    if re.fullmatch(r'[0-9a-f]{40}', version):
+        return {'kind': 'LEGACY_SHA1_INSTANCE', 'sha1': version, 'disposition': 'HOLD'}
+    if re.fullmatch(r'[A-Za-z0-9_-]{44}', version):
+        decoded = base64.urlsafe_b64decode(version)
+        if len(decoded) == 33 and decoded[-1] == 2 and base64.urlsafe_b64encode(decoded).decode().rstrip('=') == version:
+            return {'kind': 'SHA256_INSTANCE', 'sha256': decoded[:-1].hex(), 'disposition': 'HOLD'}
+        return {'kind': 'UNSUPPORTED_INSTANCE_ENCODING', 'disposition': 'HOLD'}
+    return {'kind': 'SYMBOLIC_REFERENCE_REQUIRES_RESOLUTION', 'disposition': 'HOLD'}
+
+
+def compare_gcs_bytes(descriptor, content):
+    """Pure descriptor comparison. Only a source-derived selector adds origin."""
+    if (not isinstance(descriptor, dict) or not isinstance(descriptor.get('sha256sum'), str)
+            or not HEX256.fullmatch(descriptor['sha256sum'])
+            or type(descriptor.get('size_bytes')) is not int or descriptor['size_bytes'] <= 0
+            or type(descriptor.get('generation')) is not int or descriptor['generation'] <= 0):
+        fail('gcs_descriptor_invalid')
+    if not isinstance(content, bytes) or len(content) != descriptor['size_bytes']:
+        fail('gcs_payload_size_mismatch')
+    if sha256(content) != descriptor['sha256sum']:
+        fail('gcs_payload_digest_mismatch')
+    return {'scope': 'DECLARED_GCS_DESCRIPTOR_BYTES_ONLY', 'bytes': len(content),
+        'sha256': sha256(content), 'disposition': 'HOLD', 'authority_effect': False}
+
+
+def verify_selected_gcs_bytes(electron_bytes, chromium_bytes, owner, path, object_name, content):
+    derived = deps_policy().derive_manifest(electron_bytes, chromium_bytes)
+    matches = [(row, obj) for row in derived['dependencies'] if row['owner'] == owner
+        and row['path'] == path and row['kind'] == 'gcs' for obj in row['objects']
+        if obj['object_name'] == object_name]
+    if len(matches) != 1 or matches[0][0]['selection'] != 'SELECTED' or matches[0][1]['selection'] != 'SELECTED':
+        fail('gcs_source_selection_not_resolved')
+    result = compare_gcs_bytes(matches[0][1], content)
+    return {**result, 'scope': 'PINNED_BASE_DEPS_SELECTED_GCS_BYTES_ONLY', 'owner': owner,
+        'path': path, 'object_name': object_name, 'generation': matches[0][1]['generation']}
+
+
+def known_override_keys(environment):
+    # Windows names are case-insensitive; present empty values still override.
+    return sorted({key.upper() for key in environment if key.casefold() in KNOWN_OVERRIDES
+        or key.casefold().startswith('gyp_msvs_hash_')})
+
+
+def reject_known_overrides(environment):
+    keys = known_override_keys(environment)
+    if keys:
+        fail('environment_override_forbidden:' + ','.join(keys))
+
+
+def pgo_state(content):
+    fields = content.decode('utf-8', 'strict').split()
+    if len(fields) != 2 or not re.fullmatch(r'[A-Za-z0-9._-]+', fields[0]) \
+            or fields[0] in ('.', '..') or not HEX256.fullmatch(fields[1]):
+        fail('pgo_strong_digest_state_required')
+    return {'file': fields[0], 'sha256': fields[1], 'size_bytes': None,
+        'payload': 'UNAVAILABLE', 'disposition': 'HOLD'}
+
+
+def base_siso_expected(chromium_bytes):
+    deps_policy().pinned_bytes(chromium_bytes, 'chromium')
+    found = re.findall(rb"'siso_version':\s*'git_revision:([0-9a-f]{40})'", chromium_bytes)
+    if len(found) != 1:
+        fail('base_siso_literal_unavailable')
+    return found[0] + b'\n'
+
+
+def toolchain_defaults(source_files):
+    # Called only after compare_source_bytes; literals are data, never exec.
+    source = source_files.get('chromium/build/vs_toolchain.py')
+    result = {'scope': 'UPSTREAM_BASE_DECLARATIONS_ONLY', 'disposition': 'HOLD',
+        'sdk_payload_sha256': None, 'sdk_payload_size_bytes': None}
+    if source is not None:
+        for name in ('TOOLCHAIN_HASH', 'SDK_VERSION'):
+            found = re.findall(rb'^' + name.encode() + rb" = '([A-Za-z0-9.]+)'$", source, re.MULTILINE)
+            if len(found) != 1:
+                fail('known_toolchain_literal_missing:' + name)
+            result[name.lower()] = found[0].decode('ascii')
+    descriptor = source_files.get('chromium/build/toolchain/win/rc/win/rc.exe.sha1')
+    if descriptor is not None:
+        value = descriptor.decode('ascii').strip()
+        if not re.fullmatch('[0-9a-f]{40}', value):
+            fail('legacy_rc_descriptor_invalid')
+        result['rc_legacy_sha1'] = value
+    return result
+
+
+def derive_inventory(electron_bytes, chromium_bytes, source_files, chromium_tree_objects=None):
+    parser = deps_policy()
+    derived = parser.derive_manifest(electron_bytes, chromium_bytes, chromium_tree_objects)
+    pins = catalog()
+    if derived['sources'] != pins['sources'] or derived['profile']['name'] != PROFILE:
+        fail('source_profile_catalog_mismatch')
+    sources = compare_source_bytes(source_files)
+    source_state = {row['path']: row['content'] for row in sources}
+    recipes = {(row['owner'], row['phase'], row['index']): row for row in pins['hooks']}
+    hooks = []
+    for hook in derived['hooks']:
+        if hook['selection'] == 'EXCLUDED':
+            continue
+        recipe = recipes.get((hook['owner'], hook['phase'], hook['index']))
+        holds = list(COMMON_HOLDS)
+        if recipe is None:
+            holds.append('HOOK_DATA_HANDLER_UNAVAILABLE')
+            paths = []
+        else:
+            if recipe['name'] != hook.get('name') or recipe['action_sha256'] != sha256(canonical(hook['action'])):
+                fail('catalog_action_mismatch')
+            paths = recipe['source_paths']
+        if hook['selection'] != 'SELECTED':
+            holds.append('HOOK_SELECTION_UNRESOLVED')
+        holds.extend(SPECIAL_HOLDS.get(hook.get('name'), ['GENERATED_INPUT_HANDLER_UNAVAILABLE']))
+        holds.extend('BASE_SOURCE_BYTES_UNAVAILABLE:' + path for path in paths
+            if source_state.get(path) != 'MATCHES_BASE_BLOB_BYTES')
+        hooks.append({**hook, 'disposition': 'HOLD', 'source_paths': paths,
+            'declared_host_command': hook['action'][0], 'blockers': sorted(set(holds))})
+    pgo = []
+    for target in ('win-x64', 'win-arm64', 'v8-builtins'):
+        key = 'electron/build/pgo_profiles/' + target + '.pgo.txt'
+        pgo.append({'target': target, 'state_source': key,
+            **(pgo_state(source_files[key]) if key in source_files else {'payload': 'STATE_SOURCE_UNAVAILABLE', 'disposition': 'HOLD'})})
+    siso = base_siso_expected(chromium_bytes)
+    gcs = [{**row, 'payloads': 'NOT_DOWNLOADED_OR_EXTRACTED'} for row in derived['dependencies']
+        if row['kind'] == 'gcs' and row['selection'] != 'EXCLUDED']
+    cipd = [{**row, 'reference_formats': [classify_cipd_reference(item.get('version')) for item in row['packages']]}
+        for row in derived['dependencies'] if row['kind'] == 'cipd' and row['selection'] != 'EXCLUDED']
+    return {'schema': 'metaengine.hook-tool-input-inventory.v1', 'scope': 'PINNED_TOP_LEVEL_BASE_DECLARATIONS_ONLY',
+        'disposition': 'HOLD', 'profile': derived['profile'], 'sources': sources,
+        'hooks': hooks, 'gcs_declarations': gcs, 'cipd_declarations': cipd, 'electron_pgo': pgo,
+        'windows_toolchain_defaults': toolchain_defaults(source_files),
+        'base_siso_output': {'path': 'src/electron/build/siso_revision', 'bytes': len(siso),
+            'sha256': sha256(siso), 'expected_base_text': siso.decode(), 'actual_hook_output': 'UNQUALIFIED'},
+        'known_environment_override_keys': known_override_keys(os.environ),
+        'blockers': COMMON_HOLDS + ['CIPD_PACKAGE_MEMBERSHIP_AND_EXTRACTED_GCS_PAYLOADS_UNBOUND',
+            'DECLARED_PROFILE_NOT_ACTUAL_GCLIENT_EXECUTION_SPEC', 'KNOWN_ENVIRONMENT_KEY_CHECK_IS_NOT_COMPLETE_ENVIRONMENT_IDENTITY'],
+        'summary': {'hook_selection': dict(Counter(row['selection'] for row in hooks)),
+            'source_content': dict(Counter(row['content'] for row in sources)), 'all_hook_count': len(derived['hooks'])},
+        'hooks_executed': False, 'tool_payloads_downloaded': False, 'authority_effect': False}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron-deps', required=True, type=Path)
+    parser.add_argument('--chromium-deps', required=True, type=Path)
+    parser.add_argument('--sources', type=Path, help='Read-only owner/path byte capture; never execute it')
+    parser.add_argument('--chromium-tree-objects', type=Path)
+    args = parser.parse_args()
+    try:
+        sources = {}
+        if args.sources:
+            for row in catalog()['files']:
+                key = row['owner'] + '/' + row['path']
+                path = args.sources / key
+                if path.is_symlink():
+                    fail('source_symlink_forbidden')
+                if path.is_file():
+                    sources[key] = path.read_bytes()
+        result = derive_inventory(args.electron_deps.read_bytes(), args.chromium_deps.read_bytes(),
+            sources, args.chromium_tree_objects)
+        print(json.dumps(result, indent=2))
+    except (ValueError, OSError, KeyError, TypeError, UnicodeError) as error:
+        parser.exit(1, str(error) + '\n')
+    # An inventory is never a hook execution/build admission result.
+    raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
