+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron-deps', required=True, type=Path)
+    parser.add_argument('--chromium-deps', required=True, type=Path)
+    parser.add_argument('--sources', type=Path, help='Read-only owner/path byte capture; never execute it')
+    parser.add_argument('--chromium-tree-objects', type=Path)
+    args = parser.parse_args()
+    try:
+        sources = {}
+        if args.sources:
+            for row in catalog()['files']:
+                key = row['owner'] + '/' + row['path']
+                path = args.sources / key
+                if path.is_symlink():
