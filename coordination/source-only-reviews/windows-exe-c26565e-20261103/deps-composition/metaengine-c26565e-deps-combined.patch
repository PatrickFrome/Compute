+    except (ValueError, OSError, KeyError, TypeError, UnicodeError) as error:
+        parser.exit(1, str(error) + '\n')
+    # An inventory is never a hook execution/build admission result.
+    raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
