+'use strict';
+// Build-only ingredient collection. No dependency code is imported/executed.
+// No caller-provided expected image, ASAR path, callback or "verified" receipt
+// can authorize a transform. The expected-resource producer does not exist yet;
+// this collector therefore always reports HOLD and is not a package gate.
+const fs = require('node:fs');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const APP = path.resolve(__dirname, '..');
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+const fail = reason => { throw Error('custom_electron_transform_inputs_' + reason); };
+
+function stableFile(root, relative, maximum = 8 * 1024 * 1024) {
+  if (!relative || relative.includes('\\') || path.isAbsolute(relative)
+      || relative.split('/').some(part => !part || part === '.' || part === '..')) fail('path_invalid');
+  let current = root;
+  if (fs.lstatSync(current).isSymbolicLink()) fail('source_alias');
+  for (const part of relative.split('/')) {
+    current = path.join(current, part);
+    if (fs.lstatSync(current).isSymbolicLink()) fail('source_alias');
+  }
+  const before = fs.lstatSync(current);
+  if (!before.isFile() || before.nlink !== 1 || before.size > maximum) fail('source_file_invalid');
+  const actual = fs.realpathSync(current), expected = path.resolve(current);
+  if (process.platform === 'win32' ? actual.toLowerCase() !== expected.toLowerCase() : actual !== expected) fail('source_alias');
+  const bytes = fs.readFileSync(current), after = fs.lstatSync(current);
+  if (before.dev !== after.dev || before.ino !== after.ino || before.size !== bytes.length
+      || before.size !== after.size || before.mtimeMs !== after.mtimeMs || !after.isFile() || after.nlink !== 1) fail('source_changed');
+  return bytes;
+}
+
+function catalog() {
+  const bytes = stableFile(APP, 'build/custom-electron-transform-inputs.json');
+  const value = JSON.parse(bytes);
+  if (value.schema !== 'metaengine.custom-electron.transform-input-catalog.v1'
+      || value.entry_module !== 'resedit/dist/index.js'
+      || Object.keys(value.packages).sort().join(',') !== 'pe-library,resedit'
+      || value.modules.length !== 52 || value.reference_sources.length !== 9) fail('catalog_invalid');
+  Object.defineProperty(value, 'source_catalog_sha256', { value: sha(bytes) });
