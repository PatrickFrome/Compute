+                with target.open('rb') as stream:
+                    if identity(os.fstat(stream.fileno())) != identity(before):
+                        fail('physical_file_changed')
+                    for chunk in iter(lambda: stream.read(1024 ** 2), b''):
+                        value.update(chunk)
+                    if identity(os.fstat(stream.fileno())) != identity(before):
+                        fail('physical_file_changed')
+                digest = value.hexdigest()
