+                fail('canonical_checkout_representation_mismatch:' + relative)
+            if identity(target.lstat()) != identity(before):
+                fail('physical_file_changed')
+            pins.append((target, identity(before)))
+            seen.add(relative)
+    if seen != set(expected) - gitlinks:
+        fail('physical_tree_file_set_mismatch')
+    if any(identity(target.lstat()) != before for target, before in pins):
+        fail('physical_tree_changed_during_readback')
+    return {'physical_tree_verified': True, 'physical_file_count': len(seen),
+            'gitlink_dependencies_qualified': False, 'windows_representation_qualified': False}
+
+
+def materialize_canonical_tree(root, entries, objects):
+    """Create a new source-only tree from verified raw blobs; never overwrite."""
+    root = Path(root).absolute()
+    if not root.parent.is_dir() or root.parent.resolve() != root.parent or root.exists():
+        fail('new_canonical_output_required')
+    root.mkdir(mode=0o700)
+    for row in entries:
+        target = root.joinpath(*PurePosixPath(row['path']).parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        if row['mode'] == '160000':
+            target.mkdir()
+            continue  # An empty dependency placeholder is never qualified.
+        kind, content = objects.read(row['oid'])
+        if kind != 'blob':
+            fail('canonical_source_not_blob')
+        if row['mode'] == '120000':
+            target.symlink_to(os.fsdecode(content))
+        else:
+            with target.open('xb') as stream:
+                stream.write(content)
+            target.chmod(0o755 if row['mode'] == '100755' else 0o644)
+    return physical_tree(root, entries)
+
+
+def verify_component_tree(electron_repo, checkout, component):
+    with derive_component_tree(electron_repo, checkout, component) as (evidence, entries, _):
+        observed = git(checkout, 'rev-parse', 'HEAD').decode().strip()
+        objects = Objects(checkout)
+        try:
+            if commit_tree(objects, observed) != evidence['expected_tree']:
+                fail('observed_component_tree_mismatch:' + component)
+        finally:
+            objects.close()
+        evidence.update(physical_tree(checkout, entries))
+        if git(checkout, 'rev-parse', 'HEAD').decode().strip() != observed:
+            fail('observed_component_head_changed')
+        return {**evidence, 'observed_head': observed}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--electron', required=True, type=Path)
+    parser.add_argument('--checkout', required=True, type=Path)
+    parser.add_argument('--component', required=True, choices=tuple(COMPONENTS))
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument('--derive-only', action='store_true',
+                        help='Derive expected objects only; does not qualify a physical checkout')
+    mode.add_argument('--canonical-output', type=Path,
+                        help='Create a NEW canonical raw-blob source tree; no hooks or dependencies')
+    mode.add_argument('--physical-tree', type=Path,
+                      help='Verify a separate canonical source tree against the fully derived tree')
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    try:
+        if args.derive_only or args.canonical_output or args.physical_tree:
+            with derive_component_tree(args.electron, args.checkout, args.component) as result:
+                evidence = result[0]
+                if args.canonical_output:
+                    evidence.update(materialize_canonical_tree(args.canonical_output, result[1], result[2]))
+                    evidence['canonical_source_materialization'] = True
+                elif args.physical_tree:
+                    evidence.update(physical_tree(args.physical_tree, result[1]))
+                    evidence['physical_tree_is_separate_from_object_checkout'] = True
+        else:
+            evidence = verify_component_tree(args.electron, args.checkout, args.component)
+        with args.output.open('x', encoding='utf-8') as stream:
+            json.dump(evidence, stream, indent=2)
+            stream.write('\n')
+        print(json.dumps({'scope': evidence['scope'], 'component': args.component,
+            'expected_tree': evidence['expected_tree'], 'entry_count': evidence['entry_count'],
+            'patch_count': len(evidence['patches']),
+            'physical_tree_verified': evidence['physical_tree_verified'],
+            'dependency_closure_verified': False, 'authority_effect': False}))
+    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
+        reason = str(error) if str(error).startswith('custom_electron_source_policy_') else 'custom_electron_source_policy_unavailable'
+        parser.exit(1, reason + '\n')
+
+
+if __name__ == '__main__':
+    main()
