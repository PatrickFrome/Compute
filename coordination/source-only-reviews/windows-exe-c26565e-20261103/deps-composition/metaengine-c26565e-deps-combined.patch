+  try { parsed = JSON.parse(header); } catch { fail('asar_header_json_invalid'); }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || !parsed.files
+      || typeof parsed.files !== 'object' || Array.isArray(parsed.files)) fail('asar_header_files_invalid');
+  const digest = sha(Buffer.from(header, 'utf8'));
+  return Buffer.from(JSON.stringify([{ file: 'resources\\app.asar', alg: 'SHA256', value: digest }]));
+}
+
+function collectWindowsTransformIngredients() {
+  const configBytes = stableFile(APP, 'electron-builder.test.json');
+  const config = JSON.parse(configBytes), packageBytes = stableFile(APP, 'package.json');
+  if (config.electronVersion !== '44.9.3' || config.electronDist !== 'native-dist/custom-electron'
+      || config.asar !== true || config.electronFuses?.enableEmbeddedAsarIntegrityValidation !== true
