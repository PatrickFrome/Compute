+        self.assertIsInstance(result.condition('unknown and True'), policy.Unknown)
+        self.assertIsInstance(result.condition('unknown or False'), policy.Unknown)
+        self.assertFalse(result.condition('False and unknown'))
+
+    def test_defined_plain_string_semantics_are_not_reported_as_missing_variable(self):
+        result = self.document("vars={'checkout_configuration':'default'}")
+        value = result.condition('checkout_configuration != "small"')
+        self.assertEqual(value.reasons, frozenset({'STRING_VAR_SEMANTICS_UNKNOWN:checkout_configuration'}))
+
+    def test_substitution_values_cannot_inject_condition_syntax(self):
+        result = self.document("vars={'label':'\" or True or \"','empty':Str('')}")
+        self.assertFalse(result.condition('"{label}" == "known"'))
+        self.assertFalse(result.condition('"{empty}" != ""'))
+        with self.assertRaisesRegex(ValueError, 'unsafe_condition_substitution'):
+            result.condition('"{label.__class__}" == "x"')
