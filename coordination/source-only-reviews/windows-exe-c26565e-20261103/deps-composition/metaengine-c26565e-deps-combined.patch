+#!/usr/bin/env python3
+"""Data-only base hook/tool input inventory; never execute a hook or downloader.
+
+The fixed DEPS parser derives selections again from pinned source bytes. No
+caller manifest, hook exit status or "verified" boolean can authorize a build.
+Known raw files are checked against a fixed upstream-base blob catalog. Their
+patched phase, imported code, host programs, payload members and generated
+outputs remain separate producers; every composed inventory stays HOLD.
+"""
+import argparse
+import base64
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+
+APP = Path(__file__).resolve().parents[1]
+CATALOG = APP / 'build/custom-electron-hook-inputs.json'
+HEX256 = re.compile(r'^[0-9a-f]{64}$')
+PROFILE = 'DECLARED_NATIVE_WIN_X64_INITIAL_SYNC'
+COMMON_HOLDS = [
+    'GCLIENT_PHASE_AND_CUSTOM_VARS_NOT_OPERATIONALLY_BOUND',
+    'PATCHED_DEPS_AND_HOOK_SOURCE_RECONCILIATION_UNAVAILABLE',
+    'RECURSIVE_HOOK_GRAPH_AND_GLOBAL_EXECUTION_ORDER_UNAVAILABLE',
+    'HOST_INTERPRETER_STDLIB_BOOTSTRAP_AND_SUBPROCESS_BYTES_UNBOUND',
+    'GENERATED_OUTPUT_NAMESPACE_AND_CONTENT_PRODUCER_UNAVAILABLE',
+]
+SPECIAL_HOLDS = {
+    'generate_mtime_cache': ['FILESYSTEM_MTIME_INPUTS_NOT_CANONICAL_SOURCE_BYTES'],
+    'apply_mtime_cache': ['FILESYSTEM_MTIME_INPUTS_NOT_CANONICAL_SOURCE_BYTES'],
+    'patch_chromium': ['ALL_PATCH_CONFIG_TARGET_REPOSITORIES_MUST_BE_PRESENT_NO_EXIT_STATUS_SUBSTITUTE'],
+    'electron_npm_deps': ['BARE_PATH_NODE_NOT_PINNED_NODE_SOURCE', 'YARN_LOCK_PAYLOAD_AND_INSTALL_OUTPUT_CLOSURE_UNBOUND'],
+    'gen_siso_revision': ['BARE_PATH_NODE_NOT_PINNED_NODE_SOURCE', 'ADJACENT_PATCHED_DEPS_AND_GENERATED_SISO_OUTPUT_UNBOUND'],
+    'electron_pgo_profiles_win': ['ALL_REQUESTED_WIN_X64_AND_ARM64_PROFILE_PAYLOADS_UNAVAILABLE'],
+    'electron_pgo_profiles_v8_builtins': ['V8_BUILTINS_PROFILE_PAYLOAD_UNAVAILABLE'],
+    'vpython3_common': ['VPYTHON_PLATFORM_FILTER_AND_RESOLVED_WHEEL_INSTANCES_UNBOUND'],
+    'landmines': ['LANDMINE_SCRIPT_IMPORTS_AND_CLOBBER_NAMESPACE_UNBOUND'],
+    'disable_depot_tools_selfupdate': ['DEPOT_TOOLS_BOOTSTRAP_CLIENT_AND_HOOK_SCRIPT_BYTES_UNBOUND'],
+    'remove_stale_files': ['DECLARED_REMOVAL_NAMESPACE_UNBOUND'],
+    'remove_stale_pyc_files': ['DECLARED_REMOVAL_NAMESPACE_UNBOUND'],
+    'win_toolchain': ['SDK_ARTIFACT_LABEL_NOT_STRONG_PAYLOAD_DIGEST', 'DEPOT_TOOLS_SDK_DOWNLOADER_AND_EXTRACTED_MEMBERS_UNBOUND'],
+    'lastchange': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'gpu_lists_version': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'lastchange_skia': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'lastchange_dawn': ['GIT_HISTORY_AND_ENVIRONMENT_DERIVED_OUTPUTS_UNBOUND'],
+    'rc_win': ['LEGACY_SHA1_DESCRIPTOR_NOT_STRONG_PAYLOAD_PROOF', 'DEPOT_TOOLS_GCS_DOWNLOADER_UNBOUND'],
+    'apache_win32': ['RECURSIVE_SHA1_DESCRIPTOR_AND_DOWNLOADER_CLOSURE_UNBOUND'],
+    'configure_reclient_cfgs': ['GENERATED_RECLIENT_TEMPLATES_AND_CONFIG_NAMESPACE_UNBOUND'],
+    'configure_siso': ['GENERATED_SISO_ENV_AND_BACKEND_CONFIG_NAMESPACE_UNBOUND'],
+    'tast_control': ['TAST_TEMPLATE_FILTER_AND_GENERATED_OUTPUT_BYTES_UNBOUND'],
+}
+KNOWN_OVERRIDES = frozenset(name.casefold() for name in (
+    'EXTRA_LANDMINES_SCRIPT', 'CHROMIUM_OUT_DIR', 'DEPOT_TOOLS_WIN_TOOLCHAIN',
+    'GYP_MSVS_OVERRIDE_PATH', 'WINDOWSSDKDIR', 'BASE_COMMIT_HASH',
+    'BASE_COMMIT_SUBMISSION_MS', 'PYTHONPATH', 'PYTHONHOME', 'NODE_OPTIONS',
+    'NODE_PATH', 'ELECTRON_PGO_CDN_URL', 'CDS_CLANG_BUCKET_OVERRIDE'))
+
+
+def fail(reason):
+    raise ValueError('custom_electron_hook_inputs_' + reason)
+
+
+def deps_policy():
+    spec = importlib.util.spec_from_file_location('metaengine_fixed_deps_policy',
+        Path(__file__).with_name('custom-electron-deps-policy.py'))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)  # Our data parser, never an upstream script.
+    return module
+
+
+def sha256(content):
+    return hashlib.sha256(content).hexdigest()
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()
+
+
+def catalog():
+    value = json.loads(CATALOG.read_bytes())
+    if value.get('schema') != 'metaengine.custom-electron.hook-source-catalog.v1':
+        fail('catalog_schema')
+    return value
+
+
+def compare_source_bytes(source_files):
+    """Compare bytes only; no script import/exec, patch-phase or closure claim."""
+    pins = {row['owner'] + '/' + row['path']: row for row in catalog()['files']}
+    if set(source_files) - set(pins):
+        fail('unknown_source_key')
+    result = []
+    for key, pin in pins.items():
+        content = source_files.get(key)
+        if content is not None:
+            if not isinstance(content, bytes) or len(content) != pin['bytes'] or sha256(content) != pin['sha256'] \
+                    or hashlib.sha1(b'blob ' + str(len(content)).encode() + b'\0' + content).hexdigest() != pin['blob_sha1']:
+                fail('known_source_bytes_mismatch:' + key)
+        result.append({'path': key, 'blob_sha1': pin['blob_sha1'], 'sha256': pin['sha256'],
+            'phase': pin['phase'], 'content': 'MISSING' if content is None else 'MATCHES_BASE_BLOB_BYTES'})
+    return result
+
+
+def classify_cipd_reference(version):
+    """CIPD instance syntax is not package membership, extraction or execution."""
+    if not isinstance(version, str):
+        return {'kind': 'UNRESOLVED_REFERENCE', 'disposition': 'HOLD'}
+    if re.fullmatch(r'[0-9a-f]{40}', version):
+        return {'kind': 'LEGACY_SHA1_INSTANCE', 'sha1': version, 'disposition': 'HOLD'}
+    if re.fullmatch(r'[A-Za-z0-9_-]{44}', version):
+        decoded = base64.urlsafe_b64decode(version)
+        if len(decoded) == 33 and decoded[-1] == 2 and base64.urlsafe_b64encode(decoded).decode().rstrip('=') == version:
+            return {'kind': 'SHA256_INSTANCE', 'sha256': decoded[:-1].hex(), 'disposition': 'HOLD'}
+        return {'kind': 'UNSUPPORTED_INSTANCE_ENCODING', 'disposition': 'HOLD'}
+    return {'kind': 'SYMBOLIC_REFERENCE_REQUIRES_RESOLUTION', 'disposition': 'HOLD'}
+
+
+def compare_gcs_bytes(descriptor, content):
+    """Pure descriptor comparison. Only a source-derived selector adds origin."""
+    if (not isinstance(descriptor, dict) or not isinstance(descriptor.get('sha256sum'), str)
