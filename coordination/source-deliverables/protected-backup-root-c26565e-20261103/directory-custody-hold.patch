+// VETO ONLY. There is currently no original native recovery-directory issuer.
+// W74/W76 selectors, ACL/path observations and Windows process Job handles do
+// not retain the backup/PGDATA objects or their path-resolution ancestry.
+//
+// Keep every selected backup/restore effect on HOLD. This module deliberately
+// has no capability factory, callback, injected verifier, handle/boolean input
+// or positive return branch. A future implementation needs a separately
+// reviewed original kernel-handle/operation integration, not a true flag here.
+const unavailable=new WeakSet();
+export function requireOriginalRecoveryDirectoryCustody(){
+  const error=Error('native_recovery_original_directory_custody_required');
+  unavailable.add(error);throw error;
+}
+// Classification of an original refusal only. It grants no effect authority
+// and does not mislabel an effect-free HOLD as unknown physical completion.
+export function originalRecoveryDirectoryCustodyUnavailable(error){
+  return unavailable.has(error);
+}
