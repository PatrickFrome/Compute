+    assert.ok(row&&!row.closed&&custody&&!custody.closed);custody.f.events.push({type:'handoff-inspect'});
+    return Object.freeze({root_binding_current:true,evidence_scope:'W74_W76_ORIGINAL_HOST_SOURCE_ONLY',
+      root_identity_sha256:await readDirectoryIdentity(custody.configuration.backupDirectory),
+      source_directory_identity_sha256:await readDirectoryIdentity(custody.configuration.sourceDataDirectory)});
+  },
+  closeOriginalProtectedRootHandoff:handoff=>{const row=handoffs.get(handoff);assert.ok(row);row.closed=true;},
+  drainOriginalProtectedRootHandoff:async handoff=>{assert.equal(handoffs.get(handoff)?.closed,true);},
+}});
+api=await import(moduleUrl('owned-protected-backup-root.mjs'));
+mainApi=await import(moduleUrl('protected-root-recovery-provider.mjs'));
+const {
+  createOwnedProtectedBackupRootProvider:createProvider,
+  readOwnedProtectedBackupRootConfiguration:readConfiguration,
+  closeOwnedProtectedBackupRootProvider:closeProvider,
+  drainOwnedProtectedBackupRootProvider:drainProvider,
+}=api;
+
+async function fixture(t){
+  const parent=await fs.mkdtemp(path.join(os.tmpdir(),'owned-root-synthetic-'));
+  const stateDirectory=path.join(parent,'state');
+  const sourceDataDirectory=path.join(stateDirectory,'pgdata');
+  const configFile=path.join(parent,'runtime-host-config.json');
+  await fs.mkdir(sourceDataDirectory,{recursive:true,mode:0o700});
+  await fs.writeFile(path.join(sourceDataDirectory,'source-sentinel'),SOURCE_SENTINEL);
+  await fs.writeFile(configFile,JSON.stringify({schema:'SYNTHETIC_HOST_CONFIG',stateDirectory,sourceDataDirectory}));
+  const f={parent,directories:{configFile,stateDirectory,sourceDataDirectory},
+    backupDirectory:path.join(stateDirectory,ROOT_NAME),events:[],tokens:[],mainSessions:[],releases:[],seal:{value:null},
+    canonical:{client_id:randomUUID(),device_id:randomUUID(),key_fingerprint_sha256:'a'.repeat(64),enrolled:true},
+    hostOpen:true,identityOpen:true,readConfigurationHook:null,readRegistrationHook:null,
+    persistRegistrationHook:null,aclHook:null};
+  f.identity=Object.freeze({});identities.set(f.identity,f);
+  f.currentSummary=Object.freeze({instance_id:randomUUID()});summaries.set(f.currentSummary,f);
+  f.provider=()=>{
