+const {bindOwnedRuntimeHostRecoveryComposition}=await import(moduleUrl('local-runtime-recovery-composition.mjs'));
+const {createOwnedProtectedBackupRootProvider:createProvider,readOwnedProtectedBackupRootConfiguration:readConfiguration,
+  closeOwnedProtectedBackupRootProvider:closeProvider,drainOwnedProtectedBackupRootProvider:drainProvider}=api;
+
+async function snapshotTree(parent){
+  const records=[];
+  async function visit(file,relative){
+    const stat=await fs.lstat(file,{bigint:true});
+    const type=stat.isSymbolicLink()?'symlink':stat.isDirectory()?'directory':stat.isFile()?'file':'other';
+    const record={path:relative,type,dev:String(stat.dev),ino:String(stat.ino),birth:String(stat.birthtimeNs),
+      mode:String(stat.mode),size:String(stat.size),mtime:String(stat.mtimeNs),ctime:String(stat.ctimeNs)};records.push(record);
