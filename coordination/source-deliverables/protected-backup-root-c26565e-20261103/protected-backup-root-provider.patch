+import test,{mock} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {createLocalRuntimeRecoveryFixture} from './local-runtime-recovery-fixture.mjs';
+
+let calls=[],hook=null;
+mock.module(new URL('../src/private-windows-storage-acl.mjs',import.meta.url).href,{namedExports:{
+  verifyOwnerOnlyWindowsStorage:async(target,{operation})=>{
+    calls.push({target,operation});
+    if(hook)return hook(target,operation);
+    return {owner_dacl_verified:true,operation};
+  },
+  protectOwnerOnlyWindowsDirectory:async()=>{throw Error('protection forbidden in configuration reader');},
+}});
+async function fixture(t,patch={}){
+  calls=[];hook=null;
+  const f=await createLocalRuntimeRecoveryFixture(t);
+  const configFile=f.config.runtime_host.config_file,sourceDataDirectory=path.join(f.directory,'pgdata');
+  await fs.mkdir(sourceDataDirectory);
+  const value=JSON.parse(await fs.readFile(configFile,'utf8'));
+  await fs.writeFile(configFile,JSON.stringify({...value,schema:'compute.runtime-host-config.v1',version:1,
+    state_directory:f.directory,pg_data_directory:sourceDataDirectory,...patch}));
+  const summary=await f.controller.startConfiguredLocalRuntimeHost(f.startOptions);
+  return {...f,summary,configFile,sourceDataDirectory};
+}
+test('private reader accepts only the exact current Host and retained launch config',async t=>{
+  const f=await fixture(t),read=f.controller.readOriginalOwnedRuntimeHostRecoveryConfiguration;
+  let invoked=0;
+  const proxy=new Proxy(f.summary,{get(){invoked++;throw Error('caller summary forbidden');}});
+  for(const fake of [{...f.summary},{},proxy,null])await assert.rejects(read(fake),/original_host_required/);
+  assert.equal(invoked,0);assert.equal(calls.length,0);
+  assert.deepEqual(await read(f.summary),{configFile:f.configFile,stateDirectory:f.directory,
+    sourceDataDirectory:f.sourceDataDirectory});
+  assert.deepEqual(calls.map(row=>row.operation).sort(),['VERIFY_DIRECTORY','VERIFY_FILE']);
+  const original=await fs.readFile(f.configFile,'utf8');
+  await fs.writeFile(f.configFile,original.replace('pgdata','other-data'));
+  calls=[];
+  await assert.rejects(read(f.summary),/configuration_changed/);
+  assert.equal(calls.length,0,'a new config cannot be adopted by a running child');
+  await f.controller.stopOwnedLocalRuntimeHost({timeoutMs:2000});
+  await assert.rejects(read(f.summary),/original_host_required/);
+});
