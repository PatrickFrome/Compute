+    if(newIdentity){f.identity=Object.freeze({});identities.set(f.identity,f);}
+  };
+  f.assertSourceUnchanged=async()=>{
+    assert.equal(await fs.readFile(path.join(f.directories.sourceDataDirectory,'source-sentinel'),'utf8'),SOURCE_SENTINEL);
+  };
+  fixtures.add(f);
