+
+const clone=value=>value===null?null:structuredClone(value);
+const exists=async file=>fs.lstat(file).then(()=>true,error=>{
+  if(error.code==='ENOENT')return false;
+  throw error;
+});
+const nextTurn=()=>new Promise(resolve=>setImmediate(resolve));
+function deferred(){
+  let resolve,reject;
+  const promise=new Promise((yes,no)=>{resolve=yes;reject=no;});
+  return {promise,resolve,reject};
+}
+function currentSummary(summary){
+  const f=summaries.get(summary);
+  return Boolean(f&&f.currentSummary===summary&&f.hostOpen);
+}
+function currentIdentity(identity){
+  const f=identities.get(identity);
+  return f?.identityOpen&&f.canonical?.enrolled===true?Object.freeze({...f.canonical}):null;
+}
+function originalScope(identity,token){
+  const scope=api.readOriginalProtectedBackupRootRegistrationScope(token);
+  assert.ok(scope,'the fixed provider registry must issue the sealed-storage scope');
+  assert.equal(scope.identity,identity);
+  assert.equal(typeof scope.assertCurrent,'function');
+  scope.assertCurrent();
+  return scope;
+}
+
+mock.module(moduleUrl('local-runtime-host-controller.mjs'),{namedExports:{
+  ownedLocalRuntimeHostReady:currentSummary,
+  readOriginalOwnedNativeHostBinding:capability=>{
+    const row=hostCapabilities.get(capability);
+    return row&&currentSummary(row.summary)?row.binding:null;
+  },
+  readOriginalOwnedRuntimeHostRecoveryConfiguration:async summary=>{
+    assert.equal(currentSummary(summary),true,'only an exact current registered Host may be read');
+    const f=summaries.get(summary);
+    f.events.push({type:'host-configuration'});
+    if(f.readConfigurationHook)return f.readConfigurationHook();
+    return Object.freeze({...f.directories});
+  },
+}});
+mock.module(moduleUrl('supervisor-device-identity.mjs'),{namedExports:{
+  readOriginalLoadedRecoveryIdentityW74:currentIdentity,
+  bindOriginalRecoveryOwnerW74:(identity,session)=>{
+    const f=identities.get(identity);
+    assert.ok(currentIdentity(identity));
+    assert.ok(mainApi.readOriginalMainRecoveryOwnerScope(session));
+    f.events.push({type:'owner-bind'});
+    return ()=>{f.events.push({type:'owner-unbind'});};
+  },
+  readOriginalProtectedBackupRootRegistrationW74:async(identity,token)=>{
+    const scope=originalScope(identity,token),f=identities.get(identity);
+    f.events.push({type:'read-registration'});
+    if(f.readRegistrationHook)await f.readRegistrationHook(scope);
+    scope.assertCurrent();
+    return clone(f.seal.value);
+  },
+  persistOriginalProtectedBackupRootRegistrationW74:async(identity,token)=>{
+    const scope=originalScope(identity,token),f=identities.get(identity);
+    assert.ok(scope.registration&&Object.isFrozen(scope.registration));
+    const registration=clone(scope.registration);
+    const event={type:'persist-registration',registration,rootExists:await exists(f.backupDirectory)};
+    f.events.push(event);
+    if(f.persistRegistrationHook)await f.persistRegistrationHook(scope,event);
+    scope.assertCurrent();
+    // Explicitly synthetic sealed storage. A token, rather than a caller's
+    // JSON/callback, is the only route to the statically imported issuer.
+    f.seal.value=clone(registration);
+  },
+}});
+async function syntheticAcl(target,options={}){
+    const f=[...fixtures].find(row=>
+      [row.directories.stateDirectory,row.directories.sourceDataDirectory,row.backupDirectory].includes(target));
+    assert.ok(f,'an unowned ACL target must never be used');
+    const event={type:'acl',target,operation:options.operation};
+    f.events.push(event);
+    assert.equal(options.operation,'VERIFY_DIRECTORY','the selector must never mutate or repair any DACL');
+    const result=f.aclHook?await f.aclHook(event,options):undefined;
+    return result??Object.freeze({owner_dacl_verified:true,operation:options.operation});
+}
+mock.module(moduleUrl('private-windows-storage-acl.mjs'),{namedExports:{
+  verifyOwnerOnlyWindowsStorage:syntheticAcl,
+  protectOwnerOnlyWindowsDirectory:(target,options={})=>syntheticAcl(target,{...options,operation:'PROTECT_DIRECTORY'}),
+}});
+// These additional doubles isolate only the existing native authority/IPC
+// boundary for the real selector -> real Main-provider integration below.
+mock.module(moduleUrl('native-coding-host-ipc-client.mjs'),{namedExports:{
+  readOriginalNativeCodingRecoveryClientRequest:token=>clientRequests.get(token)??null,
+}});
+mock.module(moduleUrl('host-private-custody-w76.mjs'),{namedExports:{
+  createHostPrivateCustodyW76:({identity,recoveryRootConfiguration})=>{
+    const f=identities.get(identity),custody=Object.freeze({close(){custodies.get(custody).closed=true;}});
+    assert.ok(f);f.events.push({type:'w76-create'});
+    custodies.set(custody,{f,configuration:recoveryRootConfiguration,closed:false,custodyScope:Symbol('SYNTHETIC_W76')});
+    return custody;
+  },
+  readOriginalW76ProtectedRoot:async custody=>{
+    const row=custodies.get(custody);if(!row||row.closed)return null;
+    row.f.events.push({type:'w76-read'});
+    return Object.freeze({owner:row.f.integration.owner,custody_scope:row.custodyScope,
+      backup_directory:row.configuration.backupDirectory,source_directory:row.configuration.sourceDataDirectory,
+      root_identity_sha256:await readDirectoryIdentity(row.configuration.backupDirectory),
+      source_directory_identity_sha256:await readDirectoryIdentity(row.configuration.sourceDataDirectory)});
+  },
+}});
+mock.module(moduleUrl('protected-backup-root-handoff.mjs'),{namedExports:{
+  bindOriginalProtectedRootHandoff:async input=>{
+    const row=custodies.get(input.custody),handoff=Object.freeze({});assert.ok(row&&!row.closed);
+    row.f.events.push({type:'handoff-bind'});handoffs.set(handoff,{...input,closed:false});return handoff;
+  },
+  inspectOriginalProtectedRootHandoff:async input=>{
