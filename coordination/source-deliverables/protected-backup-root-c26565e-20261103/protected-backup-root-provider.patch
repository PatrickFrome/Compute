+  let identity=new Identity({statePath:file,secureStorage:storage});
+  await identity.ensure();await identity.bindDevice(randomUUID());
+  // Preserve arbitrary pre-existing sealed Owner BYTES without interpreting
+  // this generated sentinel as a genuine Owner or binding any Owner custody.
+  const state=JSON.parse(await fs.readFile(file,'utf8'));
