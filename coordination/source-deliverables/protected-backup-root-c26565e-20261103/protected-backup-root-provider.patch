+import path from 'node:path';
+import {randomUUID,randomBytes,createCipheriv,createDecipheriv} from 'node:crypto';
+import {registerHooks} from 'node:module';
+
+const identityUrl = new URL('../src/supervisor-device-identity.mjs',import.meta.url).href;
+const scopeUrl = new URL('../src/owned-protected-backup-root.mjs',import.meta.url).href;
+const syntheticScopeUrl = 'data:text/javascript,'+encodeURIComponent(`
+  const rows=new WeakMap();
+  export function mint(identity,registration=null){const token=Object.freeze({});
+    rows.set(token,{identity,registration,open:true});return token;}
+  export function select(token,registration){rows.get(token).registration=registration;}
+  export function close(token){rows.get(token).open=false;}
+  export function readOriginalProtectedBackupRootRegistrationScope(token){
+    const row=rows.get(token);if(!row?.open)return null;
+    return Object.freeze({identity:row.identity,registration:row.registration,
+      assertCurrent(){if(!row.open)throw Error('synthetic_scope_closed');}});
+  }
+`);
+const scopes = await import(syntheticScopeUrl);
+const hook = registerHooks({resolve(specifier,context,next){
+  const resolved=next(specifier,context);
+  return context.parentURL===identityUrl && resolved.url===scopeUrl
+    ? {url:syntheticScopeUrl,shortCircuit:true} : resolved;
+}});
+let api;
+try {api=await import(identityUrl);} finally {hook.deregister();}
+const {SupervisorDeviceIdentity:Identity,readOriginalProtectedBackupRootRegistrationW74:read,
+  persistOriginalProtectedBackupRootRegistrationW74:persist}=api;
+const {createSimulatedSetupOwnerFixture}=await import('./helpers/native-setup-owner-fixture.mjs');
+
+const FIELD='encrypted_protected_backup_root_record_b64';
+const HASH_A='a'.repeat(64),HASH_B='b'.repeat(64),HASH_C='c'.repeat(64);
+function syntheticStorage(){
+  const key=randomBytes(32),counts={encrypt:0,decrypt:0};
+  return {
+    counts,onEncrypt:null,onDecrypt:null,
+    isEncryptionAvailable:()=>true,
+    encryptString(value){
+      counts.encrypt++;this.onEncrypt?.();
+      const iv=randomBytes(12),cipher=createCipheriv('aes-256-gcm',key,iv);
+      const bytes=Buffer.concat([cipher.update(value,'utf8'),cipher.final()]);
+      return Buffer.concat([iv,cipher.getAuthTag(),bytes]);
+    },
+    decryptString(value){
+      counts.decrypt++;this.onDecrypt?.();
+      const bytes=Buffer.from(value),decipher=createDecipheriv('aes-256-gcm',key,bytes.subarray(0,12));
+      decipher.setAuthTag(bytes.subarray(12,28));
+      return Buffer.concat([decipher.update(bytes.subarray(28)),decipher.final()]).toString('utf8');
+    },
+  };
