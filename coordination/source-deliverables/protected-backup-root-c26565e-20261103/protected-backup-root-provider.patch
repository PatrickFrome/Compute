+  const f=await fixture(t,{state_directory:path.join(process.cwd(),'unrelated-state')});
+  await assert.rejects(f.controller.readOriginalOwnedRuntimeHostRecoveryConfiguration(f.summary),/configuration_invalid/);
+});
+test('native ACL failure joins the other pending observation before rejection',async t=>{
+  const f=await fixture(t);let release,entered;
+  const started=new Promise(resolve=>{entered=resolve;}),pending=new Promise(resolve=>{release=resolve;});
+  hook=async(_target,operation)=>{
+    if(operation==='VERIFY_DIRECTORY')throw Error('SYNTHETIC_PRIVATE_DETAIL');
+    entered();await pending;return {owner_dacl_verified:true,operation};
+  };
+  let finished=false;
+  const read=f.controller.readOriginalOwnedRuntimeHostRecoveryConfiguration(f.summary);
+  read.then(()=>{finished=true;},()=>{finished=true;});
+  await started;await new Promise(resolve=>setImmediate(resolve));assert.equal(finished,false);
+  release();await assert.rejects(read,/configuration_unprotected/);
+});
+test('Host loss during ACL read refuses a late success and joins both observations',async t=>{
+  const f=await fixture(t);let release,entered;
+  const started=new Promise(resolve=>{entered=resolve;}),pending=new Promise(resolve=>{release=resolve;});
+  hook=async(_target,operation)=>{entered();await pending;return {owner_dacl_verified:true,operation};};
+  const read=f.controller.readOriginalOwnedRuntimeHostRecoveryConfiguration(f.summary);read.catch(()=>{});
+  await started;await f.controller.stopOwnedLocalRuntimeHost({timeoutMs:2000});
+  release();await assert.rejects(read,/generation_changed/);
+});
