+const {SupervisorDeviceIdentity:Identity,readOriginalProtectedBackupRootRegistrationW74:read,
+  persistOriginalProtectedBackupRootRegistrationW74:persist}=api;
+const {createSimulatedSetupOwnerFixture}=await import('./helpers/native-setup-owner-fixture.mjs');
+
+const FIELD='encrypted_protected_backup_root_record_b64';
+const HASH_A='a'.repeat(64),HASH_B='b'.repeat(64),HASH_C='c'.repeat(64);
