+// Isolated synthetic storage/scopes only. No installed key, Guardian, native
+// ACL, PostgreSQL, backup, installer or production proof is used by this suite.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
