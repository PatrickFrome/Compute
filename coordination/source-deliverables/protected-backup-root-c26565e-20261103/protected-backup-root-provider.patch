--- /dev/null
+++ b/apps/metaengine-browser/src/owned-protected-backup-root.mjs
@@ -0,0 +1,169 @@
+// Private selector for the existing W74/W76 recovery authority. Neither a
+// pathname nor the sealed selector is backup/restore or installation evidence.
+// The exact owned Host and already loaded enrolled identity are mandatory.
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {types} from 'node:util';
+import {ownedLocalRuntimeHostReady,readOriginalOwnedRuntimeHostRecoveryConfiguration}
+  from './local-runtime-host-controller.mjs';
+import {readOriginalLoadedRecoveryIdentityW74,readOriginalProtectedBackupRootRegistrationW74}
+  from './supervisor-device-identity.mjs';
+import {readDirectoryIdentity} from './native-coding-fs-identity.mjs';
+import {verifyOwnerOnlyWindowsStorage} from './private-windows-storage-acl.mjs';
+
+const providers=new WeakMap();
+const DEVICE=['client_id','device_id','key_fingerprint_sha256','enrolled'];
+const DIRECTORIES=['configFile','stateDirectory','sourceDataDirectory'];
+const PIN=['schema','state','registration_id','client_id','device_id','key_fingerprint_sha256',
+  'state_directory_identity_sha256','source_directory_identity_sha256','root_identity_sha256'];
+const HASH=/^[a-f0-9]{64}$/;
+const UUID=/^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;
+const fail=reason=>{throw Error('owned_protected_backup_root_'+reason);};
+const same=(a,b,keys)=>!!a&&!!b&&keys.every(key=>a[key]===b[key]);
+const pathKey=value=>process.platform==='win32'?value.toLowerCase():value;
+const samePath=(a,b)=>pathKey(a)===pathKey(b);
+function data(value,keys){
+  if(!value||typeof value!=='object'||types.isProxy(value)
+    ||![Object.prototype,null].includes(Object.getPrototypeOf(value)))fail('exact_data_required');
+  const descriptors=Object.getOwnPropertyDescriptors(value),actual=Reflect.ownKeys(value);
+  if(actual.length!==keys.length||actual.some(key=>typeof key!=='string'||!keys.includes(key)
+    ||!Object.hasOwn(descriptors[key],'value')))fail('exact_data_required');
+  return Object.freeze(Object.fromEntries(keys.map(key=>[key,descriptors[key].value])));
+}
+function canonical(value){
+  if(typeof value!=='string'||value.length<2||value.length>=2048||/[\x00-\x1f\x7f]/.test(value)
+    ||/^(?:\\\\|\/\/)/.test(value)||!path.isAbsolute(value)||path.resolve(value)!==value
+    ||path.normalize(value)!==value||value===path.parse(value).root)fail('directory_invalid');
+  return value;
+}
+function overlap(a,b){
+  const relative=path.relative(pathKey(a),pathKey(b));
+  return relative===''||relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative);
+}
+function current(row){
+  if(row.closed||row.abort.signal.aborted)fail('closed');
+  if(!ownedLocalRuntimeHostReady(row.summary)
+    ||!same(readOriginalLoadedRecoveryIdentityW74(row.identity),row.device,DEVICE))fail('original_authority_changed');
+}
+function close(row){row.closed=true;row.abort.abort();}
+async function directories(row){
+  current(row);
+  const value=data(await readOriginalOwnedRuntimeHostRecoveryConfiguration(row.summary),DIRECTORIES);current(row);
+  for(const key of DIRECTORIES)canonical(value[key]);
+  const root=path.join(value.stateDirectory,'protected-backup-root-v1');
+  if(overlap(root,value.sourceDataDirectory)||overlap(value.sourceDataDirectory,root)
+    ||samePath(value.stateDirectory,value.sourceDataDirectory)
+    ||overlap(value.sourceDataDirectory,value.stateDirectory))fail('source_root_alias');
+  if(row.directories&&!same(value,row.directories,DIRECTORIES))fail('host_configuration_changed');
+  row.directories??=value;
+  return {...value,root};
+}
+async function identities(row,dirs,includeRoot=false){
+  current(row);
+  const targets=[dirs.stateDirectory,dirs.sourceDataDirectory,...(includeRoot?[dirs.root]:[])];
+  // Join all started physical reads and native ACL observations on rejection.
+  const results=await Promise.allSettled(targets.map(target=>readDirectoryIdentity(target)));
+  current(row);
+  if(results.some(result=>result.status!=='fulfilled'||!HASH.test(result.value)))fail('directory_unconfirmed');
+  const values=results.map(result=>result.value);
+  if(new Set(values).size!==values.length)fail('physical_directory_alias');
+  return {state:values[0],source:values[1],root:values[2]};
+}
+async function verify(row,targets){
+  current(row);
+  const observations=await Promise.allSettled(targets.map(target=>
+    verifyOwnerOnlyWindowsStorage(target,{operation:'VERIFY_DIRECTORY',signal:row.abort.signal})));
+  current(row);
+  if(observations.some(result=>result.status!=='fulfilled'
+    ||result.value?.owner_dacl_verified!==true||result.value.operation!=='VERIFY_DIRECTORY'))fail('storage_unverified');
+}
+async function present(root){
+  try{await fs.lstat(root);return true;}catch(error){if(error.code==='ENOENT')return false;throw error;}
+}
+function checkedPin(value){
+  const pin=data(value,PIN);
+  if(pin.schema!=='metaengine.protected-backup-root-selector.v1'||!UUID.test(pin.registration_id)
+    ||!['REGISTERING','READY'].includes(pin.state)||!UUID.test(pin.client_id)||!UUID.test(pin.device_id)
+    ||!HASH.test(pin.key_fingerprint_sha256)||!HASH.test(pin.state_directory_identity_sha256)
+    ||!HASH.test(pin.source_directory_identity_sha256)
+    ||(pin.state==='READY'?!HASH.test(pin.root_identity_sha256):pin.root_identity_sha256!==null))fail('sealed_registration_invalid');
+  return pin;
+}
+function bound(pin,row,measured){
+  if(!same(pin,row.device,['client_id','device_id','key_fingerprint_sha256'])
+    ||pin.state_directory_identity_sha256!==measured.state
+    ||pin.source_directory_identity_sha256!==measured.source)fail('sealed_registration_changed');
+}
+
+export function createOwnedProtectedBackupRootProvider(input){
+  const {identity,summary}=data(input,['identity','summary']);
+  if(types.isProxy(identity)||types.isProxy(summary)||!ownedLocalRuntimeHostReady(summary))fail('original_host_required');
+  const device=readOriginalLoadedRecoveryIdentityW74(identity);
+  if(!device||device.enrolled!==true||!UUID.test(device.client_id)||!UUID.test(device.device_id)
+    ||!HASH.test(device.key_fingerprint_sha256))fail('loaded_identity_required');
+  const token=Object.freeze(Object.create(null,{toJSON:{value(){fail('not_serializable');}}}));
+  providers.set(token,{identity,summary,device,closed:false,abort:new AbortController(),pending:new Set(),
+    reading:false,directories:null});
+  return token;
+}
+
+// Read-only scope. This selector cannot issue REGISTERING/READY, even through
+// the identity class's retained persistence interface. Original parent-namespace
+// custody does not exist, so no production scope supplies a writable record.
+export function readOriginalProtectedBackupRootRegistrationScope(token){
+  const row=providers.get(token);if(!row)return null;
+  try{current(row);return Object.freeze({identity:row.identity,registration:null,
+    assertCurrent:()=>{current(row);}});}catch{return null;}
+}
+
+export function readOwnedProtectedBackupRootConfiguration(token){
+  const row=providers.get(token);if(!row)return Promise.reject(Error('owned_protected_backup_root_original_provider_required'));
+  let work;
+  try{current(row);if(row.reading)fail('concurrent_read_forbidden');row.reading=true;}
+  catch(error){close(row);return Promise.reject(error);}
+  work=Promise.resolve().then(async()=>{
+    try{
+      const dirs=await directories(row),first=await identities(row,dirs);
+      await verify(row,[dirs.stateDirectory,dirs.sourceDataDirectory]);
+      const again=await identities(row,dirs);
+      if(!same(first,again,['state','source']))fail('directory_changed');
+      const raw=await readOriginalProtectedBackupRootRegistrationW74(row.identity,token);current(row);
+      let pin;
+      if(raw!==null){
+        pin=checkedPin(raw);bound(pin,row,first);
+        // A failed/crashed registration is a durable HOLD, never mkdir/retry.
+        if(pin.state!=='READY')fail('registration_incomplete');
+        if(!await present(dirs.root))fail('registered_root_missing');current(row);
+      }else{
+        // Observation is not a lease of the state/identity-store namespaces.
+        // A parent can be swapped after the last read and before either the
+        // REGISTERING persistence or mkdir. No actual original native holder
+        // binds those effects, so refuse BEFORE issuing a registration record,
+        // generating an ID, persisting a seal or creating any directory.
+        fail('original_parent_namespace_custody_required');
+      }
+      await verify(row,[dirs.stateDirectory,dirs.sourceDataDirectory,dirs.root]);
+      const last=await identities(row,dirs,true);bound(pin,row,last);
+      if(last.root!==pin.root_identity_sha256)fail('registered_root_changed');
+      await directories(row);current(row);
+      // Re-read sealed state: a concurrent identity write never becomes a new
+      // root registration. The pin is a selector, not positive effect evidence.
+      const retained=checkedPin(await readOriginalProtectedBackupRootRegistrationW74(row.identity,token));current(row);
+      if(!same(pin,retained,PIN))fail('sealed_registration_changed');
+      return Object.freeze({backupDirectory:dirs.root,sourceDataDirectory:dirs.sourceDataDirectory});
+    }catch(error){
+      close(row);
+      if(/^owned_protected_backup_root_[a-z_]+$/.test(error?.message||''))throw error;
+      throw Error('owned_protected_backup_root_original_read_unconfirmed');
+    }finally{row.reading=false;}
+  });
+  row.pending.add(work);const done=()=>row.pending.delete(work);work.then(done,done);return work;
+}
+export function closeOwnedProtectedBackupRootProvider(token){
+  const row=providers.get(token);if(!row)fail('original_provider_required');close(row);
+}
+export async function drainOwnedProtectedBackupRootProvider(token){
+  const row=providers.get(token);if(!row)fail('original_provider_required');
+  if(!row.closed)fail('close_before_drain');
+  while(row.pending.size)await Promise.allSettled([...row.pending]);
+}
