+      await verify(row,[dirs.stateDirectory,dirs.sourceDataDirectory]);
+      const again=await identities(row,dirs);
+      if(!same(first,again,['state','source']))fail('directory_changed');
+      const raw=await readOriginalProtectedBackupRootRegistrationW74(row.identity,token);current(row);
+      let pin;
+      if(raw!==null){
+        pin=checkedPin(raw);bound(pin,row,first);
+        // A failed/crashed registration is a durable HOLD, never mkdir/retry.
+        if(pin.state!=='READY')fail('registration_incomplete');
+        if(!await present(dirs.root))fail('registered_root_missing');current(row);
+      }else{
+        if(await present(dirs.root))fail('unregistered_root_present');current(row);
+        row.registration=Object.freeze({schema:'metaengine.protected-backup-root-selector.v1',state:'REGISTERING',
+          registration_id:randomUUID(),client_id:row.device.client_id,device_id:row.device.device_id,
+          key_fingerprint_sha256:row.device.key_fingerprint_sha256,state_directory_identity_sha256:first.state,
+          source_directory_identity_sha256:first.source,root_identity_sha256:null});
+        // Persist intent in the EXISTING sealed identity before creating a
+        // directory. Unknown persistence or interrupted creation cannot rotate
+        // the destination or silently consume a new root after restart.
+        await persistOriginalProtectedBackupRootRegistrationW74(row.identity,token);current(row);
+        await directories(row);
+        const beforeCreate=await identities(row,dirs);
+        if(!same(first,beforeCreate,['state','source']))fail('directory_changed');
+        await fs.mkdir(dirs.root,{mode:0o700});current(row); // exclusive; no recursive/adopt/repair
+        const created=await identities(row,dirs,true);
+        if(!same(first,created,['state','source']))fail('directory_changed');
+        // The new child must inherit sufficient protection from the already
+        // verified private state. Never repair a path's DACL: path replacement
+        // could otherwise mutate an existing object before post-check refusal.
+        await verify(row,[dirs.root]);
+        const after=await identities(row,dirs,true);
+        if(!same(created,after,['state','source','root']))fail('directory_changed');
+        await directories(row);current(row);
+        pin=Object.freeze({...row.registration,state:'READY',root_identity_sha256:after.root});
+        row.registration=pin;
+        await persistOriginalProtectedBackupRootRegistrationW74(row.identity,token);current(row);
