+const moduleUrl=name=>new URL('../src/'+name,import.meta.url).href;
+const test=(name,body)=>nodeTest(name,{timeout:15000},body);
+const PREFIX=/^owned_protected_backup_root_/;
+const ROOT_NAME='protected-backup-root-v1';
+const SOURCE_SENTINEL='SYNTHETIC_SOURCE_MUST_REMAIN_UNCHANGED';
