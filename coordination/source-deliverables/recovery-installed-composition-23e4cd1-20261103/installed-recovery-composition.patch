@@ -0,0 +1,72 @@
+// Fixed installed Host composition. Package selection and original request
+// observations do not issue native directory custody; the existing veto stays.
+import path from 'node:path';
+import {readVerifiedOfflineRuntimePackage} from './offline-runtime-bundle.mjs';
+import {readOriginalNativeCodingHostOsScope} from './native-coding-host-os-scope.mjs';
+import {createOriginalRecoveryHostObservation} from './native-coding-recovery-host-observation.mjs';
+import {createNativeCodingHostRecoveryService} from './native-coding-host-recovery-service.mjs';
+
+const fail=reason=>{throw Error('native_recovery_installed_'+reason);};
+const tools=['pg_dump','pg_restore','pg_dumpall','postgres','initdb','pg_ctl','psql'];
+const samePath=(a,b)=>typeof a==='string'&&typeof b==='string'
+  &&(process.platform==='win32'?path.resolve(a).toLowerCase()===path.resolve(b).toLowerCase():path.resolve(a)===path.resolve(b));
+
+function sourceConnection(value){
+  let url;
+  try{url=new URL(value);}catch{fail('protected_connection_invalid');}
+  let username,password;
+  try{username=decodeURIComponent(url.username);password=decodeURIComponent(url.password);}catch{fail('protected_connection_invalid');}
+  const port=Number(url.port);
+  if(!['postgres:','postgresql:'].includes(url.protocol)||url.hostname!=='127.0.0.1'
+    ||url.pathname!=='/postgres'||url.search||url.hash||!['state_owner','postgres'].includes(username)
+    ||!Number.isSafeInteger(port)||port<1024||port>65535||password.length<16||password.length>512
+    ||/[\x00-\x1f\x7f]/.test(password))fail('protected_connection_invalid');
+  return Object.freeze({host:'127.0.0.1',port,database:'postgres',username,password});
+}
+
+export function composeInstalledNativeCodingRecoveryService({config,installedBundle,sql,connect,
+  hostInstanceId,hostPid,postgresIdentity,postgresContinuity,readNativeScope,readPublicationHost,assertHostCurrent}={}){
+  // Runtime Host sets this to null for verifier/entry/image test overrides.
+  // Legacy bundles without the optional pair retain their ordinary PG/API.
+  if(installedBundle===null||installedBundle===undefined)return null;
+  let installed;
+  try{installed=readVerifiedOfflineRuntimePackage(installedBundle);}
+  catch(error){
+    // A substituted verifier cannot convey installed context. Keep this
+    // optional native service unmounted; do not stop the existing PG/API.
+    if(error.code==='offline_bundle_verified_result_required')return null;
+    throw error;
+  }
+  if(installed.preparedJobRuntime===null)return null;
+  if(!installed.preparedJobRuntime||!samePath(installed.bundleDirectory,config?.bundle_directory)
+    ||installed.bundleSha256!==config?.expected_bundle_sha256
+    ||path.basename(installed.bundleDirectory)!=='client-state-runtime'
+    ||!samePath(installedBundle.paths?.postgresBinDirectory,path.join(installed.bundleDirectory,'runtime','postgresql','bin')))
+    fail('original_package_required');
+  const original=readOriginalNativeCodingHostOsScope(readNativeScope,readPublicationHost,sql);
+  if(!original||original.host_pid!==process.pid||hostPid!==process.pid
+    ||original.parent_pid!==process.ppid||typeof assertHostCurrent!=='function')fail('original_host_required');
+  if(typeof connect!=='function'||!installed.postgresToolHashes
+    ||tools.some(name=>typeof installed.postgresToolHashes[name]!=='string'
+      ||!/^[a-f0-9]{64}$/.test(installed.postgresToolHashes[name])))fail('original_tool_pins_required');
+  assertHostCurrent();
+  let connection;
+  try{connection=sourceConnection(config.inspect_database_url);}
+  catch(error){
+    // Attached PG may legitimately use another database/login or URL options.
+    // Unsupported recovery scope must not stop that existing PG/API service.
+    if(error.message==='native_recovery_installed_protected_connection_invalid')return null;
+    throw error;
+  }
+  const hostObservation=createOriginalRecoveryHostObservation({sql,sourceDataDirectory:config.pg_data_directory});
+  const service=createNativeCodingHostRecoveryService({sql,hostInstanceId,hostPid,connect,
+    hostObservation,installedBundle,sourceConnection:connection,
+    sourceDataDirectory:config.pg_data_directory,postgresIdentity,postgresContinuity,
+    pgBinDir:path.join(installed.bundleDirectory,'runtime','postgresql','bin'),toolHashes:installed.postgresToolHashes,
+    // These existing synchronous callbacks can only veto Host-generation loss.
+    // Actual Owner and own-PG facts come from the original request observation;
+    // neither callback claims to prove them or to issue directory custody.
+    assertOwnerCurrent:assertHostCurrent,assertKeeperCurrent:assertHostCurrent});
+  try{assertHostCurrent();return service;}
+  catch(error){service.close();throw error;}
+}
