+    hostInstanceId:randomUUID(),hostPid:process.pid,readNativeScope,readPublicationHost,
+    assertHostCurrent(){effects.host++;},postgresIdentity:{pid:process.pid,version:170011,
+      system_identifier:'1234567890123456789',started_at:new Date().toISOString(),data_directory:data,port:15439,address:'127.0.0.1'},
+    postgresContinuity:{schema:'metaengine.client-state.postgres-continuity.v1'}};
+  return {input,effects,snapshot};
+}
+const effectFree=f=>assert.deepEqual({sql:f.effects.sql,connections:f.effects.connections},{sql:0,connections:0});
+
+test('actual fixed service composes without a W76 facade or starting recovery effects',async()=>{
+  const f=fixture(),service=composeInstalledNativeCodingRecoveryService(f.input);
+  assert.ok(service);assert.deepEqual(Object.keys(service.operations).sort(),[...NATIVE_RECOVERY_ACTIONS].sort());
