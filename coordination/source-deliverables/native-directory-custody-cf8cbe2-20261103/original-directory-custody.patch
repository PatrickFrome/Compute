+// Source-only native mechanics against an isolated, deliberately modeled OS.
+// No authenticated issuer, Windows kernel, real recovery or database is used.
+import assert from 'node:assert/strict';
+import {execFileSync, spawnSync} from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import test from 'node:test';
+import {fileURLToPath} from 'node:url';
+
+const fixture=fileURLToPath(new URL('./native/recovery-directory-handles-synthetic/',import.meta.url));
+const native=fileURLToPath(new URL('../native/browser-guardian-scm/',import.meta.url));
+
+test('actual recovery directory mechanics retain original objects against a simulated Win32 boundary',{
+  skip:process.platform==='linux'?false:'Linux source model; Windows qualification is separate',
+  timeout:90_000,
+},t=>{
+  const temporary=fs.mkdtempSync(path.join(os.tmpdir(),'recovery-directory-handles-model-'));
+  try{
+    const executable=path.join(temporary,'recovery-directory-handles-model');
+    execFileSync('g++',['-std=c++20','-Wall','-Wextra','-Werror','-pthread',
+      '-I',fixture,'-I',native,path.join(fixture,'core.cpp'),
+      path.join(native,'recovery-directory-handles.cpp'),'-o',executable],
+    {cwd:temporary,encoding:'utf8',timeout:60_000});
+    const names=JSON.parse(execFileSync(executable,['--list'],{encoding:'utf8',timeout:5_000}));
+    assert.ok(names.length>=15,'the model must exercise independent adversarial scenarios');
+    assert.equal(new Set(names).size,names.length,'duplicate native scenarios');
+    for(const required of ['swap_after_last_check_is_denied_without_another_check',
+      'preexisting_attribute_only_handle_cannot_convert_retained_nonempty_directory',
+      'fixed_child_create_uses_retained_parent_and_same_returned_object',
+      'pending_native_create_cancellation_joins_late_completion',
+      'post_create_allocation_exception_quarantines_original_child',
+      'worker_transfer_check_allocation_exception_preserves_originals_without_deadlock',
+      'partial_worker_transfer_quarantines_originals_and_preserves_remote_copy',
+      'worker_duplicates_survive_holder_crash_until_original_process_exit',
+      'namespace_cannot_expand_after_original_worker_transfer',
+      'late_callback_retains_handles_after_worker_join'])assert.ok(names.includes(required),required);
+    const rows=[];
+    for(const name of names){
+      // Each case starts a fresh model process. Unknown native work remains
+      // quarantined; a later case cannot reset and adopt the old scope.
+      const result=spawnSync(executable,[name],{cwd:temporary,encoding:'utf8',timeout:5_000});
+      assert.ifError(result.error);
+      assert.equal(result.status,0,`${name}: ${result.stdout}${result.stderr}`);
+      const output=result.stdout.trim().split(/\r?\n/).filter(Boolean).map(line=>JSON.parse(line));
+      assert.equal(output.length,1,'each fresh process must report exactly its selected case');
+      assert.equal(output[0].name,name);rows.push(output[0]);
+    }
+    for(const row of rows){
+      assert.equal(row.state,'PASS',JSON.stringify(row));
+      assert.equal(row.runtime,'SYNTHETIC_NATIVE_MECHANICS');
+      assert.equal(row.windows_native_execution,'NOT_RUN');
+      assert.equal(row.original_creation_proof,false);
+      assert.equal(row.physical_authority,false);
+      assert.equal(row.authority_effect,false);
+      t.diagnostic(JSON.stringify(row));
+    }
+    t.diagnostic(JSON.stringify({runtime:'SYNTHETIC_NATIVE_MECHANICS',tests_passed:rows.length,
+      tests_failed:0,windows_native_execution:'NOT_RUN',original_creation_proof:false,
+      physical_authority:false,authority_effect:false}));
+  }finally{fs.rmSync(temporary,{recursive:true,force:true});}
+});
diff --git a/infra/client-state-runtime/README-recovery-directory-custody.md b/infra/client-state-runtime/README-recovery-directory-custody.md
