+NTSTATUS NTAPI modeledNtCreateFile(PHANDLE returned,ACCESS_MASK access,POBJECT_ATTRIBUTES attributes,
+    PIO_STATUS_BLOCK status,PLARGE_INTEGER,ULONG fileAttributes,ULONG share,ULONG disposition,
+    ULONG options,PVOID,ULONG){
+    using namespace model;
+    ++world.creates;
+    if(!returned||!attributes||!attributes->ObjectName||!status||disposition!=2||
+        !(options&1)||!(options&0x20)||!(attributes->Attributes&0x1000U))return invalid_status;
+    const auto parent=lookup(attributes->RootDirectory);
+    if(!parent||parent->kind!=Kind::File||!(parent->open->node->attributes&FILE_ATTRIBUTE_DIRECTORY)||
+        (parent->open->node->attributes&FILE_ATTRIBUTE_REPARSE_POINT))return denied_status;
+    if(world.on_nt_create)world.on_nt_create();
+    const auto name=attributes->ObjectName;
+    const std::wstring leaf(name->Buffer,name->Length/sizeof(wchar_t));
+    if(leaf.empty()||leaf.find_first_of(L"\\/:")!=std::wstring::npos||leaf==L"."||leaf==L".."||leaf.find(L'\0')!=std::wstring::npos)return invalid_status;
+    ++world.relative_creates;
+    const auto path=parent->open->node->path+L"\\"+leaf;
+    if(named(path)){status->Status=collision_status;status->Information=0;return collision_status;}
+    const auto child=nodeAt(path,true);child->attributes=fileAttributes;
+    child->metadata_denied=world.created_metadata_denied;
+    *returned=open(child,access,share);
+    if(!live(*returned))return denied_status;
+    status->Information=2;
+    if(world.pending_create){status->Status=pending_status;world.pending.push_back({status,*returned,false});return pending_status;}
+    status->Status=0;return 0;
+}
