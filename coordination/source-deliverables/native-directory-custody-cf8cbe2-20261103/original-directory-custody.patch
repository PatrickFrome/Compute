+constexpr std::size_t maximum_directories = 128;
+constexpr std::size_t maximum_workers = 256;
+constexpr std::size_t maximum_operations = 4096;
+constexpr DWORD volume_name_guid = 1U;
+constexpr NTSTATUS status_pending = static_cast<NTSTATUS>(0x103);
+
+bool deny(std::string* failure,const char* reason) noexcept {
+    if (failure) {
+        try {*failure = std::string("recovery_directory_handles_") + reason;}
+        catch (...) {failure->clear();}
+    }
+    return false;
+}
+bool valid(HANDLE value) { return value && value != INVALID_HANDLE_VALUE; }
+
+struct Handle final {
+    HANDLE value = nullptr;
+    Handle() = default;
+    explicit Handle(HANDLE handle) noexcept : value(handle) {}
+    ~Handle() { if (valid(value)) CloseHandle(value); }
+    Handle(const Handle&) = delete;
+    Handle& operator=(const Handle&) = delete;
+    Handle(Handle&& other) noexcept : value(std::exchange(other.value,nullptr)) {}
+    Handle& operator=(Handle&& other) noexcept {
+        if (this != &other) {
+            if (valid(value)) CloseHandle(value);
+            value = std::exchange(other.value,nullptr);
+        }
+        return *this;
+    }
+    void quarantine() noexcept { value = nullptr; } // OS ownership intentionally survives until process exit.
+    bool close() noexcept {
+        if (!valid(value)) return true;
+        if (!CloseHandle(value)) return false;
+        value = nullptr;
+        return true;
+    }
+};
+
+template<class Function> Function native(const wchar_t* module,const char* name) {
+    Function function = nullptr;
+    const auto library = GetModuleHandleW(module);
+    const auto address = library ? GetProcAddress(library,name) : nullptr;
+    static_assert(sizeof(function) == sizeof(address));
+    std::memcpy(&function,&address,sizeof(function));
+    return function;
+}
+bool sameObject(HANDLE left,HANDLE right) {
+    using Compare = BOOL(WINAPI*)(HANDLE,HANDLE);
+    const auto compare = native<Compare>(L"kernelbase.dll","CompareObjectHandles");
+    return valid(left) && valid(right) && compare && compare(left,right);
+}
+Handle duplicate(HANDLE original) {
+    HANDLE raw = nullptr;
+    if (!valid(original) || !DuplicateHandle(GetCurrentProcess(),original,GetCurrentProcess(),
+        &raw,0,FALSE,DUPLICATE_SAME_ACCESS)) return {};
+    Handle result(raw);
+    return sameObject(original,result.value) ? std::move(result) : Handle{};
+}
+std::uint64_t ticks(FILETIME value) {
+    return (std::uint64_t{value.dwHighDateTime} << 32U) | value.dwLowDateTime;
+}
+
+std::size_t volumeRootLength(const std::wstring& path) {
+    const std::wstring prefix = L"\\\\?\\Volume{";
+    if (!path.starts_with(prefix)) return 0;
+    const auto end = path.find(L"}\\",prefix.size());
+    if (end == std::wstring::npos || end - prefix.size() != 36) return 0;
+    const auto length = end + 2;
+    if (path.size() > length && path.back() == L'\\') return 0;
+    std::size_t begin = length;
+    while (begin < path.size()) {
+        const auto next = path.find(L'\\',begin);
+        const auto part = path.substr(begin,next == std::wstring::npos ? next : next-begin);
+        if (part.empty() || part == L"." || part == L".." || part.find_first_of(L"/:") != std::wstring::npos)
+            return 0;
+        if (next == std::wstring::npos) break;
+        begin = next + 1;
+    }
+    return length;
+}
+std::optional<std::wstring> parentPath(const std::wstring& path) {
+    const auto root = volumeRootLength(path);
+    if (!root || path.size() <= root) return {};
+    const auto split = path.find_last_of(L'\\');
+    if (split == std::wstring::npos) return {};
+    return path.substr(0,split < root ? root : split);
+}
+
+struct Metadata final {
+    RecoveryDirectoryIdentity identity;
+    bool directory = false;
+};
+bool equalIdentity(const RecoveryDirectoryIdentity& left,const RecoveryDirectoryIdentity& right) {
+    return left.volume_id == right.volume_id && left.file_id == right.file_id
+        && left.birth_time_100ns == right.birth_time_100ns && left.native_volume_id == right.native_volume_id
+        && left.native_file_id == right.native_file_id && left.canonical_volume_path == right.canonical_volume_path;
+}
+bool metadata(HANDLE original,int required_kind,Metadata* output) {
+    if (!output || !valid(original) || GetFileType(original) != FILE_TYPE_DISK) return false;
+    FILE_ATTRIBUTE_TAG_INFO tag{},after_tag{};
+    FILE_ID_INFO id{};
+    FILE_STANDARD_INFO standard{};
+    BY_HANDLE_FILE_INFORMATION basic{};
+    if (!GetFileInformationByHandleEx(original,FileAttributeTagInfo,&tag,sizeof(tag))
+        || (tag.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)
+        || !GetFileInformationByHandleEx(original,FileIdInfo,&id,sizeof(id))
+        || !GetFileInformationByHandleEx(original,FileStandardInfo,&standard,sizeof(standard))
+        || standard.DeletePending || !GetFileInformationByHandle(original,&basic)) return false;
+    const bool directory = (tag.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+    if ((required_kind >= 0 && directory != (required_kind == 1))
+        || directory != (standard.Directory != FALSE)
+        || (!directory && (standard.NumberOfLinks != 1 || basic.nNumberOfLinks != 1))) return false;
+    if (directory) {
+        FILE_CASE_SENSITIVE_INFO sensitive{};
+        // Unsupported information classes refuse; no path/case fallback.
+        if (!GetFileInformationByHandleEx(original,FileCaseSensitiveInfo,&sensitive,sizeof(sensitive))
+            || (sensitive.Flags & FILE_CS_FLAG_CASE_SENSITIVE_DIR)) return false;
+    }
+    std::wstring path(32768,L'\0');
+    const auto count = GetFinalPathNameByHandleW(original,path.data(),static_cast<DWORD>(path.size()),
+        FILE_NAME_NORMALIZED | volume_name_guid);
+    if (!count || count >= path.size()) return false;
+    path.resize(count);
+    if (!volumeRootLength(path) || !GetFileInformationByHandleEx(original,FileAttributeTagInfo,&after_tag,sizeof(after_tag))
+        || after_tag.FileAttributes != tag.FileAttributes || after_tag.ReparseTag != tag.ReparseTag) return false;
+    Metadata result;
+    result.directory = directory;
+    result.identity.volume_id = basic.dwVolumeSerialNumber;
+    result.identity.file_id = (std::uint64_t{basic.nFileIndexHigh} << 32U) | basic.nFileIndexLow;
+    result.identity.birth_time_100ns = ticks(basic.ftCreationTime);
+    result.identity.native_volume_id = id.VolumeSerialNumber;
+    std::copy(std::begin(id.FileId.Identifier),std::end(id.FileId.Identifier),result.identity.native_file_id.begin());
+    result.identity.canonical_volume_path = std::move(path);
+    if (!result.identity.file_id || !result.identity.birth_time_100ns
+        || std::all_of(result.identity.native_file_id.begin(),result.identity.native_file_id.end(),
+            [](unsigned char value){return value == 0;})) return false;
+    *output = std::move(result);
+    return true;
+}
+
+struct OriginalObject final {
+    HANDLE observed = nullptr; // Original issuer's handle; never reopened by numeric lookup/path.
+    Handle original;
+    Handle held;
+    Handle comparison;
+    Metadata captured;
+    void quarantine() noexcept { original.quarantine();held.quarantine();comparison.quarantine(); }
+    bool close() noexcept { return comparison.close() && held.close() && original.close(); }
+};
+bool exact(const OriginalObject& object) {
+    Metadata source,current;
+    return sameObject(object.observed,object.original.value) && sameObject(object.held.value,object.comparison.value)
+        && metadata(object.original.value,object.captured.directory ? 1 : 0,&source)
+        && metadata(object.held.value,object.captured.directory ? 1 : 0,&current)
+        && equalIdentity(source.identity,object.captured.identity)
+        && equalIdentity(current.identity,object.captured.identity);
+}
+bool capture(HANDLE original,int kind,OriginalObject* output) {
+    if (!output) return false;
+    OriginalObject result;
+    result.observed = original;
+    result.original = duplicate(original);
+    if (!valid(result.original.value) || !metadata(result.original.value,kind,&result.captured)) return false;
+    // Object-relative strengthening, not a by-name reacquisition. ReOpenFile
+    // creates a distinct open description: compare its PHYSICAL tuple to the
+    // still-retained original, then CompareObjectHandles only its duplicates.
+    result.held = Handle(ReOpenFile(result.original.value,FILE_READ_ATTRIBUTES | READ_CONTROL | SYNCHRONIZE,
+        FILE_SHARE_READ,FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS));
+    result.comparison = duplicate(result.held.value);
+    if (!exact(result)) return false;
+    *output = std::move(result);
+    return true;
+}
+bool captureCreated(Handle* original,OriginalObject* output) {
+    if (!output || !original || !valid(original->value)) return false;
+    OriginalObject result;
+    result.observed = original->value;
+    // Leave the successful native-create handle owned by the caller until
+    // every post-effect observation succeeds. Metadata/duplicate failure must
+    // not close the only retained original before UNKNOWN is quarantined.
+    result.original = duplicate(original->value);
+    result.held = duplicate(result.original.value);
+    result.comparison = duplicate(result.held.value);
+    if (!metadata(result.original.value,1,&result.captured) || !exact(result)) return false;
+    result.original = std::move(*original);
+    *output = std::move(result);
+    return true;
+}
+struct Directory final {
+    OriginalObject object;
+    std::optional<OriginalObject> anchor;
+    void quarantine() noexcept { object.quarantine();if(anchor)anchor->quarantine(); }
+    bool close() noexcept { return (!anchor || anchor->close()) && object.close(); }
+};
+bool directAnchor(const Directory& directory,const OriginalObject& anchor) {
+    const auto parent = parentPath(anchor.captured.identity.canonical_volume_path);
+    return parent && *parent == directory.object.captured.identity.canonical_volume_path
+        && !equalIdentity(directory.object.captured.identity,anchor.captured.identity);
+}
+bool correlation(const RecoveryDirectoryBinding& value) {
+    const auto text = [](const std::string& item){
+        return !item.empty() && item.size() <= 128 && std::all_of(item.begin(),item.end(),
+            [](unsigned char c){return c >= 0x21 && c <= 0x7e;});
+    };
+    return text(value.original_job_id) && text(value.owner_id) && text(value.host_instance_id)
+        && value.owner_epoch && value.owner_generation && value.host_generation && value.host_pid;
+}
