+        require(first->completeOperation(*a,&f.failure)&&second->completeOperation(*b,&f.failure),"exact_scope_ticket_could_not_join");
+        require(first->drain(&f.failure)&&second->drain(&f.failure),"exact_scope_joins_did_not_drain");
+    }},
+    {"reused_observed_handle_with_equal_pid_and_birth_is_not_original_worker",[]{
+        Fixture f;auto held=f.retain();Worker worker;
+        auto ticket=held->retainOriginalWorker(worker.process_handle,worker.job_handle,&f.failure);
+        require(ticket!=nullptr,"worker_registration_failed");
+        const auto raw=worker.process_handle;require(CloseHandle(raw),"observed_handle_close_failed");
+        auto impostor=std::make_shared<model::Process>();impostor->pid=worker.process->pid;impostor->birth=worker.process->birth;
+        auto object=std::make_shared<model::Object>();object->kind=model::Kind::Process;object->process=impostor;
+        model::process(model::main_pid)->next_handle=reinterpret_cast<std::uintptr_t>(raw);
+        require(model::put(object)==raw,"numeric_handle_reuse_control_failed");
+        require(!held->checkOriginals(&f.failure)&&held->revoked(),"numeric_handle_pid_birth_clone_replaced_original_worker");
+        require(!held->joinOriginalWorker(*ticket,&f.failure),"cloned_handle_was_claimed_original_join");
+        require(!held->drain(&f.failure),"unresolved_original_worker_released_namespace");
+    }},
+};}
+void emit(const char* name,bool passed,const std::string& reason={}){
+    // Error messages are fixed model assertions and native reason identifiers.
+    // No filesystem path, runtime credential or genuine authority is reported.
+    std::cout<<"{\"name\":\""<<name<<"\",\"state\":\""<<(passed?"PASS":"FAIL")
+        <<"\",\"runtime\":\"SYNTHETIC_NATIVE_MECHANICS\",\"windows_native_execution\":\"NOT_RUN\","
+        <<"\"original_creation_proof\":false,\"physical_authority\":false,\"authority_effect\":false";
+    if(!reason.empty()){
+        std::cout<<",\"reason\":\"";
+        for(const char ch:reason){if(ch=='\\'||ch=='\"')std::cout<<'\\';if(ch>=' ')std::cout<<ch;}
+        std::cout<<'\"';
+    }
+    std::cout<<"}\n";
+}
+}
+
+int main(int argc,char** argv){
+    const auto cases=tests::cases();
+    if(argc==2&&std::string_view(argv[1])=="--list"){
+        std::cout<<'[';
+        for(std::size_t i=0;i<cases.size();++i){if(i)std::cout<<',';std::cout<<'\"'<<cases[i].first<<'\"';}
+        std::cout<<"]\n";return 0;
+    }
+    if(argc!=2)return 2;
+    const auto selected=std::find_if(cases.begin(),cases.end(),[&](const auto& entry){return entry.first==std::string_view(argv[1]);});
+    if(selected==cases.end())return 2;
+    try{selected->second();tests::emit(selected->first,true);return 0;}
+    catch(const std::exception& error){tests::emit(selected->first,false,error.what());return 1;}
+}
