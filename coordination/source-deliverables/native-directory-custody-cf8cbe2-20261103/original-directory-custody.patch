@@ -0,0 +1,109 @@
+// Original-request prerequisite only. This module does not issue directory
+// custody, allocate a token, open a helper or own cleanup resources. Genuine
+// native acquisition remains unavailable behind the fixed custody refusal.
+import {types} from 'node:util';
+import {readOriginalNativeCodingRecoveryJob} from './native-coding-host-recovery-lifetime.mjs';
+import {readOriginalNativeCodingRecoveryServerRequest} from './native-coding-host-ipc.mjs';
+import {readOriginalRecoveryRootPhase} from '../../apps/metaengine-browser/src/native-coding-recovery-root-phase.mjs';
+import {NATIVE_RECOVERY_ACTION} from '../../apps/metaengine-browser/src/native-coding-recovery-contract.mjs';
+import {nativePhysicalSettlementUnconfirmed,markNativePhysicalSettlementUnconfirmed}
+  from '../../apps/metaengine-browser/src/native-coding-host-settlement.mjs';
+import {requireOriginalRecoveryDirectoryCustody} from './native-coding-recovery-directory-custody.mjs';
+
+const INPUT=['originalJob','signal','deadlineAt'];
+const JOB=['request','signal','deadlineAt','assertCurrent'];
+const SERVER=['binding','assertCurrent'];
+const BINDING=['instance_id','host_pid','request_id','action','request_sha256','body_sha256'];
+const REQUEST=['signal','deadlineAt','instanceId','hostPid','requestId','action','requestDigest','bodyDigest','recoveryRootPhase'];
+const UUID=/^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;
