+struct RecoveryDirectoryHandles::State final {
+    using Handle = recovery_directory_detail::Handle;
+    using Directory = recovery_directory_detail::Directory;
+    struct Operation final { const OperationTicket* ticket = nullptr;bool joined = false; };
+    struct Remote final { HANDLE source = nullptr;HANDLE remote = nullptr; };
+    struct Worker final {
+        const WorkerTicket* ticket = nullptr;
+        HANDLE observed_process = nullptr,observed_job = nullptr;
+        Handle process,process_comparison,job,job_comparison;
+        DWORD pid = 0;
+        std::uint64_t birth = 0;
+        std::vector<Remote> transferred;
+        bool joined = false;
+        void quarantine() noexcept { process.quarantine();process_comparison.quarantine();job.quarantine();job_comparison.quarantine(); }
+        bool close() noexcept { return job_comparison.close() && job.close() && process_comparison.close() && process.close(); }
+    };
+    RecoveryDirectoryBinding correlation;
+    std::vector<Directory> directories;
+    std::vector<Handle> uncertain_creates;
+    std::map<std::uint64_t,Operation> operations;
+    std::map<std::uint64_t,Worker> workers;
+    mutable std::mutex mutex;
+    std::atomic<bool> revoked{false},released{false};
+    bool unknown = false,quarantined = false;
+    std::uint64_t sequence = 0;
+
+    bool pending() const {
+        return std::any_of(operations.begin(),operations.end(),[](const auto& item){return !item.second.joined;})
+            || std::any_of(workers.begin(),workers.end(),[](const auto& item){return !item.second.joined;});
+    }
+    void abandon() noexcept { unknown = true;revoked.store(true); }
+    bool workerObjects(const Worker& row) const {
+        return recovery_directory_detail::sameObject(row.observed_process,row.process.value)
+            && recovery_directory_detail::sameObject(row.process.value,row.process_comparison.value)
+            && recovery_directory_detail::sameObject(row.observed_job,row.job.value)
+            && recovery_directory_detail::sameObject(row.job.value,row.job_comparison.value)
+            && GetProcessId(row.process.value) == row.pid;
+    }
+    bool workerBirth(const Worker& row) const {
+        FILETIME created{},exit{},kernel{},user{};
+        return workerObjects(row) && GetProcessTimes(row.process.value,&created,&exit,&kernel,&user)
+            && recovery_directory_detail::ticks(created) == row.birth;
+    }
+    bool remoteObjects(const Worker& row) const {
+        if (!workerBirth(row) || WaitForSingleObject(row.process.value,0) != WAIT_TIMEOUT) return false;
+        BOOL in_job = FALSE;
+        if (!IsProcessInJob(row.process.value,row.job.value,&in_job) || !in_job) return false;
+        for (const auto& transferred : row.transferred) {
+            HANDLE raw = nullptr;
+            if (!DuplicateHandle(row.process.value,transferred.remote,GetCurrentProcess(),&raw,0,FALSE,DUPLICATE_SAME_ACCESS))
+                return false;
+            Handle copied(raw);
+            if (!recovery_directory_detail::sameObject(transferred.source,copied.value)) return false;
+        }
+        return true;
+    }
+    bool check(bool allow_unanchored,std::string* failure) const {
+        using namespace recovery_directory_detail;
+        if (released.load()) return deny(failure,"released");
+        for (const auto& directory : directories) {
+            if (!exact(directory.object)) return deny(failure,"original_directory_changed");
+            if (!directory.anchor) {
+                if (!allow_unanchored) return deny(failure,"original_direct_child_anchor_required");
+            } else if (!exact(*directory.anchor) || !directAnchor(directory,*directory.anchor)) {
+                return deny(failure,"original_direct_child_anchor_changed");
+            }
+            auto parent = parentPath(directory.object.captured.identity.canonical_volume_path);
+            while (parent) {
+                if (std::none_of(directories.begin(),directories.end(),[&](const Directory& held){
+                    return held.object.captured.identity.canonical_volume_path == *parent;
+                })) return deny(failure,"original_ancestor_required");
+                parent = parentPath(*parent);
+            }
+        }
+        return true;
+    }
+    bool current(std::string* failure) {
+        using namespace recovery_directory_detail;
+        if (revoked.load() || unknown || quarantined) return deny(failure,"revoked");
+        try {
+            if (!check(false,failure)) { revoked.store(true);return false; }
+            for (const auto& item : workers) {
+                if (!item.second.joined && !remoteObjects(item.second)) {
+                    revoked.store(true);return deny(failure,"original_worker_custody_changed");
+                }
+            }
+        } catch (...) {
+            abandon();return deny(failure,"original_observation_unknown");
+        }
+        // A native observation may have raced synchronous cancellation. This
+        // is the final liveness fence, not an admission flag.
+        if (revoked.load() || unknown || quarantined) return deny(failure,"revoked");
+        return true;
+    }
+    bool closeAll() noexcept {
+        for (auto& item : workers) if (!item.second.close()) return false;
+        for (auto& item : directories) if (!item.close()) return false;
+        for (auto& item : uncertain_creates) if (!item.close()) return false;
+        released.store(true);
+        return true;
+    }
+    ~State() {
+        // A destructor is not an original physical join. Keep actual native
+        // opens alive until process exit when their remaining work is unknown.
+        if (unknown || quarantined || pending()) {
+            for (auto& item : workers) item.second.quarantine();
+            for (auto& item : directories) item.quarantine();
+            for (auto& item : uncertain_creates) item.quarantine();
+        }
+    }
+};
+
+RecoveryDirectoryHandles::OperationTicket::OperationTicket(std::shared_ptr<State> state,std::uint64_t id)
+    : state_(std::move(state)),id_(id) {}
+RecoveryDirectoryHandles::OperationTicket::~OperationTicket() {
+    if (!state_) return;
+    std::lock_guard lock(state_->mutex);
+    const auto found = state_->operations.find(id_);
+    if (found != state_->operations.end() && found->second.ticket == this && !found->second.joined) state_->abandon();
+}
+RecoveryDirectoryHandles::WorkerTicket::WorkerTicket(std::shared_ptr<State> state,std::uint64_t id)
+    : state_(std::move(state)),id_(id) {}
+RecoveryDirectoryHandles::WorkerTicket::~WorkerTicket() {
+    if (!state_) return;
+    std::lock_guard lock(state_->mutex);
+    const auto found = state_->workers.find(id_);
+    if (found != state_->workers.end() && found->second.ticket == this && !found->second.joined) state_->abandon();
+}
+RecoveryDirectoryHandles::RecoveryDirectoryHandles(std::shared_ptr<State> state) : state_(std::move(state)) {}
+
+std::unique_ptr<RecoveryDirectoryHandles> RecoveryDirectoryHandles::retainOriginal(
+    const RecoveryDirectoryBinding& binding,std::span<const OriginalRecoveryDirectory> originals,std::string* failure) {
+    using namespace recovery_directory_detail;
+    if (!correlation(binding) || originals.empty() || originals.size() > maximum_directories) {
+        deny(failure,"original_inputs_required");return {};
+    }
+    auto state = std::make_shared<State>();state->correlation = binding;
+    // Reserve before any creation/remote-transfer effect so allocation failure
+    // cannot discard a newly created original or an unrecorded remote copy.
+    state->directories.reserve(maximum_directories);
+    state->uncertain_creates.reserve(maximum_directories);
+    for (const auto& original : originals) {
+        Directory entry;
+        OriginalObject anchor;
+        if (!capture(original.directory,1,&entry.object) || !capture(original.direct_child_anchor,-1,&anchor)) {
+            deny(failure,"original_capture_unavailable");return {};
+        }
+        if (!directAnchor(entry,anchor)) {deny(failure,"original_direct_child_anchor_required");return {};}
+        entry.anchor.emplace(std::move(anchor));
+        if (std::any_of(state->directories.begin(),state->directories.end(),[&](const Directory& prior){
+            return equalIdentity(prior.object.captured.identity,entry.object.captured.identity)
+                || prior.object.captured.identity.canonical_volume_path == entry.object.captured.identity.canonical_volume_path;
+        })) {deny(failure,"duplicate_original_directory");return {};}
+        state->directories.push_back(std::move(entry));
+    }
+    if (!state->check(false,failure)) return {};
+    return std::unique_ptr<RecoveryDirectoryHandles>(new RecoveryDirectoryHandles(std::move(state)));
+}
+
+RecoveryDirectoryHandles::~RecoveryDirectoryHandles() {
+    revoke();
+    std::lock_guard lock(state_->mutex);
+    if (state_->unknown || state_->pending()) state_->quarantined = true;
+    else if (!state_->closeAll()) state_->abandon();
+}
+bool RecoveryDirectoryHandles::checkOriginals(std::string* failure) const {
+    std::lock_guard lock(state_->mutex);return state_->current(failure);
+}
+std::size_t RecoveryDirectoryHandles::directoryCount() const {
+    std::lock_guard lock(state_->mutex);return state_->directories.size();
+}
+std::optional<RecoveryDirectoryIdentity> RecoveryDirectoryHandles::identity(std::size_t index) const {
+    std::lock_guard lock(state_->mutex);
+    if (state_->released.load() || index >= state_->directories.size()) return {};
+    return state_->directories[index].object.captured.identity;
+}
+RecoveryDirectoryBinding RecoveryDirectoryHandles::binding() const {
+    std::lock_guard lock(state_->mutex);return state_->correlation;
+}
