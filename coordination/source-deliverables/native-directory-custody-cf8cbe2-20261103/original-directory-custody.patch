+DWORD expanded(DWORD access){
+    DWORD result=access;
+    if(access&(GENERIC_READ|GENERIC_ALL))result|=FILE_READ_DATA|FILE_READ_EA|FILE_READ_ATTRIBUTES|READ_CONTROL;
+    if(access&(GENERIC_WRITE|GENERIC_ALL))result|=FILE_WRITE_DATA|FILE_APPEND_DATA|FILE_WRITE_EA|FILE_WRITE_ATTRIBUTES;
+    if(access&(GENERIC_EXECUTE|GENERIC_ALL))result|=FILE_EXECUTE;
+    if(access&GENERIC_ALL)result|=DELETE|WRITE_DAC|WRITE_OWNER;
+    return result;
+}
+bool compatible(DWORD desired,DWORD share){
+    const auto access=expanded(desired);
+    return (!(access&(FILE_READ_DATA|FILE_EXECUTE))||(share&FILE_SHARE_READ))&&
+        (!(access&(FILE_WRITE_DATA|FILE_APPEND_DATA))||(share&FILE_SHARE_WRITE))&&
+        (!(access&DELETE)||(share&FILE_SHARE_DELETE));
+}
+bool canOpen(const std::shared_ptr<Node>& node,DWORD access,DWORD share){
+    for(const auto& [pid,p]:world.processes){
+        (void)pid;
+        for(const auto& [raw,object]:p->handles){
+            (void)raw;
+            if(object->kind!=Kind::File||object->open->node!=node)continue;
+            if(!compatible(access,object->open->share)||!compatible(object->open->access,share)){
+                world.error=ERROR_SHARING_VIOLATION;return false;
+            }
+        }
+    }
+    return true;
+}
+HANDLE open(const std::shared_ptr<Node>& node,DWORD access,DWORD share){
+    if(!node){world.error=ERROR_FILE_NOT_FOUND;return INVALID_HANDLE_VALUE;}
+    if(!canOpen(node,access,share))return INVALID_HANDLE_VALUE;
+    auto object=std::make_shared<Object>();object->kind=Kind::File;
+    object->open=std::make_shared<Open>(Open{node,access,share});return put(std::move(object));
+}
+bool live(HANDLE value){return value&&value!=INVALID_HANDLE_VALUE&&lookup(value)!=nullptr;}
+bool directChild(const std::wstring& parent,const std::wstring& child){
+    auto prefix=key(parent);if(prefix.back()!=L'\\')prefix+=L"\\";
+    const auto full=key(child);
+    return full.starts_with(prefix)&&full.size()>prefix.size()&&full.find(L'\\',prefix.size())==std::wstring::npos;
+}
+bool hasChildren(const std::shared_ptr<Node>& parent){
+    for(const auto& [path,node]:world.paths){(void)path;if(directChild(parent->path,node->path))return true;}return false;
+}
+bool rename(const std::wstring& from,const std::wstring& to){
+    const auto original=named(from);
+    if(!original){world.error=ERROR_FILE_NOT_FOUND;return false;}
+    const auto deleting=open(original,DELETE,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE);
+    if(!live(deleting))return false;
+    if(named(to)){CloseHandle(deleting);world.error=ERROR_ALREADY_EXISTS;return false;}
+    const auto old=key(from),prefix=old+L"\\";
+    std::vector<std::shared_ptr<Node>> moving;
+    for(const auto& [path,node]:world.paths)if(path==old||path.starts_with(prefix))moving.push_back(node);
+    for(const auto& node:moving)world.paths.erase(key(node->path));
+    for(const auto& node:moving){node->path=to+node->path.substr(from.size());world.paths[key(node->path)]=node;}
+    CloseHandle(deleting);return true;
+}
+bool junction(const std::wstring& path){
+    const auto node=named(path);
+    if(!node){world.error=ERROR_FILE_NOT_FOUND;return false;}
+    if(hasChildren(node)){world.error=ERROR_DIR_NOT_EMPTY;return false;}
+    const auto writer=open(node,GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE);
+    if(!live(writer))return false;
+    node->attributes|=FILE_ATTRIBUTE_REPARSE_POINT;CloseHandle(writer);return true;
+}
