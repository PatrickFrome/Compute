+std::shared_ptr<Node> nodeAt(const std::wstring& path,bool directory=true,std::string bytes={}){
+    auto node=std::make_shared<Node>();node->path=path;node->bytes=std::move(bytes);
+    node->attributes=directory?FILE_ATTRIBUTE_DIRECTORY:FILE_ATTRIBUTE_NORMAL;
+    node->identity.VolumeSerialNumber=17;
