@@ -0,0 +1,855 @@
+// Actual native mechanical source, simulated OS only. No admission issuer.
+#include "windows.h"
+#include "winternl.h"
+#include "recovery-directory-handles.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <cwctype>
+#include <functional>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace model {
+constexpr DWORD main_pid=1001;
+constexpr NTSTATUS pending_status=0x103;
+constexpr NTSTATUS collision_status=static_cast<NTSTATUS>(0xc0000035U);
+constexpr NTSTATUS invalid_status=static_cast<NTSTATUS>(0xc000000dU);
+constexpr NTSTATUS denied_status=static_cast<NTSTATUS>(0xc0000022U);
+const HANDLE current_process=reinterpret_cast<HANDLE>(static_cast<std::intptr_t>(-2));
+enum class Kind{File,Process,Job,Event};
+struct Node{
+    std::wstring path;
+    std::string bytes;
+    FILE_ID_INFO identity{};
+    std::uint64_t birth=134000000000000001ULL;
+    DWORD attributes=FILE_ATTRIBUTE_DIRECTORY;
+    bool case_sensitive=false,metadata_denied=false;
+};
+struct Open{
+    std::shared_ptr<Node> node;
+    DWORD access=0,share=0;
+};
+struct Process;
+struct Job{std::set<std::shared_ptr<Process>,std::owner_less<std::shared_ptr<Process>>> members;};
+struct Event{bool signaled=false;};
+struct Object{
+    Kind kind=Kind::File;
+    std::shared_ptr<Open> open;
+    std::shared_ptr<Process> process;
+    std::shared_ptr<Job> job;
+    std::shared_ptr<Event> event;
+};
+struct Process{
+    DWORD pid=0;
+    std::uint64_t birth=134000000000000123ULL;
+    bool live=true;
+    std::map<HANDLE,std::shared_ptr<Object>> handles;
+    std::uintptr_t next_handle=0x100;
+};
+struct Pending{
+    IO_STATUS_BLOCK* status=nullptr;
+    HANDLE original=nullptr;
+    bool cancelled=false;
+};
+struct World{
+    DWORD error=ERROR_SUCCESS,current_pid=main_pid;
+    std::uint64_t next_id=1,ticks=0;
+    std::map<std::wstring,std::shared_ptr<Node>> paths;
+    std::map<DWORD,std::shared_ptr<Process>> processes;
+    std::vector<Pending> pending;
+    std::function<void()> on_wait,on_sleep,on_nt_create,on_metadata;
+    bool missing_nt_create=false,pending_create=false,duplicate_denied=false,wrong_file_duplicate=false,
+        compare_denied=false,query_job_denied=false,created_metadata_denied=false,
+        throw_created_metadata=false,throw_worker_copyback=false,process_wait_failed=false;
+    DWORD fail_duplicate_target_pid=0;
+    unsigned target_duplicate_count=0,fail_target_duplicate_at=0;
+    unsigned creates=0,cancel_requests=0,close_before_completion=0,
+        relative_creates=0,duplicate_calls=0,compare_calls=0,waits=0,sleeps=0;
+};
+World world;
+void require(bool value,std::string_view reason){if(!value)throw std::runtime_error(std::string(reason));}
+std::wstring key(std::wstring value){
+    if(value.starts_with(L"\\\\?\\"))value.erase(0,4);
+    while(value.size()>3&&value.back()==L'\\')value.pop_back();
+    std::transform(value.begin(),value.end(),value.begin(),[](wchar_t ch){return std::towlower(ch);});
+    return value;
+}
+std::shared_ptr<Process> process(DWORD pid){
+    const auto found=world.processes.find(pid);return found==world.processes.end()?nullptr:found->second;
+}
+std::shared_ptr<Object> lookup(DWORD pid,HANDLE handle){
+    const auto p=process(pid);if(!p)return {};
+    const auto found=p->handles.find(handle);return found==p->handles.end()?nullptr:found->second;
+}
+std::shared_ptr<Object> lookup(HANDLE handle){return lookup(world.current_pid,handle);}
+std::shared_ptr<Process> processFrom(HANDLE handle){
+    if(handle==current_process)return process(world.current_pid);
+    const auto object=lookup(handle);return object&&object->kind==Kind::Process?object->process:nullptr;
+}
+HANDLE put(const std::shared_ptr<Process>& p,std::shared_ptr<Object> object){
+    if(!p||!p->live){world.error=ERROR_INVALID_HANDLE;return nullptr;}
+    HANDLE value=nullptr;
+    do{value=reinterpret_cast<HANDLE>(p->next_handle++);}while(p->handles.contains(value));
+    p->handles.emplace(value,std::move(object));return value;
+}
