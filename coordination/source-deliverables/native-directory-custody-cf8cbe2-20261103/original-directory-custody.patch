+#pragma once
+
+// INTERNAL kernel mechanics only. There is no authenticated issuer, effect
+// admission, NAPI entry, arbitrary path argument, signing key or wire format.
+// The missing existing native issuer must supply the ORIGINAL objects and
+// bind its actual Owner/Host/request/job authority independently.
+#include <windows.h>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+
+namespace metaengine::guardian {
+
+struct RecoveryDirectoryBinding final {
+    std::string original_job_id;
+    std::string owner_id;
+    std::string host_instance_id;
+    std::uint64_t owner_epoch = 0;
+    std::uint64_t owner_generation = 0;
+    std::uint64_t host_generation = 0;
+    DWORD host_pid = 0;
+    // Correlation ONLY. None of these fields supplies admission or proves an
+    // authenticated original job, Owner, Host or process provenance.
+};
+
+struct RecoveryDirectoryIdentity final {
+    // Raw native observations only, NOT the JS stat identity digest. NT birth
+    // uses the 1601 epoch; JS nanoseconds require separately qualified mapping
+    // and conversion (ticks - 116444736000000000) * 100. No mapping is asserted.
+    // These values are not a path hash, database digest or portable capability.
+    std::uint64_t volume_id = 0;
+    std::uint64_t file_id = 0;
+    std::uint64_t birth_time_100ns = 0;
+    std::uint64_t native_volume_id = 0;
+    std::array<unsigned char,16> native_file_id{};
+    std::wstring canonical_volume_path;
+};
+
+struct OriginalRecoveryDirectory final {
+    HANDLE directory = nullptr;
+    HANDLE direct_child_anchor = nullptr;
+    // Both handles are borrowed ORIGINAL issuer objects, retained by that
+    // issuer until drain. Core duplicates and compares exact opens, then uses
+    // ReOpenFile on each OBJECT with fixed restrictive sharing. It never
+    // reacquires a supplied path. A retained direct child keeps the directory
+    // nonempty, excluding empty-directory reparse conversion.
+};
+
+class RecoveryDirectoryHandles final {
+    struct State;
+public:
+    class OperationTicket final {
+    public:
+        ~OperationTicket();
+        OperationTicket(const OperationTicket&) = delete;
+        OperationTicket& operator=(const OperationTicket&) = delete;
+        OperationTicket(OperationTicket&&) = delete;
+        OperationTicket& operator=(OperationTicket&&) = delete;
+    private:
+        friend class RecoveryDirectoryHandles;
+        OperationTicket(std::shared_ptr<State>,std::uint64_t);
+        std::shared_ptr<State> state_;
+        std::uint64_t id_ = 0;
+    };
+
+    class WorkerTicket final {
+    public:
+        ~WorkerTicket();
+        WorkerTicket(const WorkerTicket&) = delete;
+        WorkerTicket& operator=(const WorkerTicket&) = delete;
+        WorkerTicket(WorkerTicket&&) = delete;
+        WorkerTicket& operator=(WorkerTicket&&) = delete;
+    private:
+        friend class RecoveryDirectoryHandles;
+        WorkerTicket(std::shared_ptr<State>,std::uint64_t);
+        std::shared_ptr<State> state_;
+        std::uint64_t id_ = 0;
+    };
+
+    // Supply every volume-root/ancestor directory needed to resolve the
+    // selected namespaces, each with an original direct child anchor. Missing
+    // ancestry, empty/unanchored objects and unsupported native APIs refuse.
+    static std::unique_ptr<RecoveryDirectoryHandles> retainOriginal(
+        const RecoveryDirectoryBinding&,std::span<const OriginalRecoveryDirectory>,std::string* failure);
+    ~RecoveryDirectoryHandles();
+    RecoveryDirectoryHandles(const RecoveryDirectoryHandles&) = delete;
+    RecoveryDirectoryHandles& operator=(const RecoveryDirectoryHandles&) = delete;
+    RecoveryDirectoryHandles(RecoveryDirectoryHandles&&) = delete;
+    RecoveryDirectoryHandles& operator=(RecoveryDirectoryHandles&&) = delete;
+
+    bool checkOriginals(std::string* failure) const;
+    std::size_t directoryCount() const;
+    std::optional<RecoveryDirectoryIdentity> identity(std::size_t) const;
+    RecoveryDirectoryBinding binding() const;
+
+    // Sole creation operation: NtCreateFile(FILE_CREATE) relative to the
+    // retained original parent; basename is literally protected-backup-root-v1.
+    // There is no open-existing/adopt/repair/delete fallback. The SAME returned
+    // native object is retained, initially UNANCHORED. It does not qualify any
+    // namespace until the original issuer supplies its retained direct child.
+    std::optional<std::size_t> createProtectedBackupRoot(std::size_t parent_index,std::string* failure);
+    bool duplicateOriginalDirectory(std::size_t,HANDLE* output,std::string* failure) const;
+    bool attachOriginalDirectChildAnchor(std::size_t,HANDLE original_child,std::string* failure);
+
+    // Local original callback tickets are not external-worker admission. An
+    // abandoned ticket is terminal unknown. No completion boolean is accepted.
+    std::unique_ptr<OperationTicket> beginOperation(std::string* failure);
+    bool completeOperation(OperationTicket&,std::string* failure);
+    void abandonOperation(OperationTicket&) noexcept;
+
+    // Caller must already own the exact process AND its existing original Job.
+    // Directory+anchor opens are duplicated into that exact process and checked
+    // by duplicate-back + CompareObjectHandles before this ticket is returned.
+    // This does not create/resume a child or prove every descendant received
+    // custody: the absent authenticated issuer/runner must bind ALL effectful
+    // workers before resume. Partial transfer irreversibly revokes this core.
+    // MANDATORY future integration invariant: this core belongs in the native
+    // process that ALREADY OWNS the original Job lifetime. Borrowing an external
+    // prepared helper's Job would keep KILL_ON_JOB_CLOSE alive after that helper
+    // crashes. These mechanical arguments cannot prove that owner placement;
+    // until the actual issuer enforces it, no effect admission may be exposed.
+    std::unique_ptr<WorkerTicket> retainOriginalWorker(HANDLE original_process,HANDLE original_job,std::string* failure);
+    bool joinOriginalWorker(WorkerTicket&,std::string* failure);
+
+    // Revoke is atomic and synchronous even while original native creation is
+    // pending. Drain never treats cancel/timeout as completion: it releases only
+    // after revoke and all exact original tickets have joined, without UNKNOWN.
+    void revoke() noexcept;
+    bool drain(std::string* failure);
+    bool revoked() const noexcept;
+    bool released() const noexcept;
+
+private:
+    explicit RecoveryDirectoryHandles(std::shared_ptr<State>);
+    std::shared_ptr<State> state_;
+};
+
+} // namespace metaengine::guardian
