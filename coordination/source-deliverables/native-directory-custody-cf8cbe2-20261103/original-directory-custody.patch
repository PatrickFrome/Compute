+BOOL DuplicateHandle(HANDLE sourceProcess,HANDLE original,HANDLE destinationProcess,PHANDLE duplicate,DWORD access,BOOL inherit,DWORD options){
+    ++model::world.duplicate_calls;
+    const auto source=model::processFrom(sourceProcess),destination=model::processFrom(destinationProcess);
+    if(!source||!destination||!duplicate||inherit||model::world.duplicate_denied||
+        !(options&DUPLICATE_SAME_ACCESS)||access){SetLastError(ERROR_INVALID_PARAMETER);return FALSE;}
+    const auto found=source->handles.find(original);
+    if(found==source->handles.end()){SetLastError(ERROR_INVALID_HANDLE);return FALSE;}
+    const auto object=found->second;
+    if(model::world.throw_worker_copyback&&source->pid!=model::world.current_pid&&
+        destination->pid==model::world.current_pid&&object->kind==model::Kind::File){
+        model::world.throw_worker_copyback=false;throw std::bad_alloc{};
+    }
+    if(destination->pid==model::world.fail_duplicate_target_pid&&
+        ++model::world.target_duplicate_count==model::world.fail_target_duplicate_at){
+        SetLastError(ERROR_ACCESS_DENIED);return FALSE;
+    }
+    if(model::world.wrong_file_duplicate&&object->kind==model::Kind::File){
+        model::world.wrong_file_duplicate=false;
+        auto substituted=std::make_shared<model::Object>(*object);
+        substituted->open=std::make_shared<model::Open>(*object->open);
+        *duplicate=model::put(destination,substituted);
+    }else *duplicate=model::put(destination,object);
+    if(options&DUPLICATE_CLOSE_SOURCE)source->handles.erase(original);
+    return *duplicate?TRUE:FALSE;
