+std::optional<std::size_t> RecoveryDirectoryHandles::createProtectedBackupRoot(std::size_t parent_index,std::string* failure) {
+    using namespace recovery_directory_detail;
+    using Create = NTSTATUS(NTAPI*)(PHANDLE,ACCESS_MASK,POBJECT_ATTRIBUTES,PIO_STATUS_BLOCK,
+        PLARGE_INTEGER,ULONG,ULONG,ULONG,ULONG,PVOID,ULONG);
+    std::lock_guard lock(state_->mutex);
+    if (!state_->current(failure)) return {};
+    if (parent_index >= state_->directories.size() || state_->directories.size() >= maximum_directories) {
+        deny(failure,"original_parent_required");return {};
+    }
+    if (!state_->workers.empty() || !state_->operations.empty()) {
+        state_->revoked.store(true);deny(failure,"namespace_expansion_after_ticket_forbidden");return {};
+    }
+    const auto create = native<Create>(L"ntdll.dll","NtCreateFile");
+    if (!create) {state_->revoked.store(true);deny(failure,"relative_create_unavailable");return {};}
+    const std::wstring leaf = L"protected-backup-root-v1";
+    UNICODE_STRING name{};name.Buffer = const_cast<PWSTR>(leaf.c_str());
+    name.Length = static_cast<USHORT>(leaf.size()*sizeof(wchar_t));
+    name.MaximumLength = static_cast<USHORT>(name.Length+sizeof(wchar_t));
+    OBJECT_ATTRIBUTES attributes{};attributes.Length = sizeof(attributes);
+    attributes.RootDirectory = state_->directories[parent_index].object.held.value;
+    attributes.ObjectName = &name;attributes.Attributes = 0x40U | 0x1000U; // CASE_INSENSITIVE | DONT_REPARSE.
+    IO_STATUS_BLOCK operation{};operation.Status = status_pending;
+    HANDLE raw = nullptr;
+    if (state_->revoked.load()) {deny(failure,"revoked");return {};}
+    const auto result = create(&raw,FILE_READ_ATTRIBUTES | READ_CONTROL | SYNCHRONIZE,&attributes,&operation,
+        nullptr,FILE_ATTRIBUTE_DIRECTORY,FILE_SHARE_READ,2U,1U | 0x20U | 0x00200000U,nullptr,0);
+    Handle created(raw);
+    Directory child;
+    try {
+    if (result == status_pending) {
+        // Keep the original kernel-owned IO_STATUS_BLOCK and every parent
+        // object in this frame until terminal. Cancellation is not completion.
+        if (valid(created.value)) CancelIoEx(created.value,nullptr);
+        const auto* status = reinterpret_cast<volatile const NTSTATUS*>(&operation.Status);
+        while (*status == status_pending) {
+            const auto wait = valid(created.value) ? WaitForSingleObject(created.value,25) : WAIT_FAILED;
+            if (wait != WAIT_TIMEOUT) Sleep(25);
+        }
+        state_->abandon();
+        if (valid(created.value)) state_->uncertain_creates.push_back(std::move(created));
+        deny(failure,"relative_create_unknown");return {};
+    }
+    if (result != 0 || operation.Status != 0 || operation.Information != 2U || !valid(created.value)) {
+        state_->revoked.store(true);
+        if (valid(created.value)) {state_->abandon();state_->uncertain_creates.push_back(std::move(created));}
+        deny(failure,"exclusive_create_failed");return {};
+    }
+    if (state_->revoked.load()) {
+        state_->abandon();state_->uncertain_creates.push_back(std::move(created));
+        deny(failure,"relative_create_revoked");return {};
+    }
+    if (!captureCreated(&created,&child.object)) {
+        state_->abandon();
+        if (valid(created.value)) state_->uncertain_creates.push_back(std::move(created));
+        deny(failure,"original_created_child_unconfirmed");return {};
+    }
+    const auto parent = parentPath(child.object.captured.identity.canonical_volume_path);
+    if (!parent || *parent != state_->directories[parent_index].object.captured.identity.canonical_volume_path
+        || child.object.captured.identity.canonical_volume_path != *parent + (parent->back()==L'\\' ? L"" : L"\\") + leaf) {
+        state_->abandon();child.quarantine();deny(failure,"original_created_child_changed");return {};
+    }
+    const auto index = state_->directories.size();state_->directories.push_back(std::move(child));
+    // This child is intentionally unanchored. No current operation ticket or
+    // worker can be issued until attachOriginalDirectChildAnchor succeeds.
+    return index;
+    } catch (...) {
+        // Even allocation failure after FILE_CREATE is an irreversible effect
+        // boundary. Preserve whichever original object owns the new child.
+        state_->abandon();
+        // The terminal exception handler itself must not allocate. Dropping
+        // C++ ownership intentionally leaves each raw kernel open alive until
+        // process exit, even if every allocation is now failing.
+        created.quarantine();
+        child.quarantine();
+        deny(failure,"original_created_child_unknown");return {};
+    }
+}
+
+bool RecoveryDirectoryHandles::duplicateOriginalDirectory(std::size_t index,HANDLE* output,std::string* failure) const {
+    using namespace recovery_directory_detail;
+    std::lock_guard lock(state_->mutex);
+    if (!output || index >= state_->directories.size() || state_->revoked.load() || !state_->check(true,failure))
+        return deny(failure,"original_directory_required");
+    auto copy = duplicate(state_->directories[index].object.held.value);
+    if (!valid(copy.value)) return deny(failure,"original_directory_duplicate_failed");
+    if (state_->revoked.load()) return deny(failure,"revoked");
+    *output = std::exchange(copy.value,nullptr);return true;
+}
+bool RecoveryDirectoryHandles::attachOriginalDirectChildAnchor(std::size_t index,HANDLE original_child,std::string* failure) {
+    using namespace recovery_directory_detail;
+    std::lock_guard lock(state_->mutex);
+    if (index >= state_->directories.size() || state_->revoked.load() || !state_->check(true,failure))
+        return deny(failure,"original_directory_required");
+    auto& directory = state_->directories[index];
+    if (directory.anchor) return deny(failure,"original_anchor_immutable");
+    OriginalObject anchor;
+    if (!capture(original_child,-1,&anchor) || !directAnchor(directory,anchor)) {
+        state_->revoked.store(true);return deny(failure,"original_direct_child_anchor_required");
+    }
+    directory.anchor.emplace(std::move(anchor));
+    if (!state_->check(false,failure)) {state_->revoked.store(true);return false;}
+    if (state_->revoked.load()) return deny(failure,"revoked");
+    return true;
+}
+
+std::unique_ptr<RecoveryDirectoryHandles::OperationTicket> RecoveryDirectoryHandles::beginOperation(std::string* failure) {
+    using namespace recovery_directory_detail;
+    std::unique_lock lock(state_->mutex);
+    if (!state_->current(failure)) return {};
+    if (state_->operations.size() >= maximum_operations) {state_->revoked.store(true);deny(failure,"operation_budget");return {};}
+    const auto id = ++state_->sequence;
+    const auto row = state_->operations.emplace(id,State::Operation{}).first;
+    try {
+        auto ticket = std::unique_ptr<OperationTicket>(new OperationTicket(state_,id));
+        row->second.ticket = ticket.get();
+        if (state_->revoked.load()) {
+            row->second.joined = true;deny(failure,"revoked");lock.unlock();return {};
+        }
+        return ticket;
+    } catch (...) {state_->operations.erase(row);throw;}
+}
+bool RecoveryDirectoryHandles::completeOperation(OperationTicket& ticket,std::string* failure) {
+    std::lock_guard lock(state_->mutex);
+    const auto found = state_->operations.find(ticket.id_);
+    if (ticket.state_ != state_ || found == state_->operations.end() || found->second.ticket != &ticket || found->second.joined)
+        return recovery_directory_detail::deny(failure,"original_operation_required");
+    found->second.joined = true;return true;
+}
+void RecoveryDirectoryHandles::abandonOperation(OperationTicket& ticket) noexcept {
+    std::lock_guard lock(state_->mutex);
+    const auto found = state_->operations.find(ticket.id_);
+    if (ticket.state_ == state_ && found != state_->operations.end() && found->second.ticket == &ticket && !found->second.joined)
+        state_->abandon();
+}
+
+std::unique_ptr<RecoveryDirectoryHandles::WorkerTicket> RecoveryDirectoryHandles::retainOriginalWorker(
+    HANDLE original_process,HANDLE original_job,std::string* failure) {
+    using namespace recovery_directory_detail;
+    std::unique_lock lock(state_->mutex);
+    if (!state_->current(failure)) return {};
+    if (state_->workers.size() >= maximum_workers) {state_->revoked.store(true);deny(failure,"worker_budget");return {};}
+    State::Worker worker;
+    worker.observed_process = original_process;worker.observed_job = original_job;
+    worker.process = duplicate(original_process);worker.process_comparison = duplicate(worker.process.value);
+    worker.job = duplicate(original_job);worker.job_comparison = duplicate(worker.job.value);
+    FILETIME created{},exit{},kernel{},user{};BOOL in_job = FALSE;
+    worker.pid = valid(worker.process.value) ? GetProcessId(worker.process.value) : 0;
+    if (!worker.pid || !state_->workerObjects(worker) || !GetProcessTimes(worker.process.value,&created,&exit,&kernel,&user)
+        || WaitForSingleObject(worker.process.value,0) != WAIT_TIMEOUT
+        || !IsProcessInJob(worker.process.value,worker.job.value,&in_job) || !in_job) {
+        state_->revoked.store(true);deny(failure,"original_worker_required");return {};
+    }
+    worker.birth = ticks(created);
+    worker.transferred.reserve(state_->directories.size()*2);
+    const auto id = ++state_->sequence;
+    auto& row = state_->workers.emplace(id,std::move(worker)).first->second;
+    std::unique_ptr<WorkerTicket> ticket;
+    try {ticket.reset(new WorkerTicket(state_,id));}
+    catch (...) {row.joined = true;throw;}
+    row.ticket = ticket.get();
+    try {
+    bool transferred = true;
+    for (const auto& directory : state_->directories) {
+        for (const auto source : {directory.object.held.value,directory.anchor->held.value}) {
+            HANDLE remote = nullptr;
+            if (state_->revoked.load() || !DuplicateHandle(GetCurrentProcess(),source,row.process.value,
+                &remote,0,FALSE,DUPLICATE_SAME_ACCESS)) {transferred = false;break;}
+            row.transferred.push_back(State::Remote{source,remote});
+        }
+        if (!transferred) break;
+    }
+    if (!transferred || !state_->remoteObjects(row) || !state_->check(false,failure) || state_->revoked.load()) {
+        state_->revoked.store(true);
+        if (row.transferred.empty()) row.joined = true;
+        else state_->abandon(); // Keep partial remote copies until exact process/Job joins; no eager remote close.
+        deny(failure,"original_worker_transfer_unconfirmed");
+        lock.unlock();return {};
+    }
+    return ticket;
+    } catch (...) {
+        // Remote effects already recorded in this original row must outlive
+        // observation/allocation failure and every corresponding worker join.
+        state_->abandon();deny(failure,"original_worker_transfer_unknown");
+        lock.unlock();return {};
+    }
+}
+bool RecoveryDirectoryHandles::joinOriginalWorker(WorkerTicket& ticket,std::string* failure) {
+    std::lock_guard lock(state_->mutex);
+    const auto found = state_->workers.find(ticket.id_);
+    if (ticket.state_ != state_ || found == state_->workers.end() || found->second.ticket != &ticket || found->second.joined)
+        return recovery_directory_detail::deny(failure,"original_worker_required");
+    auto& row = found->second;
+    JOBOBJECT_BASIC_ACCOUNTING_INFORMATION accounting{};
+    DWORD exit = STILL_ACTIVE;
+    if (!state_->workerBirth(row) || WaitForSingleObject(row.process.value,0) != WAIT_OBJECT_0
+        || !GetExitCodeProcess(row.process.value,&exit) || exit == STILL_ACTIVE
+        || !QueryInformationJobObject(row.job.value,JobObjectBasicAccountingInformation,&accounting,sizeof(accounting),nullptr)
+        || accounting.ActiveProcesses != 0)
+        return recovery_directory_detail::deny(failure,"original_worker_join_pending");
+    row.joined = true;return true;
+}
+
+void RecoveryDirectoryHandles::revoke() noexcept { state_->revoked.store(true); }
+bool RecoveryDirectoryHandles::drain(std::string* failure) {
+    std::lock_guard lock(state_->mutex);
+    if (!state_->revoked.load()) return recovery_directory_detail::deny(failure,"revoke_before_drain");
+    if (state_->unknown || state_->quarantined) return recovery_directory_detail::deny(failure,"original_finish_unknown");
+    if (state_->pending()) return recovery_directory_detail::deny(failure,"original_join_pending");
+    if (!state_->closeAll()) {state_->abandon();return recovery_directory_detail::deny(failure,"original_close_unconfirmed");}
+    return true;
+}
+bool RecoveryDirectoryHandles::revoked() const noexcept { return state_->revoked.load(); }
+bool RecoveryDirectoryHandles::released() const noexcept { return state_->released.load(); }
+
+} // namespace metaengine::guardian
