--- /dev/null
+++ b/apps/metaengine-browser/test/fixtures/recovery-runner-source-contract.mjs
@@ -0,0 +1,133 @@
+// TEST ONLY: inspect committed C# source and execute its small, unchanged
+// boolean expressions in JavaScript. This is not a C# compiler, native API
+// model, original scope factory, or evidence of Windows execution.
+import assert from 'node:assert/strict';
+
+export function csharpTokens(source){
+  const result=[];let cursor=0;
+  while(cursor<source.length){
+    const start=cursor,ch=source[cursor],next=source[cursor+1];
+    if(/\s/.test(ch)){cursor++;continue;}
+    if(ch==='/'&&next==='/'){cursor=source.indexOf('\n',cursor+2);if(cursor<0)break;continue;}
+    if(ch==='/'&&next==='*'){
+      cursor=source.indexOf('*/',cursor+2);assert.ok(cursor>=0,'unterminated C# comment');cursor+=2;continue;
+    }
+    if(ch==='@'&&next==='"'){
+      cursor+=2;let closed=false;
+      while(cursor<source.length){
+        if(source[cursor]==='"'){
+          if(source[cursor+1]==='"'){cursor+=2;continue;}
+          cursor++;closed=true;break;
+        }
+        cursor++;
+      }
+      assert.ok(closed,'unterminated verbatim C# string');
+      result.push({text:source.slice(start,cursor),kind:'literal',start,end:cursor});continue;
+    }
+    if(ch==='"'||ch==="'"){
+      cursor++;let closed=false;
+      while(cursor<source.length){
+        if(source[cursor]==='\\'){cursor+=2;continue;}
+        if(source[cursor++]===ch){closed=true;break;}
+      }
+      assert.ok(closed,'unterminated C# literal');
+      result.push({text:source.slice(start,cursor),kind:'literal',start,end:cursor});continue;
+    }
+    const identifier=/^[A-Za-z_][A-Za-z0-9_]*/.exec(source.slice(cursor));
+    if(identifier){cursor+=identifier[0].length;result.push({text:identifier[0],kind:'identifier',start,end:cursor});continue;}
+    const number=/^[0-9][A-Za-z0-9_.]*/.exec(source.slice(cursor));
+    if(number){cursor+=number[0].length;result.push({text:number[0],kind:'number',start,end:cursor});continue;}
+    const pair=source.slice(cursor,cursor+2);
+    cursor+=['&&','||','==','!=','<=','>=','=>','++','--','??','+=','-=','<<','>>'].includes(pair)?2:1;
+    result.push({text:source.slice(start,cursor),kind:'punctuation',start,end:cursor});
+  }
+  return result;
+}
+
+export const compactCsharp=source=>csharpTokens(source).map(token=>token.text).join(' ');
+
+export function sourceBlock(source,declaration){
+  const tokens=csharpTokens(source),wanted=csharpTokens(declaration).map(token=>token.text),matches=[];
+  for(let index=0;index<=tokens.length-wanted.length;index++)
+    if(wanted.every((text,offset)=>tokens[index+offset].text===text))matches.push(index);
+  assert.equal(matches.length,1,`one actual ${declaration} declaration required`);
+  const start=matches[0];let open=start+wanted.length;
+  while(open<tokens.length&&tokens[open].text!=='{'){
+    assert.notEqual(tokens[open].text,';',`${declaration} has no method/class body`);open++;
+  }
+  assert.ok(open<tokens.length,`${declaration} body missing`);
+  let depth=1,close=open+1;
+  for(;close<tokens.length;close++){
+    if(tokens[close].text==='{')depth++;
+    else if(tokens[close].text==='}'&&--depth===0)break;
+  }
+  assert.ok(close<tokens.length,`${declaration} body unclosed`);
+  return {header:source.slice(tokens[start].start,tokens[open].start),
+    body:source.slice(tokens[open].end,tokens[close].start),
+    start:tokens[start].start,end:tokens[close].end,bodyStart:tokens[open].end,bodyEnd:tokens[close].start};
+}
+
+export function exactSourcePredicate(source,name){
+  const method=sourceBlock(source,'static bool '+name),signature=method.header.slice(method.header.indexOf('(')+1,method.header.lastIndexOf(')'));
+  const parameters=signature.split(',').map(value=>{
+    const match=/^\s*(bool|long|uint|int)\s+([A-Za-z_][A-Za-z0-9_]*)\s*$/.exec(value);
+    assert.ok(match,`${name} must have only the explicitly modeled scalar parameter types`);
+    return {type:match[1],name:match[2]};
+  });
+  const tokens=csharpTokens(method.body);
+  assert.equal(tokens[0]?.text,'return');assert.equal(tokens.at(-1)?.text,';');
+  const expressionTokens=tokens.slice(1,-1),names=new Set(parameters.map(value=>value.name));
+  for(const token of expressionTokens){
+    if(token.kind==='identifier')assert.ok(names.has(token.text)||['true','false'].includes(token.text),`${name} uses an unmodeled identifier`);
+    else if(token.kind==='number')assert.equal(token.text,'0',`${name} uses an unmodeled numeric literal`);
+    else assert.ok(['(',')','!','&&','||','==','!=','>','<','>=','<='].includes(token.text),`${name} must remain a pure boolean expression`);
+  }
+  assert.ok(expressionTokens.length>0);
+  const expression=method.body.slice(expressionTokens[0].start,expressionTokens.at(-1).end);
+  // No algorithm transcription or C# rewrite: these operators have the same
+  // meaning on the strictly typed synthetic scalar arguments below.
+  const run=new Function(...parameters.map(value=>value.name),`'use strict'; return (${expression});`);
+  const execute=values=>{
+    assert.deepEqual(Object.keys(values).sort(),[...names].sort());
+    const args=parameters.map(({type,name:parameter})=>{
+      const value=values[parameter];
+      if(type==='bool')assert.equal(typeof value,'boolean');
+      else if(type==='long'){
+        assert.equal(typeof value,'bigint');assert.ok(value>=-(2n**63n)&&value<2n**63n);
+      }else{
+        assert.ok(Number.isInteger(value));
