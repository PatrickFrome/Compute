+struct Config {
+    int pid_failure_at = 0, pid_zero_at = 0, pid_change_at = 0;
+    int open_failure_at = 0, times_failure_at = 0, birth_change_at = 0, wait_failure_at = 0;
+    bool impersonate_failure = false, thread_token_failure = false;
+    bool user_size_failure = false, user_read_failure = false;
+    bool sid_failure = false, sid_null = false, session_failure = false, session_short = false;
+    bool revert_failure = false, revert_error_zero = false;
+    DWORD session = kSession;
