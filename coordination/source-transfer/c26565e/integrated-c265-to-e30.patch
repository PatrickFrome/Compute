@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Compose actual reader sender/receiver code with two synthetic handle tables.
+
+The protocol fixture runs complete, unedited sender and receiver methods. A
+complementary existing lifecycle fixture executes the actual native owner drain
+and worker join path. Neither model qualifies Windows, code identity, SCM,
+cryptography, public launch admission, installation, or recovery after a crash.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+CASES = (
+    'original_pair', 'entry_hello_after_reader', 'forged_process_event', 'forged_token_event',
+    'process_seed_closed_before_local_dup', 'process_seed_reused_before_local_dup',
+    'token_seed_closed_before_local_dup', 'token_seed_reused_before_local_dup',
+    'process_seed_reused_after_local_dup', 'token_seed_reused_after_local_dup',
+    'reuse_then_cancel_after_local_dup', 'local_process_dup_failure', 'local_token_dup_failure',
+    'sender_process_seed_failure', 'sender_process_seed_unknown',
+    'sender_token_seed_failure', 'sender_token_seed_unknown',
+    'sender_process_readback_wrong', 'sender_token_readback_wrong', 'sender_token_open_failure',
+    'sender_seed_reused_before_readback', 'cancel_before_acquire', 'cancel_pending_request',
+    'cancel_pending_reply', 'sender_partial_write', 'sender_failed_write', 'unknown_late_write',
+    'peer_close_during_reply', 'peer_crash_modeled_os_exit', 'late_hello_after_revoke',
+    'same_peer_double_acquire', 'second_peer_process_budget', 'independent_pipe_scope_refused',
+    'independent_root_scope_refused', 'independent_policy_refused', 'atomic_process_budget',
+)
+
+
+def between(source, first, after):
+    if source.count(first) != 1:
+        raise RuntimeError(f'Expected one production extraction anchor: {first}')
+    start = source.index(first)
+    return source[start:source.index(after, start)]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    instrumentation = parser.add_mutually_exclusive_group()
+    instrumentation.add_argument('--sanitize', action='store_true')
+    instrumentation.add_argument('--tsan', action='store_true')
+    parser.add_argument('--evidence', type=Path)
+    parser.add_argument('--case', choices=CASES)
+    parser.add_argument('--protocol-only', action='store_true', help='Diagnostic mode; native owner lifecycle remains NOT RUN')
+    args = parser.parse_args()
+    here = Path(__file__).resolve().parent
+    tree = here.parents[3]
+    native = here.parents[1] / 'native/browser-guardian-scm'
+    sender_path = native / 'browser-guardian-original-main-debug-owner.cpp'
+    receiver_path = native / 'browser-guardian-connected-peer.cpp'
+    sender, receiver = sender_path.read_text(), receiver_path.read_text()
+    io = (native / 'browser-guardian-pipe-io-lifetime.hpp').read_text()
+    fragments = {
+        'actual-reader-once.inc.hpp': between(receiver, 'bool beginOriginalReaderTransfer()', 'struct Handle {'),
+        'actual-reader-handle.inc.hpp': between(receiver, 'struct Handle {', 'struct ServiceHandle {'),
+        'actual-reader-fail.inc.hpp': between(receiver, '    bool fail(', '    std::uint64_t birthOfReader()'),
+        'actual-reader-acquire.inc.hpp': between(receiver, '    bool acquireOriginalReader()', '    bool originalKernel('),
+        'actual-sender-cancel-fail.inc.hpp': between(sender, '    bool cancelled()', '    void publish()'),
+        'actual-sender-arm.inc.hpp': between(sender, '    bool armPipe(', '    bool pipeIdentity()'),
+        'actual-sender-pump.inc.hpp': between(sender, '    bool pumpPipe()', '    bool createOriginal()'),
+        'actual-pipe-join.inc.hpp': between(io, 'constexpr DWORD kGuardianIoJoinPollMs', '}  // namespace metaengine::guardian'),
+    }
+    temporary = tempfile.TemporaryDirectory(prefix='guardian-reader-composition-') if args.evidence is None else None
+    evidence = Path(temporary.name) if temporary else args.evidence.resolve()
+    if not temporary:
+        evidence.mkdir(parents=True, exist_ok=False)
+    for name, body in fragments.items():
+        (evidence / name).write_text(body)
+    fixture = here / 'browser-guardian-original-reader-transfer-composition-model.cpp'
+    source_paths = [sender_path, receiver_path, fixture,
+                    native / 'browser-guardian-original-reader-transfer.hpp',
+                    native / 'browser-guardian-original-main-entry-protocol.hpp',
+                    native / 'browser-guardian-pipe-io-lifetime.hpp']
+    source_hashes = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_paths}
+    binary = evidence / 'reader-composition'
+    sanitizer = 'thread' if args.tsan else 'address,undefined' if args.sanitize else 'none'
+    flags = [f'-fsanitize={sanitizer}', '-fno-omit-frame-pointer', '-g', '-no-pie'] if sanitizer != 'none' else []
+    compile_command = ['g++', '-std=c++20', '-Wall', '-Wextra', '-Werror', '-pedantic', '-pthread',
+                       *flags, '-I', str(evidence), '-I', str(native), str(fixture), '-o', str(binary)]
+    compiled = subprocess.run(compile_command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=90)
+    (evidence / 'compile.log').write_text(compiled.stdout)
+    if compiled.returncode:
+        raise SystemExit(compiled.stdout)
+    environment = dict(os.environ)
+    if args.sanitize:
+        environment['ASAN_OPTIONS'] = 'detect_leaks=1:halt_on_error=1'
+        environment['UBSAN_OPTIONS'] = 'halt_on_error=1:print_stacktrace=1'
+    if args.tsan:
+        environment['TSAN_OPTIONS'] = 'halt_on_error=1'
+    cases = [args.case] if args.case else list(CASES)
+    if args.tsan and 'atomic_process_budget' in cases:
+        cases.remove('atomic_process_budget')
+        cases.insert(0, 'atomic_process_budget')
+    results = []
+    for case in cases:
+        result = subprocess.run([str(binary), case], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, env=environment, timeout=20)
+        (evidence / f'{case}.log').write_text(result.stdout)
+        if args.tsan and result.returncode and 'ThreadSanitizer: unexpected memory mapping' in result.stdout:
+            report = {'status': 'NOT RUN', 'reason': 'ThreadSanitizer runtime rejected the host address layout',
+                      'sanitizer': sanitizer, 'windows_execution': 'NOT RUN'}
+            (evidence / 'summary.json').write_text(json.dumps(report, indent=2) + '\n')
+            print(json.dumps(report), flush=True)
+            raise SystemExit(77)
+        print(result.stdout, end='', flush=True)
+        results.append({'case': case, 'exit_code': result.returncode})
+        if result.returncode:
+            raise SystemExit(result.returncode)
+    lifecycle = {'status': 'NOT RUN', 'reason': 'Explicit protocol-only diagnostic mode'}
+    if not args.protocol_only:
+        lifecycle_runner = here.parent / 'run-guardian-original-main-lifecycle-composition.py'
+        command = ['python3', str(lifecycle_runner), '--tree', str(tree), '--evidence', str(evidence / 'native-owner-lifecycle'),
+                   '--sanitizer', sanitizer]
+        result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                env=environment, timeout=180)
+        (evidence / 'native-owner-lifecycle.log').write_text(result.stdout)
+        print(result.stdout, end='', flush=True)
+        lifecycle = {'status': 'PASS' if result.returncode == 0 else 'FAIL', 'exit_code': result.returncode,
+                     'scope': 'COMPLEMENTARY_ACTUAL_NATIVE_OWNER_LIFECYCLE; PUBLIC_SCM_RESULT_BOUNDARY_NOT_TESTED_HERE'}
+        if result.returncode:
+            raise SystemExit(result.returncode)
+    report = {'schema': 'metaengine.guardian.reader-transfer-composition-model.v1',
+              'passed': len(results), 'failed': 0, 'sanitizer': sanitizer,
+              'leak_sanitizer': 'PASS: detect_leaks=1' if args.sanitize else 'NOT RUN',
+              'protocol_scope': 'ACTUAL_SENDER_AND_RECEIVER_WITH_TWO_SYNTHETIC_HANDLE_TABLES',
+              'native_owner_lifecycle': lifecycle,
+              'windows_execution': 'NOT RUN', 'native_authority': 'NOT QUALIFIED',
+              'crash_scope': 'MODELED_OS_TABLE_RETIREMENT_ONLY; NO_CALLBACK_OR_GRACEFUL_HOLD_PROOF',
+              'source_sha256': source_hashes,
+              'source_unchanged': all(hashlib.sha256(path.read_bytes()).hexdigest() == source_hashes[str(path)]
+                                      for path in source_paths),
+              'actual_fragments_sha256': {name: hashlib.sha256(body.encode()).hexdigest() for name, body in fragments.items()}}
+    (evidence / 'summary.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps(report, sort_keys=True), flush=True)
+    if not report['source_unchanged']:
+        raise SystemExit('Source changed during the composed model run')
+    if temporary:
+        temporary.cleanup()
+
+
+if __name__ == '__main__':
+    main()
