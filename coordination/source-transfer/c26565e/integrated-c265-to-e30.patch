+    void configure() {
+        const auto& name = data.scenario;
+        if (name == "process_seed_closed_before_local_dup" || name == "process_seed_reused_before_local_dup")
+            data.before_local_process = [&] { data.replaceBorrowed(data.process_seed, name == "process_seed_reused_before_local_dup"); };
+        if (name == "token_seed_closed_before_local_dup" || name == "token_seed_reused_before_local_dup")
+            data.after_local_process = [&] { data.replaceBorrowed(data.token_seed, name == "token_seed_reused_before_local_dup"); };
+        if (name == "process_seed_reused_after_local_dup" || name == "reuse_then_cancel_after_local_dup")
+            data.after_local_process = [&] {
+                data.replaceBorrowed(data.process_seed, true);
+                if (name == "reuse_then_cancel_after_local_dup") SetEvent(data.child_cancel);
+            };
+        if (name == "token_seed_reused_after_local_dup") data.after_local_token = [&] { data.replaceBorrowed(data.token_seed, true); };
+        if (name == "late_hello_after_revoke") data.after_local_process = [&] { SetEvent(data.child_cancel); };
+        if (name == "independent_pipe_scope_refused") data.pipe_scope = false;
+        if (name == "independent_root_scope_refused") data.root_scope = false;
+        if (name == "independent_policy_refused") data.policy_scope = false;
+        if (name == "cancel_before_acquire") { Context child(Side::Child); SetEvent(data.child_cancel); }
+    }
+    bool acquire() { Context child(Side::Child); return receiver->acquireOriginalReader(); }
+    void closeReceiver() { Context child(Side::Child); receiver.reset(); }
+    void exitThroughModeledOs() { data.kernelExit(); }
+};
+
+static void runCase(const std::string& name) {
+    if (name == "atomic_process_budget") {
+        std::atomic<unsigned> winners{0}; std::vector<std::thread> threads;
+        for (unsigned i = 0; i < 32; ++i) threads.emplace_back([&] {
+            if (metaengine::guardian::beginOriginalReaderTransfer()) winners.fetch_add(1);
+        });
+        for (auto& thread : threads) thread.join();
+        require(winners.load() == 1 && !metaengine::guardian::beginOriginalReaderTransfer(), "process-wide native gate admitted multiple threads");
+        return;
+    }
+    Fixture f(name);
+    const bool okay = f.acquire();
+    const bool expected = name == "original_pair" || name == "entry_hello_after_reader" ||
+        name == "process_seed_reused_after_local_dup" || name == "token_seed_reused_after_local_dup" ||
+        name == "same_peer_double_acquire" || name == "second_peer_process_budget" || name == "peer_crash_modeled_os_exit";
+    require(okay == expected, "unexpected actual receiver acquisition result");
+    require(f.data.seed_attempts <= 2 && f.sender->reader_seed_duplicate_attempts <= 2 && f.data.seeds_created <= 2,
+        "original sender exceeded its fixed two seed budget");
+    require(f.sender->reader_seed_insertions_observed <= f.sender->reader_seed_duplicate_attempts,
+        "observed insert count claims unknown effects absent");
+    if (okay) {
+        require(f.receiver->reader_bound, "actual receiver did not bind owned copies");
+        auto* process = f.data.slot(Side::Child, f.receiver->original_service_reader.value);
+        auto* token = f.data.slot(Side::Child, f.receiver->original_service_token.value);
+        require(process && token && process->owner == Owner::LocalCopy && token->owner == Owner::LocalCopy,
+            "receiver adopted a borrowed numeric seed");
+        require(process->object == f.data.service_process && token->object == f.data.service_token,
+            "owned copies lost original object identity");
+        require(process->access == rw::kRequiredAccess && token->access == TOKEN_QUERY, "owned-copy access changed");
+    } else {
+        require(f.receiver->observation_revoked && !f.receiver->reader_bound && !f.receiver->pipe.valid(),
+            "failed receiver kept a live pipe or authorization facts");
+        require(f.data.count(Side::Child, Owner::LocalCopy) == 0, "partial receiver copies leaked");
+        require(f.data.child_alive && !f.data.process_exits, "receiver false was incorrectly treated as child exit");
+    }
+    if (f.data.sentinel) {
+        const auto* sentinel = f.data.slot(Side::Child, f.data.sentinel);
+        require(sentinel && sentinel->owner == Owner::Sentinel, "borrowed slot reuse closed unrelated sentinel");
+    }
+    if (name == "entry_hello_after_reader") {
+        const auto request = ew::encode(ew::Request{ew::Operation::Hello, 1});
+        f.data.request.assign(request.begin(), request.end());
+        { Context service(Side::Service); require(f.data.dispatch(), "actual sender rejected entry Hello after reader"); }
+        ew::Reply reply;
+        require(ew::decode(f.data.reply.data(), f.data.reply.size(), &reply) && reply.sequence == 1 && f.sender->hello,
+            "actual entry wire response missing");
+        require(f.data.seeds_created == 2, "entry Hello reissued seed handles");
+    }
+    if (name == "same_peer_double_acquire") {
+        const auto writes = f.data.request_writes;
+        require(!f.acquire() && f.data.request_writes == writes, "same peer retried transfer");
+    }
+    if (name == "second_peer_process_budget") {
+        const auto writes = f.data.request_writes;
+        { Context child(Side::Child); Receiver second;
+          require(!second.acquireOriginalReader() && second.reason == "ORIGINAL_READER_PROCESS_TRANSFER_ALREADY_ATTEMPTED",
+              "second native peer bypassed process lifetime budget"); }
+        require(f.data.request_writes == writes && f.data.seeds_created == 2, "second peer requested more seeds");
+    }
+    if (name == "late_hello_after_revoke" || name == "unknown_late_write") {
+        const auto attempts = f.data.seed_attempts;
+        { Context service(Side::Service); f.sender->fail("TEST_RECEIVER_PIPE_BREAK_OBSERVED");
+          const auto hello = ew::encode(ew::Request{ew::Operation::Hello, 1});
+          f.data.request.assign(hello.begin(), hello.end());
+          require(!f.data.dispatch(), "late entry bytes revived revoked sender"); }
+        require(f.data.seed_attempts == attempts && !f.sender->hello && !f.sender->status.hello_reply_written,
+            "late acknowledgement reissued or resurrected sender status");
+    }
+    if (name == "sender_process_readback_wrong" || name == "sender_token_readback_wrong")
+        require(f.data.wrong_readback_used && f.sender->revoked.load(), "sender readback mismatch was not exercised");
+    if (name == "cancel_pending_request" || name == "cancel_pending_reply" || name == "unknown_late_write") {
+        const auto joined = std::find(f.data.events.begin(), f.data.events.end(), "receiver-io-join");
+        const auto close = std::find(f.data.events.begin(), f.data.events.end(), "receiver-pipe-close");
+        require(joined != f.data.events.end() && close != f.data.events.end() && joined < close,
+            "receiver released endpoint before actual pending-I/O helper completed");
+    }
+    require(f.data.remote_closes == 0 && f.data.foreign_closes == 0 && f.data.invalid_closes == 0,
+        "protocol closed a borrowed, remote-source, or invalid slot");
+    if (name == "peer_crash_modeled_os_exit") {
+        const auto closes_before_crash = f.data.closed.size();
+        require(f.data.count(Side::Child, Owner::Seed) == 2 && f.data.count(Side::Child, Owner::LocalCopy) == 2,
+            "crash scenario did not hold both seeds and owned copies");
+        f.exitThroughModeledOs();
+        // A crashed process executes no C++ destructor. Retire the fixture's
+        // inert wrapper memory without invoking any simulated CloseHandle.
+        f.receiver->cancelled.value = f.receiver->pipe.value = f.receiver->server_process.value = INVALID_HANDLE_VALUE;
+        f.receiver->original_service_reader.value = f.receiver->original_service_token.value = INVALID_HANDLE_VALUE;
+        f.receiver.reset();
+        require(f.data.child.slots.empty() && f.data.seed_reclaims == 2 && f.data.closed.size() == closes_before_crash,
+            "modeled crash was incorrectly credited to a C++ cleanup callback");
+        return;
+    }
+    f.closeReceiver();
+    require(f.data.count(Side::Child, Owner::LocalCopy) == 0, "owned copies survived receiver destruction");
+    const auto seeds = f.data.count(Side::Child, Owner::Seed);
+    require(f.data.child_alive && f.data.process_exits == 0, "local cleanup claimed native process death");
+    // This is explicitly a modeled OS exit, not a C++ callback, native drain,
+    // public response, durable recovery completion, or Windows qualification.
+    f.exitThroughModeledOs();
+    require(f.data.child.slots.empty() && f.data.seed_reclaims == seeds, "process exit failed to retire original table");
+}
+
+int main(int argc, char** argv) {
+    if (argc != 2) return 2;
+    try {
+        runCase(argv[1]);
+        std::cout << "{\"case\":\"" << argv[1] << "\",\"state\":\"PASS\",\"Windows\":\"NOT RUN\","
+            "\"authority\":\"SYNTHETIC_BOUNDARIES_NOT_QUALIFIED\"}\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << argv[1] << ": " << error.what() << '\n';
+        return 1;
+    }
+}
