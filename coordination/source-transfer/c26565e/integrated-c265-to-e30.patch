+DWORD WaitForSingleObject(HANDLE raw, DWORD wait) {
+    using namespace fixture;
+    ++wait_calls;
+    require(wait == 0, "unexpected blocking process wait");
+    auto* value = handle(raw, Kind::Process);
+    if (!value || config.wait_failure_at == wait_calls) { last_error = ERROR_INVALID_HANDLE; return WAIT_FAILED; }
