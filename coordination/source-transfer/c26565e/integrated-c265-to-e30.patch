+    pipe_header = NATIVE / "browser-guardian-owner-enrollment-observer.hpp"
+    pipe_scope = scope_declaration(pipe_header)
+    pipe_source = pipe_header.read_text()
+    connection_start = pipe_source.index("    bool originalMainConnectionLive() const noexcept {")
+    connection_end = pipe_source.index("\n    }", connection_start) + len("\n    }")
+    pipe_connection = pipe_source[connection_start:connection_end] + "\n"
+    getter_start = pipe_source.index("    bool impersonationRevertFailed() const noexcept {")
+    revert_getter = pipe_source[getter_start:pipe_source.index("\n", getter_start)] + "\n"
+    actuator = (NATIVE / "browser-guardian-update-actuator.cpp").read_text()
+    helper_start = actuator.index("OwnerEnrollmentObservation observeOriginalClientOrStop(")
+    helper_end = actuator.index("\n}", helper_start) + len("\n}")
+    observation_helper = actuator[helper_start:helper_end] + "\n"
+    source_paths = [
+        FIXTURE,
+        NATIVE / "browser-guardian-original-main-launch-session.inc.hpp",
+        NATIVE / "browser-guardian-original-main-launch-grant.hpp",
+        NATIVE / "browser-guardian-original-main-challenge.hpp",
+        NATIVE / "browser-guardian-original-main-launch-wire.hpp",
+        NATIVE / "browser-guardian-effect-admission.hpp",
+    ]
