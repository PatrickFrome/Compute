+}
+BOOL CloseHandle(HANDLE raw) {
+    using namespace fixture;
+    auto* value = static_cast<Handle*>(raw);
+    if (!value || value == INVALID_HANDLE_VALUE || !value->open ||
+        (value->kind != Kind::Process && value->kind != Kind::Token)) {
+        ++invalid_closes; last_error = ERROR_INVALID_HANDLE; return FALSE;
+    }
+    value->open = false; return TRUE;
+}
+BOOL ImpersonateNamedPipeClient(HANDLE raw) {
+    using namespace fixture;
+    ++impersonate_calls;
+    if (!handle(raw, Kind::Pipe) || config.impersonate_failure) { last_error = ERROR_ACCESS_DENIED; return FALSE; }
+    impersonating = true; return TRUE;
+}
+BOOL OpenThreadToken(HANDLE raw, DWORD access, BOOL open_as_self, HANDLE* output) {
+    using namespace fixture;
+    require(handle(raw, Kind::Thread) && access == TOKEN_QUERY && open_as_self && impersonating,
+        "thread token not queried in the original identification scope");
+    if (config.thread_token_failure) { last_error = ERROR_ACCESS_DENIED; return FALSE; }
+    *output = allocate(Kind::Token); return TRUE;
+}
+BOOL GetTokenInformation(HANDLE raw, TOKEN_INFORMATION_CLASS kind, void* output, DWORD size, DWORD* written) {
+    using namespace fixture;
+    require(handle(raw, Kind::Token) && impersonating, "token read outside the original impersonation");
+    if (kind == TokenUser) {
+        if (!output) {
