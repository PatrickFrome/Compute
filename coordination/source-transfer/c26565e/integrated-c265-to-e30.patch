+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+APP = Path(__file__).resolve().parents[2]
+NATIVE = APP / "native/browser-guardian-scm"
+FIXTURE = Path(__file__).with_name("browser-guardian-main-launch-scope-model.cpp")
+
+
+def scope_declaration(path):
+    source = path.read_text()
+    declarations = re.findall(
+        r"std::shared_ptr<const char>\s+original_main_scope_\s*=\s*[^;]+;", source
+    )
+    if len(declarations) != 1:
+        raise SystemExit(f"Expected one private original_main_scope_ declaration in {path.name}")
+    if source.index(declarations[0]) < source.index("private:"):
+        raise SystemExit(f"The native scope declaration must remain private: {path.name}")
+    return declarations[0] + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sanitize", action="store_true")
+    parser.add_argument("--cxx", default="g++")
+    args = parser.parse_args()
+    service = (NATIVE / "browser-guardian-scm-service.cpp").read_text()
+    start = service.index("class GuardianOriginalMainChallengeIssuer final {")
