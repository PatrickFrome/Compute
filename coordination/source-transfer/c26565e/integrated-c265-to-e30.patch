+    {"termination_request_failed_wait_and_job_query_never_establish_join",[]{
+        Fixture f;auto held=f.retain();Worker worker;
+        auto ticket=held->retainOriginalWorker(worker.process_handle,worker.job_handle,&f.failure);
+        require(ticket!=nullptr,"worker_original_transfer_failed");held->revoke();
