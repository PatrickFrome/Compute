+        client.client_creation_time_100ns && _wcsicmp(client.user_sid.c_str(), owner.record.expected_owner_sid.c_str()) == 0;
+}
+static bool deviceProofExact(std::string_view x, std::string_view y, std::string_view signature,
+    std::string_view material, const OwnerEnrollmentStoreResult& owner) {
+    auto& m = model();
+    ++m.proof_calls;
+    m.last_material = material;
+    const bool accepted = m.proof_ok && owner.exact && x == std::string(43, 'A') &&
+        y == std::string(43, 'B') && signature == std::string(86, 'C') && material == m.expected_material;
+    fire(m.proof_hook);
+    return accepted; // Deliberately synthetic; no cryptographic verification.
+}
+static std::string sha256Text(const std::string& wire) {
+    auto& m = model();
+    m.last_hash_wire = wire;
+    fire(m.hash_hook);
+    return m.hash_ok ? std::string(64, 'a') : std::string{};
+}
