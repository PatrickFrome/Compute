+struct GuardianNativeRootSession::State {
+    OwnerEnrollmentObservation client;
+    OwnerRecord owner = model().durable.record;
+    LUID logon_id;
+    ScopedHandle user_token{model().make(ModelHandle::Kind::Token)};
+    ScopedHandle client_process{model().make(ModelHandle::Kind::Requester)};
+    std::unique_ptr<GuardianInstalledNamespace> installed = std::make_unique<GuardianInstalledNamespace>();
+    static bool tokenLogonId(HANDLE token, LUID* output) {
+        if (!token || token->closed || !output || !model().logon_ok) return false;
+        *output = model().token_logon;
+        return true;
+    }
+    bool sameTuple(const OwnerEnrollmentObservation& observed, const OwnerEnrollmentStoreResult& durable) const {
+        return client.session_id == observed.session_id && client.client_pid == observed.client_pid &&
+            client.client_creation_time_100ns == observed.client_creation_time_100ns &&
+            _wcsicmp(client.user_sid.c_str(), observed.user_sid.c_str()) == 0 &&
+            owner.expected_owner_sid == durable.record.expected_owner_sid &&
+            owner.enrollment_evidence_sha256 == durable.record.enrollment_evidence_sha256 &&
+            owner.device_key_fingerprint_sha256 == durable.record.device_key_fingerprint_sha256;
+    }
+    bool recheck() {
+        ++model().root_checks;
+        return installed && model().root_ok && model().process_ok &&
+            ownerAndClientExact(client, model().durable) && sameTuple(client, model().durable);
+    }
+    bool originalProcessExact() const { return model().process_ok; }
+};
