+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {execFile} from 'node:child_process';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {promisify} from 'node:util';
+import {SAFE_QUALIFICATION_SUITES,safeQualificationPlan,parseSafeQualificationArguments,
+  safeQualificationEnvironment,safeQualificationInvocation,classifySafeQualificationResult,
+  createSafeQualificationWorkspace} from './safe-install-qualification.mjs';
+
+const execute=promisify(execFile);
+const summary=({pass=1,fail=0,cancelled=0,skipped=0,todo=0}={})=>
+  Object.entries({tests:pass+fail+cancelled+skipped+todo,pass,fail,cancelled,skipped,todo})
+    .map(([key,value])=>'# '+key+' '+value).join('\n')+'\n';
+
+test('CLI cannot select arbitrary tests, commands, output paths or runtime flags',()=>{
+  assert.equal(parseSafeQualificationArguments([]),'list');
+  assert.equal(parseSafeQualificationArguments(['--list']),'list');
+  assert.equal(parseSafeQualificationArguments(['--run']),'run');
+  for(const args of [['--run','test/*.test.mjs'],['--run','--execute'],['--run','--out','existing'],
+    ['--run','--test-name-pattern','.*'],['--run','--run'],['--unknown']])
+    assert.throws(()=>parseSafeQualificationArguments(args),/arguments_invalid/);
+});
+
+test('allowlist is fixed and excludes DB integration, native runners and installer entrypoints',()=>{
+  assert.ok(Object.isFrozen(SAFE_QUALIFICATION_SUITES));
+  const files=SAFE_QUALIFICATION_SUITES.flatMap(value=>value.files);
+  assert.equal(new Set(files).size,files.length);
+  for(const suite of SAFE_QUALIFICATION_SUITES){
+    assert.ok(Object.isFrozen(suite)&&Object.isFrozen(suite.files));
+    for(const file of suite.files){
+      assert.match(file,/^(apps\/metaengine-browser\/test|infra\/client-state-runtime)\/[a-z0-9-]+\.test\.mjs$/);
+      assert.doesNotMatch(file,/integration|\.pg17\.|\/native\/|[?*]|\.ps1$/);
+    }
+  }
+  assert.ok(files.includes('apps/metaengine-browser/test/native-coding-initial-setup-main.test.mjs'));
+  assert.ok(files.includes('apps/metaengine-browser/test/native-coding-capacity-first-dispatch.test.mjs'));
