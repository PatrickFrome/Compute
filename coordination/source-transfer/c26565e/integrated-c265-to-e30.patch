+// Synthetic handle-table model. @ACTUAL_* markers are replaced by production
+// source without rewriting method bodies. Each case runs in a fresh process;
+// the production process-wide transfer budget has no reset seam.
+#include "browser-guardian-original-reader-transfer.hpp"
+#include "browser-guardian-original-main-entry-protocol.hpp"
+#include <array>
+#include <atomic>
