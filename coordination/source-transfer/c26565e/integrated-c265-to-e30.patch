+      &&selected.token===request.recoveryRootPhase,'original_phase_required');
+    synchronous(original.assertCurrent);
+    synchronous(admitted.assertCurrent);
+    synchronous(selected.assertCurrent);
+    must(value.deadlineAt>Date.now(),'original_binding_invalid');
+    // Fixed native vetoes may revoke or replace a registry row. Matching
+    // descriptors after that change cannot preserve the original identities.
+    must(readOriginalNativeCodingRecoveryJob(value.originalJob)===job
+      &&readOriginalNativeCodingRecoveryServerRequest(admitted.request)===server
