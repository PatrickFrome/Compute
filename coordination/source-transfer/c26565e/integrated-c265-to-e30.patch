+    handles.clear();
+    last_error = ERROR_SUCCESS;
+    pid_calls = open_calls = times_calls = wait_calls = 0;
+    impersonate_calls = revert_calls = invalid_closes = sid_allocations = 0;
+    stop_calls = 0; impersonating = stop_signaled = false;
+}
+void resourcesClosed() {
+    for (const auto& value : handles) require(!value->open, "an observed process/token handle leaked");
+    require(!invalid_closes, "a handle was closed twice or with the wrong ownership");
+    require(!sid_allocations, "a converted SID allocation leaked");
+}
+}
+
+DWORD GetLastError() { return fixture::last_error; }
+HANDLE GetCurrentThread() { return &fixture::thread; }
+BOOL SetEvent(HANDLE raw) {
+    fixture::require(fixture::handle(raw, fixture::Kind::Stop), "unexpected stop object");
+    ++fixture::stop_calls; fixture::stop_signaled = true; return TRUE;
+}
+BOOL GetNamedPipeClientProcessId(HANDLE raw, ULONG* pid) {
+    using namespace fixture;
+    ++pid_calls;
+    if (!handle(raw, Kind::Pipe) || config.pid_failure_at == pid_calls) {
+        last_error = ERROR_ACCESS_DENIED; return FALSE;
+    }
+    *pid = config.pid_zero_at == pid_calls ? 0 : config.pid_change_at == pid_calls ? kPidB : kPidA;
+    return TRUE;
+}
+HANDLE OpenProcess(DWORD access, BOOL inherit, DWORD pid) {
+    using namespace fixture;
+    ++open_calls;
+    require(!inherit && (access == PROCESS_QUERY_LIMITED_INFORMATION ||
+        access == (PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE)), "unexpected process access");
+    if (config.open_failure_at == open_calls || (pid != kPidA && pid != kPidB)) {
