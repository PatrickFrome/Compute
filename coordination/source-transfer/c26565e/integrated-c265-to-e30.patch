+BOOL WriteFile(HANDLE pipe, void* bytes, DWORD count, DWORD* done, OVERLAPPED* operation) {
+    ++world.writes;
+    if (world.pending_write) {
+        operation->Internal = 0x103U; world.pending.push_back({pipe, operation, bytes, count, true});
+        world.last_error = ERROR_IO_PENDING; return FALSE;
+    }
+    world.receive_request(bytes, count); *done = count - world.short_write; return TRUE;
+}
+BOOL ReadFile(HANDLE pipe, void* bytes, DWORD count, DWORD* done, OVERLAPPED* operation) {
+    ++world.reads;
+    if (world.pending_read) {
+        operation->Internal = 0x103U; world.pending.push_back({pipe, operation, bytes, count, false});
+        world.last_error = ERROR_IO_PENDING; return FALSE;
+    }
+    world.send_reply(bytes, count); *done = count - world.short_read; return TRUE;
+}
+BOOL CancelIoEx(HANDLE pipe, OVERLAPPED* operation) {
+    ++world.cancel_requests;
+    if (world.pending.empty() || world.pending.front().pipe != pipe || world.pending.front().operation != operation)
+        throw std::runtime_error("cancellation lost original pending operation");
+    return TRUE;
+}
+void Sleep(DWORD) { ++world.sleeps; }
+BOOL GetOverlappedResult(HANDLE pipe, OVERLAPPED* operation, DWORD* done, BOOL) {
+    ++world.completion_polls;
+    if (world.pending.empty() || world.pending.front().pipe != pipe || world.pending.front().operation != operation)
+        throw std::runtime_error("completion lost original pending operation");
+    if (world.get_result_fails_once) { world.get_result_fails_once = false; world.last_error = ERROR_IO_INCOMPLETE; return FALSE; }
+    if (world.cancel_requests && world.incomplete_polls++ < 2) { world.last_error = ERROR_IO_INCOMPLETE; return FALSE; }
+    auto pending = world.pending.front();
+    if (pending.writing) {
+        if (!world.cancel_requests || world.late_write) world.receive_request(pending.buffer, pending.count);
+    } else if (!world.cancel_requests) world.send_reply(pending.buffer, pending.count);
+    operation->Internal = 0;
+    *done = pending.count;
+    world.pending.erase(world.pending.begin());
+    return TRUE;
+}
+BOOL DuplicateHandle(HANDLE source_process, HANDLE source, HANDLE target_process, HANDLE* target, DWORD rights, BOOL inherit, DWORD flags) {
+    ++world.duplicates; world.duplicate_rights.emplace_back(rights, flags);
+    if (source_process != GetCurrentProcess() || target_process != GetCurrentProcess() || inherit || flags)
+        throw std::runtime_error("receiver duplicated with foreign process, inheritance or closing flags");
+    if (flags & DUPLICATE_CLOSE_SOURCE) ++world.close_source;
+    if (world.duplicates == world.duplicate_fail_at) return FALSE;
+    auto slot = world.slot(source);
+    if (!slot || !target || (rights & ~slot->rights)) return FALSE;
+    const auto object = slot->object;
+    *target = world.insert(object, true, rights);
+    if (world.reuse_borrowed_process && World::key(source) == world.grant.child_local_handle) world.replace_borrowed(source);
+    if (world.reuse_borrowed_token && World::key(source) == world.grant.child_local_token) world.replace_borrowed(source);
+    if (world.duplicates == world.cancel_on_duplicate) world.object(world.cancel)->signaled = true;
+    return TRUE;
+}
+HANDLE OpenProcess(DWORD rights, BOOL, DWORD pid) {
+    if (pid != World::server) return nullptr;
+    return world.insert(world.slot(world.process_sentinel)->object, true, rights);
+}
