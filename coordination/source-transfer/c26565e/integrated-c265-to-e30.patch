+class GuardianNativeRootSession {
+public:
+    GuardianNativeRootSession(const GuardianEffectAdmission&, HANDLE, GuardianStartupCodeCustody*);
+    ~GuardianNativeRootSession();
+    GuardianNativeRootSession(const GuardianNativeRootSession&) = delete;
+    GuardianNativeRootSession& operator=(const GuardianNativeRootSession&) = delete;
+    std::unique_ptr<GuardianOriginalMainLaunchGrant> authorizeOriginalMainLaunch(
+        const std::string&, OwnerEnrollmentPipe&, GuardianOriginalMainChallenge&, std::string*);
+    bool duplicateOriginalMainLaunchObjects(const GuardianOriginalMainLaunchGrant&, OwnerEnrollmentPipe&,
+        HANDLE*, HANDLE*, std::unique_ptr<GuardianInstalledNamespace>*, std::string*);
+    void expireReplacementPreparation() {}
+private:
+#include "scope-model-session-field.inc.hpp"
+    friend class GuardianScmEffectOwner;
