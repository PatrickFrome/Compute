+#!/usr/bin/env python3
+"""Compose the actual pipe observer and transport predicate with synthetic APIs.
+
+This executes production observeClientIdentity, its SID/birth/stop helpers, and
+clientTransportExact. Only the Windows API boundary and the pipe holder are
+synthetic. It does not qualify Windows, SCM, WTS, cryptography, or authority.
+"""
+
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def section(source: str, first: str, following: str) -> str:
+    """Keep the selected production implementation intact; fail on source drift."""
+    if source.count(first) != 1:
+        raise RuntimeError(f"expected one production section: {first!r}")
+    start = source.index(first)
+    return source[start:source.index(following, start)]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sanitize", action="store_true", help="use ASAN/UBSAN; LSAN disabled")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2] / "native/browser-guardian-scm"
+    observer = (root / "browser-guardian-owner-enrollment-observer.cpp").read_text()
+    header = (root / "browser-guardian-owner-enrollment-observer.hpp").read_text()
+    actuator = (root / "browser-guardian-update-actuator.cpp").read_text()
+    observation = section(header, "struct OwnerEnrollmentObservation {", "\nclass OwnerEnrollmentPipe final")
+    valid = section(header, "    bool valid() const noexcept", "\n\n    // The caller must complete")
+    fatal_latch = section(header, "    bool impersonation_revert_failed_ = false;", "\n    HANDLE pipe_")
+    helpers = section(observer, "std::wstring tokenSidString(HANDLE token)", "\n}  // namespace")
+    methods = section(observer, "OwnerEnrollmentObservation OwnerEnrollmentPipe::observeClientIdentity(",
+                      "\nconst char* browserGuardianOwnerEnrollmentObserverContractJson()")
+    predicate = section(actuator, "bool clientTransportExact(const OwnerEnrollmentObservation& client)",
+                        "\nbool ownerAndClientExact(")
+    stop_helper = section(actuator, "OwnerEnrollmentObservation observeOriginalClientOrStop(",
+                          "\nbool clientTransportExact(")
+
+    preamble = r'''
+#include <cstdint>
+#include <cwchar>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+using DWORD = std::uint32_t;
+using ULONG = std::uint32_t;
+using BYTE = unsigned char;
+using BOOL = int;
+using HANDLE = void*;
+using LPWSTR = wchar_t*;
+constexpr BOOL TRUE = 1, FALSE = 0;
+#define INVALID_HANDLE_VALUE reinterpret_cast<HANDLE>(static_cast<std::intptr_t>(-1))
+constexpr DWORD ERROR_SUCCESS = 0, ERROR_ACCESS_DENIED = 5, ERROR_INVALID_HANDLE = 6;
+constexpr DWORD ERROR_INVALID_DATA = 13, ERROR_INSUFFICIENT_BUFFER = 122, ERROR_INVALID_STATE = 5023;
+constexpr DWORD TOKEN_QUERY = 8, PROCESS_QUERY_LIMITED_INFORMATION = 0x1000, SYNCHRONIZE = 0x100000;
+constexpr DWORD WAIT_OBJECT_0 = 0, WAIT_TIMEOUT = 258, WAIT_FAILED = 0xffffffffU;
+enum TOKEN_INFORMATION_CLASS { TokenUser, TokenSessionId };
+struct FILETIME { DWORD dwLowDateTime = 0, dwHighDateTime = 0; };
+// The anonymous members model the Windows SDK's integer union, not an API.
+union ULARGE_INTEGER {
+    __extension__ struct { DWORD LowPart, HighPart; };
+    std::uint64_t QuadPart;
+};
