+
+// No native issuer exists. Original request admission is necessary, never
+// sufficient: preserve the real custody refusal instead of issuing a token or
+// accepting a caller backend, handle, proof callback or positive JSON report.
+export async function beginOriginalRecoveryDirectoryCustody(input){
+  assertOriginalRecoveryDirectoryRequest(input);
+  requireOriginalRecoveryDirectoryCustody();
+}
