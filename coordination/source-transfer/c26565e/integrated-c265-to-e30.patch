+// Actual native mechanical source, simulated OS only. No admission issuer.
+#include "windows.h"
+#include "winternl.h"
+#include "recovery-directory-handles.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <cwctype>
+#include <functional>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace model {
+constexpr DWORD main_pid=1001;
+constexpr NTSTATUS pending_status=0x103;
+constexpr NTSTATUS collision_status=static_cast<NTSTATUS>(0xc0000035U);
+constexpr NTSTATUS invalid_status=static_cast<NTSTATUS>(0xc000000dU);
+constexpr NTSTATUS denied_status=static_cast<NTSTATUS>(0xc0000022U);
+const HANDLE current_process=reinterpret_cast<HANDLE>(static_cast<std::intptr_t>(-2));
+enum class Kind{File,Process,Job,Event};
+struct Node{
+    std::wstring path;
+    std::string bytes;
+    FILE_ID_INFO identity{};
+    std::uint64_t birth=134000000000000001ULL;
+    DWORD attributes=FILE_ATTRIBUTE_DIRECTORY;
+    bool case_sensitive=false,metadata_denied=false;
+};
+struct Open{
+    std::shared_ptr<Node> node;
+    DWORD access=0,share=0;
+};
+struct Process;
+struct Job{std::set<std::shared_ptr<Process>,std::owner_less<std::shared_ptr<Process>>> members;};
+struct Event{bool signaled=false;};
+struct Object{
+    Kind kind=Kind::File;
+    std::shared_ptr<Open> open;
+    std::shared_ptr<Process> process;
+    std::shared_ptr<Job> job;
+    std::shared_ptr<Event> event;
+};
+struct Process{
+    DWORD pid=0;
+    std::uint64_t birth=134000000000000123ULL;
+    bool live=true;
+    std::map<HANDLE,std::shared_ptr<Object>> handles;
+    std::uintptr_t next_handle=0x100;
+};
+struct Pending{
+    IO_STATUS_BLOCK* status=nullptr;
+    HANDLE original=nullptr;
+    bool cancelled=false;
+};
+struct World{
+    DWORD error=ERROR_SUCCESS,current_pid=main_pid;
+    std::uint64_t next_id=1,ticks=0;
+    std::map<std::wstring,std::shared_ptr<Node>> paths;
+    std::map<DWORD,std::shared_ptr<Process>> processes;
+    std::vector<Pending> pending;
+    std::function<void()> on_wait,on_sleep,on_nt_create,on_metadata;
+    bool missing_nt_create=false,pending_create=false,duplicate_denied=false,wrong_file_duplicate=false,
+        compare_denied=false,query_job_denied=false,created_metadata_denied=false,
+        throw_created_metadata=false,throw_worker_copyback=false,process_wait_failed=false;
+    DWORD fail_duplicate_target_pid=0;
+    unsigned target_duplicate_count=0,fail_target_duplicate_at=0;
+    unsigned creates=0,cancel_requests=0,close_before_completion=0,
+        relative_creates=0,duplicate_calls=0,compare_calls=0,waits=0,sleeps=0;
+};
+World world;
+void require(bool value,std::string_view reason){if(!value)throw std::runtime_error(std::string(reason));}
+std::wstring key(std::wstring value){
+    if(value.starts_with(L"\\\\?\\"))value.erase(0,4);
+    while(value.size()>3&&value.back()==L'\\')value.pop_back();
+    std::transform(value.begin(),value.end(),value.begin(),[](wchar_t ch){return std::towlower(ch);});
+    return value;
+}
+std::shared_ptr<Process> process(DWORD pid){
+    const auto found=world.processes.find(pid);return found==world.processes.end()?nullptr:found->second;
+}
+std::shared_ptr<Object> lookup(DWORD pid,HANDLE handle){
+    const auto p=process(pid);if(!p)return {};
+    const auto found=p->handles.find(handle);return found==p->handles.end()?nullptr:found->second;
+}
+std::shared_ptr<Object> lookup(HANDLE handle){return lookup(world.current_pid,handle);}
+std::shared_ptr<Process> processFrom(HANDLE handle){
+    if(handle==current_process)return process(world.current_pid);
+    const auto object=lookup(handle);return object&&object->kind==Kind::Process?object->process:nullptr;
+}
+HANDLE put(const std::shared_ptr<Process>& p,std::shared_ptr<Object> object){
+    if(!p||!p->live){world.error=ERROR_INVALID_HANDLE;return nullptr;}
+    HANDLE value=nullptr;
+    do{value=reinterpret_cast<HANDLE>(p->next_handle++);}while(p->handles.contains(value));
+    p->handles.emplace(value,std::move(object));return value;
+}
+HANDLE put(std::shared_ptr<Object> object){return put(process(world.current_pid),std::move(object));}
+std::shared_ptr<Node> nodeAt(const std::wstring& path,bool directory=true,std::string bytes={}){
+    auto node=std::make_shared<Node>();node->path=path;node->bytes=std::move(bytes);
+    node->attributes=directory?FILE_ATTRIBUTE_DIRECTORY:FILE_ATTRIBUTE_NORMAL;
+    node->identity.VolumeSerialNumber=17;
+    const auto id=world.next_id++;
+    std::memcpy(node->identity.FileId.Identifier,&id,sizeof(id));
+    node->birth+=id;
+    world.paths[key(path)]=node;return node;
+}
+std::shared_ptr<Node> named(const std::wstring& path){
+    const auto found=world.paths.find(key(path));return found==world.paths.end()?nullptr:found->second;
+}
+DWORD expanded(DWORD access){
+    DWORD result=access;
+    if(access&(GENERIC_READ|GENERIC_ALL))result|=FILE_READ_DATA|FILE_READ_EA|FILE_READ_ATTRIBUTES|READ_CONTROL;
+    if(access&(GENERIC_WRITE|GENERIC_ALL))result|=FILE_WRITE_DATA|FILE_APPEND_DATA|FILE_WRITE_EA|FILE_WRITE_ATTRIBUTES;
+    if(access&(GENERIC_EXECUTE|GENERIC_ALL))result|=FILE_EXECUTE;
+    if(access&GENERIC_ALL)result|=DELETE|WRITE_DAC|WRITE_OWNER;
+    return result;
+}
+bool compatible(DWORD desired,DWORD share){
+    const auto access=expanded(desired);
+    return (!(access&(FILE_READ_DATA|FILE_EXECUTE))||(share&FILE_SHARE_READ))&&
+        (!(access&(FILE_WRITE_DATA|FILE_APPEND_DATA))||(share&FILE_SHARE_WRITE))&&
+        (!(access&DELETE)||(share&FILE_SHARE_DELETE));
+}
+bool canOpen(const std::shared_ptr<Node>& node,DWORD access,DWORD share){
+    for(const auto& [pid,p]:world.processes){
+        (void)pid;
+        for(const auto& [raw,object]:p->handles){
+            (void)raw;
+            if(object->kind!=Kind::File||object->open->node!=node)continue;
+            if(!compatible(access,object->open->share)||!compatible(object->open->access,share)){
+                world.error=ERROR_SHARING_VIOLATION;return false;
+            }
+        }
+    }
+    return true;
+}
+HANDLE open(const std::shared_ptr<Node>& node,DWORD access,DWORD share){
+    if(!node){world.error=ERROR_FILE_NOT_FOUND;return INVALID_HANDLE_VALUE;}
+    if(!canOpen(node,access,share))return INVALID_HANDLE_VALUE;
+    auto object=std::make_shared<Object>();object->kind=Kind::File;
+    object->open=std::make_shared<Open>(Open{node,access,share});return put(std::move(object));
+}
+bool live(HANDLE value){return value&&value!=INVALID_HANDLE_VALUE&&lookup(value)!=nullptr;}
+bool directChild(const std::wstring& parent,const std::wstring& child){
+    auto prefix=key(parent);if(prefix.back()!=L'\\')prefix+=L"\\";
+    const auto full=key(child);
+    return full.starts_with(prefix)&&full.size()>prefix.size()&&full.find(L'\\',prefix.size())==std::wstring::npos;
+}
+bool hasChildren(const std::shared_ptr<Node>& parent){
+    for(const auto& [path,node]:world.paths){(void)path;if(directChild(parent->path,node->path))return true;}return false;
+}
+bool rename(const std::wstring& from,const std::wstring& to){
+    const auto original=named(from);
+    if(!original){world.error=ERROR_FILE_NOT_FOUND;return false;}
+    const auto deleting=open(original,DELETE,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE);
+    if(!live(deleting))return false;
+    if(named(to)){CloseHandle(deleting);world.error=ERROR_ALREADY_EXISTS;return false;}
+    const auto old=key(from),prefix=old+L"\\";
+    std::vector<std::shared_ptr<Node>> moving;
+    for(const auto& [path,node]:world.paths)if(path==old||path.starts_with(prefix))moving.push_back(node);
+    for(const auto& node:moving)world.paths.erase(key(node->path));
+    for(const auto& node:moving){node->path=to+node->path.substr(from.size());world.paths[key(node->path)]=node;}
+    CloseHandle(deleting);return true;
+}
+bool junction(const std::wstring& path){
+    const auto node=named(path);
+    if(!node){world.error=ERROR_FILE_NOT_FOUND;return false;}
+    if(hasChildren(node)){world.error=ERROR_DIR_NOT_EMPTY;return false;}
+    const auto writer=open(node,GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE);
+    if(!live(writer))return false;
+    node->attributes|=FILE_ATTRIBUTE_REPARSE_POINT;CloseHandle(writer);return true;
+}
+bool attributeOnlyJunction(HANDLE original){
+    const auto object=lookup(original);
+    if(!object||object->kind!=Kind::File||!(expanded(object->open->access)&FILE_WRITE_ATTRIBUTES)){
+        world.error=ERROR_ACCESS_DENIED;return false;
+    }
+    if(hasChildren(object->open->node)){world.error=ERROR_DIR_NOT_EMPTY;return false;}
+    object->open->node->attributes|=FILE_ATTRIBUTE_REPARSE_POINT;return true;
+}
+void exitProcess(const std::shared_ptr<Process>& p){
+    require(p!=nullptr,"missing_process");p->live=false;p->handles.clear();
+}
+std::size_t fileHandleCount(){
+    std::size_t total=0;for(const auto& [pid,p]:world.processes){(void)pid;
+        for(const auto& [raw,object]:p->handles){(void)raw;if(object->kind==Kind::File)++total;}}
+    return total;
+}
+void initialize(){
+    world=World{};auto p=std::make_shared<Process>();p->pid=main_pid;world.processes.emplace(main_pid,p);
+}
+FILETIME time(std::uint64_t ticks){return {static_cast<DWORD>(ticks),static_cast<DWORD>(ticks>>32)};}
+}
+
+DWORD GetLastError(){return model::world.error;}
+void SetLastError(DWORD error){model::world.error=error;}
+HANDLE GetCurrentProcess(){return model::current_process;}
+DWORD GetCurrentProcessId(){return model::world.current_pid;}
+DWORD GetProcessId(HANDLE handle){const auto p=model::processFrom(handle);return p?p->pid:0;}
+BOOL GetProcessTimes(HANDLE handle,FILETIME* created,FILETIME* ended,FILETIME* kernel,FILETIME* user){
+    const auto p=model::processFrom(handle);if(!p||!created||!ended||!kernel||!user)return FALSE;
+    *created=model::time(p->birth);*ended={};*kernel={};*user={};return TRUE;
+}
+BOOL GetExitCodeProcess(HANDLE handle,DWORD* code){
+    const auto p=model::processFrom(handle);if(!p||!code)return FALSE;*code=p->live?STILL_ACTIVE:0;return TRUE;
+}
+BOOL IsProcessInJob(HANDLE processHandle,HANDLE jobHandle,BOOL* member){
+    const auto p=model::processFrom(processHandle);
+    const auto job=model::lookup(jobHandle);
+    if(!p||!job||job->kind!=model::Kind::Job||!member)return FALSE;
+    *member=job->job->members.contains(p)?TRUE:FALSE;return TRUE;
+}
+BOOL QueryInformationJobObject(HANDLE handle,JOBOBJECTINFOCLASS kind,LPVOID output,DWORD bytes,DWORD* returned){
+    const auto object=model::lookup(handle);
+    if(!object||object->kind!=model::Kind::Job||!output||model::world.query_job_denied)return FALSE;
+    if(kind==JobObjectBasicAccountingInformation&&bytes==sizeof(JOBOBJECT_BASIC_ACCOUNTING_INFORMATION)){
+        JOBOBJECT_BASIC_ACCOUNTING_INFORMATION info{};
+        info.TotalProcesses=static_cast<DWORD>(object->job->members.size());
+        info.ActiveProcesses=static_cast<DWORD>(object->job->members.size());
+        *static_cast<JOBOBJECT_BASIC_ACCOUNTING_INFORMATION*>(output)=info;
+        if(returned)*returned=sizeof(info);
+        return TRUE;
+    }
+    return FALSE;
+}
+HANDLE CreateFileW(LPCWSTR path,DWORD access,DWORD share,SECURITY_ATTRIBUTES*,DWORD disposition,DWORD,HANDLE){
+    if(!path||disposition!=OPEN_EXISTING){SetLastError(ERROR_INVALID_PARAMETER);return INVALID_HANDLE_VALUE;}
+    return model::open(model::named(path),access,share);
+}
+HANDLE ReOpenFile(HANDLE original,DWORD access,DWORD share,DWORD){
+    const auto object=model::lookup(original);
+    if(!object||object->kind!=model::Kind::File)return INVALID_HANDLE_VALUE;
+    return model::open(object->open->node,access,share);
+}
+BOOL CloseHandle(HANDLE value){
+    const auto p=model::process(model::world.current_pid);
+    if(!p||!p->handles.contains(value)){SetLastError(ERROR_INVALID_HANDLE);return FALSE;}
+    for(const auto& operation:model::world.pending)
+        if(operation.original==value&&operation.status&&operation.status->Status==model::pending_status)
+            ++model::world.close_before_completion;
+    p->handles.erase(value);return TRUE;
+}
+BOOL DuplicateHandle(HANDLE sourceProcess,HANDLE original,HANDLE destinationProcess,PHANDLE duplicate,DWORD access,BOOL inherit,DWORD options){
+    ++model::world.duplicate_calls;
+    const auto source=model::processFrom(sourceProcess),destination=model::processFrom(destinationProcess);
+    if(!source||!destination||!duplicate||inherit||model::world.duplicate_denied||
+        !(options&DUPLICATE_SAME_ACCESS)||access){SetLastError(ERROR_INVALID_PARAMETER);return FALSE;}
+    const auto found=source->handles.find(original);
+    if(found==source->handles.end()){SetLastError(ERROR_INVALID_HANDLE);return FALSE;}
+    const auto object=found->second;
+    if(model::world.throw_worker_copyback&&source->pid!=model::world.current_pid&&
+        destination->pid==model::world.current_pid&&object->kind==model::Kind::File){
+        model::world.throw_worker_copyback=false;throw std::bad_alloc{};
+    }
+    if(destination->pid==model::world.fail_duplicate_target_pid&&
+        ++model::world.target_duplicate_count==model::world.fail_target_duplicate_at){
+        SetLastError(ERROR_ACCESS_DENIED);return FALSE;
+    }
+    if(model::world.wrong_file_duplicate&&object->kind==model::Kind::File){
+        model::world.wrong_file_duplicate=false;
+        auto substituted=std::make_shared<model::Object>(*object);
+        substituted->open=std::make_shared<model::Open>(*object->open);
+        *duplicate=model::put(destination,substituted);
+    }else *duplicate=model::put(destination,object);
+    if(options&DUPLICATE_CLOSE_SOURCE)source->handles.erase(original);
+    return *duplicate?TRUE:FALSE;
+}
+BOOL CompareObjectHandles(HANDLE left,HANDLE right){
+    ++model::world.compare_calls;
+    const auto a=model::lookup(left),b=model::lookup(right);
+    return !model::world.compare_denied&&a&&a==b?TRUE:FALSE;
+}
+BOOL GetFileInformationByHandleEx(HANDLE handle,FILE_INFO_BY_HANDLE_CLASS kind,LPVOID output,DWORD bytes){
+    const auto object=model::lookup(handle);
+    if(!object||object->kind!=model::Kind::File||!output||object->open->node->metadata_denied)return FALSE;
+    const auto& node=*object->open->node;
+    if(model::world.on_metadata)model::world.on_metadata();
+    if(model::world.throw_created_metadata&&node.path.ends_with(L"\\protected-backup-root-v1")){
+        model::world.throw_created_metadata=false;throw std::bad_alloc{};
+    }
+    if(kind==FileIdInfo&&bytes==sizeof(FILE_ID_INFO)){*static_cast<FILE_ID_INFO*>(output)=node.identity;return TRUE;}
+    if(kind==FileAttributeTagInfo&&bytes==sizeof(FILE_ATTRIBUTE_TAG_INFO)){
+        *static_cast<FILE_ATTRIBUTE_TAG_INFO*>(output)={node.attributes,(node.attributes&FILE_ATTRIBUTE_REPARSE_POINT)?0xa0000003U:0};return TRUE;
+    }
+    if(kind==FileCaseSensitiveInfo&&bytes==sizeof(FILE_CASE_SENSITIVE_INFO)){
+        *static_cast<FILE_CASE_SENSITIVE_INFO*>(output)={node.case_sensitive?FILE_CS_FLAG_CASE_SENSITIVE_DIR:0};return TRUE;
+    }
+    if(kind==FileBasicInfo&&bytes==sizeof(FILE_BASIC_INFO)){
+        FILE_BASIC_INFO value{};value.CreationTime.QuadPart=static_cast<LONGLONG>(node.birth);value.FileAttributes=node.attributes;
+        *static_cast<FILE_BASIC_INFO*>(output)=value;return TRUE;
+    }
+    if(kind==FileStandardInfo&&bytes==sizeof(FILE_STANDARD_INFO)){
+        FILE_STANDARD_INFO value{};value.EndOfFile.QuadPart=static_cast<LONGLONG>(node.bytes.size());
+        value.NumberOfLinks=1;value.Directory=(node.attributes&FILE_ATTRIBUTE_DIRECTORY)?TRUE:FALSE;
+        *static_cast<FILE_STANDARD_INFO*>(output)=value;return TRUE;
+    }
+    return FALSE;
+}
+BOOL GetFileInformationByHandle(HANDLE handle,BY_HANDLE_FILE_INFORMATION* output){
+    const auto object=model::lookup(handle);
