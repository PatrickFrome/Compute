+
+test('an exit code or skipped-only output cannot masquerade as passed qualification',()=>{
+  assert.equal(classifySafeQualificationResult({exitCode:0,stdout:summary()}).state,'PASSED');
+  for(const result of [
+    {exitCode:1,stdout:summary()},
+    {exitCode:0,signal:'SIGTERM',stdout:summary()},
+    {exitCode:0,stdout:summary({pass:0,skipped:1}),expectedSkipped:1},
+    {exitCode:0,stdout:summary({skipped:1})},
+    {exitCode:0,stdout:summary({todo:1})},
+    {exitCode:0,stdout:summary({fail:1})},
+    {exitCode:0,stdout:'TAP version 13\n'},
+    {exitCode:0,stdout:summary()+summary()},
+  ])assert.equal(classifySafeQualificationResult(result).state,'FAILED');
+  assert.equal(classifySafeQualificationResult({exitCode:0,stdout:summary({skipped:2}),expectedSkipped:2}).state,'PASSED');
+});
+
+test('portable success never grants physical restore, native Windows or first-task proof',()=>{
+  const plan=safeQualificationPlan();
+  assert.equal(plan.full_qualification,'INCOMPLETE');
+  for(const key of ['production_qualified','physical_restore_proven','windows_native_proven','first_real_task_proven',
+    'upgrade_authorized','authority_effect'])assert.equal(plan[key],false,key);
+  for(const domain of ['Physical PostgreSQL restore','Installed authentication and first real task'])
+    assert.equal(plan.not_run.find(value=>value.domain===domain).status,'NOT RUN');
+  assert.equal(plan.installer_authorization,'NOT AUTHORIZED');
+  assert.match(plan.not_run.find(value=>value.domain==='wire_route_authenticates_then_launches').reason,/FAIL due HOLD/);
+});
