+BOOL DuplicateHandle(HANDLE source_process, HANDLE source, HANDLE target_process, HANDLE* output,
+    DWORD rights, BOOL inherit, DWORD options) {
+    auto& m = *fixture::model;
+    using fixture::ReaderFault;
+    if (options & DUPLICATE_CLOSE_SOURCE) { ++m.errors; m.record("forbidden-remote-slot-close"); return FALSE; }
+    const auto object = m.get(source);
+    if (m.config.reader_fault != ReaderFault::None && target_process != GetCurrentProcess()) {
+        if (source_process != GetCurrentProcess() || m.get(target_process) != m.process || inherit || options || !output || !object) {
+            ++m.errors; return FALSE;
+        }
+        const bool token = object->kind == fixture::Kind::Token;
+        if (rights != (token ? TOKEN_QUERY : metaengine::guardian::original_reader_wire::kRequiredAccess)) ++m.errors;
+        ++m.seed_attempts;
+        const auto fault = m.config.reader_fault;
+        if ((!token && fault == ReaderFault::ProcessInsertFailed) || (token && fault == ReaderFault::TokenInsertFailed)) return FALSE;
+        *output = m.add(object, true); ++m.seed_inserted; m.record(token ? "token-seed-inserted" : "process-seed-inserted");
+        if ((!token && fault == ReaderFault::ProcessInsertUnknown) || (token && fault == ReaderFault::TokenInsertUnknown)) return FALSE;
+        return TRUE;
+    }
+    if (m.config.reader_fault != ReaderFault::None && source_process != GetCurrentProcess()) {
+        if (m.get(source_process) != m.process || target_process != GetCurrentProcess() || inherit || options || !output || !object) {
+            ++m.errors; return FALSE;
+        }
+        const bool token = object->kind == fixture::Kind::Token;
+        if (rights != (token ? TOKEN_QUERY : metaengine::guardian::original_reader_wire::kRequiredAccess)) ++m.errors;
+        const auto fault = m.config.reader_fault;
+        if ((!token && fault == ReaderFault::ProcessReadbackFailed) || (token && fault == ReaderFault::TokenReadbackFailed)) return FALSE;
+        auto copy = object;
+        if ((!token && fault == ReaderFault::ProcessReadbackMismatch) || (token && fault == ReaderFault::TokenReadbackMismatch)) {
+            copy = std::make_shared<fixture::Object>(object->kind); copy->pid = 999;
+        }
+        *output = m.add(std::move(copy), false, true); return TRUE;
+    }
+    if (source_process != GetCurrentProcess() || target_process != GetCurrentProcess() || inherit || options || !output) {
+        ++m.errors; return FALSE;
+    }
+    if (!object || m.config.duplicate_failed) { fixture::last_error = ERROR_ACCESS_DENIED; return FALSE; }
+    *output = m.add(object); return TRUE;
+}
+BOOL CloseHandle(HANDLE value) {
+    auto& m = *fixture::model;
+    std::lock_guard guard(m.mutex);
+    for (const auto& slot : m.slots) if (slot.get() == value) {
+        const auto object = slot->object;
+        if (!object) { ++m.errors; return FALSE; }
+        if (slot->remote) ++m.errors;
+        if (slot->reader_local && m.worker && !m.worker->signaled) ++m.errors;
+        if (object->kind == fixture::Kind::Process && object->pid == 480 && !object->signaled) ++m.errors;
+        if (object->kind == fixture::Kind::Job && object->active.load() != 0) ++m.errors;
+        if (object->kind == fixture::Kind::Pipe && m.pipe_pending) ++m.errors;
+        if (object->kind == fixture::Kind::File) ++m.event_files_closed;
+        slot->object.reset(); return TRUE;
+    }
+    ++m.errors; return FALSE;
+}
