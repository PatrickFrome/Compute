+static bool duplicate(GuardianNativeRootSession& session, OwnerEnrollmentPipe& pipe,
+    const GuardianOriginalMainLaunchGrant& grant, Outputs& outputs, std::string& failure) {
+    return session.duplicateOriginalMainLaunchObjects(grant, pipe, &outputs.token, &outputs.requester,
+        &outputs.package, &failure);
+}
+static void refuse(GuardianNativeRootSession& session, OwnerEnrollmentPipe& pipe,
+    const GuardianOriginalMainLaunchGrant& grant, const std::string& expected = {}) {
+    const auto* retained = GuardianScmEffectOwner::package(session);
+    const auto live = model().liveDuplicates();
+    Outputs outputs;
+    std::string failure;
+    require(!duplicate(session, pipe, grant, outputs, failure), "unsafe duplication accepted");
+    require(outputs.empty(), "failed duplication published outputs");
+    require(GuardianScmEffectOwner::package(session) == retained, "failed duplication lost original package");
+    require(model().liveDuplicates() == live, "failed duplication leaked a duplicate handle");
+    require(!failure.empty() && (expected.empty() || failure == expected), "unexpected refusal reason");
+}
+static void requireFatalStopped(const Fixture& fixture) {
+    const auto& m = model();
+    require(fixture.pipe.impersonationRevertFailed() && m.fatal_observed, "fatal observation was not latched");
+    require(m.stop->signaled && m.stop_signals == 1, "fatal observation did not signal the existing stop event");
+    require(m.store_reads == m.store_reads_at_fatal && m.store_constructions == m.store_constructions_at_fatal,
+        "store accessed after failed impersonation revert");
+    require(m.root_checks == m.root_checks_at_fatal && m.startup_checks == m.startup_checks_at_fatal,
+        "native custody rechecked after failed impersonation revert");
+}
+template<class T> struct ReusedObject {
+    alignas(T) unsigned char storage[sizeof(T)];
+    T* object = nullptr;
+    ~ReusedObject() { if (object) std::destroy_at(object); }
+    template<class... Args> T& reconstruct(Args&&... args) {
+        if (object) std::destroy_at(object);
+        object = nullptr;
+        object = std::construct_at(reinterpret_cast<T*>(storage), std::forward<Args>(args)...);
+        return *object;
+    }
+};
