+      &&currentRequest.signal===value.signal&&currentRequest.recoveryRootPhase===selected.token,'original_binding_changed');
+  }catch(error){
+    if(ownErrors.has(error))throw error;
+    const refused=failure('original_binding_unavailable');
+    throw nativePhysicalSettlementUnconfirmed(error)?markNativePhysicalSettlementUnconfirmed(refused):refused;
+  }
