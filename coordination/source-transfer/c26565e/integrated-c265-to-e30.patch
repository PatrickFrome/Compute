+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import {constants as fsConstants} from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {createHash,randomUUID} from 'node:crypto';
+import {performance} from 'node:perf_hooks';
+import {readDirectoryIdentity as nativeDirectoryIdentity} from '../src/native-coding-fs-identity.mjs';
+
+const test=(name,body)=>nodeTest(name,{timeout:15000},body);
+const moduleUrl=name=>new URL('../src/'+name,import.meta.url).href;
+const PREFIX=/^owned_protected_backup_root_/;
+const NAMESPACE_HOLD='owned_protected_backup_root_original_parent_namespace_custody_required';
+const ROOT_NAME='protected-backup-root-v1';
