+
+using HANDLE = void*;
+using DWORD = std::uint32_t;
+using ULONG = std::uint32_t;
+using BOOL = int;
+using PUCHAR = unsigned char*;
+#define INVALID_HANDLE_VALUE reinterpret_cast<HANDLE>(UINTPTR_MAX)
+#define BCRYPT_SUCCESS(status) ((status) >= 0)
+constexpr BOOL TRUE = 1, FALSE = 0;
+constexpr DWORD ERROR_SUCCESS = 0, ERROR_ACCESS_DENIED = 5, ERROR_INVALID_DATA = 13;
+constexpr DWORD ERROR_NOT_ENOUGH_MEMORY = 8, ERROR_NOT_SUPPORTED = 50;
+constexpr DWORD ERROR_OPERATION_ABORTED = 995, ERROR_IO_INCOMPLETE = 996, ERROR_IO_PENDING = 997;
+constexpr DWORD WAIT_OBJECT_0 = 0, WAIT_TIMEOUT = 258, WAIT_FAILED = 0xffffffff;
+constexpr DWORD FILE_READ_DATA = 1, FILE_WRITE_DATA = 2, FILE_READ_ATTRIBUTES = 0x80;
+constexpr DWORD FILE_WRITE_ATTRIBUTES = 0x100, SYNCHRONIZE = 0x100000, OPEN_EXISTING = 3;
+constexpr DWORD PROCESS_QUERY_INFORMATION = 0x400, PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
+constexpr DWORD PROCESS_VM_READ = 0x10, TOKEN_QUERY = 8, FILE_TYPE_PIPE = 3;
+constexpr DWORD FILE_FLAG_OVERLAPPED = 0x40000000, SECURITY_SQOS_PRESENT = 0x100000;
+constexpr DWORD SECURITY_IDENTIFICATION = 0x10000, PIPE_TYPE_MESSAGE = 4, PIPE_SERVER_END = 1;
+constexpr DWORD PIPE_READMODE_MESSAGE = 2, PIPE_NOWAIT = 1, BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2;
+constexpr DWORD DUPLICATE_CLOSE_SOURCE = 1, DUPLICATE_SAME_ACCESS = 2;
+struct FILETIME { DWORD dwLowDateTime = 0, dwHighDateTime = 0; };
+struct OVERLAPPED { std::uintptr_t Internal = 0; HANDLE hEvent = nullptr; };
+#define HasOverlappedIoCompleted(operation) ((operation)->Internal != 0x103U)
+struct TOKEN_STATISTICS { std::uint64_t TokenId = 12; };
+constexpr int TokenStatistics = 10;
+namespace wire = metaengine::guardian::original_reader_wire;
+
+// Ownership belongs to a table slot, while duplicates share the same object.
+// Reuse erases one slot without changing the object retained by another slot.
+enum class Kind { Event, Pipe, Process, Token };
+struct Object {
+    Kind kind;
+    bool signaled = false;
+    DWORD pid = 0;
+    std::uint64_t birth = 0, identity = 0;
+    std::wstring image = L"C:\\synthetic\\METAENGINEBrowserGuardian.exe";
+};
+struct Slot { std::shared_ptr<Object> object; bool peer_owned; DWORD rights; bool seed = false; };
+struct Pending {
+    HANDLE pipe;
+    OVERLAPPED* operation;
+    void* buffer;
+    DWORD count;
+    bool writing;
+};
+struct World {
+    static constexpr DWORD child = 1042, server = 2042;
+    static constexpr std::uint64_t child_birth = 134000000000000001ULL, server_birth = child_birth - 100;
+    std::map<std::uintptr_t, Slot> table;
+    std::uintptr_t next = 0x1000;
+    std::uint64_t next_identity = 1;
+    HANDLE event_sentinel = nullptr, process_sentinel = nullptr, token_sentinel = nullptr, cancel = nullptr;
+    std::vector<Pending> pending;
+    wire::Grant grant;
+    int reads = 0, writes = 0, duplicates = 0, transferred = 0, closes_foreign = 0, closes_invalid = 0;
+    int closes_while_pending = 0, close_source = 0, opens = 0, observations = 0, clock_fences = 0;
+    int cancel_requests = 0, incomplete_polls = 0, completion_polls = 0, sleeps = 0, diagnostics_failed = 0;
+    int duplicate_fail_at = 0, cancel_on_duplicate = 0, server_queries = 0, client_queries = 0;
+    int cancellation_polls = 0, cancel_on_poll = 0;
+    bool open_ok = true, set_mode_ok = true, get_mode_ok = true, legitimate_sender = false;
+    bool rng_ok = true, short_write = false, short_read = false, server_changed = false, client_changed = false;
+    bool pending_write = false, pending_read = false, cancel_wait = false, timeout_wait = false;
+    bool get_result_fails_once = false, late_write = false, cancelled_after_read = false;
+    bool reuse_borrowed_process = false, reuse_borrowed_token = false, observe_throws = false;
+    bool pipe_alive = true, image_throws = false, diagnostic_throws = false;
+    DWORD mode = PIPE_READMODE_MESSAGE, last_error = ERROR_SUCCESS;
+    std::vector<std::pair<DWORD,DWORD>> duplicate_rights;
+    static std::uintptr_t key(HANDLE h) { return reinterpret_cast<std::uintptr_t>(h); }
+    Slot* slot(HANDLE h) { auto it = table.find(key(h)); return it == table.end() ? nullptr : &it->second; }
+    Object* object(HANDLE h) { auto s = slot(h); return s ? s->object.get() : nullptr; }
+    HANDLE insert(std::shared_ptr<Object> object, bool owned, DWORD rights, bool seed = false) {
+        auto h = reinterpret_cast<HANDLE>(next); next += 4;
+        table.emplace(key(h), Slot{std::move(object), owned, rights, seed}); return h;
+    }
+    HANDLE create(Kind kind, bool owned, DWORD rights = 0xffffffff, DWORD pid = 0, std::uint64_t birth = 0, bool seed = false) {
+        auto object = std::make_shared<Object>(Object{kind, false, pid, birth, next_identity++});
+        return insert(std::move(object), owned, rights, seed);
+    }
+    void replace_borrowed(HANDLE h) {
+        auto s = slot(h); if (!s || s->peer_owned) throw std::runtime_error("bad slot reuse fixture");
+        s->object = std::make_shared<Object>(Object{Kind::Event, false, 0, 0, next_identity++});
+    }
+    void reset() {
+        *this = World{};
+        event_sentinel = create(Kind::Event, false);
+        process_sentinel = create(Kind::Process, false, wire::kRequiredAccess, server, server_birth);
+        token_sentinel = create(Kind::Token, false, TOKEN_QUERY);
+        grant.correlation = 0xabc123;
+        grant.child_pid = child; grant.service_pid = server;
+        grant.child_birth = child_birth; grant.service_birth = server_birth;
+        grant.event_serial = 7; grant.retained_images = 3; grant.policy_sha256.fill(0x41);
+        grant.child_local_handle = key(process_sentinel); grant.child_local_token = key(token_sentinel);
+    }
+    bool sentinels_open() { return slot(event_sentinel) && slot(process_sentinel) && slot(token_sentinel); }
+    bool no_transfer() const { return reads == 0 && writes == 0 && duplicates == 0 && transferred == 0; }
+    bool all_peer_handles_closed() const { for (const auto& [h, s] : table) { (void)h; if (s.peer_owned) return false; } return true; }
+    int seed_slots() const { int count = 0; for (const auto& [h, s] : table) { (void)h; count += s.seed; } return count; }
+    void receive_request(void* bytes, DWORD count) {
+        wire::Request request;
+        if (!wire::decode(static_cast<std::uint8_t*>(bytes), count, &request)) throw std::runtime_error("invalid request fixture");
+        grant.correlation = request.correlation;
+        if (legitimate_sender && !transferred) {
+            grant.child_local_handle = key(create(Kind::Process, false, wire::kRequiredAccess, server, server_birth, true));
+            grant.child_local_token = key(create(Kind::Token, false, TOKEN_QUERY, 0, 0, true));
+            transferred += 2;
+        }
+    }
+    void send_reply(void* bytes, DWORD count) {
+        const auto reply = wire::encode(grant);
+        if (count != reply.size()) throw std::runtime_error("unexpected response size");
+        std::memcpy(bytes, reply.data(), reply.size());
+        if (cancelled_after_read) object(cancel)->signaled = true;
+    }
+} world;
+
+// A narrow diagnostic throw seam around the actual std::string field. This
+// does not edit production fail(); it exercises its real assignment/caller.
+struct DiagnosticString : std::string {
+    using std::string::operator=;
+    DiagnosticString& operator=(const char* text) {
+        if (world.diagnostic_throws) { ++world.diagnostics_failed; throw std::bad_alloc(); }
+        std::string::operator=(text); return *this;
+    }
+};
+HANDLE GetCurrentProcess() { return INVALID_HANDLE_VALUE; }
+DWORD GetCurrentProcessId() { return World::child; }
+DWORD GetLastError() { return world.last_error; }
+BOOL CloseHandle(HANDLE h) {
+    for (const auto& p : world.pending) if (p.pipe == h || p.operation->hEvent == h) ++world.closes_while_pending;
+    auto slot = world.slot(h);
+    if (!slot) { ++world.closes_invalid; return FALSE; }
+    if (!slot->peer_owned) ++world.closes_foreign;
+    world.table.erase(World::key(h)); return TRUE;
+}
+HANDLE CreateEventW(void*, BOOL, BOOL signaled, const wchar_t*) {
+    auto h = world.create(Kind::Event, true); world.object(h)->signaled = !!signaled;
+    if (!world.cancel) world.cancel = h;
+    return h;
+}
+DWORD WaitForSingleObject(HANDLE h, DWORD) {
+    if (h == GetCurrentProcess()) return WAIT_TIMEOUT;
+    if (h == world.cancel && ++world.cancellation_polls == world.cancel_on_poll) world.object(h)->signaled = true;
+    auto object = world.object(h);
+    return !object ? WAIT_FAILED : object->signaled ? WAIT_OBJECT_0 : WAIT_TIMEOUT;
+}
+DWORD WaitForMultipleObjects(DWORD, const HANDLE*, BOOL, DWORD) {
+    if (world.cancel_wait) { world.object(world.cancel)->signaled = true; return WAIT_OBJECT_0; }
+    return world.timeout_wait ? WAIT_TIMEOUT : WAIT_OBJECT_0 + 1;
+}
+HANDLE CreateFileW(const wchar_t* name, DWORD access, DWORD sharing, void*, DWORD creation, DWORD flags, HANDLE) {
+    ++world.opens;
+    if (std::wstring(name) != metaengine::guardian::original_main_wire::kPipe ||
+        access != (FILE_READ_DATA | FILE_WRITE_DATA | FILE_READ_ATTRIBUTES | SYNCHRONIZE | FILE_WRITE_ATTRIBUTES) ||
+        sharing != 0 || creation != OPEN_EXISTING ||
+        flags != (FILE_FLAG_OVERLAPPED | SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION))
+        throw std::runtime_error("native-host caller changed its fixed pipe open");
+    return world.open_ok ? world.create(Kind::Pipe, true) : INVALID_HANDLE_VALUE;
+}
+BOOL SetNamedPipeHandleState(HANDLE, DWORD*, void*, void*) { return world.set_mode_ok; }
+BOOL GetNamedPipeHandleStateW(HANDLE, DWORD* mode, void*, void*, void*, void*, DWORD) { *mode = world.mode; return world.get_mode_ok; }
+BOOL GetNamedPipeInfo(HANDLE, DWORD* flags, void*, void*, void*) { *flags = PIPE_TYPE_MESSAGE; return TRUE; }
+BOOL GetNamedPipeClientProcessId(HANDLE, ULONG* pid) {
+    ++world.client_queries; *pid = World::child + (world.client_changed && world.client_queries > 1); return TRUE;
