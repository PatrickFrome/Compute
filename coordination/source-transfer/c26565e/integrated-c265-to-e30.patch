+DWORD WaitForSingleObject(HANDLE handle,DWORD timeout){
+    ++model::world.waits;if(timeout&&model::world.on_wait)model::world.on_wait();
+    const auto object=model::lookup(handle);if(!object)return WAIT_FAILED;
+    if(object->kind==model::Kind::Process){
+        if(model::world.process_wait_failed)return WAIT_FAILED;
+        return object->process->live?WAIT_TIMEOUT:WAIT_OBJECT_0;
+    }
+    if(object->kind==model::Kind::Event)return object->event->signaled?WAIT_OBJECT_0:WAIT_TIMEOUT;
+    if(object->kind==model::Kind::File){
+        for(const auto& op:model::world.pending)if(op.original==handle&&op.status->Status==model::pending_status)return WAIT_TIMEOUT;
+        return WAIT_OBJECT_0;
+    }
+    return WAIT_TIMEOUT;
+}
+DWORD WaitForMultipleObjects(DWORD count,const HANDLE* handles,BOOL all,DWORD timeout){
+    if(!handles||all)return WAIT_FAILED;
+    for(DWORD i=0;i<count;++i)if(WaitForSingleObject(handles[i],0)==WAIT_OBJECT_0)return WAIT_OBJECT_0+i;
+    if(timeout&&model::world.on_wait)model::world.on_wait();
+    return WAIT_TIMEOUT;
+}
