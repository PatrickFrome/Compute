+
+    def test_worktree_configuration_cannot_hide_a_promisor_or_filter(self):
+        _, electron, node, _ = self.fixture()
+        run(node, 'config', 'extensions.worktreeConfig', 'true')
+        (node / '.git/config.worktree').write_text(
+            '[remote "model"]\n promisor = true\n[filter "model"]\n clean = untrusted-command\n')
+        with mock.patch.object(policy, 'Objects') as objects, self.assertRaisesRegex(
+                ValueError, 'local_config_composition_forbidden'):
+            policy.verify_component_tree(electron, node, 'node')
+        objects.assert_not_called()
+
+    def test_external_filter_configuration_is_refused(self):
+        _, electron, node, _ = self.fixture()
+        run(node, 'config', 'filter.model.clean', 'untrusted-command')
+        with self.assertRaisesRegex(ValueError, 'partial_clone_or_external_filter_forbidden'):
+            policy.verify_component_tree(electron, node, 'node')
+
+    def test_replacement_refs_are_refused(self):
+        _, electron, node, _ = self.fixture()
+        base = policy.COMPONENTS['node'][0]
+        run(node, 'update-ref', 'refs/replace/' + base,
+            run(node, 'rev-parse', 'HEAD').decode().strip())
+        with self.assertRaisesRegex(ValueError, 'replacement_objects_forbidden'):
+            policy.verify_component_tree(electron, node, 'node')
+
+    @unittest.skipIf(os.name == 'nt', 'Windows does not expose the Git executable bit as a POSIX mode')
+    def test_executable_mode_drift_is_refused_even_when_blob_bytes_match(self):
+        root, electron, node, _ = self.fixture()
+        with policy.derive_component_tree(electron, node, 'node') as (_, entries, objects):
+            output = root / 'canonical-source'
+            policy.materialize_canonical_tree(output, entries, objects)
+            (output / 'main.cc').chmod(0o755)
+            with self.assertRaisesRegex(ValueError, 'physical_file_mode_mismatch'):
+                policy.physical_tree(output, entries)
+
+    def test_composed_external_root_is_not_silently_ignored(self):
+        _, electron, node, _ = self.fixture()
+        (node / 'unqualified-electron-root').mkdir()
+        with self.assertRaisesRegex(ValueError, 'extra_physical_directory'):
+            policy.verify_component_tree(electron, node, 'node')
+
+    def test_reviewed_symlink_targets_and_modes_are_exact(self):
+        _, _, node, _ = self.fixture()
+        root = node.parent / 'physical-only'
+        root.mkdir()
+        target = root / 'target'
+        target.write_bytes(b'file')
+        target.chmod(0o644)
+        try:
+            (root / 'link').symlink_to('target')
+        except OSError:
+            self.skipTest('Host cannot create a source symlink')
+        oid = lambda data: hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest()
+        entries = [{'path': 'target', 'mode': '100644', 'oid': oid(b'file')},
+                   {'path': 'link', 'mode': '120000', 'oid': oid(b'target')}]
+        self.assertTrue(policy.physical_tree(root, entries)['physical_tree_verified'])
+        (root / 'link').unlink()
+        (root / 'link').symlink_to('../unreviewed')
+        with self.assertRaisesRegex(ValueError, 'canonical_checkout_representation_mismatch'):
+            policy.physical_tree(root, entries)
+
+
+if __name__ == '__main__':
+    unittest.main()
