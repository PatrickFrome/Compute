+const RETAINED_SENTINEL='SYNTHETIC_RETAINED_ORIGINAL_BACKUP_EVIDENCE';
+const identities=new WeakMap(),summaries=new WeakMap(),fixtures=new Set();
+const hostCapabilities=new WeakMap(),clientRequests=new WeakMap(),custodies=new WeakMap(),handoffs=new WeakMap();
+const filesystemWrites=[];
