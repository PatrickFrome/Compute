+BOOL GetProcessTimes(HANDLE raw, FILETIME* created, FILETIME*, FILETIME*, FILETIME*) {
+    using namespace fixture;
+    ++times_calls;
+    auto* value = handle(raw, Kind::Process);
+    if (!value || config.times_failure_at == times_calls) { last_error = ERROR_ACCESS_DENIED; return FALSE; }
+    const auto birth = value->process->birth + (config.birth_change_at == times_calls ? 1 : 0);
+    created->dwLowDateTime = static_cast<DWORD>(birth);
+    created->dwHighDateTime = static_cast<DWORD>(birth >> 32);
+    return TRUE;
