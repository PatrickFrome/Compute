@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""Run unedited production original-Main lifecycle methods under a Win32 model.
+
+This Linux source-only test composes the production startup, cancellation,
+process/Job drain, callback release and close methods byte-for-byte. Image and
+package validation, the registry and OS calls are fixtures. It cannot qualify
+Windows execution, a launch route, signatures, installation or authority.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+
+def sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def fragment(source: str, begin: str, end: str) -> str:
+    if source.count(begin) != 1:
+        raise ValueError(f"Expected a unique production marker: {begin}")
+    start = source.index(begin)
+    return source[start:source.index(end, start)]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tree", type=Path, required=True)
+    parser.add_argument("--evidence", type=Path, required=True)
+    parser.add_argument("--owner-source", type=Path, help="Optional original source for a regression control")
+    parser.add_argument("--sanitizer", choices=("none", "address,undefined", "thread"), default="none")
+    parser.add_argument("--repeat", type=int, default=1)
+    parser.add_argument("--case", help="Run cases whose names contain this exact substring")
+    args = parser.parse_args()
+    if not 1 <= args.repeat <= 100:
+        raise SystemExit("repeat must be from 1 through 100")
+    tree = args.tree.resolve()
+    native = tree / "apps/metaengine-browser/native/browser-guardian-scm"
+    source = (args.owner_source or native / "browser-guardian-original-main-debug-owner.cpp").resolve()
+    fixture = tree / "apps/metaengine-browser/test/native/browser-guardian-original-main-lifecycle-tests.cpp"
+    model = fixture.parent / "guardian-original-main-lifecycle-model/windows.h"
+    evidence = args.evidence.resolve()
+    if evidence.exists():
+        raise SystemExit("Use a new disposable evidence directory")
+    text = source.read_bytes().decode("utf-8")
+    fragments = {
+        "helpers": fragment(text, "bool duplicate(", "std::wstring lower("),
+        "fields": fragment(text, "    mutable std::mutex lock;", "    bool cancelled()"),
+        "cancellation": fragment(text, "    bool cancelled()", "    void publish()"),
+        "original-alive": fragment(text, "    bool originalAlive()", "    // WTS and the requester's"),
+        "create": fragment(text, "    bool createOriginal()", "    bool event("),
+        "pipe-identity": fragment(text, "    bool pipeIdentity()", "    bool pumpPipe()"),
+        "arm-pipe": fragment(text, "    bool armPipe(", "    bool pipeIdentity()"),
+        "pump-pipe": fragment(text, "    bool pumpPipe()", "\n    bool createOriginal()"),
+        "worker": fragment(text, "    bool continuePending(", "\n};\n\nGuardianOriginalMainDebugOwner::GuardianOriginalMainDebugOwner"),
+        "owner": fragment(text, "GuardianOriginalMainDebugOwner::GuardianOriginalMainDebugOwner()", "} // namespace metaengine::guardian"),
+    }
+    evidence.mkdir(parents=True)
+    extracted = []
+    for name, body in fragments.items():
+        target = evidence / f"guardian-main-lifecycle-{name}.inc.hpp"
+        target.write_bytes(body.encode("utf-8"))
+        extracted.append(target)
+    tracked = [Path(__file__).resolve(), source, fixture, model, *extracted,
+               *(native / name for name in (
+                   "browser-guardian-original-main-debug-owner.hpp", "browser-guardian-replacement-drain.hpp",
+                   "browser-guardian-effect-admission.hpp", "browser-guardian-original-main-debug-image.hpp",
+                   "browser-guardian-original-main-entry-protocol.hpp", "browser-guardian-original-reader-transfer.hpp",
+                   "browser-guardian-pipe-io-lifetime.hpp"))]
+    before = {str(path): sha(path) for path in tracked}
+    binary = evidence / "original-main-lifecycle.test"
+    compile_command = ["g++", "-std=c++20", "-O1", "-g", "-Wall", "-Wextra", "-Werror", "-pedantic", "-pthread",
+                       "-I", str(model.parent), "-I", str(evidence), str(fixture), "-o", str(binary)]
+    if args.sanitizer != "none":
+        compile_command.extend([f"-fsanitize={args.sanitizer}", "-fno-omit-frame-pointer"])
+        # Fixed executable placement avoids ASan shadow collisions on hosts
+        # with a very wide randomized address space. This is a Linux test only.
+        compile_command.append("-no-pie")
+    run_command = [str(binary)] + ([args.case] if args.case else [])
+    commands = [("compile", compile_command)] + [(f"run-{i + 1}", run_command) for i in range(args.repeat)]
+    records = []
+    for step, command in commands:
+        try:
+            result = subprocess.run(command, capture_output=True, text=True, timeout=60, check=False)
+        except subprocess.TimeoutExpired as error:
+            stdout, stderr = error.stdout or "", error.stderr or ""
+            if isinstance(stdout, bytes):
+                stdout = stdout.decode(errors="replace")
+            if isinstance(stderr, bytes):
+                stderr = stderr.decode(errors="replace")
+            result = subprocess.CompletedProcess(command, 124, stdout, stderr + "\nTIMEOUT after 60 seconds\n")
+        (evidence / f"{step}.stdout.log").write_text(result.stdout)
+        (evidence / f"{step}.stderr.log").write_text(result.stderr)
+        records.append({"step": step, "argv": command, "exit_code": result.returncode,
+                        "status": "PASS" if result.returncode == 0 else "FAIL"})
+        if result.returncode:
+            print(result.stdout, end="")
+            print(result.stderr, end="")
+            break
+        if step == "run-1":
+            print(result.stdout, end="")
+    report = {"schema": "metaengine.guardian.original-main-lifecycle-composition.v1",
+              "source_hashes": before, "production_fragments_byte_exact": True,
+              "source_unchanged": all(sha(Path(path)) == value for path, value in before.items()),
+              "commands": records, "sanitizer": args.sanitizer,
+              "windows_execution": "NOT RUN", "native_authority": "NOT RUN", "installation_qualification": "NOT RUN"}
+    (evidence / "commands-results.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"evidence": str(evidence), "steps": len(records), "sanitizer": args.sanitizer,
