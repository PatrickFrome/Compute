+        !s.original_service_token.valid() && !s.server_process.valid(), "failed native transport retained pipe or owned readers");
+    no_authority(peer);
+}
+void reader_refused(Peer& peer) {
+    require(!peer.connectOriginalNativeHostAuthority(), "synthetic reader forged native-host authority success");
+    transport_dropped(peer);
+}
+void attach(Peer& peer) { peer.state_->pipe.reset(world.create(Kind::Pipe, true)); }
+void reader_acquired(Peer& peer) {
