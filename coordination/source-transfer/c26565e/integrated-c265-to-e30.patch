+        (temp / "scope-model-session-field.inc.hpp").write_text(session_scope)
+        (temp / "scope-model-pipe-field.inc.hpp").write_text(pipe_scope)
+        (temp / "scope-model-pipe-connection.inc.hpp").write_text(pipe_connection)
+        (temp / "scope-model-pipe-revert-getter.inc.hpp").write_text(revert_getter)
+        (temp / "scope-model-observation-helper.inc.hpp").write_text(observation_helper)
