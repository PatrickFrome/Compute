+        pipe_connection_method_sha256=hashlib.sha256(pipe_connection.encode()).hexdigest(),
+        pipe_revert_getter_sha256=hashlib.sha256(revert_getter.encode()).hexdigest(),
+        fatal_observation_helper_sha256=hashlib.sha256(observation_helper.encode()).hexdigest(),
+    )
+    with tempfile.TemporaryDirectory(prefix="guardian-main-launch-scope-model-") as temporary:
