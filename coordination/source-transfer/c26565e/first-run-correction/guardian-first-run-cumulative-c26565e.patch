index 0000000000000000000000000000000000000000..13785ace7390e76d036d784b795a614e52ae2b37
--- /dev/null
+++ b/apps/metaengine-browser/src/fresh-provider-restart-fence.mjs
@@ -0,0 +1,24 @@
+const ROOT_NAME = 'client-first-run-v1';
+
+function claimsFreshLayout(config) {
+  const files = [config?.runtime_identity_file, config?.runtime_host?.config_file];
+  // Either path claiming METAENGINE's reserved fresh tree activates the fence;
+  // an unrelated user/parent named client-first-run-v1 does not. Inspect raw
+  // components so '..' cannot normalize an interrupted fresh claim away.
+  return files.some(file => {
+    if (typeof file !== 'string') return false;
+    const parts = file.split(/[\\/]/).filter(Boolean).map(part => part.toLowerCase());
+    return parts.some((part, index) => part === 'metaengine' && parts[index + 1] === ROOT_NAME);
+  });
+}
+
+// The fresh operator's journal is writable/deletable by its current OS owner.
+// Canonical terminal JSON, matching public hashes, file identity or an owner-only
+// DACL cannot prove original installation or native first-Owner completion.
+// This composition has no genuine native completion producer to clear the fence.
+// Keep every recognized fresh restart on HOLD without reading, repairing or
+// trusting journal bytes, caller completion flags, credentials or ACL assertions.
+// Unrelated attached/upgrade providers retain their existing admission checks.
+export async function assertFreshProviderRestartFence(config) {
+  if (claimsFreshLayout(config)) throw new Error('local_state_provider_fresh_install_incomplete');
+}
