+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import test from 'node:test';
+import vm from 'node:vm';
+import { createBrowserGuardianMachineBootstrapLauncher } from '../src/browser-guardian-machine-bootstrap-launcher.mjs';
+import { createBrowserGuardianStatusObserver } from '../src/browser-guardian-status-observer.mjs';
+import { BROWSER_GUARDIAN_UPDATE_ACTUATOR_PIPE } from '../src/browser-guardian-update-actuator-client.mjs';
+
+// Production Main/observer/launcher/actuator/read-pipe methods, with generated
+// files, signing data and EventEmitter sockets only. No Windows, package-signing,
+// DPAPI, real credential, native process or database qualification is claimed.
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const fingerprint = 'd'.repeat(64);
+function tracked(promise) {
+  let settled = false;
+  promise.then(() => { settled = true; }, () => { settled = true; });
+  return { promise, get settled() { return settled; } };
+}
+function hold(reason) {
+  return Object.freeze({
+    schema: 'metaengine.browser-guardian.machine-bootstrap-launcher.v1',
+    state: 'HOLD', reason, ready: false, guardian_service_ready: false,
+    owner_binding_proven: false, device_binding_proven: false,
+    explicit_user_action_required: true, uac_consent_required: false,
+    fixed_packaged_bootstrap: true, caller_supplied_path_used: false,
+    caller_supplied_arguments_used: false, arbitrary_shell_used: false,
+    automatic_retry_allowed: false, authority_effect: false,
+  });
+}
+const boundResponse = {
+  schema: 'metaengine.browser-guardian.update-actuator-result.v1',
+  state: 'OWNER_BOUND', reason: 'SYNTHETIC_TEST_RESPONSE_ONLY',
+  effect_absent_proven: true, owner_binding_proven: true,
+  device_binding_proven: true, device_key_fingerprint_sha256: fingerprint,
+  automatic_retry_allowed: false, caller_supplied_path_used: false,
+  caller_supplied_url_used: false, caller_supplied_shell_used: false,
+  authority_effect: false,
+};
+
+async function fixture(t) {
+  const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'guardian-status-cancellation-'));
+  t.after(() => fs.rm(directory, { recursive: true, force: true }));
+  const version = '0.7.0-dev.2.1', head = 'a'.repeat(40);
+  const name = `METAENGINE-Guardian-Bootstrap-${version}-x64.exe`;
+  const bytes = Buffer.alloc(64 * 1024, 0x41);
+  await fs.mkdir(path.join(directory, 'guardian-bootstrap'));
+  await fs.writeFile(path.join(directory, 'guardian-bootstrap', name), bytes);
+  const binding = {
+    schema: 'metaengine.browser-guardian.machine-bootstrap-binding.v1',
+    source_head: head, package_version: version,
+    slot_id: '0123456789abcdef-fedcba9876543210', bootstrap_name: name,
+    bootstrap_sha256: createHash('sha256').update(bytes).digest('hex'),
+    bootstrap_size: bytes.length, guardian_manifest_sha256: 'b'.repeat(64),
+    service_sha256: 'c'.repeat(64), configurator_sha256: 'd'.repeat(64),
+    embedded_assets_only: true, explicit_elevated_install_required: true,
+    automatic_retry_allowed: false, authority_effect: false,
+  };
+  let signerReads = 0, legacyReads = 0, bindingReads = 0, elevations = 0;
+  const identity = {
+    randomNonce: () => 'a'.repeat(32),
+    guardianOwnerReadChallenge() {
+      signerReads++;
+      return { public_jwk: { kty: 'EC', crv: 'P-256', x: 'A'.repeat(43), y: 'B'.repeat(43) },
+        signature: 'C'.repeat(86), key_fingerprint_sha256: fingerprint };
+    },
+    guardianOwnerChallenge() { legacyReads++; throw Error('ensure-capable signer forbidden'); },
+    guardianUpdateActuatorProof() { throw Error('effectful signer forbidden'); },
+  };
+  const launcher = createBrowserGuardianMachineBootstrapLauncher({
+    platform: 'win32', isPackaged: true, resourcesPath: directory, version, identity,
+    openPath() { elevations++; throw Error('native launch forbidden'); },
+    trustRootLoader: () => ({ build_sha: head }),
+    bindingLoader: () => { bindingReads++; return binding; },
+  });
+  const platform = Object.getOwnPropertyDescriptor(process, 'platform');
+  Object.defineProperty(process, 'platform', { ...platform, value: 'win32' });
+  t.after(() => Object.defineProperty(process, 'platform', platform));
+  const sockets = [];
+  t.mock.method(net, 'createConnection', pipe => {
+    assert.equal(pipe, BROWSER_GUARDIAN_UPDATE_ACTUATOR_PIPE);
+    const socket = new EventEmitter();
+    socket.writes = [];
+    socket.destroyCalls = 0;
+    socket.destroy = () => { socket.destroyCalls++; return socket; };
+    socket.setTimeout = () => socket;
+    socket.write = value => { socket.writes.push(value); return true; };
+    sockets.push(socket);
+    return socket;
+  });
+  // Explicit synthetic fixture cleanup only. Tests assert that an absent close
+  // notification cannot settle a production read; destroy never emits it here.
+  t.after(async () => { for (const socket of sockets) socket.emit('close'); await tick(); });
+  t.mock.timers.enable({ apis: ['setTimeout'] });
+  const main = await fs.readFile(new URL('../src/main.mjs', import.meta.url), 'utf8');
