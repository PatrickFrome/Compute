+  const end = main.indexOf('\nasync function initGithubChatRelay(', start);
+  assert.ok(start >= 0 && end > start);
+  const ensureObserver = vm.runInNewContext(`let guardianStatusObserver = null;\n${main.slice(start, end)}\nensureGuardianStatusObserver`, {
+    createBrowserGuardianStatusObserver,
+    ensureGuardianBootstrapLauncher: () => launcher,
+  });
+  return { observer: ensureObserver(), sockets, main,
+    counters: () => ({ signerReads, legacyReads, bindingReads, elevations }) };
+}
+
+test('quiesce before loaded dispatch passes an already-aborted signal and opens no pipe', async t => {
+  const f = await fixture(t);
+  const reading = tracked(f.observer.observe({ force: true }));
+  const joining = tracked(f.observer.quiesce());
+  await Promise.all([reading.promise, joining.promise]);
