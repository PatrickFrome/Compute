+  assert.equal(f.sockets.length, 0);
+  assert.equal((await f.observer.observe({ force: true })).state, 'HOLD');
+  assert.equal(f.observer.refreshIfDue(), false);
+  assert.equal(f.sockets.length, 0);
+});
+
+for (const connected of [false, true]) {
+  test(`quiesce aborts the original hung read but joins only its actual close; connected=${connected}`, async t => {
+    const f = await fixture(t);
+    const reading = tracked(f.observer.observe({ force: true }));
+    await tick();
+    assert.equal(f.sockets.length, 1);
+    const [socket] = f.sockets;
+    if (connected) socket.emit('connect');
+    const joining = tracked(f.observer.quiesce());
+    assert.strictEqual(f.observer.quiesce(), joining.promise);
+    assert.equal(socket.destroyCalls, 1, 'observer cancellation must reach the real fixed read-pipe method');
+    socket.emit('connect');
+    socket.emit('data', Buffer.from(JSON.stringify(boundResponse) + '\n'));
+    socket.emit('end');
+    t.mock.timers.tick(30_000);
+    await reading.promise;
+    await tick();
+    assert.equal(joining.settled, false);
+    assert.equal(f.observer.snapshot().state, 'HOLD');
+    assert.equal(f.observer.snapshot().owner_binding_proven, false);
+    assert.equal(socket.writes.length, connected ? 1 : 0);
+    assert.equal((await f.observer.observe({ force: true })).state, 'HOLD');
