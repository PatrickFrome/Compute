+function terminalRecord() {
+  const public_jwk = { crv: 'P-256', ext: true, key_ops: ['verify'], kty: 'EC', x: 'A'.repeat(43), y: 'B'.repeat(43) };
+  return { schema: 'compute.fresh-client-install-journal.v1', stage: 'PROVIDER_CONFIGURED_DEVICE_ADMIN_VERIFIED',
+    bundle_sha256: digest, automatic_retry_allowed: false, device_enrolled: true, guardian_ready: false,
+    device_enrollment: { cluster_system_identifier: '765432109876543210', runtime_instance_id: historicalInstance,
+      client_id: '33333333-3333-4333-8333-333333333333', profile: 'A2_DEVICE_HTTP_SIGNATURE_V1', public_jwk,
+      key_fingerprint_sha256: createHash('sha256').update(JSON.stringify(public_jwk)).digest('hex'),
+      request_id: '44444444-4444-4444-8444-444444444444', requested_at: '2026-01-01T00:00:00.123Z',
+      expires_at: '2026-01-01T00:30:00.123Z', requested_at_db: '2026-01-01 00:00:00.123456+00',
+      expires_at_db: '2026-01-01 00:30:00.123456+00', device_id: '55555555-5555-4555-8555-555555555555' } };
+}
+
+async function fixture(t) {
+  const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'fresh-provider-restart-fence-'));
+  t.after(() => fs.rm(directory, { recursive: true, force: true }));
+  const local = path.join(directory, 'local'), appData = path.join(directory, 'roaming');
+  const root = path.join(local, 'METAENGINE', 'client-first-run-v1'), runtime = path.join(root, 'runtime');
+  await fs.mkdir(runtime, { recursive: true });
+  const ownerFile = localStateProviderOwnerFile({ env: { APPDATA: appData }, platform: 'win32' });
+  const owner = { schema: 'metaengine.browser.local-state-provider-config.v1', version: 1, profile: 'CLIENT_LOCAL_POSTGRES_V1',
+    provider: 'LOCAL_POSTGRES', base_url: 'http://127.0.0.1:15433/a2-browser-native-supervisor-v1',
+    runtime_identity_file: path.join(runtime, 'runtime-instance.json'),
+    runtime_host: { bundle_directory: path.join(directory, 'verified-bundle-fixture'), expected_bundle_sha256: digest,
