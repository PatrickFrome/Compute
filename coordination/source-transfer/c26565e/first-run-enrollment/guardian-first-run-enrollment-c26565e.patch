+    endpoint: owner.base_url, runtime_ready: true, state_provider: 'LOCAL_POSTGRES', hosted_supabase_required: false,
+    automatic_cloud_fallback: false, capability_health: { state: 'ATTESTED', authority_effect: false }, authority_effect: false };
+  await fs.writeFile(owner.runtime_identity_file, JSON.stringify(identity));
