+const bootstrapUrl = new URL('../src/local-state-provider-bootstrap.mjs', import.meta.url).href;
+const hostModule = `
+  export async function startConfiguredLocalRuntimeHost() {
+    globalThis.__freshProviderRestartFenceTestEffects.starts++; return null;
+  }
+  export async function stopOwnedLocalRuntimeHost() {
+    globalThis.__freshProviderRestartFenceTestEffects.stops++; return {cleanup_confirmed:true};
+  }
+  export function ownedLocalRuntimeHostReady() { return true; }
+`;
+const hook = registerHooks({ resolve(specifier, context, next) {
+  if (context.parentURL === bootstrapUrl && specifier === './local-runtime-host-controller.mjs')
+    return { url: `data:text/javascript,${encodeURIComponent(hostModule)}`, shortCircuit: true };
