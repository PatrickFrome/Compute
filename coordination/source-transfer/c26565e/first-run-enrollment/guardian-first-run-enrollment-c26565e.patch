diff --git a/apps/metaengine-browser/src/fresh-provider-restart-fence.mjs b/apps/metaengine-browser/src/fresh-provider-restart-fence.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7be408a065c8e8819270ac8dff1c92c50b898984
--- /dev/null
+++ b/apps/metaengine-browser/src/fresh-provider-restart-fence.mjs
@@ -0,0 +1,114 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+
+const ROOT_NAME = 'client-first-run-v1';
+const JOURNAL_LIMIT = 16384;
+const SHA256 = /^[a-f0-9]{64}$/;
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+const fail = () => { throw new Error('local_state_provider_fresh_install_incomplete'); };
+const samePath = (a, b) => path.resolve(a).toLowerCase() === path.resolve(b).toLowerCase();
+const exactKeys = (value, keys) => value && typeof value === 'object' && !Array.isArray(value)
+  && Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key));
+
+function freshJournalFile(config, env) {
+  const files = [config?.runtime_identity_file, config?.runtime_host?.config_file];
+  // Either path claiming METAENGINE's reserved fresh tree activates the fence;
+  // an unrelated user/parent named client-first-run-v1 does not. Inspect raw
+  // components so '..' cannot normalize an interrupted fresh claim away.
+  if (!files.some(file => {
+    if (typeof file !== 'string') return false;
+    const parts = file.split(/[\\/]/).filter(Boolean).map(part => part.toLowerCase());
+    return parts.some((part, index) => part === 'metaengine' && parts[index + 1] === ROOT_NAME);
+  })) return null;
+  if (typeof env.LOCALAPPDATA !== 'string' || !path.isAbsolute(env.LOCALAPPDATA)
+    || /^(?:\\\\|\/\/)/.test(env.LOCALAPPDATA) || /[\x00-\x1f]/.test(env.LOCALAPPDATA)) fail();
+  const root = path.join(env.LOCALAPPDATA, 'METAENGINE', ROOT_NAME);
+  if (!files.every(file => typeof file === 'string' && path.isAbsolute(file))
+    || !samePath(files[0], path.join(root, 'runtime', 'runtime-instance.json'))
+    || !samePath(files[1], path.join(root, 'runtime', 'host-config.json'))
+    || !SHA256.test(config.runtime_host.expected_bundle_sha256 || '')) fail();
+  return path.join(root, 'install-journal.json');
+}
+
+const sameObject = (a, b) => a.dev === b.dev && a.ino === b.ino;
+const regularJournal = stat => stat.isFile() && !stat.isSymbolicLink()
+  && stat.nlink === 1 && stat.size > 0 && stat.size <= JOURNAL_LIMIT;
+
+async function readJournal(file) {
+  const parents = [];
+  let current = path.parse(file).root;
+  for (const part of path.relative(current, path.dirname(file)).split(path.sep).filter(Boolean)) {
+    current = path.join(current, part);
+    const stat = await fs.lstat(current);
+    if (!stat.isDirectory() || stat.isSymbolicLink()) fail();
+    parents.push({ file: current, stat });
+  }
+  const before = await fs.lstat(file);
+  if (!regularJournal(before)) fail();
+  const handle = await fs.open(file, 'r');
+  try {
+    const opened = await handle.stat();
+    if (!regularJournal(opened) || !sameObject(before, opened)) fail();
+    const bytes = Buffer.alloc(JOURNAL_LIMIT + 1);
+    const { bytesRead } = await handle.read(bytes, 0, bytes.length, 0);
+    const after = await handle.stat(), named = await fs.lstat(file);
+    if (bytesRead !== opened.size || !regularJournal(after) || !regularJournal(named)
+      || !sameObject(opened, after) || !sameObject(after, named)
+      || opened.size !== after.size || opened.mtimeMs !== after.mtimeMs || opened.ctimeMs !== after.ctimeMs) fail();
+    for (const parent of parents) {
+      const stat = await fs.lstat(parent.file);
+      if (!stat.isDirectory() || stat.isSymbolicLink() || !sameObject(parent.stat, stat)) fail();
+    }
+    const content = bytes.subarray(0, bytesRead), record = JSON.parse(content.toString('utf8'));
+    // The sole writer uses exactly JSON.stringify(record) plus one newline.
+    // Refuse duplicate keys, invalid UTF-8 and partial/noncanonical rewrites.
+    if (!content.equals(Buffer.from(JSON.stringify(record) + '\n'))) fail();
+    return record;
+  } finally { await handle.close(); }
+}
+
+function terminalJournal(record, config) {
+  if (!exactKeys(record, ['schema', 'stage', 'bundle_sha256', 'automatic_retry_allowed',
+    'device_enrolled', 'guardian_ready', 'device_enrollment'])
+    || record.schema !== 'compute.fresh-client-install-journal.v1'
+    || record.stage !== 'PROVIDER_CONFIGURED_DEVICE_ADMIN_VERIFIED'
+    || record.bundle_sha256 !== config.runtime_host.expected_bundle_sha256
+    || record.automatic_retry_allowed !== false || record.device_enrolled !== true
+    || record.guardian_ready !== false) fail();
+  const binding = record.device_enrollment;
+  if (!exactKeys(binding, ['cluster_system_identifier', 'runtime_instance_id', 'client_id', 'profile',
+    'public_jwk', 'key_fingerprint_sha256', 'request_id', 'requested_at', 'expires_at',
+    'requested_at_db', 'expires_at_db', 'device_id'])
+    || typeof binding.cluster_system_identifier !== 'string'
+    || !/^[1-9][0-9]{0,19}$/.test(binding.cluster_system_identifier)
+    || !['runtime_instance_id', 'client_id', 'request_id', 'device_id'].every(key => UUID.test(binding[key] || ''))
+    || binding.profile !== 'A2_DEVICE_HTTP_SIGNATURE_V1' || !SHA256.test(binding.key_fingerprint_sha256 || '')) fail();
+  const key = binding.public_jwk;
+  if (!exactKeys(key, ['crv', 'ext', 'key_ops', 'kty', 'x', 'y']) || key.crv !== 'P-256'
+    || key.ext !== true || key.kty !== 'EC' || JSON.stringify(key.key_ops) !== '["verify"]'
+    || !/^[A-Za-z0-9_-]{43}$/.test(key.x || '') || !/^[A-Za-z0-9_-]{43}$/.test(key.y || '')) fail();
+  const canonical = { crv: key.crv, ext: true, key_ops: ['verify'], kty: key.kty, x: key.x, y: key.y };
+  if (createHash('sha256').update(JSON.stringify(canonical)).digest('hex') !== binding.key_fingerprint_sha256) fail();
+  // These are historical enrollment observations. Normal restart changes the
+  // runtime UUID, and expiration of the old request does not undo its commit.
+  for (const key of ['requested_at', 'expires_at', 'requested_at_db', 'expires_at_db']) {
+    if (typeof binding[key] !== 'string' || binding[key].length > 128
+      || !Number.isFinite(Date.parse(binding[key]))) fail();
+  }
+  if (Date.parse(binding.requested_at) !== Date.parse(binding.requested_at_db)
+    || Date.parse(binding.expires_at) !== Date.parse(binding.expires_at_db)
+    || Date.parse(binding.expires_at) <= Date.parse(binding.requested_at)) fail();
+}
+
+// A denial-only restart fence for the existing fresh operator's fixed layout.
+// An Owner profile can be published before its terminal journal append fails.
+// Reading a terminal record merely removes that interruption veto; this helper
+// issues no READY, provenance, native Owner, Guardian, device or task authority.
+// The original runtime/PG/health admission checks must still run afterwards.
+export async function assertFreshProviderRestartFence(config, { env = process.env } = {}) {
+  try {
+    const file = freshJournalFile(config, env);
+    if (file) terminalJournal(await readJournal(file), config);
+  } catch { fail(); }
+}
