+import { provisionPersistentClientProvider } from '../../../infra/client-state-runtime/persistent-client-provider.mjs';
+import { localStateProviderOwnerFile, validateLocalStateProviderConfig } from '../src/local-state-provider-policy.mjs';
+
+const digest = 'a'.repeat(64);
+const currentInstance = '11111111-1111-4111-8111-111111111111';
+const historicalInstance = '22222222-2222-4222-8222-222222222222';
+const failure = /^Error: local_state_provider_fresh_install_incomplete$/;
