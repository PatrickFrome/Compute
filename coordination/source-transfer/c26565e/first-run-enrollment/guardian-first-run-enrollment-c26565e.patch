diff --git a/apps/metaengine-browser/test/browser-guardian-loaded-status-reader.test.mjs b/apps/metaengine-browser/test/browser-guardian-loaded-status-reader.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..925188462d74cb59ac25829dc1d83e02303b2d82
--- /dev/null
+++ b/apps/metaengine-browser/test/browser-guardian-loaded-status-reader.test.mjs
@@ -0,0 +1,196 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import test from 'node:test';
+import vm from 'node:vm';
+
+import { createBrowserGuardianStatusObserver } from '../src/browser-guardian-status-observer.mjs';
+
+// Source-only control-flow fixtures. No Electron, credentials, OS pipe, native
+// admission or database is acquired. Positive diagnostics below are test data.
+const tick = () => new Promise(resolve => setImmediate(resolve));
+function deferred() {
+  let resolve, reject;
+  const promise = new Promise((done, fail) => { resolve = done; reject = fail; });
+  return { promise, resolve, reject };
+}
+function hold(reason) {
+  return Object.freeze({
+    schema: 'metaengine.browser-guardian.machine-bootstrap-launcher.v1',
+    state: 'HOLD', reason, ready: false, guardian_service_ready: false,
+    owner_binding_proven: false, device_binding_proven: false,
+    explicit_user_action_required: true, uac_consent_required: false,
+    fixed_packaged_bootstrap: true, caller_supplied_path_used: false,
+    caller_supplied_arguments_used: false, arbitrary_shell_used: false,
+    automatic_retry_allowed: false, authority_effect: false,
+  });
+}
+function ready(reason) {
+  return Object.freeze({ ...hold(reason), state: 'READY', ready: true,
+    guardian_service_ready: true, owner_binding_proven: true,
+    device_binding_proven: true, explicit_user_action_required: false });
+}
+function deadlines() {
+  const timers = new Set();
+  return {
+    setTimeoutImpl(callback) { timers.add(callback); return callback; },
+    clearTimeoutImpl(callback) { timers.delete(callback); },
+    expire() {
+      assert.equal(timers.size, 1);
+      const [callback] = timers;
+      timers.delete(callback);
+      callback();
+    },
+  };
+}
+
+test('Main Guardian status uses its cached loaded-only reader without credential initialization or legacy fallback', async () => {
+  const main = fs.readFileSync(new URL('../src/main.mjs', import.meta.url), 'utf8');
+  const start = main.indexOf('function ensureGuardianStatusObserver() {');
+  const end = main.indexOf('\nasync function initGithubChatRelay(', start);
+  assert.ok(start >= 0 && end > start);
+  const source = main.slice(start, end);
+  assert.match(source, /readStatus:\s*\(\) => ensureGuardianBootstrapLauncher\(\)\.statusLoaded\(\)/);
+  assert.doesNotMatch(source, /\.status\(|\.ensure\(|\.activate\(/);
+  let loaded = 0, legacy = 0, initializations = 0;
+  const launcher = {
+    statusLoaded() { loaded++; return Promise.resolve(hold('DEVICE_NOT_LOADED')); },
+    status() { legacy++; throw Error('legacy owner status forbidden'); },
+    ensure() { initializations++; throw Error('credential initialization forbidden'); },
+  };
+  // Execute the exact Main observer factory, without evaluating Main's imports
+  // or starting Electron. The real status observer is used unchanged.
+  const ensureObserver = vm.runInNewContext(`let guardianStatusObserver = null;\n${source}\nensureGuardianStatusObserver`, {
+    createBrowserGuardianStatusObserver,
+    ensureGuardianBootstrapLauncher: () => launcher,
+  });
+  const observer = ensureObserver();
+  assert.strictEqual(ensureObserver(), observer);
+  const value = await observer.observe({ force: true });
+  assert.equal(value.state, 'HOLD');
+  assert.equal(value.reason, 'DEVICE_NOT_LOADED');
+  assert.equal(value.authority_effect, false);
+  assert.equal(loaded, 1);
+  assert.equal(legacy, 0);
+  assert.equal(initializations, 0);
+});
+
+test('diagnostic timeout and forced refresh retain one original loaded read until it actually settles', async () => {
+  const original = deferred(), timer = deadlines();
+  let calls = 0;
+  const readStatus = () => {
+    calls++;
+    return calls === 1 ? original.promise : Promise.resolve(hold('CURRENT_READ'));
+  };
+  const observer = createBrowserGuardianStatusObserver({ readStatus, ...timer });
+  const first = observer.observe({ force: true });
+  await tick();
+  timer.expire();
+  assert.equal((await first).state, 'HOLD');
+  assert.match(observer.snapshot().observation_error, /observation_deadline/);
+  assert.equal(observer.snapshot().refresh_in_flight, true);
+  for (let refresh = 0; refresh < 3; refresh++) {
+    assert.equal((await observer.observe({ force: true })).state, 'HOLD');
+    assert.equal(observer.refreshIfDue(), false);
+  }
+  assert.equal(calls, 1);
+  original.resolve(ready('LATE_ORIGINAL_READ'));
+  await tick();
+  assert.equal(observer.snapshot().state, 'HOLD');
+  assert.equal(observer.snapshot().observation_revision, 0);
+  assert.equal(observer.snapshot().refresh_in_flight, false);
+  assert.equal((await observer.observe({ force: true })).reason, 'CURRENT_READ');
+  assert.equal(calls, 2);
+});
+
+test('success, rejection and synchronous source failure release only their settled read without automatic retry', async () => {
+  const original = deferred();
+  let calls = 0;
+  const observer = createBrowserGuardianStatusObserver({ readStatus: () => {
+    calls++;
+    if (calls === 1) return original.promise;
+    if (calls === 2) throw Error('source unavailable');
+    return hold('LATER_READ');
+  } });
+  const first = observer.observe({ force: true });
+  await tick();
+  original.reject(Error('original close failed'));
+  assert.match((await first).observation_error, /original close failed/);
+  await tick();
+  assert.equal(calls, 1);
+  assert.match((await observer.observe({ force: true })).observation_error, /source unavailable/);
+  assert.equal(calls, 2);
+  assert.equal((await observer.observe({ force: true })).reason, 'LATER_READ');
+  assert.equal((await observer.observe({ force: true })).reason, 'LATER_READ');
+  assert.equal(calls, 4);
+});
+
+for (const timeoutFirst of [false, true]) {
+  test(`invalidation and forced refresh cannot rebind an old read to the new generation; timeout first=${timeoutFirst}`, async () => {
+    const original = deferred(), timer = deadlines();
+    let calls = 0;
+    const observer = createBrowserGuardianStatusObserver({ readStatus: () => {
+      calls++;
+      return calls === 1 ? original.promise : hold('CURRENT_GENERATION_READ');
+    }, ...timer });
+    const oldRead = observer.observe({ force: true });
+    await tick();
+    if (timeoutFirst) { timer.expire(); await oldRead; }
+    observer.invalidate('GUARDIAN_ACTIVATION_STARTED');
+    const refresh = observer.observe({ force: true });
+    if (!timeoutFirst) { timer.expire(); await oldRead; }
+    assert.equal((await refresh).state, 'HOLD');
+    assert.equal(calls, 1);
+    original.resolve(ready('STALE_PRE_INVALIDATION_READ'));
+    await tick();
+    const after = observer.snapshot();
+    assert.equal(after.state, 'HOLD');
+    assert.equal(after.reason, 'GUARDIAN_ACTIVATION_STARTED');
+    assert.equal(after.observation_revision, 0);
+    assert.equal(after.owner_binding_proven, false);
+    assert.equal((await observer.observe({ force: true })).reason, 'CURRENT_GENERATION_READ');
+    assert.equal(calls, 2);
+  });
+}
+
+for (const quiesceFirst of [false, true]) {
+  test(`quiesce retains the actual loaded read through its diagnostic deadline; quiesce first=${quiesceFirst}`, async () => {
+    const original = deferred(), timer = deadlines();
+    let calls = 0, settled = false;
+    const observer = createBrowserGuardianStatusObserver({ readStatus: () => { calls++; return original.promise; }, ...timer });
+    const reading = observer.observe({ force: true });
+    await tick();
+    let quiescing;
+    if (quiesceFirst) quiescing = observer.quiesce().then(value => { settled = true; return value; });
+    timer.expire();
+    await reading;
+    if (!quiesceFirst) quiescing = observer.quiesce().then(value => { settled = true; return value; });
+    await tick();
+    assert.equal(settled, false, 'diagnostic timeout is not physical source cleanup');
+    assert.equal((await observer.observe({ force: true })).state, 'HOLD');
+    assert.equal(calls, 1);
+    if (quiesceFirst) original.resolve(hold('ORIGINAL_READ_CLOSED'));
+    else original.reject(Error('original read closed after error'));
+    await quiescing;
+    assert.equal(settled, true);
+    assert.equal(observer.snapshot().refresh_in_flight, false);
+    assert.equal(calls, 1);
+  });
+}
+
+test('late old loaded-read completion cannot replace a newer recorded Guardian diagnostic', async () => {
+  const original = deferred(), timer = deadlines();
+  let calls = 0;
+  const readStatus = () => { calls++; return original.promise; };
+  const observer = createBrowserGuardianStatusObserver({ readStatus, ...timer });
+  const reading = observer.observe({ force: true });
+  await tick();
+  observer.invalidate('GUARDIAN_ACTIVATION_STARTED');
+  observer.record(hold('NEWER_RECORDED_DIAGNOSTIC'));
+  const refresh = observer.observe({ force: true });
+  original.resolve(ready('STALE_OLD_DIAGNOSTIC'));
+  await Promise.all([reading, refresh]);
+  assert.equal(observer.snapshot().reason, 'NEWER_RECORDED_DIAGNOSTIC');
+  assert.equal(observer.snapshot().observation_revision, 1);
+  assert.equal(observer.snapshot().authority_effect, false);
+  assert.equal(calls, 1);
+});
