+  assert.equal(response.status, 200);
+  const result = await response.json();
+  assert.equal(result.meta_orchestrator.state, 'PROVIDER_NOT_READY');
+  assert.equal(result.automatic_retry_allowed, false);
+  assert.equal(names.filter(name => name === 'devos_fleet_reconcile_v1').length, 1);
