@@ -0,0 +1,223 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compileMetaPlan, assertZeroAuthorityMetaOutput } from '../src/meta-orchestrator-core.mjs';
+import { reconcileContinuousMetaOrchestrator } from '../src/meta-orchestrator-continuous-reconcile.mjs';
+import {
+  buildMetaAuthoritativeSnapshot,
+  reconcileMetaAuthoritativeSnapshot,
+} from '../src/meta-orchestrator-authoritative-snapshot.mjs';
+import { MetaOrchestratorPrivilegedAdapter } from '../src/meta-orchestrator-privileged-adapter.mjs';
+import { createMetaDevosSuperstep } from '../supabase/a2-browser-native-supervisor-v1/meta-devos-superstep.mjs';
+import { createDevosSupervisorRoutes } from '../supabase/a2-browser-native-supervisor-v1/devos-routes.mjs';
+
+const WS = '2de9f84b-7c0a-4091-911c-894ff1d6eaf4';
+const ROADMAP = 'metaengine-development-os-v1';
+const SHA = 'd91e94b307ed60e890aabc53a2678a8ae9c6a79d';
+const authority = {
+  authority_key: 'METAENGINE_DEVOS', roadmap_id: ROADMAP,
+  active_milestone_key: 'META_ORCHESTRATOR_V1', integration_line: 'integration/metaengine-development-os-v1',
+  baseline_sha: SHA, alignment_epoch: 7, updated_at: '2026-11-05T00:00:00Z',
+};
+const plan = compileMetaPlan({ authority, plan_generation: 3, nodes: [
+  { point_id: 'meta.core', role: 'IMPLEMENTER', objective: 'Verify parent/child closure', risk: 'NORMAL',
+    evidence_contract: { required: ['roadmap_receipt:mainline_seal'], min_verified: 1 } },
+] });
+const receipt = { roadmap_id: ROADMAP, milestone_key: 'meta.core', step_kind: 'MAINLINE_SEAL',
+  status: 'VERIFIED', result_checkpoint_id: 'verified_checkpoint_001', receipt_id: 1 };
+function rawTask(point_id, state, taskSequence = 1, generation = 1, planGeneration = 3) {
+  return { task_id: `00000000-0000-4000-8000-${String(taskSequence).padStart(12, '0')}`,
+    point_id, state, role: point_id === 'meta.core' ? 'IMPLEMENTER' : 'CRITIC',
+    base_sha: SHA, lease_generation: generation, authority_effect: false,
+    task_spec: { meta_orchestrator: {
+      roadmap_id: ROADMAP, alignment_epoch: 7, plan_generation: planGeneration,
+      parent_plan_point: 'meta.core', parent_point_id: point_id === 'meta.core' ? null : 'meta.core',
+    } },
+  };
+}
+function planState() { return {
+  schema: 'metaengine.meta-orchestrator.plan-state.v1', found: true,
+  workspace_id: WS, roadmap_id: ROADMAP, plan_generation: 3, alignment_epoch: 7,
+  baseline_sha: SHA, plan_sha256: 'a'.repeat(64), plan_spec: plan, state: 'ACTIVE',
+  automatic_retry_allowed: false, scheduler_authority: false, browser_authority: false,
+  release_authority: false, authority_effect: false,
+}; }
+function inputRows(tasks) { return {
+  schema: 'metaengine.meta-orchestrator.authoritative-inputs.v1', workspace_id: WS,
+  roadmap_id: ROADMAP, roadmap_authority: authority, plan_state: planState(),
+  tasks, roadmap_receipts: [receipt],
+  capacity: { source: 'DEVOS_SCHEDULER_SNAPSHOT', available_slots: 0 },
+  task_meta_projection_only: true, task_payload_exposed: false, result_summary_exposed: false,
+  scheduler_identity_exposed: false, receipt_summary_exposed: false, receipt_evidence_exposed: false,
+  automatic_retry_allowed: false, task_content_authority: false, scheduler_authority: false,
+  browser_authority: false, release_authority: false, authority_effect: false,
+}; }
+const leader = { expected_epoch: 9, observed_epoch: 9 };
+const parent = () => rawTask('meta.core', 'COMPLETED', 1);
+const child = (state, i = 2, point = 'meta.core.critic', generation = 1) => rawTask(point, state, i, generation);
+function snapshot(rows) { return buildMetaAuthoritativeSnapshot({
+  roadmapAuthority: authority, plan, observedPlanGeneration: 3,
+  tasks: rows, roadmapReceipts: [receipt],
+  capacity: { source: 'DEVOS_SCHEDULER_SNAPSHOT', available_slots: 0 },
+}); }
+function continuous(rows) {
+  const s = snapshot(rows);
+  return reconcileContinuousMetaOrchestrator({ plan, leader, tasks: s.tasks,
+    evidence: s.evidence, observed_alignment_epoch: 7, observed_plan_generation: 3,
+    capacity: s.capacity });
+}
+function adapter(rows) {
+  return new MetaOrchestratorPrivilegedAdapter({
+    readAuthoritativeInputs: async () => inputRows(rows),
+    activatePlan: async () => { throw new Error('effect_forbidden_in_source_test'); },
+  });
+}
+
+for (const [state, expected] of [
+  ['RUNNING', 'SAFETY_WAIT'], ['AMBIGUOUS', 'RECONCILING'],
+  ['CANCELLED', 'BLOCKED'], ['FAILED', 'BLOCKED'], ['COMPLETED', 'CONVERGED'],
+]) {
+  test(`authoritative snapshot routes ${state} child to ${expected}`, () => {
+    const r = reconcileMetaAuthoritativeSnapshot({ plan, snapshot: snapshot([parent(), child(state)]), leader });
+    assert.equal(r.state, expected);
+    assert.equal(assertZeroAuthorityMetaOutput(r), true);
+    assert.equal(r.actions.some(action => String(action.type).includes('RETRY')), false);
+  });
+  test(`privileged adapter routes ${state} child to ${expected}`, async () => {
+    const r = await adapter([parent(), child(state)]).reconcile({ workspace_id: WS, roadmap_id: ROADMAP, leader });
+    assert.equal(r.state, expected);
+  });
+}
+
+test('production continuous reconciler holds a non-verifier child', () => {
+  const r = continuous([parent(), child('COMPLETED'), child('RUNNING', 3, 'meta.core.audit')]);
+  assert.equal(r.state, 'SAFETY_WAIT');
+});
+test('old ambiguous child effect does not disappear behind newer completed incarnation', () => {
+  const r = continuous([parent(), child('AMBIGUOUS', 2, 'meta.core.audit', 1),
+    child('COMPLETED', 3, 'meta.core.audit', 2), child('COMPLETED', 4)]);
+  assert.equal(r.state, 'RECONCILING');
+  assert.equal(r.actions.some(action => String(action.type).includes('RETRY')), false);
+});
+test('cancelled generic child blocks convergence and is not a success receipt', () => {
+  assert.equal(continuous([parent(), child('CANCELLED', 2, 'meta.core.audit'), child('COMPLETED', 3)]).state, 'BLOCKED');
+});
+test('stale observer plan generation cannot clear safety debt', () => {
+  const old = rawTask('meta.core.critic', 'COMPLETED', 2, 1, 2);
+  assert.notEqual(continuous([parent(), old]).state, 'CONVERGED');
+});
+const complete512 = [parent(), child('COMPLETED'), ...Array.from({ length: 510 }, (_, i) =>
+  child('COMPLETED', i + 3, `meta.core.audit${i}`))];
+
+test('bounded 512-row authoritative SQL result is incomplete until exact producer proves exhaustion', async () => {
+  await assert.rejects(
+    adapter(complete512).readAuthoritativeBundle({ workspace_id: WS, roadmap_id: ROADMAP }),
+    /incomplete|truncat|page_exhaustion/i,
+  );
+});
+
+test('production superstep refuses a potentially truncated 512-row read and never admits', async () => {
+  const calls = [];
+  const rpc = async (name) => {
+    calls.push(name);
+    if (name === 'meta_orchestrator_controller_lease_v1') return {
+      schema: 'metaengine.meta-orchestrator.controller-lease.v1', workspace_id: WS,
+      roadmap_id: ROADMAP, leased: true, leader_epoch: 9, holder_verified: true,
+      not_expired: true, expires_at: '2099-01-01T00:00:00Z', transitions: 1,
+      lease_seconds: 12, scheduler_authority: false, browser_authority: false,
+      release_authority: false, authority_effect: false,
+    };
+    if (name === 'meta_orchestrator_authoritative_inputs_v1') return inputRows(complete512);
+    if (name === 'devos_fleet_capacity_snapshot_v1') return {
+      schema: 'metaengine.devos.scheduler-capacity.v1', workspace_id: WS,
+      source: 'DEVOS_SCHEDULER_SNAPSHOT', state: 'FRESH', available_slots: 0, new_frontier_slots: 0,
+      live_transport_slots: 1, ready_backlog: 0, leased_backlog: 0, running_backlog: 0,
+      result_ready_backlog: 0, ambiguous_backlog: 0, blocked_backlog: 0, active_claims: 0,
+      ready_backlog_limit: 8, ambiguity_pressure_limit: 8, pressure_state: 'NORMAL',
+      transport_admission: 'ACTIVE_EXACT_PROOF_V1', scheduler_source: 'NATIVE_SUPERVISOR_HEARTBEAT',
+      automatic_retry_allowed: false, authority_effect: false,
+    };
+    throw new Error(`unexpected_rpc:${name}`);
+  };
+  const run = createMetaDevosSuperstep({ rpc, workspaceId: WS, roadmapId: ROADMAP });
+  const result = await run({ clientId: 'native:test/browser-1' });
+  assert.equal(result.state, 'PROVIDER_NOT_READY');
+  assert.equal(result.reason, 'PROVIDER_NOT_READY');
+  assert.equal(calls.some(x => x.includes('admit')), false);
+});
+
+
+test('511 fully observed rows do not introduce an artificial fleet-wide cap', () => {
+  const allObserved = complete512.slice(0, 511);
+  const s = snapshot(allObserved);
+  assert.equal(s.tasks.length, 511);
+  assert.equal(reconcileMetaAuthoritativeSnapshot({ plan, snapshot: s, leader }).state, 'CONVERGED');
+});
+
+test('a 512-receipt bounded SQL window fails closed without a trusted exhaustion cursor', () => {
+  assert.throws(() => buildMetaAuthoritativeSnapshot({
+    roadmapAuthority: authority, plan, observedPlanGeneration: 3,
+    tasks: [parent(), child('COMPLETED')],
+    roadmapReceipts: Array.from({ length: 512 }, (_, i) => ({ ...receipt, receipt_id: i + 1 })),
+  }), /incomplete/);
+});
+
+test('old parent ambiguity is not cleared by newer parent completion without readback', () => {
+  const r = continuous([rawTask('meta.core', 'AMBIGUOUS', 40, 1),
+    rawTask('meta.core', 'COMPLETED', 1, 2), child('COMPLETED')]);
+  assert.equal(r.state, 'RECONCILING');
+  assert.equal(r.actions[0].automatic_retry_allowed, false);
+});
+
+test('failed member of critical parent+critic+falsifier group cannot be suppressed', () => {
+  const critical = compileMetaPlan({ authority, plan_generation: 3, nodes: [{
+    point_id: 'meta.core', role: 'IMPLEMENTER', objective: 'test critical partial failure',
+    risk: 'CRITICAL', evidence_contract: { required: ['roadmap_receipt:mainline_seal'], min_verified: 1 },
+  }] });
+  const s = buildMetaAuthoritativeSnapshot({ roadmapAuthority: authority, plan: critical,
+    observedPlanGeneration: 3, tasks: [parent(), child('COMPLETED'),
+      child('FAILED', 3, 'meta.core.falsifier')], roadmapReceipts: [receipt],
+    capacity: { source: 'DEVOS_SCHEDULER_SNAPSHOT', available_slots: 0 },
+  });
+  const r = reconcileMetaAuthoritativeSnapshot({ plan: critical, snapshot: s, leader });
+  assert.equal(r.state, 'BLOCKED');
+  assert.equal(r.actions.some(action => String(action.type).includes('RETRY')), false);
+});
+
+test('production DevOS cycle preserves the existing scheduler when Meta readback is incomplete', async () => {
+  const names = [];
+  const rpc = async (name) => {
+    names.push(name);
+    if (name === 'meta_orchestrator_controller_lease_v1') return {
+      schema: 'metaengine.meta-orchestrator.controller-lease.v1', workspace_id: WS,
+      roadmap_id: ROADMAP, leased: true, leader_epoch: 9, holder_verified: true,
+      not_expired: true, expires_at: '2099-01-01T00:00:00Z',
+      scheduler_authority: false, browser_authority: false, release_authority: false, authority_effect: false,
+    };
+    if (name === 'meta_orchestrator_authoritative_inputs_v1') return inputRows(complete512);
+    if (name === 'devos_fleet_capacity_snapshot_v1') return {
+      schema: 'metaengine.devos.scheduler-capacity.v1', workspace_id: WS,
+      source: 'DEVOS_SCHEDULER_SNAPSHOT', state: 'FRESH', available_slots: 0, new_frontier_slots: 0,
+      live_transport_slots: 1, ready_backlog: 0, leased_backlog: 0, running_backlog: 0,
+      result_ready_backlog: 0, ambiguous_backlog: 0, blocked_backlog: 0, active_claims: 0,
+      ready_backlog_limit: 8, ambiguity_pressure_limit: 8, pressure_state: 'NORMAL',
+      authority_effect: false, automatic_retry_allowed: false,
+    };
+    if (name === 'devos_fleet_reconcile_v1') return {
+      schema: 'metaengine.devos.reconcile.v1', requeued: 0, failed: 0, authority_effect: false,
+    };
+    if (name === 'devos_fleet_snapshot_v1') return {
+      active_tasks: [], active_claims: [], recent_events: [], authority_effect: false,
+    };
+    throw new Error(`unexpected_rpc:${name}`);
+  };
+  const handle = createDevosSupervisorRoutes({ rpc, workspaceId: WS, metaRoadmapId: ROADMAP });
+  const response = await handle({ req: { method: 'POST' }, path: '/v1/devos/cycle',
