--- /dev/null
+++ b/apps/metaengine-browser/test/agent-toolbelt-retirement-composed-integration.test.mjs
@@ -0,0 +1,103 @@
+// Inert production-cycle routing: signed-route responses are fixed local objects.
+// No agent, browser, network, service, real SQL or installed client is started.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {createHash} from 'node:crypto';
+import {DevOsNativeTaskCycle} from '../src/devos-native-task-cycle-core.mjs';
+
+const sha=s=>createHash('sha256').update(s).digest('hex');
+const chat='https://chatgpt.com/c/12345678-abcd-4abc-8abc-123456789abc';
+const lease=Object.freeze({task_id:'66666666-6666-4666-8666-666666666666',lease_generation:1,
+ agent_id:'agent_composed-retirement-00001',role:'IMPLEMENTER',tab_id:'tab_123e4567-e89b-42d3-a456-426614174222',
+ target_id:'webcontents:9',base_sha:'a'.repeat(40),agent_generation_epoch:1,automatic_retry_allowed:false,
+ task_spec:{objective:'Inert completion readback',constraints:[],deliverable:'fixture'},conversation_url_sha256:sha(chat)});
+const fleet={schema:'metaengine.browser.fleet-snapshot.v1',policy:{warm_agents:1,spawn_burst_limit:1},
+ agents:[{agent_id:lease.agent_id,role:lease.role,tab_id:lease.tab_id,target_id:lease.target_id,
+ lifecycle_state:'ACTIVE',generation_epoch:1,automatic_retry_allowed:false}]};
+const response=body=>({ok:true,status:200,json:async()=>structuredClone(body)});
+const transcript=['```tool','TOOL_REQUEST_V1','request_id=composed:unknown','action=CAPTURE',`tab_id=${lease.tab_id}`,'payload_json={}','```'].join('\n');
+function makeCycle({budgetState='UNKNOWN',ackLost=false,status='RESULT_READY',generation=1}={}) {
+ const calls={complete:0,status:0,issue:0,budget:0,custody:0};
+ const runtime={
+  prepareLease:async()=>null,contextForLease:()=>'',continueConversation:async()=>null,waitForChildren:async()=>({waiting:false,children:[],pending_message_seqs:[]}),
+  recordActivity:async()=>({recorded:true}),
+  readToolCustodyForCompletion:async current=>{
+   calls.custody++;return {schema:'metaengine.project.tool-custody-completion-read.v1',
+    task_id:current.task_id,agent_id:current.agent_id,lease_generation:current.lease_generation,
+    state:budgetState==='UNKNOWN'?'PENDING':'CLEAR',authority_effect:false,automatic_retry_allowed:false};
+  },
+  serveToolRequests:async()=>[],beginToolBudgetRequest:async(_lease,request)=>{calls.budget++;return budgetState==='RESOLVED'
+   ?{state:'RESOLVED',result:{request_id:request.request_id,action:request.action,status:'COMPLETED',summary:'already durable',command_id:null}}
+   :{state:budgetState};},
+  undeliveredToolResults:async()=>[],
+ };
+ const cycle=new DevOsNativeTaskCycle({getState:async()=>({fleet}),
+  executeCommand:async command=>{
+   if(command.action==='FLEET_RECONCILE')return fleet;
+   if(command.action==='CAPTURE')return{url:chat,tab_id:lease.tab_id,semantic_targets:[]};
+   if(command.action==='READ_TRANSCRIPT')return{text:transcript,total_chars:transcript.length,has_more:false,census_truncated:false};
+   throw Error('unexpected source-only command:'+command.action);
+  },
+  signedRequest:async(route,opts={})=>{
+   if(route==='/v1/devos/cycle')return response({schema:'metaengine.devos.browser-cycle.v1',backlog:{ready:0,running:1},running:[lease]});
+   if(route==='/v1/devos/complete') {calls.complete++;if(ackLost)throw Error('lost completion ACK');return response({state:'RESULT_READY'});}
+   if(route.endsWith('/status')){calls.status++;return response({state:status,lease_generation:generation});}
+   if(route==='/v1/commands/issue-tool'){calls.issue++;throw Error('tool issue must not be attempted');}
+   throw Error('unexpected signed route:'+route);
+  },
+ });
+ cycle.bindProjectRuntime(runtime);
+ return {cycle,calls};
+}
+
+// Red against #1459: the UNKNOWN budget result is rendered UNAVAILABLE and
+// pendingCount remains 0; old task-cycle can then complete as RESULT_READY.
+test('UNKNOWN original durable budget readback stops task completion, including a reconstructed task-cycle',async()=>{
+ for(let restart=0;restart<2;restart++){
+  const {cycle,calls}=makeCycle({budgetState:'UNKNOWN'});
+  const value=await cycle.cycle();
+  assert.equal(value.result_ready.state,'TOOL_EFFECT_READBACK_REQUIRED');
+  assert.equal(calls.complete,0);
+  assert.equal(calls.issue,0);
+  assert.equal(cycle.snapshot().agent_toolbelt.lease_count,1);
+  assert.equal(calls.budget,1,'one exact original custody read per reconstruction');
+ }
+});
+
+test('completion ACK uncertainty plus stale generation or UNKNOWN status retains local lease and does not replay',async()=>{
+ for(const [status,generation] of [['RESULT_READY',2],['AMBIGUOUS',1],['UNKNOWN',1]]){
+  const {cycle,calls}=makeCycle({budgetState:'RESOLVED',ackLost:true,status,generation});
+  if(status==='AMBIGUOUS'){
+   const outcome=await cycle.cycle();
+   assert.equal(outcome.result_ready.state,'AMBIGUOUS');
+  } else await assert.rejects(()=>cycle.cycle(),/devos_completion_(?:status_generation_mismatch|transport_ambiguous)/);
+  assert.equal(calls.complete,1,'never retry POST /complete');
+  assert.equal(calls.status,1,'read only exact current status once');
+  assert.equal(calls.issue,0);
+  assert.equal(cycle.snapshot().agent_toolbelt.lease_count,1);
+ }
+});
+
+test('successful ACK followed by UNKNOWN status keeps fully settled cache; exact later ACK can retire',async()=>{
+ const uncertain=makeCycle({budgetState:'RESOLVED',status:'UNKNOWN'});
+ const first=await uncertain.cycle.cycle();
+ assert.equal(first.result_ready.state,'RESULT_READY');
+ assert.equal(uncertain.calls.complete,1);assert.equal(uncertain.calls.status,1);
+ assert.equal(uncertain.cycle.snapshot().agent_toolbelt.lease_count,1);
+ const confirmed=makeCycle({budgetState:'RESOLVED',status:'RESULT_READY'});
+ const second=await confirmed.cycle.cycle();
+ assert.equal(second.result_ready.state,'RESULT_READY');
+ assert.equal(confirmed.calls.complete,1);assert.equal(confirmed.calls.status,1);
+ assert.equal(confirmed.cycle.snapshot().agent_toolbelt.lease_count,0);
+});
+
+
+test('trusted completion after restart checks original journal even when Toolbelt cache is empty',async()=>{
+ const {cycle,calls}=makeCycle({budgetState:'UNKNOWN'});
+ const result=await cycle.completeFromTrustedCommand({...lease,state:'RESULT_READY',summary:{}});
+ assert.equal(result.state,'TOOL_EFFECT_READBACK_REQUIRED');
+ assert.equal(result.custody_state,'PENDING');
+ assert.equal(calls.custody,1);
+ assert.equal(calls.complete,0,'no completion write is sent before durable clearance');
+ assert.equal(calls.issue,0,'readback cannot create tool command');
+});
