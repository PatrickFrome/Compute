+++ b/apps/metaengine-browser/test/agent-toolbelt-retirement-runtime-readback.test.mjs
@@ -0,0 +1,53 @@
+// Native project runtime read-only consumer of the original durable journal.
+// No SQL engine, disk database, socket, browser or live agent is created.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {AutonomousProjectTaskRuntime} from '../src/autonomous-project-task-runtime.mjs';
+const lease={task_id:'88888888-8888-4888-8888-888888888888',agent_id:'agent_custody-readback-0001',lease_generation:3};
+const gate=()=>{let release;const promise=new Promise(resolve=>release=resolve);return{promise,release};};
+
+function makeRuntime(journal) {
+ return new AutonomousProjectTaskRuntime({
+  request:async()=>assert.fail('no project network effect'),
+  journal:{find:async()=>null,begin:async()=>assert.fail('no mutation'),confirm:async()=>assert.fail('no mutation'),...journal},
+  materializeProject:async()=>assert.fail('no project materialization'),
+ });
+}
+test('original pending journal readback is typed, bound and JSON-serializable without issuing any effect',async()=>{
+ let reads=0;
+ const runtime=makeRuntime({hasPendingTaskEffect:async current=>{reads++;assert.equal(current.task_id,lease.task_id);return true;}});
+ try{
+  const pending=await runtime.readToolCustodyForCompletion(lease);
+  assert.deepEqual(JSON.parse(JSON.stringify(pending)),pending);
+  assert.deepEqual(pending,{schema:'metaengine.project.tool-custody-completion-read.v1',
+   task_id:lease.task_id,agent_id:lease.agent_id,lease_generation:lease.lease_generation,
+   state:'PENDING',authority_effect:false,scheduler_authority:false,second_scheduler_loop:false,automatic_retry_allowed:false});
+  assert.equal(reads,1);
+ }finally{await runtime.close();}
+});
+
+test('missing, malformed or failed journal custody readback never claims CLEAR',async()=>{
+ for(const value of [undefined,null,0,'false']){
+  const runtime=makeRuntime({hasPendingTaskEffect:async()=>value});
+  try{await assert.rejects(()=>runtime.readToolCustodyForCompletion(lease),/tool_custody_readback_invalid/);}
+  finally{await runtime.close();}
+ }
+ const missing=makeRuntime({});
+ try{await assert.rejects(()=>missing.readToolCustodyForCompletion(lease),/tool_custody_readback_required/);}
+ finally{await missing.close();}
+});
+
+test('project runtime close joins in-flight original readback before closing its journal',async()=>{
+ const blocked=gate();let reads=0,closes=0;
+ const runtime=makeRuntime({hasPendingTaskEffect:async()=>{reads++;await blocked.promise;return false;},close:async()=>{closes++;}});
+ const reading=runtime.readToolCustodyForCompletion(lease);
+ await new Promise(resolve=>setImmediate(resolve));
+ assert.equal(reads,1);
+ const closing=runtime.close();let completed=false;closing.then(()=>{completed=true;});
+ await new Promise(resolve=>setImmediate(resolve));
+ try{assert.equal(completed,false);assert.equal(closes,0);}
+ finally{blocked.release();}
+ const result=await reading;await closing;
+ assert.equal(result.state,'CLEAR');assert.equal(closes,1);
+ await assert.rejects(()=>runtime.readToolCustodyForCompletion(lease),/autonomous_project_closed/);
+});
