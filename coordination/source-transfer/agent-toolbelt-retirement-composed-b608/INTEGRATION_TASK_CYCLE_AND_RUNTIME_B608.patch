@@ -0,0 +1,67 @@
+// Inert cycle integration: requires the separate task-cycle integration hunk.
+// Neither browser, model, database, service nor network is started.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+const AGENT = 'agent_lease-retirement-0001';
+const lease = n => Object.freeze({task_id: `${(n+1).toString(16).padStart(8,'0')}-1111-4111-8111-111111111111`,
+  lease_generation:1,agent_id:AGENT});
+
+// Integration below uses the real task-cycle source with a disposable in-memory
+// signed-route fixture. The shared cycle implementation is delivered in a
+// SEPARATE integration hunk, not committed to its neighboring owner branch.
+import {createHash} from 'node:crypto';
+import {DevOsNativeTaskCycle} from '../src/devos-native-task-cycle-core.mjs';
+
+const sha = value => createHash('sha256').update(value).digest('hex');
+const url = 'https://chatgpt.com/c/12345678-abcd-4abc-8abc-123456789abc';
+const cycleLease = Object.freeze({...lease(7000),role:'IMPLEMENTER',
+  tab_id:'tab_123e4567-e89b-42d3-a456-426614174222',target_id:'webcontents:9',
+  base_sha:'a'.repeat(40),agent_generation_epoch:1,automatic_retry_allowed:false,
+  task_spec:{objective:'Inert retirement check',constraints:[],deliverable:'source test'},
+  conversation_url_sha256:sha(url),
+});
+const cycleFleet = {schema:'metaengine.browser.fleet-snapshot.v1',policy:{warm_agents:1,spawn_burst_limit:1},
+  agents:[{agent_id:cycleLease.agent_id,role:cycleLease.role,tab_id:cycleLease.tab_id,target_id:cycleLease.target_id,
+    lifecycle_state:'ACTIVE',generation_epoch:1,automatic_retry_allowed:false}]};
+const cycleResponse = body=>({ok:true,status:200,json:async()=>structuredClone(body)});
+const transcript = ['```tool','TOOL_REQUEST_V1','request_id=retire:inert-cycle','action=CAPTURE',
+  `tab_id=${cycleLease.tab_id}`,'payload_json={}','```'].join('\n');
+
+for(const [name,ackMode,statusState,statusGeneration,expectedRetired] of [
+  ['confirmed same-generation result','ACK','RESULT_READY',1,true],
+  ['status remains running','ACK','RUNNING',1,false],
+  ['changed lease generation','ACK','RESULT_READY',2,false],
+  ['lost ACK confirmed by exact status','LOST_ACK','RESULT_READY',1,true],
+])test(`real cycle frees only local settled lease after ${name}`,async()=>{
+  const calls={status:0,completion:0,issued:0};
+  const cycle=new DevOsNativeTaskCycle({
+    getState:async()=>({fleet:cycleFleet}),
+    executeCommand:async command=>{
+      if(command.action==='FLEET_RECONCILE')return cycleFleet;
+      if(command.action==='CAPTURE')return {url,tab_id:cycleLease.tab_id,semantic_targets:[]};
+      if(command.action==='READ_TRANSCRIPT')return {text:transcript,total_chars:transcript.length,
+        has_more:false,census_truncated:false};
+      throw Error('unexpected inert command '+command.action);
+    },
+    signedRequest:async(route,options={})=>{
+      if(route==='/v1/devos/cycle')return cycleResponse({schema:'metaengine.devos.browser-cycle.v1',
+        backlog:{ready:0,running:1},running:[cycleLease]});
+      if(route==='/v1/devos/complete'){
+        calls.completion++;
+        if(ackMode==='LOST_ACK')throw Error('inert lost completion ACK');
+        return cycleResponse({state:'RESULT_READY'});
+      }
+      if(route.endsWith('/status')){calls.status++;return cycleResponse({state:statusState,lease_generation:statusGeneration});}
+      if(route==='/v1/commands/issue-tool'){calls.issued++;throw Error('tool issue cannot run without project custody');}
+      throw Error('unexpected signed fixture '+route);
+    },
+  });
+  const result=await cycle.cycle();
+  assert.equal(result.result_ready.state,'RESULT_READY');
+  assert.equal(calls.completion,1);
+  assert.equal(calls.status,1);
+  assert.equal(calls.issued,0);
+  assert.equal(cycle.snapshot().agent_toolbelt.lease_count,expectedRetired?0:1);
+  assert.equal(cycle.snapshot().agent_toolbelt.served_result_count,1,
+    'bounded next-task result ring is retained after lease-local retirement');
+});
diff --git a/apps/metaengine-browser/test/agent-toolbelt-retirement-composed-integration.test.mjs b/apps/metaengine-browser/test/agent-toolbelt-retirement-composed-integration.test.mjs
