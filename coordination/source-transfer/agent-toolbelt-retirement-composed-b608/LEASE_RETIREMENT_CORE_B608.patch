@@ -0,0 +1,98 @@
+// Source-only composition regression. Uses only disposable memory and delayed promises.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {AgentToolbelt} from '../src/agent-toolbelt-core.mjs';
+import {flushCustodyMicrotasks,toolbeltCustodyModel} from './fixtures/toolbelt-custody-model.mjs';
+
+const AGENT='agent_retirement-composed-0001';
+const lease=n=>Object.freeze({task_id:`${(n+1).toString(16).padStart(8,'0')}-2222-4222-8222-222222222222`,lease_generation:1,agent_id:AGENT});
+const req=n=>({request_id:`composed:retirement:${n}`,action:'CAPTURE',payload:{}});
+const resolved=r=>({request_id:r.request_id,action:r.action,status:'COMPLETED',summary:'fixture original receipt',command_id:null});
+const ack=id=>({ok:true,status:200,json:async()=>({accepted:true,command_id:id})});
+const receipt=()=>({ok:true,status:200,json:async()=>({found:true,terminal:true,status:'COMPLETED',receipt:{result:'inert'}})});
+const gate=()=>{let release;const promise=new Promise(resolve=>{release=resolve;});return{promise,release};};
+
+// Red on #1459: requests admitted against the same old row count, then all
+// commit their result after the await and push the map over 128.
+test('same-lease async admission reserves bounded row capacity before awaiting durable readback',async()=>{
+ const current=lease(10),block=gate();let entered=0;
+ const belt=new AgentToolbelt({signedRequest:async()=>assert.fail('no command issue for durable result')});
+ belt.bindProjectRuntime({serveToolRequests:async()=>[],beginToolBudgetRequest:async(_l,r)=>{
+  if(r.request_id.startsWith('composed:retirement:late-')){entered++;await block.promise;}
+  return{state:'RESOLVED',result:resolved(r)};
+ }});
+ for(let n=0;n<127;n++)await belt.serveToolRequests({lease:current,requests:[req(n)]});
+ const pending=Array.from({length:8},(_,n)=>belt.serveToolRequests({lease:current,requests:[req('late-'+n)]}));
+ await flushCustodyMicrotasks();
+ try{
+  assert.equal(entered,8);
+  assert.equal(belt.snapshot().lease_count,1);
+ }finally{block.release();}
+ await Promise.all(pending);
+ assert.ok(belt.snapshot().issued_command_count<=128,'local cache cap cannot be bypassed by late asynchronous results');
+});
+
+// Red on #1459: two harvest invocations both see PENDING, read the same
+// original receipt, and commit its terminal accounting twice.
+test('overlapping late receipt reads serialize per request and account for exactly one durable terminal',async()=>{
+ const current=lease(20),block=gate();let gets=0,issue=0,settled=0;
+ const belt=new AgentToolbelt({signedRequest:async(_route,options={})=>{
+  if(options.method==='GET'){gets++;await block.promise;return receipt();}
+  issue++;return ack(`command-${issue}`);
+ }});
+ belt.bindProjectRuntime(toolbeltCustodyModel([current],{resolveToolBudgetRequest:async()=>{settled++;}}));
+ await belt.serveToolRequests({lease:current,requests:[req('read-once')]});
+ const a=belt.harvestResults({lease:current}),b=belt.harvestResults({lease:current});
+ await flushCustodyMicrotasks();
+ try{assert.equal(gets,1,'only one reader owns the exact pending request');}
+ finally{block.release();}
+ const results=await Promise.all([a,b]);
+ assert.equal(results.flat().length,1);
+ assert.equal(settled,1);
+ assert.equal(belt.snapshot().counters.results_terminal,1);
+ assert.equal(belt.retireSettledLease(current),true);
+});
+
+// Red on #1459: keying by task_id:generation alone lets another agent or
+// same task rebind retirement, even though durable custody binds agent_id.
+test('foreign agent cannot reuse cached lease identity or retire a different agent receipt',async()=>{
+ const current=lease(30),foreign={...current,agent_id:'agent_foreign-000000001'};
+ const belt=new AgentToolbelt({signedRequest:async()=>assert.fail('no command effect')});
+ belt.bindProjectRuntime({serveToolRequests:async()=>[],beginToolBudgetRequest:async(_l,r)=>({state:'RESOLVED',result:resolved(r)})});
+ await belt.serveToolRequests({lease:current,requests:[req('owner')]});
+ assert.deepEqual(belt.resultsForLease(foreign),[]);
+ assert.equal(belt.pendingCount(foreign),1);
+ assert.equal(belt.canRetireSettledLease(foreign),false);
+ assert.equal(belt.retireSettledLease(foreign),false);
+ const denied=await belt.serveToolRequests({lease:foreign,requests:[req('foreign')]});
+ assert.equal(denied.error,'agent_toolbelt_lease_identity_conflict');
+ assert.equal(belt.retireSettledLease(current),true);
+});
+
+test('serialized observation is read-only and does not resurrect retired request authority after restart',async()=>{
+ const current=lease(40),runtime=toolbeltCustodyModel([current]);let issues=0;
+ const create=()=>{const belt=new AgentToolbelt({signedRequest:async(_route,opts={})=>{
+  if(opts.method==='GET')return receipt();issues++;return ack(`inert-command-${issues}`);
+ }});belt.bindProjectRuntime(runtime);return belt;};
+ const first=create();await first.serveToolRequests({lease:current,requests:[req('restart')]});
+ await first.harvestResults({lease:current});assert.equal(first.retireSettledLease(current),true);
+ const serialized=JSON.parse(JSON.stringify(first.snapshot()));
+ assert.equal(serialized.lease_count,0);
+ assert.equal(Object.hasOwn(serialized,'byLease'),false);
+ assert.equal(Object.hasOwn(serialized,'budgetWitnesses'),false);
+ const second=create();await second.serveToolRequests({lease:current,requests:[req('restart')]});
+ assert.equal(second.resultsForLease(current)[0].status,'COMPLETED');
+ assert.equal(issues,1);
+});
+
+test('UNKNOWN durable readback retains original row and never repeats a lost issue ACK after restart',async()=>{
+ const current=lease(50),runtime=toolbeltCustodyModel([current]);let issues=0;
+ const make=()=>{const belt=new AgentToolbelt({signedRequest:async()=>{issues++;throw Error('inert lost command ACK');}});belt.bindProjectRuntime(runtime);return belt;};
+ const first=make();await first.serveToolRequests({lease:current,requests:[req('unknown')]});
+ assert.equal(first.retireSettledLease(current),false);
+ const snapshot=JSON.parse(JSON.stringify(first.snapshot()));assert.ok(snapshot.lease_count===1);
+ const restarted=make();await restarted.serveToolRequests({lease:current,requests:[req('unknown')]});
+ assert.equal(restarted.resultsForLease(current)[0].effect_unknown,true);
+ assert.equal(restarted.retireSettledLease(current),false);
+ assert.equal(issues,1);
+});
