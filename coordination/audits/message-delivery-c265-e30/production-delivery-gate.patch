+const identity={ok:true,id:'client-delivery-fixture',device_id:'66666666-6666-4666-8666-666666666666',access_tier:'ADMIN',admin_ready:true,admin_grant_epoch:1};
+const flags={authority_effect:false,automatic_retry_allowed:false,scheduler_authority:false};
+
+async function fixture(t){
+ const dir=await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(),'metaengine-delivery-chain-')));
