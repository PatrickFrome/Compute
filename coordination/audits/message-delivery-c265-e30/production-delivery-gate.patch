diff --git a/apps/metaengine-browser/test/project-message-delivery-page.test.mjs b/apps/metaengine-browser/test/project-message-delivery-page.test.mjs
new file mode 100644
index 0000000..569e077
--- /dev/null
+++ b/apps/metaengine-browser/test/project-message-delivery-page.test.mjs
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { boundedProjectResultPage } from '../src/devos-native-task-cycle-core.mjs';
+
+test('eight durable tool results plus pending messages keep a notification slot', () => {
+  const results = Array.from({length: 8}, (_, i) => ({ request_id: `result-${i}`, status: 'COMPLETED', summary: 'readback' }));
+  const pending = [12, 13];
+  const page = boundedProjectResultPage(results, pending);
+  assert.deepEqual(page.map(r => r.request_id), results.slice(0, 7).map(r => r.request_id));
+  assert.equal(page.length + 1, 8, 'synthetic notification fits inside the same physical prompt');
+  assert.equal(page.some(row => row.request_id === 'result-7'), false, 'the eighth tool result remains deferred, not acknowledged');
+  assert.deepEqual(boundedProjectResultPage(results, []), results, 'after ACK the eighth tool result remains available');
+  assert.deepEqual(results.map(row => row.request_id), Array.from({length:8}, (_, i) => `result-${i}`));
+});
+
+test('page allocation does not introduce a global logical-agent ceiling or grant authority', () => {
+  const hundred = Array.from({length: 100}, (_, i) => ({ request_id: String(i), effect_unknown: true }));
+  assert.equal(boundedProjectResultPage(hundred, [1]).length, 7);
+  assert.equal(boundedProjectResultPage(hundred, []).length, 8);
+  assert.equal(hundred.length, 100, 'all pending source results remain available for subsequent pages');
+  assert.throws(() => boundedProjectResultPage(hundred, null), /page_invalid/);
+});
