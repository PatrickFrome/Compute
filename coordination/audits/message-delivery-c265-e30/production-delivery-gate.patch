+     const pending=events.filter(e=>e.event_type==='BROWSER_AGENT_MESSAGE'&&e.content.recipient_task_id===a.p_task_id
+       &&!acks.has(e.seq)).map(e=>e.seq).slice(0,16);
+     const selected=lease?{...lease,state:'RUNNING',depth:0,pending_message_seqs:pending,open_children:0,blocking_children:0,pending_proposals:0}:null;
