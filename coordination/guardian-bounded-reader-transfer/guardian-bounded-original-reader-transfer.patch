+    }
+    if (name == "late_hello_after_revoke" || name == "unknown_late_write") {
+        const auto attempts = f.data.seed_attempts;
+        { Context service(Side::Service); f.sender->fail("TEST_RECEIVER_PIPE_BREAK_OBSERVED");
