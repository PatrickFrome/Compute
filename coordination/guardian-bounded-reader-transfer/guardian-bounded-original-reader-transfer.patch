+    parser = argparse.ArgumentParser(description=__doc__)
+    instrumentation = parser.add_mutually_exclusive_group()
+    instrumentation.add_argument('--sanitize', action='store_true')
+    instrumentation.add_argument('--tsan', action='store_true')
+    parser.add_argument('--evidence', type=Path)
+    parser.add_argument('--case', choices=CASES)
+    parser.add_argument('--protocol-only', action='store_true', help='Diagnostic mode; native owner lifecycle remains NOT RUN')
