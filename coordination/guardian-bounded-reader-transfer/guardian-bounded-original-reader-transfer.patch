+    'process_seed_closed_before_local_dup', 'process_seed_reused_before_local_dup',
+    'token_seed_closed_before_local_dup', 'token_seed_reused_before_local_dup',
+    'process_seed_reused_after_local_dup', 'token_seed_reused_after_local_dup',
+    'reuse_then_cancel_after_local_dup', 'local_process_dup_failure', 'local_token_dup_failure',
+    'sender_process_seed_failure', 'sender_process_seed_unknown',
+    'sender_token_seed_failure', 'sender_token_seed_unknown',
