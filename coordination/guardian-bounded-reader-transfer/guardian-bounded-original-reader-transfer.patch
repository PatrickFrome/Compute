+    'peer_close_during_reply', 'peer_crash_modeled_os_exit', 'late_hello_after_revoke',
+    'same_peer_double_acquire', 'second_peer_process_budget', 'independent_pipe_scope_refused',
+    'independent_root_scope_refused', 'independent_policy_refused', 'atomic_process_budget',
