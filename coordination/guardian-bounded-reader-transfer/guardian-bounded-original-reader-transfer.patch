+static World& world() { require(active != nullptr, "model world absent"); return *active; }
+struct Context {
+    Side previous;
+    explicit Context(Side side) : previous(world().side) { world().side = side; }
+    ~Context() { world().side = previous; }
+};
+DWORD GetLastError() { return world().last_error; }
+HANDLE GetCurrentProcess() { return INVALID_HANDLE_VALUE; }
+DWORD GetCurrentProcessId() { return world().side == Side::Child ? World::child_pid : World::service_pid; }
+ULONGLONG GetTickCount64() { return 150; }
