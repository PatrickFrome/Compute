+#!/usr/bin/env python3
+"""Exercise the actual connected-peer close under real C++ allocation failure.
+
+Win32 calls and resource construction are modeled. The production close,
+requestCancel, snapshot, host retireLocked, retained-file/oplock destructors,
+handle reset methods and cancel-and-join helper are extracted without edits.
+The pre-pipe old-account regression specifically uses libstdc++ COW ABI 0 and
+shared actual std::string storage. It is not a default MSVC/SSO reproduction.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+WINDOWS = r'''#pragma once
+#include <cstdint>
+using DWORD = std::uint32_t;
+using BOOL = int;
+using HANDLE = void*;
+using SC_HANDLE = void*;
+constexpr BOOL FALSE=0, TRUE=1;
+constexpr DWORD ERROR_SUCCESS=0, ERROR_ACCESS_DENIED=5, ERROR_IO_PENDING=997;
+constexpr DWORD ERROR_IO_INCOMPLETE=996, ERROR_OPERATION_ABORTED=995;
+constexpr DWORD WAIT_OBJECT_0=0, WAIT_TIMEOUT=258, WAIT_FAILED=0xffffffffU;
+#define INVALID_HANDLE_VALUE reinterpret_cast<HANDLE>(static_cast<std::intptr_t>(-1))
+struct OVERLAPPED { std::uintptr_t Internal=0; HANDLE hEvent=nullptr; };
+#define HasOverlappedIoCompleted(operation) ((operation)->Internal!=0x103U)
+HANDLE CreateEventW(void*, BOOL, BOOL, const wchar_t*);
+BOOL SetEvent(HANDLE);
+BOOL CloseHandle(HANDLE);
+BOOL CloseServiceHandle(SC_HANDLE);
+BOOL CancelIoEx(HANDLE, OVERLAPPED*);
+BOOL GetOverlappedResult(HANDLE, OVERLAPPED*, DWORD*, BOOL);
+DWORD WaitForSingleObject(HANDLE, DWORD);
+DWORD GetLastError();
+void Sleep(DWORD);
+'''
+
+
+CPP = r'''
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <exception>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <optional>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+#include "windows.h"
+#include "browser-guardian-connected-peer.hpp"
+#include "browser-guardian-original-reader-transfer.hpp"
+
+namespace fixture {
+enum class Kind { Cancel, Event, Pipe, File, Process, Reader, Token, Scm, Service };
+struct Resource { Kind kind=Kind::File; bool closed=false; std::atomic<bool> signaled{false}; };
+struct Storage {
+    std::array<unsigned char,32> bytes{};
+    bool alive=true;
+    int operation=-1;
+    Storage() { bytes.fill(0x5a); }
+    ~Storage();
+};
+struct Operation {
+    HANDLE file=nullptr, event=nullptr;
+    OVERLAPPED* original=nullptr;
+    Storage* storage=nullptr;
+    bool terminal=false, pipe=false, cancel_requested=false;
+    unsigned results=0, waits=0;
+};
+struct Model {
+    std::atomic<bool> deny{false};
+    std::atomic<unsigned> allocations_denied{0}, violations{0}, cancellation_signals{0};
+    std::atomic<unsigned> pipe_closes{0}, handle_closes{0}, cancel_requests{0}, joined{0}, waits{0}, sleeps{0};
+    std::atomic<bool> worker_ready{false}, worker_joined{false};
+    std::array<Resource,128> resources{};
+    std::array<Operation,16> operations{};
+    unsigned next_handle=1, operation_count=0, expected_joins=0;
+    const void* phase_context=nullptr;
+    unsigned (*phase_value)(const void*) noexcept=nullptr;
+    bool* closed=nullptr;
+    HANDLE* borrowed=nullptr;
+    bool expect_pre_pipe_terminate=false, expect_post_pipe_terminate=false, require_early_pipe=true;
+    bool account_storage_shared=false;
+    bool in_close=false;
+} model;
+thread_local DWORD last_error=ERROR_SUCCESS;
+HANDLE make(Kind kind) {
+    const auto id=model.next_handle++;
+    if (id>=model.resources.size()) std::abort();
+    model.resources[id].kind=kind;
+    return reinterpret_cast<HANDLE>(static_cast<std::uintptr_t>(id));
+}
+Resource& resource(HANDLE value) {
+    const auto id=reinterpret_cast<std::uintptr_t>(value);
+    if (!id || id>=model.next_handle) std::abort();
+    return model.resources[id];
+}
+BOOL issuePending(HANDLE file, HANDLE event, OVERLAPPED* operation, Storage* storage, bool pipe=false) {
+    const auto id=model.operation_count++;
+    if (id>=model.operations.size()) std::abort();
+    operation->Internal=0x103U; operation->hEvent=event;
+    auto& pending=model.operations[id];
+    pending.file=file; pending.event=event; pending.original=operation; pending.storage=storage; pending.pipe=pipe;
+    storage->operation=static_cast<int>(id);
+    last_error=ERROR_IO_PENDING;
+    return FALSE;
+}
+Storage::~Storage() {
+    if (operation>=0 && !model.operations[static_cast<unsigned>(operation)].terminal) ++model.violations;
+    alive=false;
+}
+[[noreturn]] void terminateObserved() noexcept {
+    const bool pending=model.phase_value && model.phase_value(model.phase_context)==2;
+    const bool allocation=model.allocations_denied.load()>0;
+    const bool before_pipe=model.pipe_closes.load()==0 && model.joined.load()==0 && model.handle_closes.load()==0;
+    const bool after_pipe=model.pipe_closes.load()==1 && model.joined.load()==model.expected_joins;
+    if (model.in_close && allocation && pending && model.cancellation_signals &&
+        model.expect_pre_pipe_terminate && before_pipe && model.account_storage_shared) {
+        std::fprintf(stderr,"EXPECTED_PRE_PIPE_BAD_ALLOC real_std_string ABI=%d shared=1 pipe=0 joined=0 allocations=%u\n",
+            _GLIBCXX_USE_CXX11_ABI,model.allocations_denied.load());
+        std::_Exit(86);
+    }
+    if (model.in_close && allocation && pending && model.expect_post_pipe_terminate && after_pipe) {
+        std::fprintf(stderr,"EXPECTED_POST_PIPE_BAD_ALLOC real_std_string ABI=%d pipe=1 joined=%u allocations=%u\n",
+            _GLIBCXX_USE_CXX11_ABI,model.joined.load(),model.allocations_denied.load());
+        std::_Exit(87);
+    }
+    std::fprintf(stderr,"UNEXPECTED_TERMINATE ABI=%d pipe=%u joined=%u denied=%u violations=%u\n",
+        _GLIBCXX_USE_CXX11_ABI,model.pipe_closes.load(),model.joined.load(),
+        model.allocations_denied.load(),model.violations.load());
+    std::_Exit(99);
+}
+}
+
+[[gnu::noinline]] void* operator new(std::size_t size) {
+    if (fixture::model.deny.load()) { ++fixture::model.allocations_denied; throw std::bad_alloc(); }
+    if (auto* value=std::malloc(size?size:1)) return value;
+    throw std::bad_alloc();
+}
+[[gnu::noinline]] void operator delete(void* value) noexcept { std::free(value); }
+[[gnu::noinline]] void operator delete(void* value,std::size_t) noexcept { std::free(value); }
+[[gnu::noinline]] void* operator new[](std::size_t size) { return ::operator new(size); }
+[[gnu::noinline]] void operator delete[](void* value) noexcept { std::free(value); }
+[[gnu::noinline]] void operator delete[](void* value,std::size_t) noexcept { std::free(value); }
+
+HANDLE CreateEventW(void*,BOOL,BOOL,const wchar_t*) { return fixture::make(fixture::Kind::Cancel); }
+BOOL SetEvent(HANDLE value) {
+    fixture::resource(value).signaled.store(true,std::memory_order_release);
+    ++fixture::model.cancellation_signals; return TRUE;
+}
+BOOL CloseHandle(HANDLE value) {
+    auto& m=fixture::model;
+    auto& resource=fixture::resource(value);
+    if (resource.closed) ++m.violations;
+    for (unsigned i=0;i<m.operation_count;++i) {
+        const auto& pending=m.operations[i];
+        if ((pending.file==value || pending.event==value) && !pending.terminal) ++m.violations;
+    }
+    resource.closed=true; ++m.handle_closes;
+    if (resource.kind==fixture::Kind::Pipe) ++m.pipe_closes;
+    return TRUE;
+}
+BOOL CloseServiceHandle(SC_HANDLE value) { return CloseHandle(value); }
+DWORD GetLastError() { return fixture::last_error; }
+BOOL CancelIoEx(HANDLE file,OVERLAPPED* operation) {
+    auto& m=fixture::model; ++m.cancel_requests;
+    for (unsigned i=0;i<m.operation_count;++i) if (m.operations[i].original==operation) {
+        auto& pending=m.operations[i];
+        if (pending.file!=file || operation->Internal!=0x103U || !pending.storage->alive) ++m.violations;
+        pending.cancel_requested=true;
+        // Refused cancellation is deliberately not treated as completion.
+        fixture::last_error=ERROR_ACCESS_DENIED; return FALSE;
+    }
+    ++m.violations; return FALSE;
+}
+BOOL GetOverlappedResult(HANDLE file,OVERLAPPED* operation,DWORD*,BOOL) {
+    auto& m=fixture::model;
+    for (unsigned i=0;i<m.operation_count;++i) if (m.operations[i].original==operation) {
+        auto& pending=m.operations[i];
+        if (!m.deny || !m.in_close || pending.file!=file || !pending.cancel_requested || !pending.storage->alive ||
+            fixture::resource(file).closed || fixture::resource(pending.event).closed ||
+            !m.phase_value || m.phase_value(m.phase_context)!=2 || !m.closed || *m.closed || !m.borrowed || *m.borrowed) ++m.violations;
+        for (const auto byte:pending.storage->bytes) if (byte!=0x5a) ++m.violations;
+        if (m.require_early_pipe && m.pipe_closes.load()!=(pending.pipe?0U:1U)) ++m.violations;
+        if (++pending.results<=3) { fixture::last_error=ERROR_IO_INCOMPLETE; return FALSE; }
+        operation->Internal=ERROR_OPERATION_ABORTED; pending.terminal=true; ++m.joined;
+        fixture::last_error=ERROR_OPERATION_ABORTED; return FALSE;
+    }
+    ++m.violations; return FALSE;
+}
+DWORD WaitForSingleObject(HANDLE event,DWORD) {
+    auto& m=fixture::model; ++m.waits;
+    for (unsigned i=0;i<m.operation_count;++i) if (m.operations[i].event==event) {
+        auto& pending=m.operations[i];
+        if (pending.terminal || pending.original->Internal!=0x103U) ++m.violations;
+        switch (++pending.waits%3) { case 1:return WAIT_TIMEOUT; case 2:return WAIT_FAILED; default:return WAIT_OBJECT_0; }
+    }
+    ++m.violations; return WAIT_FAILED;
+}
+void Sleep(DWORD) { ++fixture::model.sleeps; std::this_thread::yield(); }
+
+namespace metaengine::guardian {
+#include "actual-close-handles.inc.hpp"
+#include "actual-close-join.inc.hpp"
+namespace guardian_loaded_detail {
+class RetainedFile {
+    Handle file_{fixture::make(fixture::Kind::File)},event_{fixture::make(fixture::Kind::Event)};
+    OVERLAPPED oplock_{};
+    fixture::Storage output_;
+    bool pending_=false;
+public:
+    RetainedFile() { pending_=!fixture::issuePending(file_.value,event_.value,&oplock_,&output_) && GetLastError()==ERROR_IO_PENDING; }
+#include "actual-close-retained-destructor.inc.hpp"
+};
+}
+namespace installed_close_model {
+class ReadOplock {
+    HANDLE file;
+    Handle event{fixture::make(fixture::Kind::Event)};
+    OVERLAPPED operation{};
