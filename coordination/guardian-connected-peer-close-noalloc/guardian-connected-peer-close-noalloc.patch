+        scope.authority.get()==stable && scope.published_authority.load()==stable &&
+        m.handle_closes==closes && m.joined==joins && m.joined==m.expected_joins && m.cancel_requests==m.expected_joins &&
+        m.cancellation_signals==signals+2 && m.pipe_closes==(no_owners?0U:1U) &&
+        !state.pipe.valid() && !state.loaded_images && !state.current_release_anchor && state.current_release_directories.empty() &&
+        !state.application && !state.machine_slot && !state.compatibility_lineage && !state.server_process.valid() &&
+        !state.original_service_reader.valid() && !state.original_service_token.valid() && !state.reader_bound &&
+        !state.service.value && !state.scm.value && !state.release_policy && state.release_policy_sha256.empty() &&
+        !state.kernel_exact && !state.scm_exact && !state.package_bound && !state.current_release_policy_bound &&
+        !state.bounded_loaded_image_observed && state.release_window.invalid && state.error==ERROR_OPERATION_ABORTED;
+    if (name=="active_pipe_io") ok=ok && m.worker_joined;
+    if (!no_owners) ok=ok && m.waits==3*m.expected_joins && m.sleeps>=2*m.expected_joins;
+    const auto json=stable->snapshotJson();
+    ok=ok && json.find("\"reason\":\"ORIGINAL_PIPE_CLOSED\"")!=std::string::npos &&
+        json.find("\"account_binding\":\"UNAVAILABLE\"")!=std::string::npos &&
+        json.find("\"kernel_binding\":\"UNPROVEN\"")!=std::string::npos &&
+        json.find("\"authority_effect\":false")!=std::string::npos;
+    std::printf("%s %s ABI=%d denied=%u pipe=%u joined=%u cancel_requests=%u waits=%u sleeps=%u violations=%u\n",
+        ok?"PASS":"FAIL",name.c_str(),_GLIBCXX_USE_CXX11_ABI,m.allocations_denied.load(),m.pipe_closes.load(),
+        m.joined.load(),m.cancel_requests.load(),m.waits.load(),m.sleeps.load(),m.violations.load());
+    return ok?0:7;
+}
+'''
+
+
+def between(source: str, first: str, after: str) -> str:
+    if source.count(first) != 1:
+        raise ValueError(f"Expected unique production marker: {first}")
+    start = source.index(first)
+    return source[start:source.index(after, start)]
+
+
+def digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tree", type=Path, default=Path(__file__).resolve().parents[4])
+    parser.add_argument("--evidence", type=Path)
+    parser.add_argument("--mutation-check", action="store_true")
+    parser.add_argument("--baseline-peer-source", type=Path, help="Also compile the complete unedited baseline close and require the COW pre-pipe allocation failure")
+    instrumentation = parser.add_mutually_exclusive_group()
+    instrumentation.add_argument("--sanitize", action="store_true")
+    instrumentation.add_argument("--tsan", action="store_true")
+    args = parser.parse_args()
+    tree = args.tree.resolve()
+    native = tree / "apps/metaengine-browser/native/browser-guardian-scm"
+    inputs = {name: native / name for name in (
+        "browser-guardian-connected-peer.cpp", "browser-guardian-connected-peer.hpp",
+        "browser-guardian-original-main-native-host.cpp", "browser-guardian-pipe-io-lifetime.hpp",
+        "browser-guardian-loaded-file.hpp", "browser-guardian-installed-namespace.cpp",
+        "browser-guardian-original-reader-transfer.hpp")}
+    peer = inputs["browser-guardian-connected-peer.cpp"].read_bytes().decode("utf-8")
+    host = inputs["browser-guardian-original-main-native-host.cpp"].read_bytes().decode("utf-8")
+    loaded = inputs["browser-guardian-loaded-file.hpp"].read_bytes().decode("utf-8")
+    installed = inputs["browser-guardian-installed-namespace.cpp"].read_bytes().decode("utf-8")
+    io = inputs["browser-guardian-pipe-io-lifetime.hpp"].read_bytes().decode("utf-8")
+    fragments = {
+        "handles": between(peer, "struct Handle {", "std::uint64_t ticks("),
+        "state-fields": between(peer, "    enum class LifetimeCheck", "    bool fail("),
+        "constructors": between(peer, "GuardianConnectedPeer::GuardianConnectedPeer()", "std::unique_ptr<GuardianConnectedPeer> GuardianConnectedPeer::connect()"),
+        "request-cancel": between(peer, "void GuardianConnectedPeer::requestCancel()", "bool GuardianConnectedPeer::recheck()"),
+        "snapshot": between(peer, "std::string GuardianConnectedPeer::snapshotJson()", "void GuardianConnectedPeer::close()"),
+        "method": between(peer, "void GuardianConnectedPeer::close()", "#ifdef METAENGINE_GUARDIAN_PEER_TEST"),
+        "retire": between(host, "void retireLocked(", "void requestRetirement("),
+        "join": between(io, "constexpr DWORD kGuardianIoJoinPollMs", "}  // namespace metaengine::guardian"),
+        "retained-destructor": between(loaded, "    ~RetainedFile()", "    static std::unique_ptr<RetainedFile> capture("),
+        "installed-destructor": between(installed, "    ~ReadOplock()", "    bool acquire()"),
+    }
+    temporary = tempfile.TemporaryDirectory(prefix="guardian-peer-close-model-") if args.evidence is None else None
+    evidence = Path(temporary.name) if temporary else args.evidence.resolve()
+    if not temporary:
+        evidence.mkdir(parents=True, exist_ok=False)
+    for name, body in fragments.items():
+        (evidence / f"actual-close-{name}.inc.hpp").write_text(body)
+    (evidence / "windows.h").write_text(WINDOWS)
+    fixture = evidence / "close-model.cpp"
+    fixture.write_text(CPP)
+    baseline = args.baseline_peer_source.resolve() if args.baseline_peer_source else None
+    source_hashes = {str(path): digest(path) for path in [Path(__file__).resolve(), *inputs.values(), *([baseline] if baseline else [])]}
+    sanitizer = "thread" if args.tsan else "address,undefined" if args.sanitize else "none"
+    environment = dict(os.environ)
+    if args.sanitize:
+        environment["ASAN_OPTIONS"] = "detect_leaks=1:halt_on_error=1"
+        environment["UBSAN_OPTIONS"] = "halt_on_error=1:print_stacktrace=1"
+    if args.tsan:
+        environment["TSAN_OPTIONS"] = "halt_on_error=1"
+    records = []
+
+    def run(step, command, expected=0, marker=None):
+        try:
+            result = subprocess.run(command, capture_output=True, text=True, env=environment, timeout=60)
+        except subprocess.TimeoutExpired as error:
+            stdout, stderr = error.stdout or b"", error.stderr or b""
+            if isinstance(stdout, bytes):
+                stdout = stdout.decode(errors="replace")
+            if isinstance(stderr, bytes):
+                stderr = stderr.decode(errors="replace")
+            result = subprocess.CompletedProcess(command, 124, stdout, stderr + "\nTIMEOUT\n")
+        (evidence / f"{step}.stdout.log").write_text(result.stdout)
+        (evidence / f"{step}.stderr.log").write_text(result.stderr)
+        ok = result.returncode == expected and (marker is None or marker in result.stdout + result.stderr)
+        records.append({"step": step, "argv": command, "exit_code": result.returncode,
+                        "expected_exit_code": expected, "expected_marker": marker, "status": "PASS" if ok else "FAIL"})
+        print(result.stdout + result.stderr, end="", flush=True)
+        return ok
+
+    def compile_model(label, abi):
+        binary = evidence / label
+        command = ["g++", "-std=c++20", "-O1", "-g", "-Wall", "-Wextra", "-Werror", "-pedantic", "-pthread",
+                   "-DMETAENGINE_GUARDIAN_PEER_TEST", f"-D_GLIBCXX_USE_CXX11_ABI={abi}",
+                   "-I", str(evidence), "-I", str(native), str(fixture), "-o", str(binary)]
+        if sanitizer != "none":
+            command.extend([f"-fsanitize={sanitizer}", "-fno-omit-frame-pointer", "-no-pie"])
+        return binary, run(f"compile-{label}", command)
+
+    ok = True
+    cases = ("short_strings", "shared_account", "shared_reason", "pending_wait_order", "active_pipe_io", "idle_is_not_retirement", "empty_owners", "null_state")
+    for abi in (1, 0):
+        binary, built = compile_model(f"close-abi{abi}", abi)
+        ok = ok and built
+        if not built:
+            break
+        for case in cases:
+            ok = run(f"abi{abi}-{case}", [str(binary), case]) and ok
+    controls = []
+    if ok and args.mutation_check:
+        path = evidence / "actual-close-method.inc.hpp"
+        fixed = fragments["method"]
+        if fixed.count("state_->account.clear();") != 1 or fixed.count("state_->reason.clear();") != 1:
+            raise ValueError("Expected allocation-free diagnostic cleanup anchors")
+        mutations = (
+            ("account-diagnostic-reintroduction", 0, "shared_account", "pre", 86, "EXPECTED_PRE_PIPE_BAD_ALLOC",
+             fixed.replace("state_->account.clear();", 'state_->account = "UNAVAILABLE";')),
+            ("tail-reason-diagnostic-reintroduction", 1, "short_strings", "post", 87, "EXPECTED_POST_PIPE_BAD_ALLOC",
+             fixed.replace("    state_->closed = true;", '    state_->reason = "ORIGINAL_PIPE_CLOSED";\n    state_->closed = true;')),
+            ("late-pipe", 1, "pending_wait_order", "order", 7, "FAIL pending_wait_order",
+             fixed.replace("    state_->pipe.reset();\n", "").replace("    state_->application.reset();", "    state_->pipe.reset();\n    state_->application.reset();")),
+            ("early-closed", 1, "pending_wait_order", "order", 7, "FAIL pending_wait_order",
+             fixed.replace("    if (state_->closed) return;", "    if (state_->closed) return;\n    state_->closed = true;")),
+        )
+        try:
+            for label, abi, case, expectation, code, marker, mutant in mutations:
+                if mutant == fixed:
+                    raise ValueError(f"Mutation did not change close: {label}")
+                path.write_text(mutant)
+                binary, built = compile_model(label, abi)
+                detected = built and run(f"mutation-{label}", [str(binary), case, expectation], code, marker)
+                controls.append({"mutation": label, "abi": abi, "compiled": built,
+                                 "behaviorally_detected": detected, "expected_exit_code": code,
+                                 "scope": "Diagnostic statement reintroduced in otherwise current close" if "diagnostic" in label else "Resource/completion ordering mutation in current close"})
+                ok = detected and ok
+        finally:
+            path.write_text(fixed)
+    baseline_control = None
+    if ok and baseline:
+        path = evidence / "actual-close-method.inc.hpp"
+        original = between(baseline.read_bytes().decode("utf-8"), "void GuardianConnectedPeer::close()", "#ifdef METAENGINE_GUARDIAN_PEER_TEST")
+        (evidence / "baseline-complete-close.inc.hpp").write_text(original)
+        try:
+            path.write_text(original)
+            binary, built = compile_model("complete-baseline-close", 0)
+            detected = built and run("complete-baseline-pre-pipe", [str(binary), "shared_account", "pre"], 86, "EXPECTED_PRE_PIPE_BAD_ALLOC")
+            baseline_control = {"source": str(baseline), "complete_close_byte_exact": True, "abi": 0,
+                                "compiled": built, "behaviorally_detected": detected, "expected_exit_code": 86}
+            ok = detected and ok
+        finally:
+            path.write_text(fragments["method"])
+    unchanged = all(Path(path).is_file() and digest(Path(path)) == value for path, value in source_hashes.items())
+    ok = ok and unchanged
+    report = {"schema": "metaengine.guardian.connected-peer-close-allocator-model.v1",
+              "status": "PASS" if ok else "FAIL", "sanitizer": sanitizer,
+              "source_hashes": source_hashes, "sources_unchanged": unchanged,
+              "production_fragments_byte_exact": True, "cases_per_abi": len(cases), "abis": [1, 0],
+              "commands": records, "mutation_controls": controls, "complete_baseline_control": baseline_control,
+              "allocation_evidence_limit": "Account pre-pipe allocation is reproduced with actual libstdc++ COW ABI 0 shared std::string storage; not a default MSVC/SSO reproduction. Tail-reason allocation is separately post-pipe.",
+              "modeled_boundary": "Win32 resource construction and completion are modeled; original OVERLAPPED/buffers remain live through incomplete results, timeout/failed waits and terminal completion.",
+              "asan_options": environment.get("ASAN_OPTIONS"), "tsan_options": environment.get("TSAN_OPTIONS"),
+              "leak_sanitizer": "Enabled for normal-exit positive cases; expected terminate controls use _Exit and skip leak finalization" if args.sanitize else "NOT RUN",
+              "windows_execution": "NOT RUN", "native_authority": "NOT RUN"}
+    (evidence / "summary.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "cases": 2 * len(cases), "controls": len(controls),
+                      "evidence": str(evidence), "sanitizer": sanitizer, "windows_execution": "NOT RUN"}), flush=True)
+    raise SystemExit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
