+            m.worker_ready.store(true,std::memory_order_release);
+            while (!fixture::resource(state.cancelled.value).signaled.load(std::memory_order_acquire)) std::this_thread::yield();
+            cancelAndJoinGuardianPipeIo(state.pipe.value,&active_operation);
+            m.worker_joined.store(true,std::memory_order_release);
+        });
+        while (!m.worker_ready.load(std::memory_order_acquire)) std::this_thread::yield();
+    }
+    m.expected_joins=m.operation_count;
+    if (name=="idle_is_not_retirement") scope.transaction_phase.store(OriginalEntryScope::TransactionPhase::Idle);
+    m.in_close=true; m.deny=true;
+    if (name=="idle_is_not_retirement") {
+        retireLocked(scope);
+        if (state.closed || m.pipe_closes || m.joined) ++m.violations;
+        scope.transaction_phase.store(OriginalEntryScope::TransactionPhase::RetirePending);
+    }
+    retireLocked(scope);
+    if (active.joinable()) active.join();
