+        const bool ok=m.allocations_denied==0 && m.handle_closes==before && m.cancellation_signals==0;
+        std::printf("%s null_state ABI=%d denied=%u\n",ok?"PASS":"FAIL",_GLIBCXX_USE_CXX11_ABI,m.allocations_denied.load());
