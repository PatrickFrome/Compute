+};
+#include "actual-close-retire.inc.hpp"
+}
+
+int main(int argc,char** argv) {
+    using namespace metaengine::guardian;
+    if (argc<2) return 2;
+    const std::string name=argv[1];
+    auto& m=fixture::model;
+    std::set_terminate(fixture::terminateObserved);
+    m.expect_pre_pipe_terminate=argc>2 && std::string(argv[2])=="pre";
+    m.expect_post_pipe_terminate=argc>2 && std::string(argv[2])=="post";
+    const bool no_owners=name=="empty_owners" || name=="null_state";
+    OriginalEntryScope scope;
+    scope.authority=GuardianConnectedPeerTest::make(!no_owners);
+    auto* stable=scope.authority.get();
+    scope.published_authority.store(stable);
+    auto& state=GuardianConnectedPeerTest::state(*stable);
+    scope.original_pipe=state.pipe.value;
+    // Read the actual scope atomic during every incomplete/terminal boundary;
+    // a copied phase could hide premature retirement inside close or a deleter.
+    m.phase_context=&scope;
+    m.phase_value=[](const void* value) noexcept {
+        return static_cast<unsigned>(static_cast<const OriginalEntryScope*>(value)->transaction_phase.load());
+    };
+    m.closed=&state.closed; m.borrowed=&scope.original_pipe;
+    std::string account_copy,reason_copy;
+    if (name=="shared_account" || name=="active_pipe_io" || name=="pending_wait_order") {
+        state.account=std::string(80,'a'); account_copy=state.account;
+        m.account_storage_shared=std::as_const(state.account).data()==std::as_const(account_copy).data();
+        if (!_GLIBCXX_USE_CXX11_ABI && !m.account_storage_shared) ++m.violations;
+    }
