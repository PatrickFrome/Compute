+    bool pending=false;
+public:
+    explicit ReadOplock(HANDLE original):file(original) {
+        pending=!fixture::issuePending(file,event.value,&operation,&output) && GetLastError()==ERROR_IO_PENDING;
+    }
+#include "actual-close-installed-destructor.inc.hpp"
+};
+}
+class GuardianInstalledNamespace {
+    Handle file_{fixture::make(fixture::Kind::File)};
+    std::unique_ptr<installed_close_model::ReadOplock> oplock_=std::make_unique<installed_close_model::ReadOplock>(file_.value);
+};
+class GuardianUpgradeRetainedPath {
+    GuardianInstalledNamespace original_;
+};
+class GuardianLoadedImageObservation {
+    std::unique_ptr<guardian_loaded_detail::RetainedFile> original_=std::make_unique<guardian_loaded_detail::RetainedFile>();
+};
+struct GuardianLoadedReleaseWindow { bool invalid=false; void invalidate() noexcept { invalid=true; } };
+struct GuardianLoadedReleasePolicy {};
+struct GuardianConnectedPeer::State {
+#include "actual-close-state-fields.inc.hpp"
+    bool releaseClockFence() { ++fixture::model.violations; return false; }
+};
+#include "actual-close-constructors.inc.hpp"
+#include "actual-close-request-cancel.inc.hpp"
+#include "actual-close-snapshot.inc.hpp"
+#include "actual-close-method.inc.hpp"
+struct GuardianConnectedPeerTest {
+    static std::unique_ptr<GuardianConnectedPeer> make(bool owners) {
+        auto out=std::unique_ptr<GuardianConnectedPeer>(new GuardianConnectedPeer());
+        auto& s=*out->state_;
