+};
+struct OriginalEntryScope {
+    enum class TransactionPhase:unsigned { Idle=0, Active=1, RetirePending=2, Retired=3 };
+    std::atomic<TransactionPhase> transaction_phase{TransactionPhase::RetirePending};
+    HANDLE original_pipe=nullptr;
