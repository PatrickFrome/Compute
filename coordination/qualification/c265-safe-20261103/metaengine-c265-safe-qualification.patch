+test('an exit code or skipped-only output cannot masquerade as passed qualification',()=>{
+  assert.equal(classifySafeQualificationResult({exitCode:0,stdout:summary()}).state,'PASSED');
+  for(const result of [
+    {exitCode:1,stdout:summary()},
+    {exitCode:0,signal:'SIGTERM',stdout:summary()},
+    {exitCode:0,stdout:summary({pass:0,skipped:1}),expectedSkipped:1},
+    {exitCode:0,stdout:summary({skipped:1})},
+    {exitCode:0,stdout:summary({todo:1})},
+    {exitCode:0,stdout:summary({fail:1})},
+    {exitCode:0,stdout:'TAP version 13\n'},
+    {exitCode:0,stdout:summary()+summary()},
+  ])assert.equal(classifySafeQualificationResult(result).state,'FAILED');
+  assert.equal(classifySafeQualificationResult({exitCode:0,stdout:summary({skipped:2}),expectedSkipped:2}).state,'PASSED');
+});
