+
+const execute=promisify(execFile);
+const summary=({pass=1,fail=0,cancelled=0,skipped=0,todo=0}={})=>
+  Object.entries({tests:pass+fail+cancelled+skipped+todo,pass,fail,cancelled,skipped,todo})
