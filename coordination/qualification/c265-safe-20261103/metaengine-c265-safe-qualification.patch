+test('portable success never grants physical restore, native Windows or first-task proof',()=>{
+  const plan=safeQualificationPlan();
+  assert.equal(plan.full_qualification,'INCOMPLETE');
+  for(const key of ['production_qualified','physical_restore_proven','windows_native_proven','first_real_task_proven',
