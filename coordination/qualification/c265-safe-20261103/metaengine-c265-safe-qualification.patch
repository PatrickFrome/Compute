+test('evidence workspaces are fresh and cannot overwrite an earlier result',async t=>{
+  const first=await createSafeQualificationWorkspace(),second=await createSafeQualificationWorkspace();
+  t.after(()=>Promise.all([first,second].map(value=>fs.rm(value.root,{recursive:true,force:true}))));
+  assert.notEqual(first.root,second.root);
+  assert.deepEqual(await fs.readdir(first.evidence),[]);
+  assert.deepEqual(await fs.readdir(second.evidence),[]);
+  const report=path.join(first.evidence,'report.json');
+  await fs.writeFile(report,'earlier-evidence',{flag:'wx'});
+  await assert.rejects(fs.writeFile(report,'replacement',{flag:'wx'}),{code:'EEXIST'});
+  assert.equal(await fs.readFile(report,'utf8'),'earlier-evidence');
+});
