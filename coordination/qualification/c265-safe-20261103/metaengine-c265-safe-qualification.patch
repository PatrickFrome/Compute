@@ -0,0 +1,170 @@
+#!/usr/bin/env node
+// Reviewed source/fixture tests only. This runner is not an OS sandbox and does
+// not qualify a Windows installation, native authority, or a real DB restore.
+import {execFile} from 'node:child_process';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {promisify} from 'node:util';
+
+const execute=promisify(execFile);
+const repositoryRoot=fileURLToPath(new URL('../../../',import.meta.url));
+const browserTest='apps/metaengine-browser/test/';
+const runtimeTest='infra/client-state-runtime/';
+const entry=(id,files,expectedSkipped=0)=>Object.freeze({id,
+  files:Object.freeze(files),expectedSkipped});
+
+export const SAFE_QUALIFICATION_SUITES=Object.freeze([
+  entry('install-upgrade-model',[
+    browserTest+'installer-update-transaction.test.mjs',
+    browserTest+'installer-update-recovery.test.mjs',
+  ]),
+  entry('disposable-image-restore',[browserTest+'qa-disposable-image-restore.test.mjs']),
+  entry('database-restore-guards',[
+    runtimeTest+'disposable-recovery-bundle-guard.test.mjs',
+    runtimeTest+'upgrade-backup-restore-gate.test.mjs',
+    runtimeTest+'pg17-backup-effect-barrier.test.mjs',
+  ]),
+  // This mixed suite has exactly two physical Windows cases. Linux skips are
+  // counted explicitly; any additional skip fails the portable qualification.
+  entry('acl-contract',[browserTest+'private-windows-storage-acl.test.mjs'],2),
+  entry('auth-first-task-admission-model',[
+    browserTest+'native-coding-initial-setup-main.test.mjs',
+    browserTest+'native-coding-capacity-first-dispatch.test.mjs',
+  ]),
+]);
+
+const notRun=Object.freeze([
+  Object.freeze({domain:'Windows clean install',status:'NOT RUN',
+    reason:'Linux-only runner; real installer NOT AUTHORIZED'}),
+  Object.freeze({domain:'Windows physical upgrade',status:'NOT RUN',
+    reason:'Linux-only runner; real installer NOT AUTHORIZED'}),
+  Object.freeze({domain:'Windows effective ACL, native peer/key/token/Job and launch',status:'NOT RUN',
+    reason:'Models and injected readbacks do not prove Windows behavior'}),
+  Object.freeze({domain:'Physical PostgreSQL restore',status:'NOT RUN',
+    reason:'No database processes or restore integration tests are selected; user DB restore NOT AUTHORIZED'}),
+  Object.freeze({domain:'Installed authentication and first real task',status:'NOT RUN',
+    reason:'Admission/executor fixtures are not a running installed product'}),
+  Object.freeze({domain:'wire_route_authenticates_then_launches',status:'NOT RUN BY THIS RUNNER',
+    reason:'Separate mandatory source check; known FAIL due HOLD must not be relabelled as success'}),
+]);
+
+export function safeQualificationPlan(){
+  return {schema:'metaengine.browser.safe-install-qualification.v1',
+    evidence_class:'PORTABLE/SOURCE/FIXTURE',full_qualification:'INCOMPLETE',
+    suites:SAFE_QUALIFICATION_SUITES,not_run:notRun,
+    production_qualified:false,physical_restore_proven:false,windows_native_proven:false,
+    first_real_task_proven:false,upgrade_authorized:false,
+    installer_authorization:'NOT AUTHORIZED',authority_effect:false};
+}
+
+export function parseSafeQualificationArguments(args){
+  if(args.length===0||(args.length===1&&args[0]==='--list'))return 'list';
+  if(args.length===1&&args[0]==='--run')return 'run';
+  throw Error('safe_qualification_arguments_invalid');
+}
+
+// No parent environment is spread or consulted. In particular PG*, database
+// URLs, NODE_OPTIONS/NODE_PATH, ASAN/LSAN/UBSAN and loader hooks cannot opt a
+// selected source test into an environment-selected integration path.
+export function safeQualificationEnvironment(profileRoot){
+  if(typeof profileRoot!=='string'||!path.isAbsolute(profileRoot))
+    throw Error('safe_qualification_profile_invalid');
+  const home=path.join(profileRoot,'home'),temporary=path.join(profileRoot,'tmp');
+  return Object.freeze({PATH:'/usr/bin:/bin',LANG:'C.UTF-8',LC_ALL:'C.UTF-8',TZ:'UTC',
+    HOME:home,USERPROFILE:home,APPDATA:path.join(profileRoot,'roaming'),
+    LOCALAPPDATA:path.join(profileRoot,'local'),
+    XDG_CONFIG_HOME:path.join(profileRoot,'config'),XDG_CACHE_HOME:path.join(profileRoot,'cache'),
+    XDG_DATA_HOME:path.join(profileRoot,'data'),XDG_STATE_HOME:path.join(profileRoot,'state'),
+    TMPDIR:temporary,TMP:temporary,TEMP:temporary});
+}
+
+export function safeQualificationInvocation(id,profileRoot){
+  const suite=SAFE_QUALIFICATION_SUITES.find(value=>value.id===id);
+  if(!suite)throw Error('safe_qualification_suite_not_allowlisted');
+  return {executable:process.execPath,
+    args:['--experimental-test-module-mocks','--experimental-vm-modules',
+      '--test','--test-concurrency=1','--test-reporter=tap',...suite.files],
+    options:{cwd:repositoryRoot,env:safeQualificationEnvironment(profileRoot),
+      shell:false,windowsHide:true,timeout:120000,maxBuffer:8*1024*1024}};
+}
+
+export function classifySafeQualificationResult({exitCode,signal=null,stdout='',expectedSkipped=0}){
+  const counts={};
+  for(const key of ['tests','pass','fail','cancelled','skipped','todo']){
+    const matches=[...stdout.matchAll(new RegExp('^# '+key+' (\\d+)\\r?$','gm'))];
+    if(matches.length!==1)return {state:'FAILED',reason:'test_summary_missing_or_ambiguous'};
+    counts[key]=Number(matches[0][1]);
+  }
+  const sum=counts.pass+counts.fail+counts.cancelled+counts.skipped+counts.todo;
+  const passed=exitCode===0&&signal===null&&counts.tests===sum&&counts.pass>0
+    &&counts.fail===0&&counts.cancelled===0&&counts.todo===0
+    &&counts.skipped===expectedSkipped;
+  return {state:passed?'PASSED':'FAILED',reason:passed?'portable_tests_only':'test_failure_or_unexpected_skip',counts};
+}
+
+export async function createSafeQualificationWorkspace(){
+  // No caller-provided output path; every run owns a new, initially empty
+  // directory and every evidence file is written with exclusive creation.
+  const temporaryParent=process.platform==='linux'?'/tmp':os.tmpdir();
+  const root=await fs.mkdtemp(path.join(temporaryParent,'metaengine-safe-install-qualification-'));
+  await fs.chmod(root,0o700);
+  const evidence=path.join(root,'evidence');await fs.mkdir(evidence,{mode:0o700});
+  return {root,evidence};
+}
+
+export async function runSafeQualification(){
+  // Some reviewed suites contain platform-gated physical Windows branches.
+  // Refuse that platform entirely instead of accidentally executing them.
+  if(process.platform!=='linux')throw Error('safe_qualification_linux_required');
+  const workspace=await createSafeQualificationWorkspace(),results=[];
+  for(const suite of SAFE_QUALIFICATION_SUITES){
+    const profileRoot=path.join(workspace.root,'profiles',suite.id);
+    const invocation=safeQualificationInvocation(suite.id,profileRoot);
+    for(const directory of new Set(Object.values(invocation.options.env)
+      .filter(value=>path.isAbsolute(value)&&value.startsWith(profileRoot+path.sep))))
+      await fs.mkdir(directory,{recursive:true,mode:0o700});
+    // Test filenames are fixed source inputs, never globs, CLI arguments or
+    // environment-selected binaries. Native/source mandatory runners are absent.
+    for(const file of suite.files){
+      const stat=await fs.lstat(path.join(repositoryRoot,file));
+      if(!stat.isFile()||stat.isSymbolicLink())throw Error('safe_qualification_test_not_regular');
+    }
+    process.stderr.write('Portable qualification: '+suite.id+'\n');
+    let stdout='',stderr='',exitCode=0,signal=null;
+    try{
+      ({stdout,stderr}=await execute(invocation.executable,invocation.args,invocation.options));
+    }catch(error){
+      stdout=typeof error.stdout==='string'?error.stdout:'';
+      stderr=typeof error.stderr==='string'?error.stderr:'';
+      exitCode=Number.isInteger(error.code)?error.code:1;signal=error.signal||null;
+    }
+    const output=path.join(workspace.evidence,suite.id+'.tap');
+    await fs.writeFile(output,stdout,{flag:'wx',mode:0o600});
+    await fs.writeFile(path.join(workspace.evidence,suite.id+'.stderr'),stderr,{flag:'wx',mode:0o600});
+    results.push({id:suite.id,files:suite.files,exit_code:exitCode,signal,
+      ...classifySafeQualificationResult({exitCode,signal,stdout,expectedSkipped:suite.expectedSkipped}),
+      output});
+  }
+  const report={...safeQualificationPlan(),state:results.every(value=>value.state==='PASSED')
+    ?'PORTABLE_CHECKS_PASSED':'PORTABLE_CHECKS_FAILED',
+    platform:process.platform,node_version:process.version,evidence_directory:workspace.evidence,
+    results};
+  await fs.writeFile(path.join(workspace.evidence,'report.json'),JSON.stringify(report,null,2)+'\n',
+    {flag:'wx',mode:0o600});
+  return report;
+}
+
+if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+  try{
+    const mode=parseSafeQualificationArguments(process.argv.slice(2));
+    const report=mode==='list'?safeQualificationPlan():await runSafeQualification();
+    process.stdout.write(JSON.stringify(report,null,2)+'\n');
+    if(report.state==='PORTABLE_CHECKS_FAILED')process.exitCode=1;
+  }catch(error){
+    const reason=error?.message?.startsWith('safe_qualification_')?error.message:'safe_qualification_execution_incomplete';
+    process.stdout.write(JSON.stringify({...safeQualificationPlan(),state:'NOT RUN OR INCOMPLETE',reason})+'\n');
+    process.exitCode=2;
+  }
+}
