+test('actual child environment excludes DB selectors, Node hooks, sanitizers and credentials',async t=>{
+  const workspace=await createSafeQualificationWorkspace();
+  t.after(()=>fs.rm(workspace.root,{recursive:true,force:true}));
+  const profile=path.join(workspace.root,'profile'),env=safeQualificationEnvironment(profile);
+  await fs.mkdir(env.TMPDIR,{recursive:true});
+  const moduleUrl=new URL('./safe-install-qualification.mjs',import.meta.url).href;
+  // Contaminate only a disposable child env, never the test process or OS env.
+  const hostile={...env,NODE_OPTIONS:'--trace-warnings',NODE_PATH:'/untrusted-modules',
+    ASAN_OPTIONS:'detect_leaks=0',LSAN_OPTIONS:'exitcode=0',UBSAN_OPTIONS:'halt_on_error=0',
+    LOCAL_STATE_TEST_PG_BIN_DIR:'/untrusted-postgres',METAENGINE_PG_TEST_PORT:'55432',
+    METAENGINE_PGLITE_MODE:'1',PGHOST:'user-db.invalid',PGPASSWORD:'fixture-secret',
+    DATABASE_URL:'postgresql://fixture-secret@user-db.invalid/db',OPENAI_API_KEY:'fixture-secret'};
+  const script=`import {execFile} from 'node:child_process';
+    import {promisify} from 'node:util';
+    import {safeQualificationEnvironment} from ${JSON.stringify(moduleUrl)};
+    const result=await promisify(execFile)(process.execPath,['-e','process.stdout.write(JSON.stringify(process.env))'],
+      {env:safeQualificationEnvironment(${JSON.stringify(profile)}),shell:false});
+    process.stdout.write(result.stdout);`;
+  const output=await execute(process.execPath,['--input-type=module','-e',script],
+    {env:hostile,shell:false,timeout:10000,maxBuffer:32768});
+  const actual=JSON.parse(output.stdout);
+  for(const key of Object.keys(hostile).filter(key=>!Object.hasOwn(env,key)))
+    assert.equal(actual[key],undefined,key);
+  assert.equal(actual.HOME,env.HOME);assert.equal(actual.TMPDIR,env.TMPDIR);
+  assert.throws(()=>safeQualificationEnvironment('relative'),/profile_invalid/);
+});
