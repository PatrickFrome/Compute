{
  "schema": "metaengine.a2-browser-protocol.v1",
  "version": "1.3.0",
  "transport": {
    "scope": "local_machine_only",
    "unix": "unix_domain_socket",
    "windows": "named_pipe",
    "authentication": "256_bit_per_daemon_session_capability_token",
    "max_request_bytes": 1048576,
    "internal_devtools": "native_remote_debugging_pipe"
  },
  "identity": {
    "durable": [
      "browser_node_id",
      "profile_id",
      "context_id",
      "context_epoch",
      "target_id",
      "conversation_epoch"
    ],
    "ephemeral": [
      "browser_pid",
      "process_incarnation_id",
      "cdp_browser_context_id",
      "cdp_target_id",
      "cdp_session_id",
      "semantic_frame_id",
      "backend_dom_node_id",
      "ax_node_id"
    ]
  },
  "methods": [
    "runtime.health",
    "profile.start",
    "profile.stop",
    "profile.list",
    "context.create",
    "context.list",
    "context.close",
    "target.create",
    "target.list",
    "target.semantic_snapshot",
    "target.activate",
    "target.close",
    "action.navigate",
    "action.click",
    "action.type",
    "action.submit",
    "receipt.get",
    "receipt.verify"
  ],
  "method_effects": {
    "runtime.health": "READ_ONLY",
    "profile.start": "LOCAL_LIFECYCLE",
    "profile.stop": "LOCAL_LIFECYCLE",
    "profile.list": "READ_ONLY",
    "context.create": "LOCAL_LIFECYCLE",
    "context.list": "READ_ONLY",
    "context.close": "LOCAL_LIFECYCLE",
    "target.create": "LOCAL_LIFECYCLE",
    "target.list": "READ_ONLY",
    "target.semantic_snapshot": "READ_ONLY",
    "target.activate": "LOCAL_UI",
    "target.close": "LOCAL_LIFECYCLE",
    "action.navigate": "ACTUATION",
    "action.click": "ACTUATION",
    "action.type": "ACTUATION",
    "action.submit": "ACTUATION",
    "receipt.get": "READ_ONLY",
    "receipt.verify": "READ_ONLY"
  },
  "semantic_perception": {
    "schema": "metaengine.a2-browser-operator.semantic-frame.v1",
    "page_data_tainted": true,
    "authority_effect": false,
    "page_script_evaluation": false,
    "default_node_budget": 60,
    "min_node_budget": 30,
    "max_node_budget": 80,
    "document_epoch_source": "main_frame_loader_id",
    "raw_cdp_exposed": false
  },
  "context_kinds": [
    "PERSISTENT_DEFAULT",
    "EPHEMERAL_ISOLATED"
  ],
  "forbidden_external_capabilities": [
    "raw_cdp",
    "raw_bidi",
    "runtime_evaluate",
    "javascript_eval",
    "shell_exec",
    "arbitrary_browser_flags",
    "arbitrary_executable_path",
    "headless_override",
    "sandbox_override",
    "remote_navigation_b1",
    "default_profile_import",
    "cookie_import",
    "raw_browser_context_id",
    "context_proxy_override",
    "context_universal_network_access",
    "default_context_disposal",
    "silent_context_recreation",
    "cookie_export",
    "storage_state_import",
    "storage_state_export",
    "context_permission_override",
    "accept_insecure_certificates_override",
    "devtools_tcp_listener",
    "page_text_authority",
    "page_data_authority",
    "arbitrary_input_dispatch"
  ],
  "web_authority_effect": false,
  "local_effects_present": true,
  "devtools_tcp_exposed": false,
  "trusted_engine_transport": {
    "kind": "chromium_remote_debugging_pipe",
    "framing": "nul_delimited_json",
    "max_frame_bytes": 16777216,
    "devtools_tcp_listener": false,
    "raw_cdp_external": false
  }
}