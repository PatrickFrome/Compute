{
  "schema": "metaengine.a2-browser-protocol.v1",
  "version": "1.5.0",
  "transport": {
    "scope": "local_machine_only",
    "unix": "unix_domain_socket",
    "windows": "named_pipe",
    "authentication": "256_bit_per_daemon_session_capability_token",
    "max_request_bytes": 1048576
  },
  "identity": {
    "durable": ["browser_node_id", "profile_id", "context_id", "context_epoch", "target_id", "conversation_epoch"],
    "ephemeral": ["browser_pid", "process_incarnation_id", "cdp_browser_context_id", "cdp_target_id", "cdp_session_id", "cdp_backend_node_id"]
  },
  "trusted_engine_transport": {
    "kind": "chromium_remote_debugging_pipe",
    "framing": "nul_delimited_json",
    "max_frame_bytes": 16777216,
    "devtools_tcp_listener": false,
    "raw_cdp_external": false
  },
  "methods": [
    "runtime.health",
    "profile.start",
    "profile.stop",
    "profile.list",
    "context.create",
    "context.list",
    "context.close",
    "target.create",
    "target.list",
    "perception.snapshot",
    "webmcp.snapshot",
    "planning.lookup",
    "planning.promote",
    "planning.abort",
    "planning.stats",
    "target.activate",
    "target.close"
  ],
  "method_effects": {
    "runtime.health": "READ_ONLY",
    "profile.start": "LOCAL_LIFECYCLE",
    "profile.stop": "LOCAL_LIFECYCLE",
    "profile.list": "READ_ONLY",
    "context.create": "LOCAL_LIFECYCLE",
    "context.list": "READ_ONLY",
    "context.close": "LOCAL_LIFECYCLE",
    "target.create": "LOCAL_LIFECYCLE",
    "target.list": "READ_ONLY",
    "perception.snapshot": "READ_ONLY",
    "webmcp.snapshot": "READ_ONLY",
    "planning.lookup": "LOCAL_COORDINATION",
    "planning.promote": "LOCAL_COORDINATION",
    "planning.abort": "LOCAL_COORDINATION",
    "planning.stats": "READ_ONLY",
    "target.activate": "LOCAL_UI",
    "target.close": "LOCAL_LIFECYCLE"
  },
  "forbidden_external_capabilities": [
    "raw_cdp",
    "runtime_evaluate",
    "javascript_eval",
    "shell_exec",
    "arbitrary_browser_flags",
    "arbitrary_executable_path",
    "headless_override",
    "sandbox_override",
    "remote_navigation_b1",
    "default_profile_import",
    "cookie_import",
    "raw_browser_context_id",
    "context_proxy_override",
    "context_universal_network_access",
    "default_context_disposal",
    "silent_context_recreation",
    "raw_cdp_session_id",
    "raw_cdp_backend_node_id",
    "arbitrary_perception_limits",
    "arbitrary_computed_styles",
    "oopif_completeness_without_proof",
    "planner_provider_credentials",
    "planner_execution_payload_persistence",
    "cached_node_ref_authority",
    "webmcp_invoke_r6a",
    "webmcp_raw_frame_id",
    "webmcp_raw_backend_node_id",
    "webmcp_registration_stack_trace",
    "webmcp_annotation_as_authority"
  ],
  "semantic_perception": {
    "schema": "metaengine.a2-compute-browser.semantic-snapshot.v1",
    "scope": "MAIN_TARGET",
    "oopif_complete": false,
    "consistency": "SEQUENTIAL_READ_ONLY",
    "actuation_eligible": false,
    "engine_session_ids_exposed": false,
    "engine_node_ids_exposed": false,
    "runtime_evaluate_used": false,
    "computed_styles": ["display", "visibility", "opacity", "pointer-events"],
    "limits_owner": "daemon"
  },
  "semantic_planning": {
    "schema": "metaengine.a2-browser-operator.semantic-planning-broker.v1",
    "provider_neutral": true,
    "model_execution_location": "external_agent",
    "cache_hit_skips_model_call": true,
    "cold_miss_single_leader": true,
    "promotion_requires_fresh_perception": true,
    "lease_tokens_ephemeral": true,
    "provider_credentials_stored": false,
    "execution_payload_stored": false,
    "cached_node_ref_authority": false,
    "must_run_actionability_checks": true,
    "web_authority_effect": false
  },
  "webmcp_discovery": {
    "schema": "metaengine.a2-browser-operator.webmcp-tools.v1",
    "stage": "R6A_DISCOVERY_ONLY",
    "progressive_enhancement": true,
    "cdp_domain": "WebMCP",
    "runtime_evaluate_used": false,
    "tool_invocation_exposed": false,
    "tool_metadata_tainted": true,
    "annotations_are_hints_only": true,
    "raw_frame_ids_exposed": false,
    "raw_backend_node_ids_exposed": false,
    "registration_stack_traces_exposed": false,
    "document_loader_fenced": true,
    "unsupported_is_typed_fallback": true,
    "fallback": "SEMANTIC_PERCEPTION_B4",
    "web_authority_effect": false
  },
  "web_authority_effect": false,
  "local_effects_present": true
}
