+#!/usr/bin/env python3
+"""Run actual reader acquisition, failure, RAII and native-host connect code.
+
+The surrounding handle table and hostile endpoint are synthetic. This proves
+the source composition's fail-closed behavior, not Windows handle provenance,
+service authentication, a working reader transfer, or launch qualification.
+"""
+from pathlib import Path
+import argparse
+import os
+import subprocess
+import tempfile
+
+
+def between(source, first, after):
+    start = source.index(first)
+    return source[start:source.index(after, start)]
+
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--sanitize', action='store_true')
+parser.add_argument('--peer-source', type=Path,
+                    help='alternate connected-peer source for regression checks')
+args = parser.parse_args()
+here = Path(__file__).resolve().parent
+native = here.parents[1] / 'native/browser-guardian-scm'
+source = (args.peer_source or native / 'browser-guardian-connected-peer.cpp').read_text()
+fragments = {
+    '@ACTUAL_HANDLE@': between(source, 'struct Handle {', 'struct ServiceHandle {'),
+    '@ACTUAL_FAIL@': between(source, '    bool fail(', '    std::uint64_t birthOfReader()'),
+    '@ACTUAL_ACQUIRE@': between(source, '    bool acquireOriginalReader()', '    bool originalKernel('),
+    '@ACTUAL_CONNECT@': between(source, 'bool GuardianConnectedPeer::connectOriginalNativeHostAuthority()',
+                               'bool GuardianConnectedPeer::recheckOriginalNativeHostAuthority()'),
+    '@ACTUAL_CLIENT_ACCESS@': between(source, 'constexpr DWORD kClientAccess =', '\n'),
+}
+model = (here / 'browser-guardian-original-reader-ownership-model.cpp.in').read_text()
+for marker, fragment in fragments.items():
+    if model.count(marker) != 1:
+        raise RuntimeError(f'expected exactly one extraction marker: {marker}')
+    model = model.replace(marker, fragment)
+with tempfile.TemporaryDirectory(prefix='guardian-reader-ownership-model-') as temporary:
+    generated = Path(temporary) / 'model.cpp'
+    generated.write_text(model)
+    binary = Path(temporary) / 'model'
+    flags = ['-fsanitize=address,undefined', '-fno-omit-frame-pointer'] if args.sanitize else []
+    subprocess.run(['g++', '-std=c++20', '-Wall', '-Wextra', '-Werror', '-pedantic',
+                    '-pthread', *flags, '-I', str(native), str(generated), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True, env={**os.environ, 'ASAN_OPTIONS': 'detect_leaks=1'})
