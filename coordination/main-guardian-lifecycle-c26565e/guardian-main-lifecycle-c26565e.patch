+    HANDLE make(ModelHandle::Kind kind, unsigned origin = 0, bool duplicate = false) {
+        handles.push_back(std::make_unique<ModelHandle>(ModelHandle{
+            kind, origin ? origin : next_origin++, duplicate, false, false, nullptr}));
+        return handles.back().get();
+    }
+    std::size_t liveDuplicates() const {
+        return std::count_if(handles.begin(), handles.end(), [](const auto& handle) {
+            return handle->duplicate && !handle->closed;
+        });
+    }
+    void markFatalObservation() {
+        if (fatal_observed) return;
+        fatal_observed = true;
+        store_reads_at_fatal = store_reads;
+        store_constructions_at_fatal = store_constructions;
+        root_checks_at_fatal = root_checks;
