+#!/usr/bin/env python3
+"""Run unedited production original-Main lifecycle methods under a Win32 model.
+
+This Linux source-only test composes the production startup, cancellation,
+process/Job drain, callback release and close methods byte-for-byte. Image and
+package validation, the registry and OS calls are fixtures. It cannot qualify
+Windows execution, a launch route, signatures, installation or authority.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+
+def sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def fragment(source: str, begin: str, end: str) -> str:
+    if source.count(begin) != 1:
+        raise ValueError(f"Expected a unique production marker: {begin}")
+    start = source.index(begin)
+    return source[start:source.index(end, start)]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tree", type=Path, required=True)
+    parser.add_argument("--evidence", type=Path, required=True)
+    parser.add_argument("--owner-source", type=Path, help="Optional original source for a regression control")
+    parser.add_argument("--sanitizer", choices=("none", "address,undefined", "thread"), default="none")
+    parser.add_argument("--repeat", type=int, default=1)
+    parser.add_argument("--case", help="Run cases whose names contain this exact substring")
+    args = parser.parse_args()
+    if not 1 <= args.repeat <= 100:
+        raise SystemExit("repeat must be from 1 through 100")
+    tree = args.tree.resolve()
+    native = tree / "apps/metaengine-browser/native/browser-guardian-scm"
+    source = (args.owner_source or native / "browser-guardian-original-main-debug-owner.cpp").resolve()
+    fixture = tree / "apps/metaengine-browser/test/native/browser-guardian-original-main-lifecycle-tests.cpp"
+    model = fixture.parent / "guardian-original-main-lifecycle-model/windows.h"
+    evidence = args.evidence.resolve()
+    if evidence.exists():
+        raise SystemExit("Use a new disposable evidence directory")
+    text = source.read_bytes().decode("utf-8")
+    fragments = {
