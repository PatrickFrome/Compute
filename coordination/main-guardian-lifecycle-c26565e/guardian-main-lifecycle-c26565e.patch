+template<class T> struct ReusedObject {
+    alignas(T) unsigned char storage[sizeof(T)];
+    T* object = nullptr;
+    ~ReusedObject() { if (object) std::destroy_at(object); }
+    template<class... Args> T& reconstruct(Args&&... args) {
+        if (object) std::destroy_at(object);
+        object = nullptr;
+        object = std::construct_at(reinterpret_cast<T*>(storage), std::forward<Args>(args)...);
+        return *object;
+    }
+};
