+constexpr DWORD SYNCHRONIZE = 0x100000, PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
+constexpr DWORD BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2;
+constexpr int FALSE = 0;
+constexpr std::size_t kMaxWireBytes = 16 * 1024;
+
+struct OwnerEnrollmentObservation {
+    DWORD session_id = 3, client_pid = 4242;
+    std::uint64_t client_creation_time_100ns = 133999999000000001ULL;
+    std::wstring user_sid = L"S-1-5-21-100-200-300-1000";
+    bool transport_exact = true;
+};
+struct OwnerRecord {
+    std::wstring expected_owner_sid = L"S-1-5-21-100-200-300-1000";
+    std::string enrollment_evidence_sha256 = "synthetic-owner-epoch";
+    std::string device_key_fingerprint_sha256 = "synthetic-enrolled-device";
+};
+struct OwnerEnrollmentStoreResult { OwnerRecord record; bool exact = true; };
+
+struct ModelEnvironment {
+    ULONGLONG tick = 1000;
+    bool root_ok = true, process_ok = true, logon_ok = true, release_bound = true;
+    bool proof_ok = true, hash_ok = true, random_ok = true, random_zero = false;
+    unsigned duplicate_calls = 0, fail_duplicate_at = 0, proof_calls = 0;
+    unsigned root_checks = 0, startup_checks = 0, pipe_reads = 0, store_reads = 0;
+    unsigned store_constructions = 0, identity_attempts = 0, fail_revert_at = 0, stop_signals = 0;
+    unsigned store_reads_at_fatal = 0, store_constructions_at_fatal = 0;
+    unsigned root_checks_at_fatal = 0, startup_checks_at_fatal = 0;
+    bool fatal_observed = false;
+    unsigned next_origin = 1;
+    LUID token_logon;
+    OwnerEnrollmentStoreResult durable;
+    std::string expected_material, last_material, last_hash_wire;
+    std::function<void()> proof_hook, hash_hook, random_hook;
+    std::array<std::function<void()>, 2> duplicate_hooks;
+    std::vector<std::unique_ptr<ModelHandle>> handles;
+    std::vector<HANDLE> duplicate_sources;
+    std::vector<DWORD> duplicate_rights;
+    HANDLE service = nullptr, stop = nullptr;
+
+    ModelEnvironment() {
+        service = make(ModelHandle::Kind::Service);
+        stop = make(ModelHandle::Kind::Stop);
