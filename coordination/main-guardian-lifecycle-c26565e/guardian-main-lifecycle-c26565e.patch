+def section(source: str, first: str, following: str) -> str:
+    """Keep the selected production implementation intact; fail on source drift."""
+    if source.count(first) != 1:
+        raise RuntimeError(f"expected one production section: {first!r}")
+    start = source.index(first)
+    return source[start:source.index(following, start)]
