+namespace fixture {
+using namespace std::chrono_literals;
+enum class Kind { Event, Worker, Process, Thread, Job, Token, File, Pipe };
+struct Object {
+    explicit Object(Kind value) : kind(value) {}
+    Kind kind;
+    std::atomic<bool> signaled{false}, assigned{false}, exit_continued{false};
+    std::atomic<int> active{0};
+    DWORD pid = 0, event_number = 0;
+    std::uint64_t born = 100;
+};
+struct Slot { std::shared_ptr<Object> object; };
+struct Config {
+    bool stop_before_registration = false, registration_refused = false, registration_throws = false;
+    bool thread_failed = false, gate_signal_failed = false, duplicate_failed = false, prepare_failed = false;
+    bool create_failed = false, debug_kill_flag_failed = false, assign_failed = false, job_capture_failed = false;
+    bool dynamic_policy_failed = false, cancel_after_creation = false, event_throws = false;
+    bool diagnostic_allocation_failed = false, natural_exit = false;
+    bool hold_worker_exit = false, cancellation_failed = false;
+    bool pipe_early_failure = false, pipe_revert_failure = false;
+    int process_kill_failures = 0, job_kill_failures = 0, continue_failures = 0;
+    int job_query_failures = 0, descendants_after_exit = 0, descendant_queries = 0;
+    int process_exit_waits = 0, pipe_incomplete_results = 0, worker_wait_failures = 0;
+};
+struct Model {
+    explicit Model(Config value) : config(value), process_failures(value.process_kill_failures),
+        job_failures(value.job_kill_failures), continue_errors(value.continue_failures),
+        query_errors(value.job_query_failures), descendant_waits(value.descendant_queries),
+        process_waits(value.process_exit_waits), io_incomplete(value.pipe_incomplete_results),
+        worker_wait_errors(value.worker_wait_failures) {}
+    Config config;
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::vector<std::unique_ptr<Slot>> slots;
+    std::vector<std::thread> native_threads;
+    std::vector<std::string> events;
+    std::deque<DEBUG_EVENT> debug_events;
+    std::shared_ptr<Object> stop, worker, process, primary, job;
+    DEBUG_EVENT current_debug_event{};
+    std::atomic<int> errors{0}, callbacks{0}, worker_retained{0}, job_retained{0}, custody_holds{0};
+    std::atomic<int> process_creations{0}, resumes{0}, process_kills{0}, job_kills{0}, job_queries{0};
+    std::atomic<int> event_files_closed{0}, pipe_joins{0}, io_cancels{0}, io_results{0}, worker_waits{0};
+    std::atomic<int> process_failures, job_failures, continue_errors, query_errors, descendant_waits;
+    std::atomic<int> process_waits, io_incomplete, worker_wait_errors;
+    std::atomic<bool> registration_active{false}, registration_entered{false}, worker_gate_woken{false}, pipe_pending{false};
+    std::atomic<bool> worker_returned{false}, allow_worker_signal{false}, exit_queued{false}, natural_exit_queued{false};
+    int event_count = 0;
+    HANDLE add(std::shared_ptr<Object> object) {
+        auto slot = std::make_unique<Slot>(); slot->object = std::move(object);
+        const auto raw = static_cast<HANDLE>(slot.get());
+        std::lock_guard guard(mutex); slots.push_back(std::move(slot)); return raw;
+    }
+    HANDLE make(Kind kind) { return add(std::make_shared<Object>(kind)); }
+    std::shared_ptr<Object> get(HANDLE value) {
+        std::lock_guard guard(mutex);
+        for (const auto& slot : slots) if (slot.get() == value) return slot->object;
+        return {};
+    }
+    void record(const std::string& value) { std::lock_guard guard(mutex); events.push_back(value); changed.notify_all(); }
+    void queueExit() {
+        if (exit_queued.exchange(true)) return;
+        DEBUG_EVENT event; event.dwDebugEventCode = EXIT_PROCESS_DEBUG_EVENT;
+        event.dwProcessId = 480; event.dwThreadId = 481;
+        std::lock_guard guard(mutex); debug_events.push_back(event); changed.notify_all();
+    }
+    void join() { for (auto& thread : native_threads) if (thread.joinable()) thread.join(); }
+    bool before(const std::string& a, const std::string& b) {
+        std::lock_guard guard(mutex);
+        const auto first = std::find(events.begin(), events.end(), a), last = std::find(events.begin(), events.end(), b);
+        return first != events.end() && last != events.end() && first < last;
+    }
+};
+Model* model = nullptr;
+thread_local DWORD last_error = ERROR_SUCCESS;
+thread_local bool debugger_thread = false;
+thread_local bool reject_next_allocation = false;
+bool consume(std::atomic<int>& count) {
+    auto left = count.load();
+    while (left > 0) if (count.compare_exchange_weak(left, left - 1)) return true;
+    return false;
+}
+class Handle {
+public:
+    HANDLE value = INVALID_HANDLE_VALUE;
+    Handle() = default;
+    explicit Handle(HANDLE raw) : value(raw) {}
+    Handle(const Handle&) = delete;
+    Handle& operator=(const Handle&) = delete;
+    Handle(Handle&& other) noexcept : value(std::exchange(other.value, INVALID_HANDLE_VALUE)) {}
+    Handle& operator=(Handle&& other) noexcept {
+        if (this != &other) { if (valid()) CloseHandle(value); value = std::exchange(other.value, INVALID_HANDLE_VALUE); }
+        return *this;
+    }
+    ~Handle() { if (valid()) CloseHandle(value); }
+    bool valid() const { return value && value != INVALID_HANDLE_VALUE; }
+};
+}
+
+// One failing allocation on the debugger thread models a diagnostic allocation
+// failing while entry is already handling an image-validation exception.
+[[gnu::noinline]] void* operator new(std::size_t size) {
+    if (fixture::reject_next_allocation) {
+        fixture::reject_next_allocation = false; throw std::bad_alloc();
+    }
+    if (auto* value = std::malloc(size ? size : 1)) return value;
+    throw std::bad_alloc();
+}
+[[gnu::noinline]] void operator delete(void* value) noexcept { std::free(value); }
+[[gnu::noinline]] void operator delete(void* value, std::size_t) noexcept { std::free(value); }
+
+DWORD GetLastError() { return fixture::last_error; }
+HANDLE GetCurrentProcess() { return reinterpret_cast<HANDLE>(std::uintptr_t{1}); }
+BOOL DuplicateHandle(HANDLE source_process, HANDLE source, HANDLE target_process, HANDLE* output,
+    DWORD, BOOL inherit, DWORD) {
+    auto& m = *fixture::model;
+    if (source_process != GetCurrentProcess() || target_process != GetCurrentProcess() || inherit || !output) {
+        ++m.errors; return FALSE;
+    }
+    const auto object = m.get(source);
+    if (!object || m.config.duplicate_failed) { fixture::last_error = ERROR_ACCESS_DENIED; return FALSE; }
+    *output = m.add(object); return TRUE;
+}
+BOOL CloseHandle(HANDLE value) {
+    auto& m = *fixture::model;
+    std::lock_guard guard(m.mutex);
+    for (const auto& slot : m.slots) if (slot.get() == value) {
+        const auto object = slot->object;
+        if (!object) { ++m.errors; return FALSE; }
+        if (object->kind == fixture::Kind::Process && object->pid == 480 && !object->signaled) ++m.errors;
+        if (object->kind == fixture::Kind::Job && object->active.load() != 0) ++m.errors;
+        if (object->kind == fixture::Kind::Pipe && m.pipe_pending) ++m.errors;
+        if (object->kind == fixture::Kind::File) ++m.event_files_closed;
+        slot->object.reset(); return TRUE;
+    }
+    ++m.errors; return FALSE;
+}
+DWORD GetProcessId(HANDLE value) { const auto object = fixture::model->get(value); return object ? object->pid : 0; }
+BOOL GetProcessTimes(HANDLE value, FILETIME* created, FILETIME*, FILETIME*, FILETIME*) {
+    const auto object = fixture::model->get(value);
+    if (!object) return FALSE;
+    created->dwLowDateTime = static_cast<DWORD>(object->born);
+    created->dwHighDateTime = static_cast<DWORD>(object->born >> 32); return TRUE;
+}
+DWORD WaitForSingleObject(HANDLE value, DWORD timeout) {
+    auto& m = *fixture::model;
+    const auto object = m.get(value);
+    if (!object) { fixture::last_error = ERROR_INVALID_HANDLE; return WAIT_FAILED; }
+    if (object->kind == fixture::Kind::Worker) {
+        ++m.worker_waits;
+        if (!fixture::debugger_thread && fixture::consume(m.worker_wait_errors)) return WAIT_FAILED;
+    }
+    if (object->kind == fixture::Kind::Process && object->pid == 480 && object->exit_continued) {
+        if (fixture::consume(m.process_waits)) return WAIT_TIMEOUT;
+        object->signaled = true;
+    }
+    if (object->signaled) {
+        if (object->kind == fixture::Kind::Worker) m.record("worker-joined");
+        return WAIT_OBJECT_0;
+    }
+    if (timeout && object->kind == fixture::Kind::Worker) {
+        std::unique_lock guard(m.mutex);
+        m.changed.wait_for(guard, std::chrono::milliseconds(5), [&] { return object->signaled.load(); });
+    } else if (timeout) std::this_thread::yield();
+    return object->signaled ? WAIT_OBJECT_0 : WAIT_TIMEOUT;
+}
+DWORD WaitForMultipleObjects(DWORD count, const HANDLE* values, BOOL all, DWORD) {
+    auto& m = *fixture::model;
+    if (!fixture::debugger_thread || all) ++m.errors;
+    for (;;) {
+        for (DWORD i = 0; i < count; ++i) if (WaitForSingleObject(values[i], 0) == WAIT_OBJECT_0) {
+            m.worker_gate_woken = true; m.changed.notify_all(); return WAIT_OBJECT_0 + i;
+        }
+        std::unique_lock guard(m.mutex); m.changed.wait_for(guard, std::chrono::milliseconds(1));
+    }
+}
+HANDLE CreateEventW(void*, BOOL, BOOL signal, const wchar_t*) {
+    auto& m = *fixture::model;
+    auto object = std::make_shared<fixture::Object>(fixture::Kind::Event);
+    object->event_number = static_cast<DWORD>(++m.event_count); object->signaled = signal;
+    return m.add(std::move(object));
+}
+BOOL SetEvent(HANDLE value) {
+    auto& m = *fixture::model;
+    const auto object = m.get(value);
+    if (!object) return FALSE;
+    if (object->event_number == 2 && m.config.gate_signal_failed) { fixture::last_error = ERROR_ACCESS_DENIED; return FALSE; }
+    object->signaled = true;
+    m.changed.notify_all(); return TRUE;
+}
+void Sleep(DWORD) { std::this_thread::yield(); }
+BOOL GetTokenInformation(HANDLE value, TOKEN_INFORMATION_CLASS kind, void* output, DWORD, DWORD* written) {
+    if (!fixture::model->get(value)) return FALSE;
+    if (kind == TokenType) { *static_cast<TOKEN_TYPE*>(output) = TokenPrimary; *written = sizeof(TOKEN_TYPE); }
+    else { *static_cast<DWORD*>(output) = 2; *written = sizeof(DWORD); }
+    return TRUE;
+}
+HANDLE CreateThread(void*, std::size_t, DWORD (WINAPI* entry)(void*), void* argument, DWORD, DWORD* id) {
+    auto& m = *fixture::model;
+    if (m.config.thread_failed) { fixture::last_error = ERROR_NOT_ENOUGH_MEMORY; return nullptr; }
+    m.worker = std::make_shared<fixture::Object>(fixture::Kind::Worker);
+    const auto handle = m.add(m.worker); *id = 800;
+    if (m.config.stop_before_registration) { m.stop->signaled = true; m.changed.notify_all(); }
+    m.native_threads.emplace_back([&m, entry, argument] {
+        fixture::debugger_thread = true;
+        if (m.config.stop_before_registration) {
+            // Force the old callback-release race after the registering call
+            // has retained its own local fixture state, making the regression
+            // control deterministic without dereferencing a deleted callback.
+            std::unique_lock guard(m.mutex);
+            m.changed.wait(guard, [&] { return m.registration_entered.load(); });
+        }
+        entry(argument);
+        m.worker_returned = true; m.record("worker-returned");
+        if (m.config.hold_worker_exit) {
+            std::unique_lock guard(m.mutex);
+            m.changed.wait(guard, [&] { return m.allow_worker_signal.load(); });
+        }
+        m.worker->signaled = true; m.record("worker-signaled");
+    });
+    return handle;
+}
+HANDLE CreateJobObjectW(void*, const wchar_t*) {
+    auto& m = *fixture::model;
+    m.job = std::make_shared<fixture::Object>(fixture::Kind::Job); return m.add(m.job);
+}
+BOOL SetInformationJobObject(HANDLE, JOBOBJECTINFOCLASS, const void* value, DWORD) {
+    const auto* limits = static_cast<const JOBOBJECT_EXTENDED_LIMIT_INFORMATION*>(value);
+    if (limits->BasicLimitInformation.LimitFlags != JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE) ++fixture::model->errors;
+    return TRUE;
+}
+BOOL QueryInformationJobObject(HANDLE value, JOBOBJECTINFOCLASS, void* output, DWORD, DWORD*) {
+    auto& m = *fixture::model; ++m.job_queries;
+    const auto object = m.get(value);
