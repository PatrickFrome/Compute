+#!/usr/bin/env python3
+"""Run actual SCM lifecycle methods against synthetic handles and real C++ threads.
+
+The production methods are extracted verbatim. Win32 objects, process creation,
+policy, authorization, and Main completion are stand-ins: this is not a Windows
+kernel test and does not establish sender composition or launch authority.
+"""
+
+from pathlib import Path
+import os
+import subprocess
+import sys
+import tempfile
+
+
+native = Path(__file__).resolve().parents[2] / "native/browser-guardian-scm"
+source = (native / "browser-guardian-scm-service.cpp").read_text()
+
+
+def segment(start, end):
+    first = source.index(start)
+    return source[first:source.index(end, first)]
+
+
+publish_stop = segment("    bool publishOriginalStop(", "    void requestStop()")
+replacement_quiesced = segment("    bool replacementQuiesced()", "    GuardianStartupCodeCustody* startup()")
+request_stop = segment("    void requestStop()", "    void closeStartup()")
+close_startup = segment("    void closeStartup()", "    void initializeReplacement(")
+launch = segment("    GuardianUpdateActuatorResult launchOriginalMain(", "    bool cachePreparation(")
+control = segment("DWORD WINAPI serviceControlHandler(", "\nbool waitOverlapped(")
+service_main = segment("void WINAPI serviceMain(", "\nint printContract(")
+worker_reply_tail = segment(
+    "            if (g_effect_owner.retireWorkerAfterImpersonationFailure(pipe)) {",
+    "\n        }\n        nativeRootSession.closeOriginalMaterialReader();",
+)
+signature = launch[:launch.index(") {")]
+pipe_argument = "pipe, " if "OwnerEnrollmentPipe&" in signature else ""
+
+pre = r'''
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <future>
+#include <iostream>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#define WINAPI
+using DWORD = std::uint32_t;
+using ULONGLONG = std::uint64_t;
+using HANDLE = void*;
+using LPVOID = void*;
+using LPWSTR = wchar_t*;
+using SERVICE_STATUS_HANDLE = void*;
+struct SERVICE_STATUS {};
+constexpr DWORD WAIT_OBJECT_0 = 0, WAIT_TIMEOUT = 258, WAIT_FAILED = 0xffffffffU;
+constexpr DWORD INFINITE = 0xffffffffU;
+constexpr DWORD NO_ERROR = 0, ERROR_ACCESS_DENIED = 5, ERROR_INVALID_HANDLE = 6;
+constexpr DWORD ERROR_ALREADY_EXISTS = 183, ERROR_PROCESS_ABORTED = 1067;
+constexpr DWORD ERROR_CALL_NOT_IMPLEMENTED = 120;
+constexpr DWORD SERVICE_STOPPED = 1, SERVICE_START_PENDING = 2;
+constexpr DWORD SERVICE_STOP_PENDING = 3, SERVICE_RUNNING = 4;
+constexpr DWORD SERVICE_CONTROL_STOP = 1, SERVICE_CONTROL_INTERROGATE = 4;
+constexpr DWORD SERVICE_CONTROL_SHUTDOWN = 5;
+constexpr bool TRUE = true, FALSE = false;
+const HANDLE INVALID_HANDLE_VALUE = reinterpret_cast<HANDLE>(~std::uintptr_t(0));
+
+struct KernelObject {
+    bool signaled = false;
+    bool closed = false;
+};
+struct Fixture {
+    std::mutex mutex;
+    std::condition_variable changed;
+    KernelObject stop, worker, token, requester;
+    std::vector<std::string> events;
+    bool fail_owner = false, block_close = false, allow_close = true;
+    bool close_entered = false, owner_joined = false;
+    bool running = false, pending = false, stopped = false;
+    bool startup_closed = false, replacement_finished = false;
+    unsigned owner_starts = 0, worker_waits = 0, worker_timeouts = 0;
+    unsigned original_stop_waits = 0;
+    unsigned frames_handled = 0, replies_written = 0, failed_joins = 0, successful_joins = 0;
+
+    void recordLocked(const std::string& event) {
+        events.push_back(event);
+        changed.notify_all();
+    }
+    void record(const std::string& event) {
+        std::lock_guard guard(mutex);
+        recordLocked(event);
+    }
+    template<class Predicate>
+    bool await(Predicate predicate, unsigned milliseconds = 2000) {
+        std::unique_lock guard(mutex);
+        return changed.wait_for(guard, std::chrono::milliseconds(milliseconds), predicate);
+    }
+    template<class Predicate>
+    bool observe(Predicate predicate) {
+        std::lock_guard guard(mutex);
+        return predicate();
+    }
+    void signal(KernelObject& object, const std::string& event) {
+        std::lock_guard guard(mutex);
+        object.signaled = true;
+        recordLocked(event);
+    }
+    void releaseClose() {
+        std::lock_guard guard(mutex);
+        allow_close = true;
+        changed.notify_all();
+    }
+    void reset() {
+        std::lock_guard guard(mutex);
+        stop = {}; worker = {}; token = {}; requester = {};
+        events.clear();
+        fail_owner = block_close = close_entered = owner_joined = false;
+        allow_close = true;
+        running = pending = stopped = startup_closed = replacement_finished = false;
+        owner_starts = worker_waits = worker_timeouts = original_stop_waits = 0;
+        frames_handled = replies_written = failed_joins = successful_joins = 0;
+    }
+} fixture;
+
+thread_local DWORD last_error = NO_ERROR;
+DWORD GetLastError() { return last_error; }
+ULONGLONG GetTickCount64() { return 100; }
+bool SetEvent(HANDLE raw) {
+    if (!raw || raw == INVALID_HANDLE_VALUE) return false;
+    auto& object = *static_cast<KernelObject*>(raw);
+    std::lock_guard guard(fixture.mutex);
+    if (object.closed) return false;
+    object.signaled = true;
+    fixture.recordLocked(raw == &fixture.stop ? "STOP_EVENT_SET" : "EVENT_SET");
+    return true;
+}
+bool CloseHandle(HANDLE raw) {
+    if (!raw || raw == INVALID_HANDLE_VALUE) return false;
+    auto& object = *static_cast<KernelObject*>(raw);
+    std::lock_guard guard(fixture.mutex);
+    object.closed = true;
+    fixture.recordLocked(raw == &fixture.worker ? "WORKER_HANDLE_CLOSED" : "HANDLE_CLOSED");
+    return true;
+}
+DWORD WaitForSingleObject(HANDLE raw, DWORD milliseconds) {
+    std::unique_lock guard(fixture.mutex);
+    if (!raw || raw == INVALID_HANDLE_VALUE || static_cast<KernelObject*>(raw)->closed) {
+        last_error = ERROR_INVALID_HANDLE;
+        return WAIT_FAILED;
+    }
+    auto& object = *static_cast<KernelObject*>(raw);
+    if (raw == &fixture.worker && milliseconds) {
+        ++fixture.worker_waits;
+        fixture.recordLocked("WORKER_JOIN_WAIT");
+    }
+    if (raw == &fixture.stop && milliseconds == INFINITE) {
+        ++fixture.original_stop_waits;
+        fixture.recordLocked("WAIT_ORIGINAL_STOP");
+    }
+    bool ready = object.signaled;
+    if (!ready && milliseconds == INFINITE) {
+        fixture.changed.wait(guard, [&] { return object.signaled; });
+        ready = true;
+    } else if (!ready && milliseconds) {
+        // Deterministic short fixture waits preserve timeout/completion semantics.
+        ready = fixture.changed.wait_for(guard,
+            std::chrono::milliseconds(std::min(milliseconds, DWORD(20))),
+            [&] { return object.signaled; });
+    }
+    if (ready && raw == &fixture.worker && milliseconds)
+        fixture.recordLocked("WORKER_JOIN_OBSERVED");
+    if (!ready && raw == &fixture.worker && milliseconds) {
+        ++fixture.worker_timeouts;
+        fixture.recordLocked("WORKER_JOIN_TIMEOUT");
+    }
+    return ready ? WAIT_OBJECT_0 : WAIT_TIMEOUT;
+}
+DWORD WaitForMultipleObjects(DWORD count, const HANDLE* objects, bool all, DWORD milliseconds) {
+    std::unique_lock guard(fixture.mutex);
+    auto result = [&] {
+        for (DWORD index = 0; index < count; ++index) {
+            if (!objects[index] || objects[index] == INVALID_HANDLE_VALUE ||
+                static_cast<KernelObject*>(objects[index])->closed) return WAIT_FAILED;
+            if (static_cast<KernelObject*>(objects[index])->signaled && !all)
+                return WAIT_OBJECT_0 + index;
+        }
+        if (all && std::all_of(objects, objects + count, [](HANDLE raw) {
+                return static_cast<KernelObject*>(raw)->signaled;
+            })) return WAIT_OBJECT_0;
+        return WAIT_TIMEOUT;
+    };
+    DWORD wait = result();
+    if (wait == WAIT_TIMEOUT && milliseconds == INFINITE) {
+        fixture.changed.wait(guard, [&] { return result() != WAIT_TIMEOUT; });
+        wait = result();
+    } else if (wait == WAIT_TIMEOUT && milliseconds) {
+        fixture.changed.wait_for(guard,
+            std::chrono::milliseconds(std::min(milliseconds, DWORD(20))),
+            [&] { return result() != WAIT_TIMEOUT; });
+        wait = result();
+    }
+    return wait;
+}
+void Sleep(DWORD) { std::this_thread::sleep_for(std::chrono::milliseconds(1)); }
+
+struct GuardianEffectAdmission {
+    std::atomic<bool> revoked{false};
+    bool stopped() const noexcept { return revoked.load(std::memory_order_acquire); }
+    void stop() noexcept { revoked.store(true, std::memory_order_release); fixture.record("ADMISSION_STOPPED"); }
+};
+struct GuardianReplacementDrain { struct Callback {}; };
+struct OwnerEnrollmentPipe {
+    bool revert_failed = false;
+    bool impersonationRevertFailed() const noexcept { return revert_failed; }
+    HANDLE handle() const { return &fixture.requester; }
+};
+struct GuardianInstalledNamespace {};
+struct GuardianActiveLoadedPolicy {
+    static std::unique_ptr<GuardianActiveLoadedPolicy> capture(HANDLE) {
+        return std::make_unique<GuardianActiveLoadedPolicy>();
+    }
+    bool recheck() const { return true; }
+};
+struct GuardianOriginalMainLaunchGrant {
+    struct Bound {
+        DWORD session_id = 1, client_pid = 11;
+        std::uint64_t client_birth_100ns = 12, monotonic_deadline_ms = 450;
+    } value;
+    bool consumed = false;
+    const Bound& bound() const { return value; }
+    bool consume() { return !std::exchange(consumed, true); }
+};
+struct GuardianUpdateActuatorResult {
+    std::string state, reason;
+    DWORD win32_error = 0, pid = 0, session_id = 0;
+    std::uint64_t creation_time_100ns = 0;
+    bool effect_absent_proven = false, automatic_retry_allowed = false;
+};
+struct GuardianNativeRootSession {
+    void joinOriginalRequest(bool delivered) {
+        std::lock_guard guard(fixture.mutex);
+        if (delivered) ++fixture.successful_joins;
+        else ++fixture.failed_joins;
+        fixture.recordLocked(delivered ? "REQUEST_JOIN_TRUE" : "REQUEST_JOIN_FALSE");
+    }
+    bool originalMaterialReceiptPending(HANDLE) const { return false; }
+    bool acceptOriginalMaterialReceipt(const std::string&, OwnerEnrollmentPipe&) const { return true; }
+    bool originalMaterialReaderOpen(HANDLE) const { return false; }
+    void closeOriginalMaterialReader() { fixture.record("MATERIAL_READER_CLOSED"); }
+    bool duplicateOriginalMainLaunchObjects(const GuardianOriginalMainLaunchGrant&,
+        HANDLE* token, HANDLE* requester, std::unique_ptr<GuardianInstalledNamespace>* package,
+        std::string*) {
+        *token = &fixture.token; *requester = &fixture.requester;
+        *package = std::make_unique<GuardianInstalledNamespace>();
+        return true;
+    }
+    bool duplicateOriginalMainLaunchObjects(const GuardianOriginalMainLaunchGrant& grant,
+        OwnerEnrollmentPipe&, HANDLE* token, HANDLE* requester,
+        std::unique_ptr<GuardianInstalledNamespace>* package, std::string* failure) {
+        return duplicateOriginalMainLaunchObjects(grant, token, requester, package, failure);
