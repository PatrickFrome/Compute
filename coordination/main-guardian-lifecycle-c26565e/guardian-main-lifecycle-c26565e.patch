+// The runner composes unedited production owner lifecycle methods and fields.
+// Only Win32, package/image validation, pipe issuance, and drain-registry calls
+// are modeled here. All objects are inert in-memory objects in this test TU.
+// This is no Windows, launch-authority, image-attestation or installation proof.
+#include "../../native/browser-guardian-scm/browser-guardian-original-main-debug-owner.hpp"
+#include "../../native/browser-guardian-scm/browser-guardian-original-main-debug-image.hpp"
+#include "../../native/browser-guardian-scm/browser-guardian-original-main-entry-protocol.hpp"
