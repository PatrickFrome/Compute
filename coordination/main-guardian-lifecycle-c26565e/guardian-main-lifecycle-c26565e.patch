+    methods = section(observer, "OwnerEnrollmentObservation OwnerEnrollmentPipe::observeClientIdentity(",
+                      "\nconst char* browserGuardianOwnerEnrollmentObserverContractJson()")
+    predicate = section(actuator, "bool clientTransportExact(const OwnerEnrollmentObservation& client)",
+                        "\nbool ownerAndClientExact(")
