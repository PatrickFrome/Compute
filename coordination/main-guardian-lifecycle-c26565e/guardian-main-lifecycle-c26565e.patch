+    }
+    for (const bool late : {false, true}) {
+        run(std::string("authorize_challenge_expires_during_") + (late ? "hash" : "proof"), [&] {
+            Fixture f;
+            auto& hook = late ? model().hash_hook : model().proof_hook;
+            hook = [] { model().tick += 30000; };
+            require(!f.authorize() && !f.failure.empty());
+            require(GuardianScmEffectOwner::package(f.session));
+        });
+    }
+    run("duplicate_admission_window_expired_at_entry", [] {
+        Fixture f; auto grant = f.mint(); model().tick = grant->bound().monotonic_deadline_ms;
+        refuse(f.session, f.pipe, *grant, "ORIGINAL_MAIN_LAUNCH_ADMISSION_WINDOW_EXPIRED");
+        require(model().duplicate_calls == 0);
+    });
+    for (unsigned phase : {0U, 1U}) {
+        run("duplicate_" + std::to_string(phase + 1) + "_deadline_expires", [&] {
+            Fixture f; auto grant = f.mint();
+            model().duplicate_hooks[phase] = [&] { model().tick = grant->bound().monotonic_deadline_ms; };
+            refuse(f.session, f.pipe, *grant, "ORIGINAL_MAIN_LAUNCH_ORIGINAL_INCARNATION_POSTCHECK_FAILED");
+        });
+        run("duplicate_" + std::to_string(phase + 1) + "_original_process_lost", [&] {
+            Fixture f; auto grant = f.mint();
+            model().duplicate_hooks[phase] = [] { model().process_ok = false; };
+            refuse(f.session, f.pipe, *grant, "ORIGINAL_MAIN_LAUNCH_ORIGINAL_INCARNATION_POSTCHECK_FAILED");
+        });
+        run("duplicate_" + std::to_string(phase + 1) + "_release_binding_lost", [&] {
+            Fixture f; auto grant = f.mint();
+            model().duplicate_hooks[phase] = [] { model().release_bound = false; };
+            refuse(f.session, f.pipe, *grant, "ORIGINAL_MAIN_LAUNCH_ORIGINAL_INCARNATION_POSTCHECK_FAILED");
+        });
+    }
+    for (unsigned failure_at : {1U, 2U}) {
+        run("native_duplicate_" + std::to_string(failure_at) + "_failure_closes_partial_handles", [&] {
+            Fixture f; auto grant = f.mint(); model().fail_duplicate_at = failure_at;
+            refuse(f.session, f.pipe, *grant);
+            require(model().duplicate_calls == failure_at);
+        });
+    }
+    for (const std::string seam : {"state", "startup", "stop", "token", "pipe", "release", "hash", "rng", "zero_correlation"}) {
+        run("authorize_missing_or_invalid_" + seam, [&] {
+            Fixture f;
+            if (seam == "state") GuardianScmEffectOwner::clearState(f.session);
+            if (seam == "startup") GuardianScmEffectOwner::clearStartup(f.session);
+            if (seam == "stop") GuardianScmEffectOwner::clearStop(f.session);
+            if (seam == "token") GuardianScmEffectOwner::state(f.session).user_token.reset();
+            if (seam == "pipe") f.pipe.connected = false;
+            if (seam == "release") model().release_bound = false;
+            if (seam == "hash") model().hash_ok = false;
+            if (seam == "rng") model().random_ok = false;
+            if (seam == "zero_correlation") model().random_zero = true;
