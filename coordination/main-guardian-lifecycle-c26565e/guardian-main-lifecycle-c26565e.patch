+static bool CloseHandle(HANDLE handle) {
+    require(handle && handle != INVALID_HANDLE_VALUE && !handle->closed, "double/invalid synthetic handle close");
+    handle->closed = true;
+    return true;
+}
+static DWORD WaitForSingleObject(HANDLE handle, DWORD timeout) {
+    require(timeout == 0, "model permits only nonblocking native observations");
+    if (!handle || handle == INVALID_HANDLE_VALUE || handle->closed) return WAIT_FAILED;
+    return handle->signaled ? WAIT_OBJECT_0 : WAIT_TIMEOUT;
+}
+static bool SetEvent(HANDLE event) {
+    require(event == model().stop && event && event != INVALID_HANDLE_VALUE &&
+        !event->closed && event->kind == ModelHandle::Kind::Stop, "must signal the existing worker stop event");
+    ++model().stop_signals;
+    event->signaled = true;
+    return true;
