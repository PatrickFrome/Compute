+static bool PeekNamedPipe(HANDLE pipe, void* buffer, DWORD size, DWORD* read, DWORD* available, DWORD* left) {
+    require(!buffer && !size && !read && !available && !left, "pipe liveness must not consume input");
+    return pipe && !pipe->closed && pipe->kind == ModelHandle::Kind::Pipe &&
+        pipe->connection_live && *pipe->connection_live;
+}
+static int _wcsicmp(const wchar_t* left, const wchar_t* right) {
+    for (; *left && *right; ++left, ++right) {
+        if (std::towlower(*left) != std::towlower(*right))
+            return std::towlower(*left) < std::towlower(*right) ? -1 : 1;
+    }
+    return (*left != 0) - (*right != 0);
+}
+static bool BCRYPT_SUCCESS(long result) { return result >= 0; }
+static long BCryptGenRandom(void*, PUCHAR bytes, ULONG count, DWORD flags) {
+    require(flags == BCRYPT_USE_SYSTEM_PREFERRED_RNG, "unexpected entropy API mode");
+    auto& m = model();
+    if (!m.random_ok) return -1;
+    for (ULONG i = 0; i < count; ++i) bytes[i] = m.random_zero ? 0 : static_cast<unsigned char>(i + 1);
+    fire(m.random_hook);
+    return 0;
+}
+static bool DuplicateHandle(HANDLE source_process, HANDLE source, HANDLE target_process,
+    HANDLE* output, DWORD rights, int inherit, DWORD options) {
+    auto& m = model();
+    require(source_process == m.service && target_process == m.service && !inherit && !options,
+        "only original in-process restricted duplication is modeled");
+    ++m.duplicate_calls;
+    m.duplicate_sources.push_back(source);
+    m.duplicate_rights.push_back(rights);
+    if (!source || source->closed || m.duplicate_calls == m.fail_duplicate_at) return false;
+    *output = m.make(source->kind, source->origin, true);
+    if (m.duplicate_calls <= m.duplicate_hooks.size()) fire(m.duplicate_hooks[m.duplicate_calls - 1]);
+    return true;
+}
