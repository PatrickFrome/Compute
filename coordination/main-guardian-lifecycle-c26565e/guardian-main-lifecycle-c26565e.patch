+static ModelEnvironment* current = nullptr;
+static ModelEnvironment& model() {
+    if (!current) throw std::runtime_error("synthetic environment missing");
+    return *current;
+}
+static void require(bool okay, const char* reason = "assertion") {
+    if (!okay) throw std::runtime_error(reason);
+}
+static void fire(std::function<void()>& hook) {
+    auto once = std::move(hook);
+    hook = {};
