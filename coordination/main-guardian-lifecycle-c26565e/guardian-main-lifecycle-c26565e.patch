+    run("correlation_clock_overflow_refused", [] {
+        Fixture f;
+        model().random_hook = [] { model().tick = (std::numeric_limits<ULONGLONG>::max)() - 1; };
+        require(!f.authorize() && f.failure == "ORIGINAL_MAIN_LAUNCH_CLOCK_UNAVAILABLE");
+    });
+    for (const std::string seam : {"state", "startup", "stop", "pipe", "token", "requester", "release"}) {
+        run("duplicate_missing_or_invalid_" + seam, [&] {
+            Fixture f; auto grant = f.mint();
+            if (seam == "state") GuardianScmEffectOwner::clearState(f.session);
+            if (seam == "startup") GuardianScmEffectOwner::clearStartup(f.session);
+            if (seam == "stop") GuardianScmEffectOwner::clearStop(f.session);
+            if (seam == "pipe") f.pipe.connected = false;
+            if (seam == "token") GuardianScmEffectOwner::state(f.session).user_token.reset();
+            if (seam == "requester") GuardianScmEffectOwner::state(f.session).client_process.reset();
+            if (seam == "release") model().release_bound = false;
+            refuse(f.session, f.pipe, *grant);
+        });
+    }
+    for (unsigned missing : {0U, 1U, 2U}) {
+        run("duplicate_null_output_" + std::to_string(missing), [&] {
+            Fixture f; auto grant = f.mint(); Outputs outputs;
+            auto* retained = GuardianScmEffectOwner::package(f.session);
+            require(!f.session.duplicateOriginalMainLaunchObjects(*grant, f.pipe,
+                missing == 0 ? nullptr : &outputs.token, missing == 1 ? nullptr : &outputs.requester,
+                missing == 2 ? nullptr : &outputs.package, &f.failure));
+            require(outputs.empty() && !model().duplicate_calls && GuardianScmEffectOwner::package(f.session) == retained);
+            require(f.failure == "ORIGINAL_MAIN_LAUNCH_OUTPUTS_REQUIRED");
+        });
+    }
+    for (unsigned populated : {0U, 1U, 2U}) {
+        run("duplicate_populated_output_" + std::to_string(populated) + "_unchanged", [&] {
+            Fixture f; auto grant = f.mint(); Outputs outputs;
+            if (populated == 0) outputs.token = model().make(ModelHandle::Kind::Token);
+            if (populated == 1) outputs.requester = model().make(ModelHandle::Kind::Requester);
+            if (populated == 2) outputs.package = std::make_unique<GuardianInstalledNamespace>();
+            auto* retained = GuardianScmEffectOwner::package(f.session);
+            const auto token = outputs.token, requester = outputs.requester;
+            const auto* package = outputs.package.get();
+            require(!duplicate(f.session, f.pipe, *grant, outputs, f.failure));
+            require(outputs.token == token && outputs.requester == requester && outputs.package.get() == package);
+            require(!model().duplicate_calls && GuardianScmEffectOwner::package(f.session) == retained);
+            require(f.failure == "ORIGINAL_MAIN_LAUNCH_OUTPUTS_NOT_EMPTY");
+        });
+    }
+    run("duplicate_aliased_handle_outputs_refused", [] {
+        Fixture f; auto grant = f.mint(); Outputs outputs;
+        require(!f.session.duplicateOriginalMainLaunchObjects(*grant, f.pipe, &outputs.token, &outputs.token,
+            &outputs.package, &f.failure));
+        require(outputs.empty() && !model().duplicate_calls && GuardianScmEffectOwner::package(f.session));
+        require(f.failure == "ORIGINAL_MAIN_LAUNCH_OUTPUTS_NOT_EMPTY");
+    });
+    for (unsigned phase : {1U, 2U}) {
+        run("authorize_fatal_revert_at_observation_" + std::to_string(phase), [&] {
+            Fixture f;
+            const auto* retained = GuardianScmEffectOwner::package(f.session);
+            model().fail_revert_at = phase;
+            require(!f.authorize() && f.failure == "ORIGINAL_MAIN_LAUNCH_IMPERSONATION_REVERT_FAILED");
+            requireFatalStopped(f);
+            require(GuardianScmEffectOwner::package(f.session) == retained && !model().duplicate_calls);
+            require(model().proof_calls == (phase == 1 ? 0U : 1U));
+        });
+        run("duplicate_fatal_revert_at_observation_" + std::to_string(phase), [&] {
+            Fixture f; auto grant = f.mint();
+            model().fail_revert_at = model().pipe_reads + phase;
+            refuse(f.session, f.pipe, *grant, "ORIGINAL_MAIN_LAUNCH_IMPERSONATION_REVERT_FAILED");
+            requireFatalStopped(f);
+            require(model().duplicate_calls == (phase == 1 ? 0U : 2U));
+        });
+    }
+    run("fatal_revert_is_sticky_without_new_identity_attempt", [] {
+        Fixture f; model().fail_revert_at = 1;
+        require(!f.authorize());
+        requireFatalStopped(f);
+        const auto attempts = model().identity_attempts;
+        const auto reads = model().store_reads;
+        const auto refused = observeOriginalClientOrStop(f.pipe, model().stop);
+        require(!refused.transport_exact && f.pipe.impersonationRevertFailed());
+        require(model().identity_attempts == attempts && model().store_reads == reads);
+        require(model().stop->signaled && model().stop_signals == 2);
+    });
+    std::cout << "{\"schema\":\"metaengine.guardian.original-main-launch-scope.model.v1\",\"passed\":"
+        << passed << ",\"failed\":" << failed << "}\n";
+    return failed ? 1 : 0;
+}
+} // namespace metaengine::guardian
+
+int main() { return metaengine::guardian::runCases(); }
