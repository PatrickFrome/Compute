+int main(int argc, char** argv) {
+    using fixture::Config;
+    struct Case { const char* name; Config config; int created, resumed, workers, jobs, holds; };
+    const std::vector<Case> cases{
+        {"STOP during original worker registration", {.stop_before_registration = true}, 0, 0, 1, 0, 0},
+        {"STOP with refused registration serializes both failure paths", {.stop_before_registration = true,
+            .registration_refused = true}, 0, 0, 0, 0, 1},
+        {"STOP with registration exception serializes both failure paths", {.stop_before_registration = true,
+            .registration_throws = true}, 0, 0, 0, 0, 1},
+        {"refused worker registry preserves custody HOLD", {.registration_refused = true}, 0, 0, 0, 0, 1},
+        {"worker registry allocation exception preserves custody HOLD", {.registration_throws = true}, 0, 0, 0, 0, 1},
+        {"failed worker creation releases unused callback", {.thread_failed = true}, 0, 0, 0, 0, 0},
+        {"failed start gate signal cancels and joins worker", {.gate_signal_failed = true}, 0, 0, 1, 0, 0},
+        {"failed original handle duplication creates no worker", {.duplicate_failed = true}, 0, 0, 0, 0, 0},
+        {"failed source preparation creates no process", {.prepare_failed = true}, 0, 0, 1, 0, 0},
+        {"failed CreateProcess retains and joins pending original pipe", {.create_failed = true}, 0, 0, 1, 0, 0},
+        {"debug kill policy failure drains original unassigned process", {.debug_kill_flag_failed = true}, 1, 0, 1, 0, 1},
+        {"failed Job attach cannot substitute an empty Job for process exit", {.assign_failed = true, .process_kill_failures = 3}, 1, 0, 1, 0, 1},
+        {"failed original Job registration terminates before resume", {.job_capture_failed = true}, 1, 0, 1, 0, 1},
+        {"post-create profile failure retains physical cleanup", {.dynamic_policy_failed = true}, 1, 0, 1, 1, 0},
+        {"STOP after creation still owns Job process and primary thread", {.cancel_after_creation = true}, 1, 0, 1, 1, 0},
+        {"event validation exception drains same pending event and file", {.event_throws = true}, 1, 0, 1, 1, 0},
+        {"diagnostic allocation failure still drains original process Job and pipe", {.diagnostic_allocation_failed = true}, 1, 0, 1, 1, 0},
+        {"failed live continuation drains original event before callback release", {.continue_failures = 1}, 1, 0, 1, 1, 0},
+        {"termination failures keep original objects until process debug exit", {.process_kill_failures = 3, .job_kill_failures = 4}, 1, 1, 1, 1, 0},
+        {"main exit waits for original descendants and unknown Job queries", {.natural_exit = true, .job_query_failures = 3,
+            .descendants_after_exit = 1, .descendant_queries = 4, .process_exit_waits = 3}, 1, 1, 1, 1, 0},
+        {"failed cancellation and early pipe event retain original I/O", {.cancellation_failed = true, .pipe_incomplete_results = 6}, 1, 1, 1, 1, 0},
+        {"early pipe identity failure revokes only owned Main", {.pipe_early_failure = true}, 1, 1, 1, 1, 0},
+        {"genuine pipe revert failure stops service and drains original objects", {.pipe_revert_failure = true}, 1, 1, 1, 1, 0},
+        {"closed observation and failed waits never replace physical worker join", {.hold_worker_exit = true,
+            .worker_wait_failures = 3}, 1, 1, 1, 1, 0},
+        {"natural original exit drains pipe Job and worker", {.natural_exit = true}, 1, 1, 1, 1, 0},
+    };
+    int passed = 0, failed = 0;
+    for (const auto& c : cases) {
+        if (argc > 1 && std::string(c.name).find(argv[1]) == std::string::npos) continue;
+        fixture::Model m(c.config); fixture::model = &m;
+        bool observations = true;
+        {
+            fixture::Handle stop(m.make(fixture::Kind::Event)); m.stop = m.get(stop.value);
+            fixture::Handle token(m.make(fixture::Kind::Token));
+            auto requester_object = std::make_shared<fixture::Object>(fixture::Kind::Process); requester_object->pid = 420;
+            fixture::Handle requester(m.add(std::move(requester_object)));
+            metaengine::guardian::GuardianScmEffectOwner factory;
+            auto owner = factory.start(stop.value, token.value, requester.value);
+            // Let the real worker reach its configured terminal path. close()
+            // is then checked separately, so cancellation cannot bypass a case.
+            if (!c.config.thread_failed && !c.config.duplicate_failed) {
+                std::unique_lock guard(m.mutex);
+                observations = m.changed.wait_for(guard, std::chrono::seconds(3), [&] { return m.worker_returned.load(); });
+            }
+            if (c.config.hold_worker_exit) {
+                const auto snapshot = owner->snapshot();
+                observations = observations && snapshot.closed && !m.worker->signaled;
+                std::atomic<bool> close_returned{false};
+                std::thread close([&] { owner->close(); close_returned = true; });
+                while (m.worker_waits.load() < 5) std::this_thread::yield();
+                observations = observations && !close_returned && m.pipe_joins == 1;
+                { std::lock_guard guard(m.mutex); m.allow_worker_signal = true; }
+                m.changed.notify_all(); close.join();
+            } else owner->close();
+            // Repeated close and snapshot/revoke share the actual owner methods.
+            std::thread close_again([&] { owner->close(); });
+            for (int i = 0; i < 50; ++i) { owner->requestRevoke(); observations = observations && !owner->snapshot().scope_live; }
+            close_again.join();
+            const auto snapshot = owner->snapshot();
+            observations = observations && snapshot.closed && !snapshot.scope_live;
+            observations = observations && m.stop->signaled ==
+                (c.config.stop_before_registration || c.config.cancel_after_creation || c.config.pipe_revert_failure);
+            if (c.config.diagnostic_allocation_failed) observations = observations && snapshot.win32_error == ERROR_NOT_ENOUGH_MEMORY;
+            if (c.created) observations = observations && snapshot.physical_process_exit_observed && snapshot.original_job_empty_observed &&
+                m.event_files_closed == 1 && m.before("exit-continued", "callback-released") && m.before("job-empty", "callback-released");
+            if (m.pipe_joins) observations = observations && m.before("pipe-terminal", "callback-released");
+            if (c.workers) observations = observations && m.before("worker-retained", "callback-released");
+            owner.reset();
+        }
+        m.join();
+        for (const auto& slot : m.slots) if (slot->object) ++m.errors;
+        const bool ok = observations && m.errors == 0 && m.callbacks == 0 && m.process_creations == c.created &&
+            m.resumes == c.resumed && m.worker_retained == c.workers && m.job_retained == c.jobs && m.custody_holds == c.holds;
+        if (!ok) {
+            std::lock_guard guard(m.mutex);
+            std::cerr << "errors=" << m.errors << " observed=" << observations << " created=" << m.process_creations << " resumed=" << m.resumes
+                << " retained=" << m.worker_retained << '/' << m.job_retained << " holds=" << m.custody_holds << '\n';
+            for (const auto& event : m.events) std::cerr << event << ' ';
+            std::cerr << '\n';
+        }
+        std::cout << (ok ? "PASS " : "FAIL ") << c.name << '\n';
+        ok ? ++passed : ++failed;
+    }
+    std::cout << "TOTAL " << passed << " PASS " << failed << " FAIL; MODEL ONLY; WINDOWS/AUTHORITY NOT RUN\n";
+    return failed ? 1 : passed ? 0 : 2;
+}
