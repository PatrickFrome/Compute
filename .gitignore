# Local diagnostics and tool state are not release sources.
/.audit-local/
/supabase/.temp/

# Generated installer inputs and output artifacts.
/apps/metaengine-browser/me2-ui-dist/
/apps/metaengine-browser/me2-daemon-dist/
/apps/metaengine-browser/native-dist/
/apps/metaengine-browser/devos-source-snapshot/
/apps/metaengine-browser/dist-test/
/apps/metaengine-browser/client-state-runtime-dist-before-*/

# Build outputs (never release sources).
.next/
dist/
build-output/

# Dependencies are installed, not committed.
node_modules/

# Runtime state: databases, WAL sidecars, logs. These carry live operator
# data and must never be tracked (secrets were previously leaked via
# apps/me2-daemon/data/me2.db).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
daemon.log
dev.log
server.log
*.log.tmp

# Runtime evidence generated by CI/AppVeyor at build time.
evidence/appveyor-zero-spend.json

# Editor / OS noise.
.DS_Store
Thumbs.db
