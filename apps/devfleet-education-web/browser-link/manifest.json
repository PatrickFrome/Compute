{
 "manifest_version":3,
 "name":"Education — беседы рядом",
 "description":"Урок и отдельные обычные беседы ChatGPT в штатном Split View Chrome. Без API и чтения сообщений.",
 "version":"0.1.0",
 "minimum_chrome_version":"155",
 "permissions":["storage"],
 "host_permissions":["https://devfleet-education-web.vercel.app/*","https://chatgpt.com/*"],
 "background":{"service_worker":"worker.mjs","type":"module"},
 "content_scripts":[{"matches":["https://devfleet-education-web.vercel.app/*"],"js":["content.js"],"run_at":"document_start","all_frames":false}],
 "action":{"default_title":"Education — беседы рядом"},
 "incognito":"not_allowed",
 "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'"}
}
