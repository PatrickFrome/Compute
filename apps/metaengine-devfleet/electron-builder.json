{
  "appId": "com.metaengine.devfleet.standalone",
  "productName": "METAENGINE DevFleet",
  "copyright": "METAENGINE",
  "asar": true,
  "electronVersion": "44.0.0",
  "directories": { "output": "dist" },
  "files": ["src/**/*", "package.json"],
  "extraResources": [{"from":"scripts/devfleet-admin-mcp.mjs","to":"devfleet-admin-mcp.mjs"}],
  "publish": null,
  "win": {
    "target": [{"target":"nsis","arch":["x64"]}],
    "artifactName": "METAENGINE-DevFleet-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "METAENGINE DevFleet",
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false
  }
}
