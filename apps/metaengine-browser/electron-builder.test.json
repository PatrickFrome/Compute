{
  "appId": "com.metaengine.browser.test",
  "productName": "METAENGINE Browser Test",
  "asar": true,
  "asarUnpack": [
    "src/browser-sentinel-worker.cjs",
    "src/browser-sentinel-liveness.cjs",
    "src/browser-sentinel-action-journal.cjs",
    "src/durable-json-file.cjs"
  ],
  "directories": {
    "output": "dist-test"
  },
  "files": [
    "src/**/*",
    "ui/**/*",
    "package.json"
  ],
  "beforePack": "./scripts/electron-builder-before-pack.cjs",
  "extraResources": [
    {
      "from": "native-dist/guardian",
      "to": "guardian-native",
      "filter": ["**/*"]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "PatrickFrome",
      "repo": "Compute",
      "releaseType": "prerelease",
      "channel": "dev"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "METAENGINE-Browser-Test-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "METAENGINE Browser Test",
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false
  }
}
